'border-sky-200\' },\n  \'\344\270\200\344\272\272\351\243\257\': { bg: \'bg-teal-50\', text: \'text-teal-800\', border: \'border-teal-200\' },\n  \'\346\216\245\345\276\205\': { bg: \'bg-slate-100\', text: \'text-slate-800\', border: \'border-slate-300\' },\n  \'\350\250\230\345\277\265\346\227\245\': { bg: \'bg-amber-50\', text: \'text-amber-800\', border: \'border-amber-200\' },\n};\n\nexport const PRICE_COLORS: Record<PriceRange, { bg: string; text: string; border: string }> = {\n  \'\343\200\2341000\345\206\206\': { bg: \'bg-emerald-50\', text: \'text-emerald-800\', border: \'border-emerald-200\' },\n  \'1000\343\200\2343000\345\206\206\': { bg: \'bg-teal-50\', text: \'text-teal-800\', border: \'border-teal-200\' },\n  \'3000\343\200\2345000\345\206\206\': { bg: \'bg-amber-50\', text: \'text-amber-900\', border: \'border-amber-200\' },\n  \'5000\345\206\206\343\200\234\': { bg: \'bg-indigo-50\', text: \'text-indigo-900\', border: \'border-indigo-200\' },\n};\n\nexport function getGenreStyle(genre: string) {\n  return (\n    GENRE_COLORS[genre] || {\n      bg: \'bg-slate-100\',\n      text: \'text-slate-700\',\n      border: \'border-slate-200\',\n    }\n  );\n}\n\nexport function getSceneStyle(scene: Scene) {\n  return (\n    SCENE_COLORS[scene] || {\n      bg: \'bg-slate-100\',\n      text: \'text-slate-700\',\n      border: \'border-slate-200\',\n    }\n  );\n}\n\nexport function formatJapaneseDate(isoString: string): string {\n  try {\n    const date = new Date(isoString);\n    if (isNaN(date.getTime())) return \'\';\n    return `${date.getFullYear()}/${date.getMonth() + 1}/${date.getDate()}`;\n  } catch {\n    return \'\';\n  }\n}\n\nexport interface RelatedSpotResult {\n  spot: RestaurantSpot;\n  matchReasons: string[];\n  score: number;\n}\n\n/**\n * Requirement 3: \343\200\214\343\201\223\343\201\206\343\201\204\343\201\206\343\201\256\343\202\202\343\201\212\343\201\231\343\201\231\343\202\201\343\200\215\346\251\237\350\203\275\n * \350\251\263\347\264\260\347\224\273\351\235\242\343\201\253\343\200\201\345\220\214\343\201\230\343\202\250\343\203\252\343\202\242\343\201\276\343\201\237\343\201\257\345\220\214\343\201\230\343\202\270\343\203\243\343\203\263\343\203\253\343\202\277\343\202\260\343\202\222\346\214\201\343\201\244\344\273\226\343\201\256\343\201\212\345\272\227\343\202\222\346\234\200\345\244\2473\344\273\266\343\200\201\351\226\242\351\200\243\343\201\212\343\201\231\343\201\231\343\202\201\343\201\250\343\201\227\343\201\246\350\241\250\347\244\272\n */\nexport function getRelatedSpots(currentSpot: RestaurantSpot, allSpots: RestaurantSpot[]): RelatedSpotResult[] {\n  const otherSpots = allSpots.filter((s) => s.id !== currentSpot.id);\n\n  const scoredSpots: RelatedSpotResult[] = [];\n\n  for (const spot of otherSpots) {\n    const matchReasons: string[] = [];\n    let score = 0;\n\n    // Area match\n    if (spot.area && currentSpot.area && spot.area.trim().toLowerCase() === currentSpot.area.trim().toLowerCase()) {\n      matchReasons.push(`\345\220\214\343\201\230\343\200\214${spot.area}\343\200\215\343\202\250\343\203\252\343\202\242`);\n      score += 3;\n    }\n\n    // Genre matches\n    const commonGenres = spot.genres.filter((g) => currentSpot.genres.includes(g));\n    if (commonGenres.length > 0) {\n      matchReasons.push(`\345\220\214\343\201\230\343\202\270\343\203\243\343\203\263\343\203\253\343\200\214${commonGenres.join(\'\343\203\273\')}\343\200\215`);\n      score += commonGenres.length * 2;\n    }\n\n    // Scene matches (bonus subtle connection)\n    const commonScenes = spot.scenes.filter((sc) => currentSpot.scenes.includes(sc));\n    if (commonScenes.length > 0) {\n      score += 0.5;\n    }\n\n    if (score > 0) {\n      scoredSpots.push({\n        spot,\n        matchReasons,\n        score,\n      });\n    }\n  }\n\n  // Sort by score descending, then by newest\n  scoredSpots.sort((a, b) => {\n    if (b.score !== a.score) return b.score - a.score;\n    return new Date(b.spot.createdAt).getTime() - new Date(a.spot.createdAt).getTime();\n  });\n\n  return scoredSpots.slice(0, 3);\n}\n\nexport function generateRecommenderAvatar(name: string): { bg: string; text: string; initial: string } {\n  const palette = [\n    { bg: \'bg-indigo-100\', text: \'text-indigo-800\' },\n    { bg: \'bg-amber-100\', text: \'text-amber-800\' },\n    { bg: \'bg-teal-100\', text: \'text-teal-800\' },\n    { bg: \'bg-slate-200\', text: \'text-slate-800\' },\n    { bg: \'bg-sky-100\', text: \'text-sky-800\' },\n    { bg: \'bg-emerald-100\', text: \'text-emerald-800\' },\n  ];\n\n  let sum = 0;\n  for (let i = 0; i < name.length; i++) {\n    sum += name.charCodeAt(i);\n  }\n  const color = palette[sum % palette.length];\n  const initial = name.trim().slice(0, 1) || \'\345\217\213\';\n\n  return { ...color, initial };\n}"
