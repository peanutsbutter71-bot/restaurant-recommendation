        target_content: "import React from \'react\';\nimport { Utensils, Sparkles, Plus, Dices, Heart, Share2, User } from \'lucide-react\';\n\ninterface HeaderProps {\n  spotCount: number;\n  favoriteCount: number;\n  onOpenAddModal: () => void;\n  onOpenQuickImport: () => void;\n  onOpenRandomModal: () => void;\n  onOpenMyPage?: () => void;\n  favoritesOnly: boolean;\n  onToggleFavoritesOnly: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  spotCount,\n  favoriteCount,\n  onOpenAddModal,\n  onOpenQuickImport,\n  onOpenRandomModal,\n  onOpenMyPage,\n  favoritesOnly,\n  onToggleFavoritesOnly,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-30 bg-[#FAF8F5]/90 backdrop-blur-md border-b border-stone-200/70 transition-all\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6 py-3.5 sm:py-4\">\n        <div className=\"flex items-center justify-between gap-3\">\n          {/* Logo & Subtitle */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-br from-rose-400 via-pink-400 to-amber-300 flex items-center justify-center text-white shadow-sm shadow-rose-200\">\n              <Utensils className=\"w-5 h-5 sm:w-6 sm:h-6\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-xl sm:text-2xl font-bold tracking-tight text-stone-900 font-serif sm:font-sans\">\n                  Gourmet<span className=\"text-rose-500 font-extrabold\">Share</span>\n                </h1>\n                <span className=\"hidden sm:inline-flex items-center gap-1 text-[11px] font-semibold bg-rose-50 text-rose-600 px-2 py-0.5 rounded-full border border-rose-100\">\n                  <Sparkles className=\"w-3 h-3\" />\n                  \345\217\213\343\201\240\343\201\241\346\216\250\350\226\246\n                </span>\n              </div>\n              <p className=\"text-xs text-stone-500 font-medium hidden xs:block\">\n                \344\277\241\351\240\274\343\201\247\343\201\215\343\202\213\345\217\213\344\272\272\343\203\273\345\205\210\350\274\251\343\201\213\343\202\211\346\225\231\343\201\210\343\201\246\343\202\202\343\202\211\343\201\243\343\201\237\345\216\263\351\201\270\343\202\260\343\203\253\343\203\241\343\203\216\343\203\274\343\203\210\n              </p>\n            </div>\n          </div>"
        replacement_content: "import React from \'react\';\nimport { Utensils, Sparkles, Plus, Dices, Heart, Share2, User, Flame, ListFilter } from \'lucide-react\';\nimport { MainTab } from \'../types\';\n\ninterface HeaderProps {\n  spotCount: number;\n  favoriteCount: number;\n  activeTab: MainTab;\n  onTabChange: (tab: MainTab) => void;\n  onOpenAddModal: () => void;\n  onOpenQuickImport: () => void;\n  onOpenRandomModal: () => void;\n  onOpenMyPage?: () => void;\n  favoritesOnly: boolean;\n  onToggleFavoritesOnly: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  spotCount,\n  favoriteCount,\n  activeTab,\n  onTabChange,\n  onOpenAddModal,\n  onOpenQuickImport,\n  onOpenRandomModal,\n  onOpenMyPage,\n  favoritesOnly,\n  onToggleFavoritesOnly,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-30 bg-[#FAF8F5]/90 backdrop-blur-md border-b border-stone-200/70 transition-all\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6 py-2.5 sm:py-3.5\">\n        <div className=\"flex items-center justify-between gap-3\">\n          {/* Logo & Tab Switcher */}\n          <div className=\"flex items-center gap-3 sm:gap-6\">\n            <div className=\"flex items-center gap-2.5 cursor-pointer\" onClick={() => onTabChange(\'list\')}>\n              <div className=\"w-10 h-10 rounded-2xl bg-gradient-to-br from-rose-400 via-pink-400 to-amber-300 flex items-center justify-center text-white shadow-sm shadow-rose-200\">\n                <Utensils className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <div className=\"flex items-center gap-1.5\">\n                  <h1 className=\"text-xl sm:text-2xl font-bold tracking-tight text-stone-900 font-serif sm:font-sans\">\n                    Gourmet<span className=\"text-rose-500 font-extrabold\">Share</span>\n                  </h1>\n                </div>\n                <p className=\"text-[11px] text-stone-500 font-medium hidden md:block\">\n                  \345\217\213\344\272\272\343\201\213\343\202\211\346\225\231\343\201\210\343\201\246\343\202\202\343\202\211\343\201\243\343\201\237\344\277\241\351\240\274\343\202\260\343\203\253\343\203\241\343\203\216\343\203\274\343\203\210\n                </p>\n              </div>\n            </div>\n\n            {/* \360\237\224\245 Primary Main Tabs: \344\270\200\350\246\247 vs \347\231\272\350\246\213\343\202\271\343\203\257\343\202\244\343\203\227 */}\n            <div className=\"flex items-center p-1 bg-stone-200/80 rounded-2xl border border-stone-300/60 shadow-2xs\">\n              <button\n                type=\"button\"\n                id=\"header-tab-list\"\n                onClick={() => onTabChange(\'list\')}\n                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer ${\n                  activeTab === \'list\'\n                    ? \'bg-white text-stone-900 shadow-sm\'\n                    : \'text-stone-600 hover:text-stone-900\'\n                }`}\n              >\n                <ListFilter className=\"w-3.5 h-3.5\" />\n                <span>\344\270\200\350\246\247</span>\n                <span className=\"text-[10px] px-1.5 py-0.2 rounded-full bg-stone-100 text-stone-600\">\n                  {spotCount}\n                </span>\n              </button>\n\n              <button\n                type=\"button\"\n                id=\"header-tab-discover\"\n                onClick={() => onTabChange(\'discover\')}\n                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-extrabold transition-all cursor-pointer ${\n                  activeTab === \'discover\'\n                    ? \'bg-gradient-to-r from-rose-500 to-pink-500 text-white shadow-sm shadow-rose-200\'\n                    : \'text-stone-600 hover:text-rose-600\'\n                }`}\n              >\n                <Flame className={`w-3.5 h-3.5 ${activeTab === \'discover\' ? \'text-white\' : \'text-rose-500\'}`} />\n                <span>\347\231\272\350\246\213</span>\n                <span className={`text-[9px] px-1.5 py-0.2 rounded-full font-black uppercase tracking-wider ${\n                  activeTab === \'discover\' ? \'bg-white/25 text-white\' : \'bg-rose-100 text-rose-700\'\n                }`}>\n                  Tinder\351\242\250\n                </span>\n              </button>\n            </div>\n          </div>"
      }
      num_matches: 1
    }
  }
}
