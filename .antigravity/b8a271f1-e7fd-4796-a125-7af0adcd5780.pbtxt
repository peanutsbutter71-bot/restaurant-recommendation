      target_content: "      {/* Sticky Header */}\n      <Header\n        spotCount={spots.length}\n        favoriteCount={favoriteCount}\n        onOpenAddModal={() => {\n          setEditingSpot(null);\n          setIsAddModalOpen(true);\n        }}\n        onOpenRandomModal={() => setIsRandomModalOpen(true)}\n        favoritesOnly={filters.favoritesOnly}\n        onToggleFavoritesOnly={() =>\n          setFilters((prev) => ({ ...prev, favoritesOnly: !prev.favoritesOnly }))\n        }\n      />\n\n      {/* Main Content Area */}\n      <main className=\"max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 flex-1 w-full space-y-6\">\n        {/* Subtle Welcome & Aesthetic Hero Badge */}\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-gradient-to-r from-rose-100/50 via-pink-50/40 to-amber-50/50 p-4 sm:p-5 rounded-3xl border border-rose-100/70\">\n          <div className=\"space-y-0.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-rose-600\">\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>\344\277\241\351\240\274\343\201\247\343\201\215\343\202\213\343\201\212\343\201\231\343\201\231\343\202\201\343\201\240\343\201\221\343\201\214\351\233\206\343\201\276\343\202\213\345\240\264\346\211\200</span>\n            </div>\n            <p className=\"text-xs sm:text-sm text-stone-600 font-medium\">\n              \343\202\244\343\203\263\343\202\271\343\202\277\343\202\204\343\203\215\343\203\203\343\203\210\343\201\256\345\217\243\343\202\263\343\203\237\343\201\253\350\277\267\343\202\217\343\201\252\343\201\204\343\200\201\345\217\213\344\272\272\343\203\273\345\205\210\350\274\251\343\201\256\343\201\212\345\242\250\344\273\230\343\201\215\343\202\260\343\203\253\343\203\241\343\203\216\343\203\274\343\203\210\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-2 self-start sm:self-auto\">\n            <button\n              onClick={