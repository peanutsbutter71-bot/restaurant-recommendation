      replacement_content: "  // Parse Shared URL/Text API endpoint (Web Share Target & Quick URL Import)\n  app.post(\'/api/spots/parse-share-url\', async (req, res) => {\n    const { rawInput, title, text, url } = req.body;\n\n    // Combine any shared components\n    const inputContent = [rawInput, url, text, title]\n      .filter((s) => s && typeof s === \'string\' && s.trim().length > 0)\n      .join(\'\\n\')\n      .trim();\n\n    if (!inputContent) {\n      return res.status(400).json({\n        error: \'URL\343\201\276\343\201\237\343\201\257\343\203\206\343\202\255\343\202\271\343\203\210\343\202\222\345\205\245\345\212\233\343\201\227\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\',\n      });\n    }\n\n    const apiKey = process.env.GEMINI_API_KEY;\n\n    // Extract basic URL if present\n    const urlMatch = inputContent.match(/https?:\\/\\/[^\\s]+/i);\n    const extractedUrl = urlMatch ? urlMatch[0] : \'\';\n    const isGoogleMaps = extractedUrl.includes(\'google.com/maps\') || extractedUrl.includes(\'maps.app.goo.gl\');\n    const isTabelog = extractedUrl.includes(\'tabelog.com\');\n    const isInstagram = extractedUrl.includes(\'instagram.com\');\n\n    if (!apiKey) {\n      // Fallback extraction without Gemini API\n      let fallbackName = title || \'\346\260\227\343\201\253\343\201\252\343\202\213\343\201\212\345\272\227\';\n      let fallbackArea = \'\346\235\261\344\272\254\';\n      if (inputContent) {\n        const firstLine = inputContent.split(\'\\n\')[0].replace(/https?:\\/\\/[^\\s]+/g, \'\').trim();\n        if (firstLine.length > 0 && firstLine.length < 30) {\n          fallbackName = firstLine;\n        }\n      }\n\n      return res.json({\n        spot: {\n          name: fallbackName,\n          area: fallbackArea,\n          genres: [\'\343\202\253\343\203\225\343\202\247\343\203\273\345\226\253\350\214\266\'],\n          scenes: [\'\345\217\213\351\201\224\343\203\273\345\220\214\345\203\232\343\201\250\'],\n          priceRange: \'\302\2451,000\343\200\234\302\2452,000\',\n          recommender: \'\345\205\261\346\234\211\343\203\252\343\203\263\343\202\257\',\n          comment: `\345\205\261\346\234\211\343\203\252\343\203\263\343\202\257\343\201\213\343\202\211\350\277\275\345\212\240: ${inputContent.slice(0, 100)}`,\n          mapUrl: isGoogleMaps ? extractedUrl : undefined,\n          tabelogUrl: isTabelog ? extractedUrl : undefined,\n          highlightDish: \'\',\n        },\n        sourceUrl: extractedUrl,\n        isAiParsed: false,\n        message: \'\345\237\272\346\234\254\346\203\205\345\240\261\343\201\256\343\201\277\346\212\275\345\207\272\343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\345\277\205\350\246\201\343\201\253\345\277\234\343\201\230\343\201\246\350\243\234\346\255\243\343\201\227\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n      });\n    }\n\n    try {\n      const ai = new GoogleGenAI({\n        apiKey,\n        httpOptions: {\n          headers: {\n            \'User-Agent\': \'aistudio-build\',\n          },\n        },\n      });\n\n      const prompt = `\343\201\202\343\201\252\343\201\237\343\201\257\346\227\245\346\234\254\343\201\256\343\202\260\343\203\253\343\203\241\346\203\205\345\240\261\343\203\273\351\243\262\351\243\237\345\272\227\343\203\207\343\203\274\343\202\277\346\212\275\345\207\272\343\201\256\343\202\271\343\203\232\343\202\267\343\203\243\343\203\252\343\202\271\343\203\210\343\201\247\343\201\231\343\200\202\n\343\203\246\343\203\274\343\202\266\343\203\274\343\201\213\343\202\211\345\205\261\346\234\211\343\201\225\343\202\214\343\201\237\344\273\245\344\270\213\343\201\256URL\343\201\276\343\201\237\343\201\257\343\203\206\343\202\255\343\202\271\343\203\210\343\202\222\350\247\243\346\236\220\343\201\227\343\200\201Google\346\244\234\347\264\242\343\203\204\343\203\274\343\203\253\343\202\222\347\224\250\343\201\204\343\201\246\345\272\227\350\210\227\343\201\256\346\255\243\