    replacement_chunks {
      target_content: "import React from \'react\';\nimport { Heart, MapPin, Sparkles, ArrowUpRight, CheckCircle2, Bookmark, Lock, FolderOpen } from \'lucide-react\';\nimport { RestaurantSpot } from \'../types\';\nimport {\n  getGenreStyle,\n  getSceneStyle,\n  PRICE_COLORS,\n  generateRecommenderAvatar,\n} from \'../utils/helpers\';\nimport { getOperatingStatusBadge } from \'../utils/aiStatusCheck\';\n\ninterface SpotCardProps {\n  spot: RestaurantSpot;\n  onSelect: (spot: RestaurantSpot) => void;\n  onToggleFavorite: (id: string, e: React.MouseEvent) => void;\n  onToggleVisited?: (id: string, e: React.MouseEvent) => void;\n}\n\nexport const SpotCard: React.FC<SpotCardProps> = ({\n  spot,\n  onSelect,\n  onToggleFavorite,\n  onToggleVisited,\n}) => {\n  const avatar = generateRecommenderAvatar(spot.recommender);\n  const priceStyle = PRICE_COLORS[spot.priceRange];\n  const statusBadge = getOperatingStatusBadge(spot.operatingStatus);\n\n  return (\n    <div\n      id={`spot-card-${spot.id}`}\n      onClick={() => onSelect(spot)}\n      className={`group relative bg-white rounded-3xl border overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col cursor-pointer ${\n        statusBadge.isAlert ? \'border-red-300/80 bg-red-50/10\' : \'border-stone-200/70\'\n      }`}\n    >\n      {/* Image Container - Sleek 16:10 aspect ratio */}\n      <div className=\"relative aspect-[16/10] w-full overflow-hidden bg-stone-100\">\n        <img\n          src={\n            spot.imageUrl ||\n            \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80\'\n          }\n          alt={spot.name}\n          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n          loading=\"lazy\"\n          referrerPolicy=\"no-referrer\"\n        />\n\n        {/* Gradient Overlay for legibility */}\n        <div className=\"absolute inset-0 bg-gradient-to-t from-stone-900/60 via-transparent to-black/20\" />\n\n        {/* Top Badges: Area & Action Buttons */}\n        <div className=\"absolute top-3 inset-x-3 flex items-center justify-between pointer-events-none\">\n          {/* Area & Visit Status & Closed Alert Pills */}\n          <div className=\"flex items-center gap-1.5 pointer-events-auto flex-wrap\">\n            <span className=\"inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/90 backdrop-blur-md text-stone-800 font-bold text-xs shadow-sm\">\n              <MapPin className=\"w-3 h-3 text-rose-500\" />\n              {spot.area}\n            </span>\n\n            {/* Closed Alert Badge if Permanently or Temporarily Closed */}\n            {statusBadge.isAlert && (\n              <span className={`inline-flex items-center px-2 py-0.5 rounded-full font-extrabold text-[11px] shadow-sm ${statusBadge.bg} ${statusBadge.text}`}>\n                {statusBadge.label}\n              </span>\n            )}\n\n            {/* Visit Status Badge with Toggle */}\n            <button\n              id={`visit-toggle-card-${spot.id}`}\n              onClick={(e) => onToggleVisited && onToggleVisited(spot.id, e)}\n              className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold transition-all shadow-sm active:scale-95 ${\n                spot.isVisited\n                  ? \'bg-emerald-500 text-white shadow-emerald-500/30\'\n                  : \'bg-amber-400/95 hover:bg-amber-400 text-stone-900 shadow-amber-400/30\'\n              }`}\n              title={spot.isVisited ? \'\350\250\252\345\225\217\346\270\210\343\201\277\357\274\210\343\202\257\343\203\252\343\203\203\343\202\257\343\201\247\343\200\214\350\241\214\343\201\215\343\201\237\343\201\204\343\200\215\343\201\253\345\244\211\346\233\264\357\274\211\' : \'\350\241\214\343\201\215\343\201\237\343\201\204\357\274\210\343\202\257\343\203\252\343\203\203\343\202\257\343\201\247\343\200\214\350\241\214\343\201\243\343\201\237\343\200\215\343\201\253\345\244\211\346\233\264\357\274\211\'}\n            >\n              {spot.isVisited ? (\n                <>\n                  <CheckCircle2 className=\"w-3.5 h-3.5 stroke-[2.5]\" />\n                  <span>\350\241\214\343\201\243\343\201\237</span>\n                </>\n              ) : (\n                <>\n                  <Bookmark className=\"w-3.5 h-3.5 stroke-[2.5]\" />\n                  <span>\350\241\214\343\201\215\343\201\237\343\201\204</span>\n                </>\n              )}\n            </button>\n          </div>\n\n          {/* Favorite Button */}\n          <button\n            id={`fav-btn-${spot.id}`}\n            onClick={(e) => onToggleFavorite(spot.id, e)}\n            className={`pointer-events-auto p-2 rounded-full backdrop-blur-md transition-transform duration-200 active:scale-90 ${\n              spot.isFavorite\n                ? \'bg-rose-500 text-white shadow-md shadow-rose-500/30\'\n                : \'bg-white/80 hover:bg-white text-stone-700 hover:text-rose-500 shadow-sm\'\n            }`}\n            title={spot.isFavorite ? \'\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\350\247\243\351\231\244\' : \'\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\253\350\277\275\345\212\240\'}\n          >\n            <Heart\n              className={`w-4 h-4 transition-colors ${\n                spot.isFavorite ? \'fill-current\' : \'\'\n              }`}\n            />\n          </button>\n        </div>\n\n        {/* Bottom overlay in image: Price & Genres */}\n        <div className=\"absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs\">\n          <span className={`px-2.5 py-0.5 rounded-lg font-bold backdrop-blur-md shadow-sm ${priceStyle.bg}`}>\n            {spot.priceRange}\n          </span>\n\n          <div className=\"flex items-center gap-1 overflow-hidden\">\n            {spot.genres.slice(0, 2).map((genre) => {\n              return (\n                <span\n                  key={genre}\n                  className=\"px-2 py-0.5 rounded-md bg-white/90 backdrop-blur-md text-stone-800 text-[11px] font-semibold\"\n                >\n                  {genre}\n                </span>\n              );\n            })}\n            {spot.genres.length > 2 && (\n              <span className=\"px-1.5 py-0.5 rounded-md bg-white/80 backdrop-blur-md text-stone-700 text-[10px] font-bold\">\n                +{spot.genres.length - 2}\n              </span>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Body Content */}\n      <div className=\"p-4 sm:p-5 flex-1 flex flex-col justify-between space-y-3\">\n        <div>\n          {/* Top meta: Recommender Badge & Private Memo Icon & Folders */}\n          <div className=\"flex items-center justify-between gap-2 mb-2 flex-wrap\">\n            <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-stone-50 border border-stone-200/70\">\n              <span\n                className={`w-4 h-4 rounded-full flex items-center justify-center font-bold text-[10px] ${avatar.bg} ${avatar.text}`}\n              >\n                {avatar.initial}\n              </span>\n              <span className=\"text-xs font-semibold text-stone-700 truncate max-w-[170px]\">\n                {spot.recommender} \343\201\256\343\201\212\343\201\231\343\201\231\343\202\201\n              </span>\n            </div>\n\n            {spot.privateMemo && (\n              <span\n                className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-stone-100 text-stone-600 text-[10px] font-bold\"\n                title=\"\360\237\224\222 \351\235\236\345\205\254\351\226\213\343\203\241\343\203\242\343\201\202\343\202\212\"\n              >\n                <Lock className=\"w-3 h-3 text-stone-500\" />\n                <span>\343\203\241\343\203\242\343\201\202\343\202\212</span>\n              </span>\n            )}\n          </div>\n\n          {/* Shop Title */}\n          <h2 className=\"text-base sm:text-lg font-bold text-stone-900 leading-snug group-hover:text-rose-600 transition-colors line-clamp-1 flex items-center justify-between\">\n            <span>{spot.name}</span>\n            <ArrowUpRight className=\"w-4 h-4 text-stone-400 group-hover:text-rose-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all opacity-0 group-hover:opacity-100 flex-shrink-0\" />\n          </h2>\n\n          {/* Highlight Dish if present */}\n          {spot.highlightDish && (\n            <p className=\"mt-1 text-xs font-medium text-rose-600 flex items-center gap-1\">\n              <Sparkles className=\"w-3 h-3 flex-shrink-0\" />\n              <span className=\"truncate\">\346\216\250\343\201\227\357\274\232{spot.highlightDish}</span>\n            </p>\n          )}\n\n          {/* Comment Snippet */}\n          <p className=\"mt-2 text-xs text-stone-600 line-clamp-2 leading-relaxed font-normal\">\n            \343\200\214{spot.comment}\343\200\215\n          </p>\n        </div>\n\n        {/* Bottom Scene & Folder Tags */}\n        <div className=\"pt-2.5 border-t border-stone-100 flex flex-wrap gap-1 items-center justify-between\">\n          <div className=\"flex flex-wrap gap-1 items-center\">\n            {spot.folders && spot.folders.length > 0 && (\n              <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-50 border border-rose-200 text-rose-700 flex items-center gap-0.5\">\n                <FolderOpen className=\"w-2.5 h-2.5\" />\n                {spot.folders[0]}\n                {spot.folders.length > 1 ? ` +${spot.folders.length - 1}` : \'\'}\n              </span>\n            )}\n            {spot.scenes.map((scene) => {\n              const style = getSceneStyle(scene);\n              return (\n                <span\n                  key={scene}\n                  className={`text-[10px] sm:text-[11px] font-medium px-2 py-0.5 rounded-full border ${style.bg} ${style.text} ${style.border}`}\n                >\n                  #{scene}\n                </span>\n              );\n            })}\n          </div>\n          {spot.isVisited && spot.visitedAt && (\n            <span className=\"text-[10px] font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-100\">\n              {spot.visitedAt} \350\250\252\345\225\217\n            </span>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { Heart, MapPin, Sparkles, ArrowUpRight, Check, Bookmark, Lock, FolderOpen } from \'lucide-react\';\nimport { RestaurantSpot } from \'../types\';\nimport {\n  PRICE_COLORS,\n  generateRecommenderAvatar,\n} from \'../utils/helpers\';\nimport { getOperatingStatusBadge } from \'../utils/aiStatusCheck\';\n\ninterface SpotCardProps {\n  spot: RestaurantSpot;\n  onSelect: (spot: RestaurantSpot) => void;\n  onToggleFavorite: (id: string, e: React.MouseEvent) => void;\n  onToggleVisited?: (id: string, e: React.MouseEvent) => void;\n}\n\nexport const SpotCard: React.FC<SpotCardProps> = ({\n  spot,\n  onSelect,\n  onToggleFavorite,\n  onToggleVisited,\n}) => {\n  const avatar = generateRecommenderAvatar(spot.recommender);\n  const statusBadge = getOperatingStatusBadge(spot.operatingStatus);\n\n  return (\n    <div\n      id={`spot-card-${spot.id}`}\n      onClick={() => onSelect(spot)}\n      className={`group relative bg-white rounded-2xl border overflow-hidden shadow-2xs hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 flex flex-col cursor-pointer ${\n        statusBadge.isAlert ? \'border-red-300 bg-red-50/10\' : \'border-stone-200/90\'\n      }`}\n    >\n      {/* Image Container - Photography as Hero */}\n      <div className=\"relative aspect-[16/11] w-full overflow-hidden bg-stone-100\">\n        <img\n          src={\n            spot.imageUrl ||\n            \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80\'\n          }\n          alt={spot.name}\n          className=\"w-full h-full object-cover group-hover:scale-103 transition-transform duration-500\"\n          loading=\"lazy\"\n          referrerPolicy=\"no-referrer\"\n        />\n\n        {/* Subtle Gradient Overlay for visual depth */}\n        <div className=\"absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20\" />\n\n        {/* Top Badges: Area & Controls */}\n        <div className=\"absolute top-2.5 inset-x-2.5 flex items-center justify-between pointer-events-none\">\n          {/* Area & Status */}\n          <div className=\"flex items-center gap-1.5 pointer-events-auto flex-wrap\">\n            <span className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-black/60 backdrop-blur-md text-white font-medium text-xs shadow-2xs\">\n              <MapPin className=\"w-3 h-3 text-orange-400\" />\n              {spot.area}\n            </span>\n\n            {/* Closed Alert Badge if Permanently or Temporarily Closed */}\n            {statusBadge.isAlert && (\n              <span className={`inline-flex items-center px-2 py-0.5 rounded-md font-bold text-[11px] shadow-2xs ${statusBadge.bg} ${statusBadge.text}`}>\n                {statusBadge.label}\n              </span>\n            )}\n          </div>\n\n          {/* Top-Right Action Controls */}\n          <div className=\"flex items-center gap-1.5 pointer-events-auto\">\n            {/* Visit Status Toggle Button */}\n            <button\n              type=\"button\"\n              id={`visit-toggle-card-${spot.id}`}\n              onClick={(e) => {\n                e.stopPropagation();\n                onToggleVisited && onToggleVisited(spot.id, e);\n              }}\n              className={`px-2.5 py-1 rounded-md text-xs font-semibold backdrop-blur-md transition-all active:scale-95 flex items-center gap-1 shadow-2xs ${\n                spot.isVisited\n                  ? \'bg-stone-900/90 text-white hover:bg-stone-900\'\n                  : \'bg-white/90 text-stone-800 hover:bg-white hover:text-orange-600\'\n              }`}\n              title={spot.isVisited ? \'\350\250\252\345\225\217\346\270\210\343\201\277\357\274\210\343\202\257\343\203\252\343\203\203\343\202\257\343\201\247\343\200\214\350\241\214\343\201\215\343\201\237\343\201\204\343\200\215\343\201\253\345\244\211\346\233\264\357\274\211\' : \'\350\241\214\343\201\215\343\201\237\343\201\204\357\274\210\343\202\257\343\203\252\343\203\203\343\202\257\343\201\247\343\200\214\350\241\214\343\201\243\343\201\237\343\200\215\343\201\253\345\244\211\346\233\264\357\274\211\'}\n            >\n              {spot.isVisited ? (\n                <>\n                  <Check className=\"w-3 h-3 text-orange-400 stroke-[3]\" />\n                  <span>\350\241\214\343\201\243\343\201\237</span>\n                </>\n              ) : (\n                <>\n                  <Bookmark className=\"w-3 h-3 stroke-[2]\" />\n                  <span>\350\241\214\343\201\215\343\201\237\343\201\204</span>\n                </>\n              )}\n            </button>\n\n            {/* Favorite Button */}\n            <button\n              type=\"button\"\n              id={`fav-btn-${spot.id}`}\n              onClick={(e) => {\n                e.stopPropagation();\n                onToggleFavorite(spot.id, e);\n              }}\n              className={`p-1.5 rounded-md backdrop-blur-md transition-all active:scale-90 shadow-2xs ${\n                spot.isFavorite\n                  ? \'bg-orange-600 text-white\'\n                  : \'bg-white/90 text-stone-700 hover:text-orange-600 hover:bg-white\'\n              }`}\n              title={spot.isFavorite ? \'\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\350\247\243\351\231\244\' : \'\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\253\350\277\275\345\212\240\'}\n            >\n              <Heart\n                className={`w-3.5 h-3.5 transition-colors ${\n                  spot.isFavorite ? \'fill-current\' : \'\'\n                }`}\n              />\n            </button>\n          </div>\n        </div>\n\n        {/* Bottom Overlay inside Photo: Price & Genres */}\n        <div className=\"absolute bottom-2.5 left-2.5 right-2.5 flex items-center justify-between text-xs\">\n          <span className=\"px-2 py-0.5 rounded-md bg-black/60 backdrop-blur-md text-stone-200 text-[11px] font-medium\">\n            {spot.priceRange}\n          </span>\n\n          <div className=\"flex items-center gap-1 overflow-hidden\">\n            {spot.genres.slice(0, 2).map((genre) => (\n              <span\n                key={genre}\n                className=\"px-2 py-0.5 rounded-md bg-black/60 backdrop-blur-md text-stone-200 text-[11px] font-medium\"\n              >\n                {genre}\n              </span>\n            ))}\n            {spot.genres.length > 2 && (\n              <span className=\"px-1.5 py-0.5 rounded-md bg-black/60 backdrop-blur-md text-stone-300 text-[10px]\">\n                +{spot.genres.length - 2}\n              </span>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Body Content */}\n      <div className=\"p-4 sm:p-4.5 flex-1 flex flex-col justify-between space-y-3\">\n        <div>\n          {/* Shop Title & Arrow */}\n          <div className=\"flex items-start justify-between gap-2\">\n            <h2 className=\"text-base font-bold text-stone-900 leading-snug group-hover:text-orange-600 transition-colors line-clamp-1\">\n              {spot.name}\n            </h2>\n            <ArrowUpRight className=\"w-4 h-4 text-stone-400 group-hover:text-orange-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all opacity-0 group-hover:opacity-100 shrink-0 mt-0.5\" />\n          </div>\n\n          {/* Highlight Dish if present */}\n          {spot.highlightDish && (\n            <p className=\"mt-1 text-xs font-semibold text-orange-600 flex items-center gap-1\">\n              <Sparkles className=\"w-3 h-3 shrink-0\" />\n              <span className=\"truncate\">\345\220\215\347\211\251: {spot.highlightDish}</span>\n            </p>\n          )}\n\n          {/* Recommender Quote Card (Lemon8/BeReal style friend curation) */}\n          <div className=\"mt-2.5 p-2.5 bg-stone-50 rounded-xl border border-stone-200/70\">\n            <div className=\"flex items-center justify-between gap-1.5 mb-1\">\n              <div className=\"flex items-center gap-1.5 min-w-0\">\n                <span\n                  className={`w-4 h-4 rounded-full flex items-center justify-center font-bold text-[9px] ${avatar.bg} ${avatar.text}`}\n                >\n                  {avatar.initial}\n                </span>\n                <span className=\"text-[11px] font-semibold text-stone-700 truncate\">\n                  {spot.recommender}\n                </span>\n              </div>\n              {spot.privateMemo && (\n                <span\n                  className=\"inline-flex items-center gap-0.5 text-stone-400 text-[10px]\"\n                  title=\"\360\237\224\222 \351\235\236\345\205\254\351\226\213\343\203\241\343\203\242\343\201\202\343\202\212\"\n                >\n                  <Lock className=\"w-2.5 h-2.5\" />\n                </span>\n              )}\n            </div>\n            <p className=\"text-xs text-stone-600 line-clamp-2 leading-relaxed font-normal\">\n              \343\200\214{spot.comment}\343\200\215\n            </p>\n          </div>\n        </div>\n\n        {/* Bottom Scene & Folder Meta */}\n        <div className=\"pt-2 border-t border-stone-100 flex flex-wrap gap-1 items-center justify-between\">\n          <div className=\"flex flex-wrap gap-1 items-center\">\n            {spot.folders && spot.folders.length > 0 && (\n              <span className=\"text-[10px] font-medium px-2 py-0.5 rounded-md bg-stone-100 text-stone-700 border border-stone-200 flex items-center gap-1\">\n                <FolderOpen className=\"w-3 h-3 text-stone-500\" />\n                {spot.folders[0]}\n                {spot.folders.length > 1 ? ` +${spot.folders.length - 1}` : \'\'}\n              </span>\n            )}\n            {spot.scenes.map((scene) => (\n              <span\n                key={scene}\n                className=\"text-[10px] font-medium px-2 py-0.5 rounded-md bg-stone-100/90 text-stone-700 border border-stone-200/80\"\n              >\n                {scene}\n              </span>\n            ))}\n          </div>\n          {spot.isVisited && spot.visitedAt && (\n            <span className=\"text-[10px] font-medium text-stone-500\">\n              {spot.visitedAt} \350\250\252\345\272\227\n            </span>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};"
