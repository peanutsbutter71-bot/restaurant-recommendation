        lines {
          text: "      if (filters.sortBy === \'priceDesc\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const orderDiff = PRICE_ORDER[b.priceRange] - PRICE_ORDER[a.priceRange];"
