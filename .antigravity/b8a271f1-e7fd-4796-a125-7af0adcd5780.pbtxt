    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { X, Dices, Sparkles, MapPin, ArrowRight, RefreshCw } from \'lucide-react\';\nimport { RestaurantSpot } from \'../types\';\nimport { generateRecommenderAvatar } from \'../utils/helpers\';\n\ninterface RandomRouletteModalProps {\n  spots: RestaurantSpot[];\n  onClose: () => void;\n  onSelectSpot: (spot: RestaurantSpot) => void;\n}\n\nexport const RandomRouletteModal: React.FC<RandomRouletteModalProps> = ({\n  spots,\n  onClose,\n  onSelectSpot,\n}) => {\n  const [isSpinning, setIsSpinning] = useState(false);\n  const [currentIndex, setCurrentIndex] = useState(0);\n  const [selectedSpot, setSelectedSpot] = useState<RestaurantSpot | null>(null);\n\n  const startSpin = () => {\n    if (spots.length === 0) return;\n    setIsSpinning(true);\n    setSelectedSpot(null);\n\n    let count = 0;\n    const totalSteps = 24 + Math.floor(Math.random() * 8);\n    const speed = 70;\n\n    const interval = setInterval(() => {\n      setCurrentIndex((prev) => (prev + 1) % spots.length);\n      count++;\n\n      if (count >= totalSteps) {\n        clearInterval(interval);\n        const finalSpot = spots[(currentIndex + count) % spots.length];\n        setSelectedSpot(finalSpot);\n        setIsSpinning(false);\n      }\n    }, speed);\n  };\n\n  useEffect(() => {\n    if (spots.length > 0) {\n      startSpin();\n    }\n  }, []);\n\n  const activeSpot = selectedSpot || spots[currentIndex] || spots[0];\n  const avatar = activeSpot ? generateRecommenderAvatar(activeSpot.recommender) : null;\n\n  return (\n    <div\n      id=\"roulette-modal-backdrop\"\n      className=\"fixed inset-0 z-50 bg-stone-950/60 backdrop-blur-sm flex items-center justify-center p-4\"\n      onClick={onClose}\n    >\n      <div\n        id=\"roulette-modal-content\"\n        className=\"bg-[#FAF8F5] rounded-3xl w-full max-w-md overflow-hidden shadow-2xl border border-stone-200/80 my-auto animate-in zoom-in-95 duration-200 p-6 flex flex-col items-center text-center relative\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 p-2 rounded-full hover:bg-stone-200/60 text-stone-400 hover:text-stone-700 transition-colors\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        <div className=\"w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center mb-3 shadow-inner\">\n          <Dices className={`w-6 h-6 ${isSpinning ? \'animate-spin\' : \'\'}`} />\n        </div>\n\n        <h3 className=\"text-xl font-bold text-stone-900\">\344\273\212\346\227\245\343\201\251\343\201\223\350\241\214\343\201\217\357\274\237</h3>\n        <p className=\"text-xs text-stone-500 mb-5\">\n          \345\217\213\343\201\240\343\201\241\343\201\213\343\202\211\343\201\256\343\201\212\343\201\231\343\201\231\343\202\201\343\203\252\343\202\271\343\203\210\343\201\213\343\202\211\343\203\251\343\203\263\343\203\200\343\203\240\343\201\247\346\261\272\345\256\232\357\274\201\n        </p>\n\n        {activeSpot && (\n          <div\n            className={`w-full bg-white rounded-2xl p-4 border transition-all duration-200 mb-5 text-left shadow-sm ${\n              selectedSpot\n                ? \'border-rose-400 ring-2 ring-rose-400/20 scale-102\'\n                : \'border-stone-200 opacity-90\'\n            }`}\n          >\n            <div className=\"relative aspect-[16/9] w-full rounded-xl overflow-hidden mb-3 bg-stone-100\">\n              <img\n                src={\n                  activeSpot.imageUrl ||\n                  \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80\'\n                }\n                alt={activeSpot.name}\n                className=\"w-full h-full object-cover\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <span className=\"absolute top-2 left-2 px-2.5 py-0.5 rounded-full bg-white/90 backdrop-blur-md text-stone-800 text-xs font-bold shadow-sm flex items-center gap-1\">\n                <MapPin className=\"w-3 h-3 text-rose-500\" />\n                {activeSpot.area}\n              </span>\n              <span className=\"absolute bottom-2 right-2 px-2 py-0.5 rounded-md bg-black/60 text-white text-[11px] font-bold backdrop-blur-sm\">\n                {activeSpot.priceRange}\n              </span>\n            </div>\n\n            {avatar && (\n              <div className=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-stone-50 border border-stone-200/60 mb-1.5 text-[11px] font-semibold text-stone-600\">\n                <span className={`w-4 h-4 rounded-full flex items-center justify-center text-[9px] ${avatar.bg} ${avatar.text}`}>\n                  {avatar.initial}\n                </span>\n                <span>{activeSpot.recommender} \343\201\256\346\216\250\343\201\227</span>\n              </div>\n            )}\n\n            <h4 className=\"text-base font-extrabold text-stone-900 line-clamp-1\">\n              {activeSpot.name}\n            </h4>\n\n            <p className=\"text-xs text-stone-600 line-clamp-2 mt-1\">\n              \343\200\214{activeSpot.comment}\343\200\215\n            </p>\n          </div>\n        )}\n\n        <div className=\"w-full flex items-center gap-2\">\n          <button\n            id=\"roulette-respin-btn\"\n            onClick={startSpin}\n            disabled={isSpinning}\n            className=\"flex-1 py-3 rounded-2xl bg-stone-100 hover:bg-stone-200 text-stone-800 font-bold text-xs flex items-center justify-center gap-1.5 transition-all disabled:opacity-50 cursor-pointer\"\n          >\n            <RefreshCw className={`w-3.5 h-3.5 ${isSpinning ? \'animate-spin\' : \'\'}`} />\n            <span>\343\202\202\343\201\206\344\270\200\345\233\236\343\201\276\343\202\217\343\201\231</span>\n          </button>\n\n          {selectedSpot && (\n            <button\n              id=\"roulette-choose-btn\"\n              onClick={() => {\n                onSelectSpot(selectedSpot);\n                onClose();\n              }}\n              className=\"flex-1 py-3 rounded-2xl bg-rose-500 hover:bg-rose-600 text-white font-bold text-xs flex items-center justify-center gap-1.5 shadow-md shadow-rose-200 transition-all cursor-pointer\"\n            >\n              <span>\343\201\223\343\201\256\345\272\227\343\202\222\350\246\213\343\202\213</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
