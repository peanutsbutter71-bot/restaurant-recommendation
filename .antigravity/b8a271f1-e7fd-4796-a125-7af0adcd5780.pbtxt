    replacement_chunks {
      target_content: "import React from \'react\';\nimport {\n  Plus,\n  Dices,\n  Share2,\n  Heart,\n  Flame,\n  ListFilter,\n  User,\n  Utensils,\n} from \'lucide-react\';\n\ninterface HeaderProps {\n  onOpenAddModal: () => void;\n  onOpenRandomModal: () => void;\n  onOpenQuickImport: () => void;\n  onOpenMyPage?: () => void;\n  favoritesOnly: boolean;\n  onToggleFavoritesOnly: () => void;\n  favoriteCount: number;\n  spotCount: number;\n  activeTab: \'list\' | \'discover\';\n  onTabChange: (tab: \'list\' | \'discover\') => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  onOpenAddModal,\n  onOpenRandomModal,\n  onOpenQuickImport,\n  onOpenMyPage,\n  favoritesOnly,\n  onToggleFavoritesOnly,\n  favoriteCount,\n  spotCount,\n  activeTab,\n  onTabChange,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-stone-200/70 transition-all\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6\">\n        <div className=\"flex items-center justify-between h-16 sm:h-18 gap-2 sm:gap-4\">\n          {/* Logo & Tab Switcher */}\n          <div className=\"flex items-center gap-3 sm:gap-6\">\n            <div className=\"flex items-center gap-2.5 cursor-pointer\" onClick={() => onTabChange(\'list\')}>\n              <div className=\"w-10 h-10 rounded-2xl bg-gradient-to-br from-slate-900 via-zinc-800 to-amber-600 flex items-center justify-center text-amber-400 shadow-sm shadow-slate-900/20 border border-slate-700/40\">\n                <Utensils className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <div className=\"flex items-center gap-1.5\">\n                  <h1 className=\"text-xl sm:text-2xl font-black tracking-tight text-slate-900 font-serif sm:font-sans\">\n                    Gourmet<span className=\"text-amber-600 font-black\">Share</span>\n                  </h1>\n                </div>\n                <p className=\"text-[11px] text-stone-500 font-medium hidden md:block\">\n                  \345\217\213\351\201\224\343\201\214\343\201\212\343\201\231\343\201\231\343\202\201\343\201\231\343\202\213\344\277\241\351\240\274\343\201\256\343\201\212\345\272\227\343\203\252\343\202\271\343\203\210\n                </p>\n              </div>\n            </div>\n\n            {/* View Switcher: List vs Tinder-style Discover */}\n            <div className=\"flex items-center p-1 bg-stone-100/90 rounded-2xl border border-stone-200/60 shadow-2xs\">\n              <button\n                id=\"tab-btn-list\"\n                onClick={() => onTabChange(\'list\')}\n                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer ${\n                  activeTab === \'list\'\n                    ? \'bg-white text-slate-900 shadow-sm\'\n                    : \'text-stone-600 hover:text-slate-900\'\n                }`}\n              >\n                <ListFilter className=\"w-3.5 h-3.5\" />\n                <span>\344\270\200\350\246\247</span>\n                <span className=\"text-[10px] px-1.5 py-0.2 rounded-full bg-stone-100 text-stone-600 font-bold\">\n                  {spotCount}\n                </span>\n              </button>\n\n              <button\n                id=\"tab-btn-discover\"\n                onClick={() => onTabChange(\'discover\')}\n                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-extrabold transition-all cursor-pointer ${\n                  activeTab === \'discover\'\n                    ? \'bg-gradient-to-r from-amber-500 to-orange-500 text-white shadow-sm shadow-amber-500/20\'\n                    : \'text-stone-600 hover:text-amber-600\'\n                }`}\n              >\n                <Flame className={`w-3.5 h-3.5 ${activeTab === \'discover\' ? \'text-white\' : \'text-amber-500\'}`} />\n                <span>\347\231\272\350\246\213</span>\n                <span className={`text-[9px] px-1.5 py-0.2 rounded-full font-black uppercase tracking-wider ${\n                  activeTab === \'discover\' ? \'bg-white/25 text-white\' : \'bg-amber-100 text-amber-800\'\n                }`}>\n                  Tinder\351\242\250\n                </span>\n              </button>\n            </div>\n          </div>\n\n          {/* Action buttons */}\n          <div className=\"flex items-center gap-1.5 sm:gap-2\">\n            {/* Quick Share URL Import button */}\n            <button\n              id=\"header-quick-share-import-btn\"\n              onClick={onOpenQuickImport}\n              className=\"flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-bold bg-gradient-to-r from-amber-50 to-orange-50 text-amber-950 border border-amber-200/90 hover:border-amber-300 hover:bg-amber-100/70 transition-all duration-200 active:scale-95 cursor-pointer shadow-2xs\"\n              title=\"\351\243\237\343\201\271\343\203\255\343\202\260\343\203\273Google\343\203\236\343\203\203\343\203\227\343\203\273Instagram\343\201\256URL\343\201\213\343\202\211AI\344\270\200\347\231\272\347\231\273\351\214\262\"\n            >\n              <Share2 className=\"w-4 h-4 text-amber-600\" />\n              <span className=\"hidden sm:inline\">\345\205\261\346\234\211\343\203\252\343\203\263\343\202\257\343\201\213\343\202\211\347\231\273\351\214\262</span>\n              <span className=\"sm:hidden\">URL\347\231\273\351\214\262</span>\n              <span className=\"text-[9px] bg-slate-900 text-amber-400 font-extrabold px-1.5 py-0.2 rounded-full hidden xs:inline border border-amber-400/30\">\n                AI\n              </span>\n            </button>\n\n            {/* Favorites Only filter button */}\n            <button\n              id=\"header-favorites-only-btn\"\n              onClick={onToggleFavoritesOnly}\n              className={`flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 border ${\n                favoritesOnly\n                  ? \'bg-amber-500 text-white border-amber-500 shadow-sm shadow-amber-500/20\'\n                  : \'bg-white/80 text-stone-700 border-stone-200/80 hover:bg-amber-50/60 hover:text-amber-600\'\n              }`}\n              title=\"\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277\350\241\250\347\244\272\"\n            >\n              <Heart className={`w-4 h-4 ${favoritesOnly ? \'fill-current text-white\' : \'text-amber-500\'}`} />\n              <span className=\"hidden md:inline\">\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212</span>\n              <span className={`text-[11px] px-1.5 py-0.2 rounded-full ${favoritesOnly ? \'bg-white/20 text-white\' : \'bg-stone-100 text-stone-600\'}`}>\n                {favoriteCount}\n              </span>\n            </button>\n\n            {/* Random Roulette button */}\n            <button\n              id=\"header-random-roulette-btn\"\n              onClick={onOpenRandomModal}\n              className=\"flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-stone-100/90 text-stone-800 border border-stone-200 hover:bg-amber-50 hover:border-amber-300 hover:text-amber-900 transition-all duration-200 active:scale-95\"\n              title=\"\344\273\212\346\227\245\343\201\251\343\201\223\350\241\214\343\201\217\357\274\237\350\277\267\343\201\243\343\201\237\343\202\211\343\203\253\343\203\274\343\203\254\343\203\203\343\203\210\"\n            >\n              <Dices className=\"w-4 h-4 text-amber-600\" />\n              <span className=\"hidden lg:inline\">\350\277\267\343\201\243\343\201\237\343\202\211\343\203\253\343\203\274\343\203\254\343\203\203\343\203\210</span>\n            </button>\n\n            {/* My Page modal trigger */}\n            {onOpenMyPage && (\n              <button\n                id=\"header-mypage-btn\"\n                onClick={onOpenMyPage}\n                className=\"flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-stone-100/90 text-stone-700 hover:bg-stone-200/80 border border-stone-200/70 transition-all duration-200 active:scale-95 cursor-pointer\"\n                title=\"\343\203\236\343\202\244\343\203\232\343\203\274\343\202\270\357\274\210\347\265\261\350\250\210\343\203\273\343\203\220\343\203\203\343\202\257\343\202\242\343\203\203\343\203\227\343\203\273\345\245\275\343\201\277\343\201\256\345\202\276\345\220\221\357\274\211\"\n              >\n                <User className=\"w-4 h-4 text-stone-600\" />\n                <span className=\"hidden lg:inline\">\343\203\236\343\202\244\343\203\232\343\203\274\343\202\270</span>\n              </button>\n            )}\n\n            {/* Add spot button */}\n            <button\n              id=\"header-add-spot-btn\"\n              onClick={onOpenAddModal}\n              className=\"flex items-center gap-1.5 px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-white bg-gradient-to-r from-slate-900 to-zinc-900 hover:from-amber-600 hover:to-orange-600 active:scale-95 shadow-sm transition-all duration-200 cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4 stroke-[2.5]\" />\n              <span className=\"hidden xs:inline\">\343\201\212\345\272\227\343\202\222\350\250\230\351\214\262</span>\n              <span className=\"xs:hidden\">\350\277\275\345\212\240</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport {\n  Plus,\n  Dices,\n  Share2,\n  Heart,\n  Flame,\n  ListFilter,\n  User,\n  UtensilsCrossed,\n} from \'lucide-react\';\n\ninterface HeaderProps {\n  onOpenAddModal: () => void;\n  onOpenRandomModal: () => void;\n  onOpenQuickImport: () => void;\n  onOpenMyPage?: () => void;\n  favoritesOnly: boolean;\n  onToggleFavoritesOnly: () => void;\n  favoriteCount: number;\n  spotCount: number;\n  activeTab: \'list\' | \'discover\';\n  onTabChange: (tab: \'list\' | \'discover\') => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  onOpenAddModal,\n  onOpenRandomModal,\n  onOpenQuickImport,\n  onOpenMyPage,\n  favoritesOnly,\n  onToggleFavoritesOnly,\n  favoriteCount,\n  spotCount,\n  activeTab,\n  onTabChange,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-stone-200/80 transition-all\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6\">\n        <div className=\"flex items-center justify-between h-16 gap-3\">\n          {/* Brand Logo & Tab Switcher */}\n          <div className=\"flex items-center gap-4 sm:gap-6\">\n            <button\n              type=\"button\"\n              onClick={() => onTabChange(\'list\')}\n              className=\"flex items-center gap-2.5 text-left group cursor-pointer focus:outline-none\"\n            >\n              <div className=\"w-8 h-8 rounded-lg bg-stone-900 flex items-center justify-center text-white shadow-xs group-hover:bg-orange-600 transition-colors\">\n                <UtensilsCrossed className=\"w-4 h-4 text-orange-400\" />\n              </div>\n              <div>\n                <div className=\"flex items-center gap-1\">\n                  <span className=\"text-lg sm:text-xl font-bold tracking-tight text-stone-900 font-sans\">\n                    Gourmet<span className=\"text-orange-600 font-extrabold\">Share</span>\n                  </span>\n                </div>\n                <p className=\"text-[10px] text-stone-400 font-medium hidden md:block tracking-wide\">\n                  \345\217\213\344\272\272\343\201\256\343\203\252\343\202\242\343\203\253\343\201\252\343\201\212\343\201\231\343\201\231\343\202\201\343\202\260\343\203\253\343\203\241\343\203\216\343\203\274\343\203\210\n                </p>\n              </div>\n            </button>\n\n            {/* Segmented View Switcher: List vs Discover */}\n            <div className=\"flex items-center p-1 bg-stone-100/90 rounded-lg border border-stone-200/60\">\n              <button\n                type=\"button\"\n                id=\"tab-btn-list\"\n                onClick={() => onTabChange(\'list\')}\n                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold transition-all cursor-pointer ${\n                  activeTab === \'list\'\n                    ? \'bg-white text-stone-900 shadow-2xs font-bold\'\n                    : \'text-stone-500 hover:text-stone-900\'\n                }`}\n              >\n                <ListFilter className=\"w-3.5 h-3.5\" />\n                <span>\344\270\200\350\246\247</span>\n                <span className=\"text-[10px] px-1.5 py-0.2 rounded-md bg-stone-100 text-stone-600 font-medium\">\n                  {spotCount}\n                </span>\n              </button>\n\n              <button\n                type=\"button\"\n                id=\"tab-btn-discover\"\n                onClick={() => onTabChange(\'discover\')}\n                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold transition-all cursor-pointer ${\n                  activeTab === \'discover\'\n                    ? \'bg-stone-900 text-white shadow-2xs font-bold\'\n                    : \'text-stone-500 hover:text-stone-900\'\n                }`}\n              >\n                <Flame className={`w-3.5 h-3.5 ${activeTab === \'discover\' ? \'text-orange-400\' : \'text-stone-400\'}`} />\n                <span>\347\231\272\350\246\213</span>\n                <span className={`text-[9px] px-1.5 py-0.2 rounded font-semibold ${\n                  activeTab === \'discover\' ? \'bg-white/20 text-white\' : \'bg-stone-200/70 text-stone-600\'\n                }`}>\n                  Flick\n                </span>\n              </button>\n            </div>\n          </div>\n\n          {/* Action Buttons: Organized by visual priority */}\n          <div className=\"flex items-center gap-1.5 sm:gap-2.5\">\n            {/* Secondary: Quick URL Import */}\n            <button\n              id=\"header-quick-share-import-btn\"\n              onClick={onOpenQuickImport}\n              className=\"flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-lg text-xs font-semibold text-stone-700 bg-stone-100/90 hover:bg-stone-200/80 border border-stone-200/60 transition-all active:scale-95 cursor-pointer\"\n              title=\"\351\243\237\343\201\271\343\203\255\343\202\260\343\203\273Google\343\203\236\343\203\203\343\203\227\343\203\273Instagram\343\201\256URL\343\201\213\343\202\211AI\344\270\200\347\231\272\347\231\273\351\214\262\"\n            >\n              <Share2 className=\"w-3.5 h-3.5 text-stone-600\" />\n              <span className=\"hidden sm:inline\">\343\203\252\343\203\263\343\202\257\343\201\213\343\202\211\347\231\273\351\214\262</span>\n              <span className=\"text-[9px] bg-stone-900 text-stone-100 font-bold px-1.5 py-0.2 rounded hidden xs:inline\">\n                AI\n              </span>\n            </button>\n\n            {/* Secondary: Favorites Only */}\n            <button\n              id=\"header-favorites-only-btn\"\n              onClick={onToggleFavoritesOnly}\n              className={`flex items-center gap-1.5 px-2.5 py-2 rounded-lg text-xs font-semibold transition-all border cursor-pointer ${\n                favoritesOnly\n                  ? \'bg-orange-50 text-orange-600 border-orange-300\'\n                  : \'bg-white text-stone-600 border-stone-200 hover:bg-stone-50 hover:text-stone-900\'\n              }`}\n              title=\"\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277\350\241\250\347\244\272\"\n            >\n              <Heart className={`w-3.5 h-3.5 ${favoritesOnly ? \'fill-current text-orange-600\' : \'text-stone-400\'}`} />\n              <span className=\"hidden md:inline\">\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212</span>\n              <span className={`text-[10px] px-1.5 py-0.2 rounded ${favoritesOnly ? \'bg-orange-200/60 text-orange-800 font-bold\' : \'bg-stone-100 text-stone-500\'}`}>\n                {favoriteCount}\n              </span>\n            </button>\n\n            {/* Utility: Random Roulette */}\n            <button\n              id=\"header-random-roulette-btn\"\n              onClick={onOpenRandomModal}\n              className=\"p-2 sm:px-2.5 sm:py-2 rounded-lg text-xs font-medium text-stone-600 hover:text-stone-900 hover:bg-stone-100 border border-stone-200/60 transition-all active:scale-95 cursor-pointer flex items-center gap-1.5\"\n              title=\"\344\273\212\346\227\245\343\201\251\343\201\223\350\241\214\343\201\217\357\274\237\350\277\267\343\201\243\343\201\237\343\202\211\343\203\253\343\203\274\343\203\254\343\203\203\343\203\210\"\n            >\n              <Dices className=\"w-4 h-4 text-stone-500\" />\n              <span className=\"hidden lg:inline\">\343\203\253\343\203\274\343\203\254\343\203\203\343\203\210</span>\n            </button>\n\n            {/* Utility: My Page */}\n            {onOpenMyPage && (\n              <button\n                id=\"header-mypage-btn\"\n                onClick={onOpenMyPage}\n                className=\"p-2 sm:px-2.5 sm:py-2 rounded-lg text-xs font-medium text-stone-600 hover:text-stone-900 hover:bg-stone-100 border border-stone-200/60 transition-all active:scale-95 cursor-pointer flex items-center gap-1.5\"\n                title=\"\343\203\236\343\202\244\343\203\232\343\203\274\343\202\270\357\274\210\347\265\261\350\250\210\343\203\273\343\203\220\343\203\203\343\202\257\343\202\242\343\203\203\343\203\227\343\203\273\345\245\275\343\201\277\343\201\256\345\202\276\345\220\221\357\274\211\"\n              >\n                <User className=\"w-4 h-4 text-stone-500\" />\n                <span className=\"hidden lg:inline\">\343\203\236\343\202\244\343\203\232\343\203\274\343\202\270</span>\n              </button>\n            )}\n\n            {/* Primary Action: Add Spot */}\n            <button\n              id=\"header-add-spot-btn\"\n              onClick={onOpenAddModal}\n              className=\"flex items-center gap-1.5 px-3 sm:px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold text-white bg-stone-900 hover:bg-orange-600 active:scale-95 shadow-2xs transition-all cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4 stroke-[2.5]\" />\n              <span className=\"hidden xs:inline\">\343\201\212\345\272\227\343\202\222\350\250\230\351\214\262</span>\n              <span className=\"xs:hidden\">\350\250\230\351\214\262</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};"
    }
    instruction: "Redesign Header.tsx with refined urban lifestyle aesthetics, monotone base with orange accent, and clear visual hierarchy"
  }
}
