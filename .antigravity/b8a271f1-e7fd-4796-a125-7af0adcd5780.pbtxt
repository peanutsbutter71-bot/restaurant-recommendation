  file_change {
    absolute_path_uri: "file:///src/components/DiscoverSwipeView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef, useEffect } from \'react\';\nimport { motion, useMotionValue, useTransform, useAnimation, PanInfo } from \'motion/react\';\nimport {\n  Heart,\n  X,\n  Star,\n  RotateCcw,\n  Sparkles,\n  MapPin,\n  Utensils,\n  ExternalLink,\n  ChevronRight,\n  Info,\n  SlidersHorizontal,\n  Flame,\n  Award,\n  Compass,\n  SmilePlus,\n} from \'lucide-react\';\nimport { RestaurantSpot, SwipeDirection, UserPreferenceScores } from \'../types\';\nimport {\n  getGenreStyle,\n  getSceneStyle,\n  PRICE_COLORS,\n  generateRecommenderAvatar,\n} from \'../utils/helpers\';\nimport {\n  getSortedDiscoverDeck,\n  getPreferenceSummary,\n} from \'../utils/swipePreferences\';\n\ninterface DiscoverSwipeViewProps {\n  allSpots: RestaurantSpot[];\n  preferenceScores: UserPreferenceScores;\n  onSwipe: (spot: RestaurantSpot, direction: SwipeDirection) => void;\n  onResetPreferences: () => void;\n  onSelectSpot: (spot: RestaurantSpot) => void;\n  onSwitchToListTab: () => void;\n  onShowToast: (msg: string) => void;\n}\n\nexport const DiscoverSwipeView: React.FC<DiscoverSwipeViewProps> = ({\n  allSpots,\n  preferenceScores,\n  onSwipe,\n  onResetPreferences,\n  onSelectSpot,\n  onSwitchToListTab,\n  onShowToast,\n}) => {\n  // Deck of spots to swipe\n  const [deck, setDeck] = useState<RestaurantSpot[]>([]);\n  const [lastSwiped, setLastSwiped] = useState<{ spot: RestaurantSpot; dir: SwipeDirection } | null>(null);\n  const [showSummaryModal, setShowSummaryModal] = useState(false);\n  const [showHelpGuide, setShowHelpGuide] = useState(false);\n\n  // Initialize and update deck based on preference scores\n  useEffect(() => {\n    const sortedDeck = getSortedDiscoverDeck(allSpots, preferenceScores);\n    setDeck(sortedDeck);\n  }, [allSpots, preferenceScores]);\n\n  // Motion controls for top card\n  const controls = useAnimation();\n  const x = useMotionValue(0);\n  const y = useMotionValue(0);\n\n  // Derived transforms for 2026 slick motion: rotation, opacity of badges\n  const rotate = useTransform(x, [-250, 0, 250], [-18, 0, 18]);\n  const likeOpacity = useTransform(x, [20, 120], [0, 1]);\n  const nopeOpacity = useTransform(x, [-20, -120], [0, 1]);\n  const superlikeOpacity = useTransform(y, [-20, -100], [0, 1]);\n  const cardScale = useTransform(x, [-200, 0, 200], [1.02, 1, 1.02]);\n\n  const currentSpot = deck[0];\n  const nextSpot = deck[1];\n  const thirdSpot = deck[2];\n\n  // Trigger swipe programmatically or via drag\n  const handleSwipeAction = async (direction: SwipeDirection) => {\n    if (!currentSpot) return;\n\n    if (direction === \'right\') {\n      await controls.start({\n        x: 450,\n        opacity: 0,\n        rotate: 20,\n        transition: { duration: 0.35, ease: \'easeOut\' },\n      });\n      onShowToast(`\360\237\222\226\343\200\214${currentSpot.name}\343\200\215\343\202\222\350\241\214\343\201\215\343\201\237\343\201\204\343\203\252\343\202\271\343\203\210\343\201\253\350\277\275\345\212\240\343\201\227\343\201\276\343\201\227\343\201\237\357\274\201`);\n    } else if (direction === \'left\') {\n      await controls.start({\n        x: -450,\n        opacity: 0,\n        rotate: -20,\n        transition: { duration: 0.35, ease: \'easeOut\' },\n      });\n    } else if (direction === \'up\') {\n      await controls.start({\n        y: -500,\n        opacity: 0,\n        scale: 1.1,\n        transition: { duration: 0.35, ease: \'easeOut\' },\n      });\n      onShowToast(`\342\255\220\343\200\214${currentSpot.name}\343\200\215\343\202\222\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\357\274\206\350\241\214\343\201\215\343\201\237\343\201\204\343\201\253\350\277\275\345\212\240\343\201\227\343\201\276\343\201\227\343\201\237\357\274\201`);\n    }\n\n    setLastSwiped({ spot: currentSpot, dir: direction });\n    onSwipe(currentSpot, direction);\n\n    // Reset motion values\n    x.set(0);\n    y.set(0);\n    controls.set({ x: 0, y: 0, opacity: 1, rotate: 0, scale: 1 });\n\n    // Check if milestone reached (e.g. 10th swipe, or deck finished)\n    const newTotal = preferenceScores.totalSwipedCount + 1;\n    if (newTotal === 10 || (deck.length === 1 && newTotal >= 5)) {\n      setTimeout(() => {\n        setShowSummaryModal(true);\n      }, 400);\n    }\n  };\n\n  const handleDragEnd = (\n    _event: MouseEvent | TouchEvent | PointerEvent,\n    info: PanInfo\n  ) => {\n    const swipeThreshold = 100;\n    const verticalThreshold = -90;\n\n    if (info.offset.y < verticalThreshold && Math.abs(info.offset.x) < 80) {\n      // Superlike up\n      handleSwipeAction(\'up\');\n    } else if (info.offset.x > swipeThreshold) {\n      // Like right\n      handleSwipeAction(\'right\');\n    } else if (info.offset.x < -swipeThreshold) {\n      // Nope left\n      handleSwipeAction(\'left\');\n    } else {\n      // Snap back\n      controls.start({\n        x: 0,\n        y: 0,\n        rotate: 0,\n        scale: 1,\n        transition: { type: \'spring\', stiffness: 400, damping: 28 },\n      });\n    }\n  };\n\n  const preferenceSummary = getPreferenceSummary(preferenceScores);\n\n  return (\n    <div className=\"relative w-full max-w-lg mx-auto flex flex-col items-center justify-between min-h-[calc(100vh-140px)] py-2 sm:py-4 px-3 sm:px-4\">\n      {/* Top Header Bar: Preference indicator & Quick Info */}\n      <div className=\"w-full flex items-center justify-between gap-2 mb-2 px-1\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-8 h-8 rounded-xl bg-gradient-to-tr from-rose-500 via-pink-500 to-amber-400 flex items-center justify-center text-white shadow-sm shadow-rose-200\">\n            <Flame className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-1.5\">\n              <span className=\"text-sm font-extrabold text-stone-900 tracking-tight\">\n                \347\231\272\350\246\213\343\202\271\343\203\257\343\202\244\343\203\227\n              </span>\n              <span className=\"px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 text-[10px] font-bold\">\n                {preferenceScores.totalSwipedCount}\344\273\266 \343\202\271\343\203\257\343\202\244\343\203\227\346\270\210\n              </span>\n            </div>\n            <p className=\"text-[11px] text-stone-500\">\n              \347\233\264\346\204\237\343\201\247\351\201\270\343\201\266\343\201\273\343\201\251\343\201\202\343\201\252\343\201\237\343\201\256\345\245\275\343\201\277\343\201\253\350\277\221\343\201\245\343\201\215\343\201\276\343\201\231\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-1.5\">\n          {preferenceScores.totalSwipedCount > 0 && (\n            <button\n              id=\"discover-summary-btn\"\n              type=\"button\"\n              onClick={() => setShowSummaryModal(true)}\n              className=\"p-2 rounded-xl bg-white/90 border border-stone-200 text-stone-700 hover:bg-stone-50 text-xs font-bold flex items-center gap-1 shadow-2xs cursor-pointer transition-all active:scale-95\"\n              title=\"\345\245\275\343\201\277\343\201\256\345\210\206\346\236\220\343\203\254\343\203\235\343\203\274\343\203\210\343\202\222\350\246\213\343\202\213\"\n            >\n              <Award className=\"w-3.5 h-3.5 text-amber-500\" />\n              <span className=\"hidden sm:inline\">\345\245\275\343\201\277\343\201\256\345\210\206\346\236\220</span>\n            </button>\n          )}\n\n          <button\n            id=\"discover-help-btn\"\n            type=\"button\"\n            onClick={() => setShowHelpGuide(!showHelpGuide)}\n            className=\"p-2 rounded-xl bg-white/90 border border-stone-200 text-stone-500 hover:text-stone-800 text-xs shadow-2xs cursor-pointer\"\n            title=\"\346\223\215\344\275\234\343\202\254\343\202\244\343\203\211\"\n          >\n            <Info className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Help Guide Banner (Collapsible) */}\n      {showHelpGuide && (\n        <div className=\"w-full bg-gradient-to-r from-rose-500/10 via-amber-500/10 to-pink-500/10 backdrop-blur-md rounded-2xl p-3 border border-rose-200/60 mb-2 flex items-center justify-between text-xs text-stone-800 animate-in fade-in slide-in-from-top-2\">\n          <div className=\"flex items-center gap-3\">\n            <span className=\"flex items-center gap-1 font-bold text-emerald-700\">\n              \360\237\221\211 \345\217\263: \350\241\214\343\201\215\343\201\237\343\201\204 (+3pt)\n            </span>\n            <span className=\"flex items-center gap-1 font-bold text-amber-600\">\n              \360\237\221\206 \344\270\212: \343\201\212\346\260\227\343\201\253\345\205\245\343\202\212 (+5pt)\n            </span>\n            <span className=\"flex items-center gap-1 font-bold text-stone-500\">\n              \360\237\221\210 \345\267\246: \343\203\221\343\202\271 (-2pt)\n            </span>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => setShowHelpGuide(false)}\n            className=\"text-stone-400 hover:text-stone-700 p-1 cursor-pointer\"\n          >\n            <X className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      )}\n\n      {/* Main Card Deck Area */}\n      <div className=\"relative w-full aspect-[3/4.4] sm:aspect-[3/4.2] max-h-[580px] my-auto flex items-center justify-center\">\n        {deck.length === 0 ? (\n          /* Empty / Completed Deck View */\n          <div className=\"w-full h-full bg-white/95 backdrop-blur-xl rounded-[32px] border border-stone-200/80 shadow-xl p-6 sm:p-8 flex flex-col items-center justify-center text-center space-y-4 animate-in fade-in zoom-in-95\">\n            <div className=\"w-16 h-16 rounded-full bg-gradient-to-tr from-rose-400 via-pink-400 to-amber-300 flex items-center justify-center text-white shadow-lg shadow-rose-200\">\n              <Sparkles className=\"w-8 h-8\" />\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <h3 className=\"text-xl font-extrabold text-stone-900 font-serif sm:font-sans\">\n                \343\201\231\343\201\271\343\201\246\343\201\256\343\201\212\345\272\227\343\202\222\343\203\201\343\202\247\343\203\203\343\202\257\343\201\227\343\201\276\343\201\227\343\201\237\357\274\201\n              </h3>\n              <p className=\"text-xs sm:text-sm text-stone-500 max-w-xs mx-auto leading-relaxed\">\n                \343\202\271\343\203\257\343\202\244\343\203\227\343\201\227\343\201\237\343\201\212\345\272\227\343\201\257\343\200\214\350\241\214\343\201\215\343\201\237\343\201\204\343\203\252\343\202\271\343\203\210\343\200\215\343\201\253\350\207\252\345\213\225\346\225\264\347\220\206\343\201\225\343\202\214\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\345\245\275\343\201\277\343\201\256\345\210\206\346\236\220\343\202\222\343\203\201\343\202\247\343\203\203\343\202\257\343\201\227\343\201\246\343\201\277\343\201\276\343\201\227\343\202\207\343\201\206\343\200\202\n              </p>\n            </div>\n\n            {/* Quick Summary Preview */}\n            {preferenceSummary.topGenres.length > 0 && (\n              <div className=\"w-full bg-stone-50 rounded-2xl p-4 border border-stone-200/70 text-left space-y-2\">\n                <div className=\"text-xs font-bold text-stone-700 flex items-center gap-1\">\n                  <Award className=\"w-3.5 h-3.5 text-rose-500\" />\n                  <span>\343\201\202\343\201\252\343\201\237\343\201\256\345\245\275\343\201\215\343\201\252\343\201\212\345\272\227\345\202\276\345\220\221:</span>\n                </div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {preferenceSummary.topGenres.map((g) => (\n                    <span\n                      key={g.name}\n                      className=\"px-2.5 py-1 rounded-xl bg-rose-500 text-white text-xs font-bold shadow-2xs\"\n                    >\n                      {g.name}\n                    </span>\n                  ))}\n                  {preferenceSummary.topScenes.map((s) => (\n                    <span\n                      key={s.name}\n                      className=\"px-2.5 py-1 rounded-xl bg-amber-500 text-white text-xs font-bold shadow-2xs\"\n                    >\n                      {s.name}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            )}\n\n            <div className=\"flex flex-col sm:flex-row gap-2.5 w-full pt-2\">\n              <button\n                type=\"button\"\n                id=\"discover-go-to-list-btn\"\n                onClick={onSwitchToListTab}\n                className=\"flex-1 py-3 px-4 rounded-2xl bg-stone-900 hover:bg-rose-600 text-white text-xs sm:text-sm font-bold shadow-md transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-1.5\"\n              >\n                <span>\344\270\200\350\246\247\347\224\273\351\235\242\343\201\247\350\241\214\343\201\215\343\201\237\343\201\204\345\272\227\343\202\222\350\246\213\343\202\213</span>\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n\n              <button\n                type=\"button\"\n                id=\"discover-reset-deck-btn\"\n                onClick={() => {\n                  onResetPreferences();\n                  onShowToast(\'\360\237\224\204 \343\202\271\343\203\257\343\202\244\343\203\227\345\261\245\346\255\264\343\201\250\345\245\275\343\201\277\343\202\222\343\203\252\343\202\273\343\203\203\343\203\210\343\201\227\343\201\276\343\201\227\343\201\237\');\n                }}\n                className=\"py-3 px-4 rounded-2xl bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs sm:text-sm font-bold transition-all cursor-pointer flex items-center justify-center gap-1.5\"\n              >\n                <RotateCcw className=\"w-3.5 h-3.5\" />\n                <span>\343\202\202\343\201\206\344\270\200\345\272\246\343\202\271\343\203\257\343\202\244\343\203\227\343\201\231\343\202\213</span>\n              </button>\n            </div>\n          </div>\n        ) : (\n          <>\n            {/* Third Card (Background depth) */}\n            {thirdSpot && (\n              <div className=\"absolute inset-0 rounded-[32px] bg-stone-200/80 border border-stone-300/60 scale-[0.90] translate-y-6 pointer-events-none opacity-40 shadow-sm\" />\n            )}\n\n            {/* Second Card (Background preview) */}\n            {nextSpot && (\n              <div className=\"absolute inset-0 rounded-[32px] overflow-hidden bg-stone-900 border border-stone-300 scale-[0.95] translate-y-3 pointer-events-none opacity-85 shadow-lg transition-transform\">\n                <img\n                  src={\n                    nextSpot.imageUrl ||\n                    \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80\'\n                  }\n                  alt={nextSpot.name}\n                  className=\"w-full h-full object-cover\"\n                />\n                <div className=\"absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-900/40 to-transparent\" />\n              </div>\n            )}\n\n            {/* Top Interactive Swipe Card (2026 Immersive Visual Card) */}\n            {currentSpot && (\n              <motion.div\n                id={`swipe-card-${currentSpot.id}`}\n                className=\"absolute inset-0 rounded-[32px] overflow-hidden bg-stone-950 border border-white/20 shadow-2xl cursor-grab active:cursor-grabbing touch-none select-none\"\n                style={{\n                  x,\n                  y,\n                  rotate,\n                  scale: cardScale,\n                }}\n                drag\n                dragConstraints={{ left: 0, right: 0, top: 0, bottom: 0 }}\n                dragElastic={0.9}\n                onDragEnd={handleDragEnd}\n                animate={controls}\n              >\n                {/* Full-bleed Photo Background */}\n                <div className=\"relative w-full h-full overflow-hidden\">\n                  <img\n                    src={\n                      currentSpot.imageUrl ||\n                      \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80\'\n                    }\n                    alt={currentSpot.name}\n                    className=\"w-full h-full object-cover pointer-events-none\"\n                    draggable={false}\n                  />\n\n                  {/* Multi-step Atmospheric Gradient Overlays for high legibility */}\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/65 to-transparent pointer-events-none\" />\n                  <div className=\"absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-black/60 to-transparent pointer-events-none\" />\n\n                  {/* Swipe Decision Stamps / Badges (Smooth Fade-in on Drag) */}\n                  {/* LIKE STAMP (Right) */}\n                  <motion.div\n                    style={{ opacity: likeOpacity }}\n                    className=\"absolute top-6 left-6 rotate-[-18deg] border-4 border-emerald-400 bg-emerald-500/30 backdrop-blur-md px-4 py-1.5 rounded-2xl text-emerald-300 font-black text-xl tracking-wider shadow-lg flex items-center gap-1.5 pointer-events-none z-20\"\n                  >\n                    <Heart className=\"w-5 h-5 fill-current\" />\n                    <span>\350\241\214\343\201\215\343\201\237\343\201\204\357\274\201</span>\n                  </motion.div>\n\n                  {/* NOPE STAMP (Left) */}\n                  <motion.div\n                    style={{ opacity: nopeOpacity }}\n                    className=\"absolute top-6 right-6 rotate-[18deg] border-4 border-rose-400 bg-rose-500/30 backdrop-blur-md px-4 py-1.5 rounded-2xl text-rose-300 font-black text-xl tracking-wider shadow-lg flex items-center gap-1.5 pointer-events-none z-20\"\n                  >\n                    <X className=\"w-5 h-5\" />\n                    <span>\343\203\221\343\202\271</span>\n                  </motion.div>\n\n                  {/* SUPERLIKE STAMP (Top) */}\n                  <motion.div\n                    style={{ opacity: superlikeOpacity }}\n                    className=\"absolute top-8 inset-x-0 mx-auto w-fit border-4 border-amber-300 bg-amber-500/40 backdrop-blur-md px-5 py-2 rounded-2xl text-amber-200 font-black text-xl tracking-wider shadow-xl flex items-center gap-2 pointer-events-none z-20\"\n                  >\n                    <Star className=\"w-6 h-6 fill-current text-amber-300\" />\n                    <span>\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\357\274\201</span>\n                  </motion.div>\n\n                  {/* Top Bar on Card: Area, Price & Detail Button */}\n                  <div className=\"absolute top-4 inset-x-4 flex items-center justify-between z-10\">\n                    <div className=\"flex items-center gap-1.5 flex-wrap\">\n                      <span className=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-black/40 backdrop-blur-md border border-white/20 text-white font-extrabold text-xs shadow-sm\">\n                        <MapPin className=\"w-3.5 h-3.5 text-rose-400\" />\n                        {currentSpot.area}\n                      </span>\n                      <span className=\"inline-flex items-center px-2.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md border border-white/20 text-white font-bold text-xs\">\n                        {currentSpot.priceRange}\n                      </span>\n                    </div>\n\n                    <button\n                      type=\"button\"\n                      id={`swipe-detail-btn-${currentSpot.id}`}\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onSelectSpot(currentSpot);\n                      }}\n                      className=\"p-2 rounded-full bg-white/25 hover:bg-white/40 backdrop-blur-md text-white border border-white/30 transition-all active:scale-90 cursor-pointer shadow-sm\"\n                      title=\"\350\251\263\347\264\260\346\203\205\345\240\261\343\202\222\351\226\213\343\201\217\"\n                    >\n                      <Info className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n\n                  {/* Bottom Content: Stories-like Rich Overlay */}\n                  <div className=\"absolute bottom-0 inset-x-0 p-5 sm:p-6 text-white space-y-3 z-10\">\n                    {/* Tags: Genres & Scenes */}\n                    <div className=\"flex flex-wrap gap-1.5\">\n                      {currentSpot.genres.map((g) => (\n                        <span\n                          key={g}\n                          className=\"px-2.5 py-0.8 rounded-xl bg-white/20 backdrop-blur-md border border-white/25 text-white text-[11px] font-bold\"\n                        >\n                          {g}\n                        </span>\n                      ))}\n                      {currentSpot.scenes.map((s) => (\n                        <span\n                          key={s}\n                          className=\"px-2.5 py-0.8 rounded-xl bg-rose-500/80 backdrop-blur-md border border-rose-300/40 text-white text-[11px] font-bold\"\n                        >\n                          {s}\n                        </span>\n                      ))}\n                    </div>\n\n                    {/* Shop Name & Highlight */}\n                    <div>\n                      <h2 className=\"text-2xl sm:text-3xl font-black tracking-tight leading-tight font-serif sm:font-sans drop-shadow-md text-white\">\n                        {currentSpot.name}\n                      </h2>\n                      {currentSpot.highlightDish && (\n                        <p className=\"text-xs sm:text-sm font-bold text-amber-300 mt-1 flex items-center gap-1 drop-shadow-xs\">\n                          <Sparkles className=\"w-3.5 h-3.5\" />\n                          <span>\345\220\215\347\211\251: {currentSpot.highlightDish}</span>\n                        </p>\n                      )}\n                    </div>\n\n                    {/* Recommender Quote Card (Instagram Stories / TikTok vibe) */}\n                    <div className=\"bg-white/15 backdrop-blur-md border border-white/25 rounded-2xl p-3.5 space-y-1.5 shadow-lg\">\n                      <div className=\"flex items-center gap-2\">\n                        {(() => {\n                          const av = generateRecommenderAvatar(currentSpot.recommender);\n                          return (\n                            <span\n                              className={`w-5 h-5 rounded-full flex items-center justify-center font-bold text-[10px] ${av.bg} ${av.text}`}\n                            >\n                              {av.initial}\n                            </span>\n                          );\n                        })()}\n                        <span className=\"text-xs font-bold text-white/90\">\n                          {currentSpot.recommender} \343\201\256\343\201\212\343\201\231\343\201\231\343\202\201\343\202\263\343\203\241\343\203\263\343\203\210\n                        </span>\n                      </div>\n                      <p className=\"text-xs sm:text-sm font-medium text-white/95 leading-relaxed line-clamp-3\">\n                        \343\200\214{currentSpot.comment}\343\200\215\n                      </p>\n                    </div>\n\n                    {/* Tap for more details notice */}\n                    <div className=\"flex items-center justify-between text-[11px] text-white/70 pt-0.5\">\n                      <span>\343\202\253\343\203\274\343\203\211\345\205\250\344\275\223\343\202\222\345\267\246\345\217\263\343\201\253\343\202\271\343\203\257\343\202\244\343\203\227</span>\n                      <button\n                        type=\"button\"\n                        onClick={(e) => {\n                          e.stopPropagation();\n                          onSelectSpot(currentSpot);\n                        }}\n                        className=\"text-white hover:underline flex items-center gap-0.5 font-bold cursor-pointer\"\n                      >\n                        <span>\350\251\263\343\201\227\343\201\217\350\246\213\343\202\213</span>\n                        <ChevronRight className=\"w-3 h-3\" />\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </motion.div>\n            )}\n          </>\n        )}\n      </div>\n\n      {/* Bottom Floating Control Buttons (Tinder-style 2026 glassmorphism) */}\n      {currentSpot && (\n        <div className=\"w-full max-w-sm flex items-center justify-center gap-3 sm:gap-4 mt-3 sm:mt-4\">\n          {/* 1. DISLIKE / PASS BUTTON */}\n          <button\n            id=\"swipe-btn-dislike\"\n            type=\"button\"\n            onClick={() => handleSwipeAction(\'left\')}\n            className=\"group w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-white/90 hover:bg-rose-50 border border-stone-200/80 text-stone-500 hover:text-rose-500 shadow-lg hover:shadow-xl transition-all duration-200 active:scale-90 flex items-center justify-center cursor-pointer\"\n            title=\"\350\210\210\345\221\263\343\201\252\343\201\204\357\274\210\345\267\246\343\202\271\343\203\257\343\202\244\343\203\227\357\274\211\"\n          >\n            <X className=\"w-6 h-6 sm:w-7 sm:h-7 stroke-[2.5] group-hover:scale-110 transition-transform\" />\n          </button>\n\n          {/* 2. SUPERLIKE / INSTANT FAVORITE BUTTON */}\n          <button\n            id=\"swipe-btn-superlike\"\n            type=\"button\"\n            onClick={() => handleSwipeAction(\'up\')}\n            className=\"group w-12 h-12 sm:w-13 sm:h-13 rounded-full bg-amber-50 hover:bg-amber-100 border border-amber-300 text-amber-500 hover:text-amber-600 shadow-md hover:shadow-lg transition-all duration-200 active:scale-90 flex items-center justify-center cursor-pointer\"\n            title=\"\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\253\345\215\263\350\277\275\345\212\240\357\274\210\344\270\212\343\202\271\343\203\257\343\202\244\343\203\227\357\274\211\"\n          >\n            <Star className=\"w-5 h-5 sm:w-6 sm:h-6 fill-current group-hover:scale-110 transition-transform\" />\n          </button>\n\n          {/* 3. LIKE / WANT TO GO BUTTON */}\n          <button\n            id=\"swipe-btn-like\"\n            type=\"button\"\n            onClick={() => handleSwipeAction(\'right\')}\n            className=\"group w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-gradient-to-tr from-rose-500 to-pink-500 hover:from-rose-600 hover:to-pink-600 text-white shadow-lg shadow-rose-200/80 hover:shadow-xl hover:shadow-rose-300 transition-all duration-200 active:scale-90 flex items-center justify-center cursor-pointer\"\n            title=\"\350\241\214\343\201\215\343\201\237\343\201\204\357\274\201\357\274\210\345\217\263\343\202\271\343\203\257\343\202\244\343\203\227\357\274\211\"\n          >\n            <Heart className=\"w-6 h-6 sm:w-7 sm:h-7 fill-current stroke-[2] group-hover:scale-110 transition-transform\" />\n          </button>\n        </div>\n      )}\n\n      {/* Preference Analysis Summary Modal */}\n      {showSummaryModal && (\n        <div className=\"fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 animate-in fade-in\">\n          <div className=\"bg-white rounded-3xl border border-stone-200 shadow-2xl max-w-md w-full p-6 space-y-5 animate-in zoom-in-95\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-10 h-10 rounded-2xl bg-gradient-to-tr from-rose-500 to-amber-400 flex items-center justify-center text-white shadow-md shadow-rose-200\">\n                  <Award className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h3 className=\"text-lg font-extrabold text-stone-900\">\n                    \343\201\202\343\201\252\343\201\237\343\201\256\345\245\275\343\201\277\343\201\214\345\210\206\343\201\213\343\201\243\343\201\246\343\201\215\343\201\276\343\201\227\343\201\237\357\274\201\n                  </h3>\n                  <p className=\"text-xs text-stone-500\">\n                    \343\202\271\343\203\257\343\202\244\343\203\227\347\265\220\346\236\234\343\201\213\343\202\211AI\343\201\214\345\202\276\345\220\221\343\202\222\343\202\271\343\202\263\343\202\242\343\203\252\343\203\263\343\202\260\n                  </p>\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setShowSummaryModal(false)}\n                className=\"p-1.5 rounded-full hover:bg-stone-100 text-stone-400 hover:text-stone-700 cursor-pointer\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            {/* Stats Overview */}\n            <div className=\"grid grid-cols-3 gap-2.5 text-center\">\n              <div className=\"bg-rose-50/80 rounded-2xl p-3 border border-rose-100\">\n                <div className=\"text-lg font-black text-rose-600\">\n                  {preferenceSummary.totalSwiped}\n                </div>\n                <div className=\"text-[10px] font-bold text-stone-500\">\343\202\271\343\203\257\343\202\244\343\203\227\347\267\217\346\225\260</div>\n              </div>\n              <div className=\"bg-emerald-50/80 rounded-2xl p-3 border border-emerald-100\">\n                <div className=\"text-lg font-black text-emerald-600\">\n                  {preferenceSummary.likedCount}\n                </div>\n                <div className=\"text-[10px] font-bold text-stone-500\">\350\241\214\343\201\215\343\201\237\343\201\204\357\274\201</div>\n              </div>\n              <div className=\"bg-stone-100/80 rounded-2xl p-3 border border-stone-200\">\n                <div className=\"text-lg font-black text-stone-600\">\n                  {preferenceSummary.passedCount}\n                </div>\n                <div className=\"text-[10px] font-bold text-stone-500\">\343\203\221\343\202\271</div>\n              </div>\n            </div>\n\n            {/* Top Categories */}\n            <div className=\"space-y-3\">\n              <div>\n                <h4 className=\"text-xs font-bold text-stone-700 mb-1.5 flex items-center gap-1\">\n                  <Utensils className=\"w-3.5 h-3.5 text-rose-500\" />\n                  <span>\343\201\202\343\201\252\343\201\237\343\201\214\351\253\230\343\202\271\343\202\263\343\202\242\343\202\222\343\201\244\343\201\221\343\201\237\343\202\270\343\203\243\343\203\263\343\203\253</span>\n                </h4>\n                {preferenceSummary.topGenres.length > 0 ? (\n                  <div className=\"flex flex-wrap gap-1.5\">\n                    {preferenceSummary.topGenres.map((g) => (\n                      <span\n                        key={g.name}\n                        className=\"px-3 py-1.5 rounded-xl bg-gradient-to-r from-rose-500 to-pink-500 text-white text-xs font-bold shadow-2xs flex items-center gap-1\"\n                      >\n                        <span>{g.name}</span>\n                        <span className=\"text-[10px] opacity-80\">+{g.score}pt</span>\n                      </span>\n                    ))}\n                  </div>\n                ) : (\n                  <p className=\"text-xs text-stone-400\">\343\201\276\343\201\240\345\215\201\345\210\206\343\201\252\343\203\207\343\203\274\343\202\277\343\201\214\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223</p>\n                )}\n              </div>\n\n              <div>\n                <h4 className=\"text-xs font-bold text-stone-700 mb-1.5 flex items-center gap-1\">\n                  <Sparkles className=\"w-3.5 h-3.5 text-amber-500\" />\n                  <span>\343\202\210\343\201\217\351\201\270\343\201\266\345\210\251\347\224\250\343\202\267\343\203\274\343\203\263</span>\n                </h4>\n                {preferenceSummary.topScenes.length > 0 ? (\n                  <div className=\"flex flex-wrap gap-1.5\">\n                    {preferenceSummary.topScenes.map((s) => (\n                      <span\n                        key={s.name}\n                        className=\"px-3 py-1.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs font-bold flex items-center gap-1\"\n                      >\n                        <span>{s.name}</span>\n                        <span className=\"text-[10px] text-amber-600\">+{s.score}pt</span>\n                      </span>\n                    ))}\n                  </div>\n                ) : (\n                  <p className=\"text-xs text-stone-400\">\343\201\276\343\201\240\345\215\201\345\210\206\343\201\252\343\203\207\343\203\274\343\202\277\343\201\214\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223</p>\n                )}\n              </div>\n            </div>\n\n            {/* Actions */}\n            <div className=\"pt-2 flex flex-col gap-2\">\n              <button\n                type=\"button\"\n                id=\"summary-switch-to-list-btn\"\n                onClick={() => {\n                  setShowSummaryModal(false);\n                  onSwitchToListTab();\n                }}\n                className=\"w-full py-3 rounded-2xl bg-stone-900 hover:bg-rose-600 text-white font-bold text-xs sm:text-sm shadow-md transition-all cursor-pointer flex items-center justify-center gap-1.5\"\n 