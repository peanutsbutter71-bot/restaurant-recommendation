                    #{scene}\n                      </span>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n\n            {/* Google Map Link & Action Row */}\n            <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-2\">\n              {spot.mapUrl ? (\n                <a\n                  id=\"detail-map-link\"\n                  href={spot.mapUrl}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-stone-900 hover:bg-stone-800 text-white font-bold text-sm shadow-md transition-all active:scale-98\"\n                >\n                  <MapPin className=\"w-4 h-4 text-rose-400\" />\n                  <span>Google\343\203\236\343\203\203\343\203\227\343\201\247\351\226\213\343\201\217</span>\n                  <ExternalLink className=\"w-3.5 h-3.5 text-stone-400 ml-1\" />\n                </a>\n              ) : (\n                <a\n                  id=\"detail-map-search-link\"\n                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(\n                    `${spot.name} ${spot.area}`\n                  )}`}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-stone-100 hover:bg-stone-200 text-stone-800 font-bold text-sm border border-stone-200 transition-all\"\n                >\n                  <MapPin className=\"w-4 h-4 text-rose-500\" />\n                  <span>Google\343\203\236\343\203\203\343\203\227\343\201\247\345\272\227\345\220\215\343\202\222\346\244\234\347\264\242</span>\n                  <ExternalLink className=\"w-3.5 h-3.5 text-stone-400 ml-1\" />\n                </a>\n              )}\n\n              {/* Edit & Delete Controls */}\n              <div className=\"flex items-center gap-2 justify-end\">\n                <button\n                  id=\"detail-edit-btn\"\n                  onClick={() => onEditSpot(spot)}\n                  className=\"flex items-center gap-1.5 px-4 py-3 rounded-2xl bg-white hover:bg-stone-100 text-stone-700 font-semibold text-xs border border-stone-200 transition-colors cursor-pointer\"\n                >\n                  <Edit3 className=\"w-3.5 h-3.5\" />\n                  <span>\347\267\250\351\233\206</span>\n                </button>\n\n                {showDeleteConfirm ? (\n                  <div className=\"flex items-center gap-1\">\n                    <button\n                      id=\"confirm-delete-btn\"\n                      onClick={() => onDeleteSpot(spot.id)}\n                      className=\"px-3 py-3 rounded-2xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs transition-colors cursor-pointer\"\n                    >\n                      \345\211\212\351\231\244\343\201\231\343\202\213\n                    </button>\n                    <button\n                      onClick={() => setShowDeleteConfirm(false)}\n                      className=\"px-3 py-3 rounded-2xl bg-stone-200 hover:bg-stone-300 text-stone-700 font-semibold text-xs transition-colors cursor-pointer\"\n                    >\n                      \343\202\255\343\203\243\343\203\263\343\202\273\343\203\253\n                    </button>\n                  </div>\n                ) : (\n                  <button\n                    id=\"detail-delete-btn\"\n                    onClick={() => setShowDeleteConfirm(true)}\n                    className=\"p-3 rounded-2xl bg-white hover:bg-red-50 text-stone-400 hover:text-red-600 border border-stone-200 transition-colors cursor-pointer\"\n                    title=\"\345\211\212\351\231\244\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                )}\n              </div>\n            </div>\n\n            {/* Added date metadata */}\n            <div className=\"flex items-center gap-1.5 text-xs text-stone-400 pt-2 border-t border-stone-100\">\n              <Calendar className=\"w-3.5 h-3.5\" />\n              <span>\350\250\230\351\214\262\346\227\245: {formatJapaneseDate(spot.createdAt)}</span>\n            </div>"
