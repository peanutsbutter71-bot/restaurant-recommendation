e SortOption = \'newest\' | \'oldest\' | \'priceAsc\' | \'priceDesc\';\n\nexport type CardDisplayMode = \'card\' | \'list\'; // \'card\' = \345\244\247\343\202\253\343\203\274\343\203\211\345\206\231\347\234\237\351\207\215\350\246\226, \'list\' = \343\202\263\343\203\263\343\203\221\343\202\257\343\203\210\343\203\252\343\202\271\343\203\210\n\nexport interface FilterState {\n  searchQuery: string;\n  areas: string[];\n  genres: string[];\n  priceRanges: PriceRange[];\n  scenes: Scene[];\n  favoritesOnly: boolean;\n  unvisitedOnly: boolean; // \343\200\214\346\234\252\350\250\252\345\225\217\343\201\256\345\272\227\350\210\227\343\201\256\343\201\277\350\241\250\347\244\272\343\200\215\343\203\210\343\202\260\343\203\253\343\202\271\343\202\244\343\203\203\343\203\201\347\224\250\n  visitStatus: VisitStatusFilter; // \'all\' | \'unvisited\' (\'\350\241\214\343\201\215\343\201\237\343\201\204/\346\234\252\350\250\252\345\225\217\') | \'visited\' (\'\350\241\214\343\201\243\343\201\237/\350\250\252\345\225\217\346\270\210\343\201\277\')\n  sortBy: SortOption;\n}"
