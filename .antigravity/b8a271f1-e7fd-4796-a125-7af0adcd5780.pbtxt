    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport {\n  Sparkles,\n  X,\n  Link,\n  Clipboard,\n  Smartphone,\n  CheckCircle2,\n  AlertCircle,\n  Share2,\n  Compass,\n  Utensils,\n  Camera,\n  Info,\n  ChevronDown,\n  ChevronUp,\n} from \'lucide-react\';\nimport { RestaurantSpot } from \'../types\';\nimport { parseSharedUrlOrText } from \'../utils/aiShareImport\';\n\ninterface QuickUrlImportModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onSuccessParsed: (prefilledSpot: Partial<RestaurantSpot>) => void;\n  initialShareText?: string;\n  onShowToast: (msg: string) => void;\n}\n\nexport const QuickUrlImportModal: React.FC<QuickUrlImportModalProps> = ({\n  isOpen,\n  onClose,\n  onSuccessParsed,\n  initialShareText = \'\',\n  onShowToast,\n}) => {\n  const [inputText, setInputText] = useState(initialShareText);\n  const [isLoading, setIsLoading] = useState(false);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n  const [showPwaGuide, setShowPwaGuide] = useState(false);\n\n  useEffect(() => {\n    if (initialShareText) {\n      setInputText(initialShareText);\n    }\n  }, [initialShareText]);\n\n  if (!isOpen) return null;\n\n  const handlePasteClipboard = async () => {\n    try {\n      if (!navigator.clipboard) {\n        onShowToast(\'\343\202\257\343\203\252\343\203\203\343\203\227\343\203\234\343\203\274\343\203\211\343\201\256\350\252\255\343\201\277\345\217\226\343\202\212\343\201\253\345\257\276\345\277\234\343\201\227\343\201\246\343\201\204\343\201\252\343\201\204\343\203\226\343\203\251\343\202\246\343\202\266\343\201\247\343\201\231\');\n        return;\n      }\n      const text = await navigator.clipboard.readText();\n      if (text) {\n        setInputText(text);\n        onShowToast(\'\343\202\257\343\203\252\343\203\203\343\203\227\343\203\234\343\203\274\343\203\211\343\201\213\343\202\211\350\262\274\343\202\212\344\273\230\343\201\221\343\201\276\343\201\227\343\201\237\360\237\223\213\');\n      } else {\n        onShowToast(\'\343\202\257\343\203\252\343\203\203\343\203\227\343\203\234\343\203\274\343\203\211\343\201\214\347\251\272\343\201\247\343\201\231\');\n      }\n    } catch {\n      onShowToast(\'\343\202\257\343\203\252\343\203\203\343\203\227\343\203\234\343\203\274\343\203\211\343\201\270\343\201\256\343\202\242\343\202\257\343\202\273\343\202\271\343\201\214\350\250\261\345\217\257\343\201\225\343\202\214\343\201\246\343\201\204\343\201\276\343\201\233\343\202\223\');\n    }\n  };\n\n  const handleAnalyzeAndImport = async () => {\n    if (!inputText.trim()) {\n      setErrorMessage(\'\345\205\261\346\234\211\343\201\225\343\202\214\343\201\237URL\343\201\276\343\201\237\343\201\257\343\203\206\343\202\255\343\202\271\343\203\210\343\202\222\345\205\245\345\212\233\343\201\227\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\');\n      return;\n    }\n\n    setIsLoading(true);\n    setErrorMessage(null);\n\n    try {\n      const result = await parseSharedUrlOrText(inputText);\n      if (result.spot) {\n        onShowToast(\'\342\234\250 AI\343\201\214\345\272\227\350\210\227\346\203\205\345\240\261\343\202\222\350\247\243\346\236\220\343\201\227\343\201\276\343\201\227\343\201\237\357\274\201\');\n        onSuccessParsed(result.spot);\n        onClose();\n      } else {\n        setErrorMessage(\'\345\272\227\350\210\227\346\203\205\345\240\261\343\201\256\350\247\243\346\236\220\343\201\214\343\201\247\343\201\215\343\201\276\343\201\233\343\202\223\343\201\247\343\201\227\343\201\237\343\200\202URL\343\202\222\343\201\224\347\242\272\350\252\215\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\');\n      }\n    } catch (err: any) {\n      console.error(\'Share parse error:\', err);\n      setErrorMessage(err.message || \'\350\247\243\346\236\220\343\201\253\345\244\261\346\225\227\343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-stone-900/60 backdrop-blur-sm animate-in fade-in duration-200\">\n      <div className=\"bg-white rounded-3xl w-full max-w-lg shadow-2xl border border-stone-200/80 overflow-hidden flex flex-col max-h-[92vh]\">\n        {/* Header */}\n        <div className=\"px-6 py-4.5 bg-gradient-to-r from-rose-500 via-rose-600 to-amber-500 text-white flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-9 h-9 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-white shadow-inner\">\n              <Share2 className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-base font-extrabold flex items-center gap-1.5\">\n                <span>\345\205\261\346\234\211\343\203\252\343\203\263\343\202\257\343\201\213\343\202\211AI\344\270\200\347\231\272\347\231\273\351\214\262</span>\n                <span className=\"text-[10px] bg-white/25 px-2 py-0.5 rounded-full font-bold\">\n                  AI\350\247\243\346\236\220\n                </span>\n              </h2>\n              <p className=\"text-xs text-rose-100 font-medium\">\n                \351\243\237\343\201\271\343\203\255\343\202\260\343\203\273Google\343\203\236\343\203\203\343\203\227\343\203\273Instagram\343\201\252\343\201\251\343\201\256URL\343\202\222\350\207\252\345\213\225\345\210\244\345\210\245\n              </p>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"p-2 rounded-full hover:bg-white/20 text-white/90 hover:text-white transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content Body */}\n        <div className=\"p-6 space-y-4.5 overflow-y-auto\">\n          {/* Supported Apps Pills */}\n          <div className=\"flex items-center gap-1.5 flex-wrap\">\n            <span className=\"text-[11px] font-bold text-stone-500 mr-1\">\345\257\276\345\277\234\343\202\265\343\203\274\343\203\223\343\202\271:</span>\n            <span className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-xl text-[11px] font-bold bg-amber-50 text-amber-800 border border-amber-200\">\n              <Utensils className=\"w-3 h-3 text-amber-600\" />\n              \351\243\237\343\201\271\343\203\255\343\202\260\n            </span>\n            <span className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-xl text-[11px] font-bold bg-rose-50 text-rose-800 border border-rose-200\">\n              <Compass className=\"w-3 h-3 text-rose-600\" />\n              Google\343\203\236\343\203\203\343\203\227\n            </span>\n            <span className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-xl text-[11px] font-bold bg-fuchsia-50 text-fuchsia-800 border border-fuchsia-200\">\n              <Camera className=\"w-3 h-3 text-fuchsia-600\" />\n              Instagram\n            </span>\n            <span className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-xl text-[11px] font-bold bg-stone-100 text-stone-700 border border-stone-200\">\n              Web\350\250\230\344\272\213 / \345\205\261\346\234\211\346\226\207\n            </span>\n          </div>\n\n          {/* Text Input Area */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"text-xs font-bold text-stone-800 flex items-center gap-1\">\n                <Link className=\"w-3.5 h-3.5 text-rose-500\" />\n                <span>\345\205\261\346\234\211URL\343\201\276\343\201\237\343\201\257\343\203\206\343\202\255\343\202\271\343\203\210\343\202\222\350\262\274\343\202\212\344\273\230\343\201\221</span>\n              </label>\n              <button\n                type=\"button\"\n                onClick={handlePasteClipboard}\n                className=\"text-xs font-bold text-rose-600 hover:text-rose-700 flex items-center gap-1 px-2.5 py-1 rounded-xl bg-rose-50 hover:bg-rose-100 border border-rose-200/70 transition-all active:scale-95 cursor-pointer\"\n              >\n                <Clipboard className=\"w-3.5 h-3.5\" />\n                <span>\343\202\257\343\203\252\343\203\203\343\203\227\343\203\234\343\203\274\343\203\211\343\201\213\343\202\211\350\262\274\344\273\230</span>\n              </button>\n            </div>\n\n            <textarea\n              id=\"input-quick-share-text\"\n              rows={4}\n              placeholder=\"\344\276\213: \343\200\214\343\201\223\343\201\256\343\202\253\343\203\225\343\202\247\350\211\257\343\201\225\343\201\235\343\201\206\357\274\201 https://tabelog.com/...\343\200\215 \343\201\276\343\201\237\343\201\257 Google\343\203\236\343\203\203\343\203\227\343\201\256\345\205\261\346\234\211\343\203\252\343\203\263\343\202\257\"\n              value={inputText}\n              onChange={(e) => setInputText(e.target.value)}\n              className=\"w-full p-3.5 bg-stone-50/70 border border-stone-200 rounded-2xl text-xs sm:text-sm leading-relaxed text-stone-800 placeholder-stone-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-400/30 focus:border-rose-400 transition-all resize-none\"\n            />\n          </div>\n\n          {errorMessage && (\n            <div className=\"flex items-start gap-2 p-3 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs animate-in fade-in\">\n              <AlertCircle className=\"w-4 h-4 text-rose-600 shrink-0 mt-0.5\" />\n              <span>{errorMessage}</span>\n            </div>\n          )}\n\n          {/* Action Button */}\n          <button\n            id=\"btn-analyze-shared-url\"\n            type=\"button\"\n            onClick={handleAnalyzeAndImport}\n            disabled={isLoading || !inputText.trim()}\n            className={`w-full py-3.5 rounded-2xl font-extrabold text-sm shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer ${\n              isLoading\n                ? \'bg-rose-100 text-rose-500 cursor-wait\'\n                : !inputText.trim()\n                ? \'bg-stone-200 text-stone-400 cursor-not-allowed\'\n                : \'bg-gradient-to-r from-rose-500 to-amber-500 hover:from-rose-600 hover:to-amber-600 text-white active:scale-98 shadow-rose-200\'\n            }`}\n          >\n            {isLoading ? (\n              <>\n                <div className=\"w-4 h-4 border-2 border-rose-500 border-t-transparent rounded-full animate-spin\" />\n                <span>AI\343\201\214\345\272\227\345\220\215\343\203\273\343\202\250\343\203\252\343\202\242\343\203\273\343\202\270\343\203\243\343\203\263\343\203\253\343\202\222\350\247\243\346\236\220\344\270\255...</span>\n              </>\n            ) : (\n              <>\n                <Sparkles className=\"w-4 h-4 text-amber-200\" />\n                <span>AI\343\201\247\350\247\243\346\236\220\343\201\227\343\201\246\347\231\273\351\214\262\347\224\273\351\235\242\343\202\222\351\226\213\343\201\217</span>\n              </>\n            )}\n          </button>\n\n          {/* PWA / Mobile Share Target Guide (Collapsible) */}\n          <div className=\"pt-2 border-t border-stone-100\">\n            <button\n              type=\"button\"\n              onClick={() => setShowPwaGuide(!showPwaGuide)}\n              className=\"w-full flex items-center justify-between text-xs font-bold text-stone-600 hover:text-stone-900 py-1.5 cursor-pointer\"\n            >\n              <span className=\"flex items-center gap-1.5\">\n                <Smartphone className=\"w-4 h-4 text-rose-500\" />\n                <span>\343\202\271\343\203\236\343\203\233\343\201\256\343\200\214\345\205\261\346\234\211\343\200\215\343\203\241\343\203\213\343\203\245\343\203\274\343\201\213\343\202\211\347\233\264\346\216\245\351\226\213\343\201\217\346\226\271\346\263\225\357\274\210PWA\357\274\211</span>\n              </span>\n              {showPwaGuide ? (\n                <ChevronUp className=\"w-4 h-4 text-stone-400\" />\n              ) : (\n                <ChevronDown className=\"w-4 h-4 text-stone-400\" />\n              )}\n            </button>\n\n            {showPwaGuide && (\n              <div className=\"mt-2 p-3.5 rounded-2xl bg-stone-50 border border-stone-200 space-y-2.5 text-[11px] text-stone-600 animate-in fade-in\">\n                <p className=\"font-bold text-stone-800\">\n                  \360\237\223\261 \343\203\233\343\203\274\343\203\240\347\224\273\351\235\242\343\201\253\350\277\275\345\212\240\343\201\231\343\202\213\343\201\250\343\200\201\344\273\226\343\202\242\343\203\227\343\203\252\343\201\256\343\200\214\345\205\261\346\234\211\343\200\215\343\203\234\343\202\277\343\203\263\343\201\213\343\202\211\347\233\264\346\216\245\343\201\223\343\201\256\343\202\242\343\203\227\343\203\252\343\201\253\351\243\233\343\201\271\343\202\213\343\202\210\343\201\206\343\201\253\343\201\252\343\202\212\343\201\276\343\201\231\357\274\201\n                </p>\n                <div className=\"space-y-1.5 pl-1\">\n                  <div>\n                    <span className=\"font-bold text-rose-600\">iPhone (Safari):</span>\n                    <p className=\"text-stone-500\">\n                      \347\224\273\351\235\242\344\270\213\343\201\256\345\205\261\346\234\211\343\203\234\343\202\277\343\203\263 <Share2 className=\"w-3 h-3 inline text-stone-700\" /> \342\206\222\343\200\214<strong>\343\203\233\343\203\274\343\203\240\347\224\273\351\235\242\343\201\253\350\277\275\345\212\240</strong>\343\200\215\343\202\222\343\202\277\343\203\203\343\203\227\n                    </p>\n                  </div>\n                  <div>\n                    <span className=\"font-bold text-amber-600\">Android (Chrome):</span>\n                    <p className=\"text