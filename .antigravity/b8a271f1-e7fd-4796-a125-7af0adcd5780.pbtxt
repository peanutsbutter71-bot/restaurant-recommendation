    instruction: "Add onOpenMyPage prop and button to Header.tsx"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { Utensils, Sparkles, Plus, Dices, Heart, Share2 } from \'lucide-react\';\n\ninterface HeaderProps {\n  spotCount: number;\n  favoriteCount: number;\n  onOpenAddModal: () => void;\n  onOpenQuickImport: () => void;\n  onOpenRandomModal: () => void;\n  favoritesOnly: boolean;\n  onToggleFavoritesOnly: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  spotCount,\n  favoriteCount,\n  onOpenAddModal,\n  onOpenQuickImport,\n  onOpenRandomModal,\n  favoritesOnly,\n  onToggleFavoritesOnly,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-30 bg-[#FAF8F5]/90 backdrop-blur-md border-b border-stone-200/70 transition-all\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6 py-3.5 sm:py-4\">\n        <div className=\"flex items-center justify-between gap-3\">\n          {/* Logo & Subtitle */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-br from-rose-400 via-pink-400 to-amber-300 flex items-center justify-center text-white shadow-sm shadow-rose-200\">\n              <Utensils className=\"w-5 h-5 sm:w-6 sm:h-6\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-xl sm:text-2xl font-bold tracking-tight text-stone-900 font-serif sm:font-sans\">\n                  Gourmet<span className=\"text-rose-500 font-extrabold\">Share</span>\n                </h1>\n                <span className=\"hidden sm:inline-flex items-center gap-1 text-[11px] font-semibold bg-rose-50 text-rose-600 px-2 py-0.5 rounded-full border border-rose-100\">\n                  <Sparkles className=\"w-3 h-3\" />\n                  \345\217\213\343\201\240\343\201\241\346\216\250\350\226\246\n                </span>\n              </div>\n              <p className=\"text-xs text-stone-500 font-medium hidden xs:block\">\n                \344\277\241\351\240\274\343\201\247\343\201\215\343\202\213\345\217\213\344\272\272\343\203\273\345\205\210\350\274\251\343\201\213\343\202\211\346\225\231\343\201\210\343\201\246\343\202\202\343\202\211\343\201\243\343\201\237\345\216\263\351\201\270\343\202\260\343\203\253\343\203\241\343\203\216\343\203\274\343\203\210\n              </p>\n            </div>\n          </div>\n\n          {/* Action Buttons */}\n          <div className=\"flex items-center gap-1.5 sm:gap-2\">\n            {/* Quick Share URL Import Button */}\n            <button\n              id=\"header-quick-share-import-btn\"\n              onClick={onOpenQuickImport}\n              className=\"flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-bold bg-gradient-to-r from-rose-50 to-amber-50 text-rose-700 border border-rose-200/80 hover:border-rose-300 hover:bg-rose-100/70 transition-all duration-200 active:scale-95 cursor-pointer shadow-2xs\"\n              title=\"\351\243\237\343\201\271\343\203\255\343\202\260\343\203\273Google\343\203\236\343\203\203\343\203\227\343\203\273Instagram\343\201\256URL\343\201\213\343\202\211AI\344\270\200\347\231\272\347\231\273\351\214\262\"\n            >\n              <Share2 className=\"w-4 h-4 text-rose-500\" />\n              <span className=\"hidden sm:inline\">\345\205\261\346\234\211\343\203\252\343\203\263\343\202\257\343\201\213\343\202\211\347\231\273\351\214\262</span>\n              <span className=\"sm:hidden\">URL\347\231\273\351\214\262</span>\n              <span className=\"text-[9px] bg-rose-500 text-white font-extrabold px-1.5 py-0.2 rounded-full hidden xs:inline\">\n                AI\n              </span>\n            </button>\n\n            {/* Quick Favorites Button */}\n            <button\n              id=\"header-fav-toggle-btn\"\n              onClick={onToggleFavoritesOnly}\n              className={`flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 border ${\n                favoritesOnly\n                  ? \'bg-rose-500 text-white border-rose-500 shadow-sm shadow-rose-200\'\n                  : \'bg-white/80 text-stone-600 border-stone-200/80 hover:bg-rose-50/60 hover:text-rose-600\'\n              }`}\n              title=\"\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277\350\241\250\347\244\272\"\n            >\n              <Heart className={`w-4 h-4 ${favoritesOnly ? \'fill-current text-white\' : \'text-rose-500\'}`} />\n              <span className=\"hidden md:inline\">\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212</span>\n              <span className={`text-[11px] px-1.5 py-0.2 rounded-full ${favoritesOnly ? \'bg-white/20 text-white\' : \'bg-stone-100 text-stone-600\'}`}>\n                {favoriteCount}\n              </span>\n            </button>\n\n            {/* Random Pick Roulette Button */}\n            <button\n              id=\"header-random-roulette-btn\"\n              onClick={onOpenRandomModal}\n              className=\"flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-amber-50 text-amber-800 border border-amber-200/70 hover:bg-amber-100 hover:border-amber-300 transition-all duration-200 active:scale-95\"\n              title=\"\344\273\212\346\227\245\343\201\251\343\201\223\350\241\214\343\201\217\357\274\237\350\277\267\343\201\243\343\201\237\343\202\211\343\203\253\343\203\274\343\203\254\343\203\203\343\203\210\"\n            >\n              <Dices className=\"w-4 h-4 text-amber-600\" />\n              <span className=\"hidden lg:inline\">\344\273\212\346\227\245\343\201\251\343\201\223\350\241\214\343\201\217\357\274\237</span>\n              <span className=\"lg:hidden hidden sm:inline\">\343\203\253\343\203\274\343\203\254\343\203\203\343\203\210</span>\n            </button>\n\n            {/* Add Spot Button */}\n            <button\n              id=\"header-add-spot-btn\"\n              onClick={onOpenAddModal}\n              className=\"flex items-center gap-1.5 px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-white bg-gradient-to-r from-stone-900 to-stone-800 hover:from-rose-600 hover:to-pink-600 active:scale-95 shadow-sm transition-all duration-200 cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4 stroke-[2.5]\" />\n              <span className=\"hidden xs:inline\">\343\201\212\345\272\227\343\202\222\350\250\230\351\214\262</span>\n              <span className=\"xs:hidden\">\350\277\275\345\212\240</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { Utensils, Sparkles, Plus, Dices, Heart, Share2, User } from \'lucide-react\';\n\ninterface HeaderProps {\n  spotCount: number;\n  favoriteCount: number;\n  onOpenAddModal: () => void;\n  onOpenQuickImport: () => void;\n  onOpenRandomModal: () => void;\n  onOpenMyPage?: () => void;\n  favoritesOnly: boolean;\n  onToggleFavoritesOnly: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  spotCount,\n  favoriteCount,\n  onOpenAddModal,\n  onOpenQuickImport,\n  onOpenRandomModal,\n  onOpenMyPage,\n  favoritesOnly,\n  onToggleFavoritesOnly,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-30 bg-[#FAF8F5]/90 backdrop-blur-md border-b border-stone-200/70 transition-all\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6 py-3.5 sm:py-4\">\n        <div className=\"flex items-center justify-between gap-3\">\n          {/* Logo & Subtitle */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-br from-rose-400 via-pink-400 to-amber-300 flex items-center justify-center text-white shadow-sm shadow-rose-200\">\n              <Utensils className=\"w-5 h-5 sm:w-6 sm:h-6\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-xl sm:text-2xl font-bold tracking-tight text-stone-900 font-serif sm:font-sans\">\n                  Gourmet<span className=\"text-rose-500 font-extrabold\">Share</span>\n                </h1>\n                <span className=\"hidden sm:inline-flex items-center gap-1 text-[11px] font-semibold bg-rose-50 text-rose-600 px-2 py-0.5 rounded-full border border-rose-100\">\n                  <Sparkles className=\"w-3 h-3\" />\n                  \345\217\213\343\201\240\343\201\241\346\216\250\350\226\246\n                </span>\n              </div>\n              <p className=\"text-xs text-stone-500 font-medium hidden xs:block\">\n                \344\277\241\351\240\274\343\201\247\343\201\215\343\202\213\345\217\213\344\272\272\343\203\273\345\205\210\350\274\251\343\201\213\343\202\211\346\225\231\343\201\210\343\201\246\343\202\202\343\202\211\343\201\243\343\201\237\345\216\263\351\201\270\343\202\260\343\203\253\343\203\241\343\203\216\343\203\274\343\203\210\n              </p>\n            </div>\n          </div>\n\n          {/* Action Buttons */}\n          <div className=\"flex items-center gap-1.5 sm:gap-2\">\n            {/* Quick Share URL Import Button */}\n            <button\n              id=\"header-quick-share-import-btn\"\n              onClick={onOpenQuickImport}\n              className=\"flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-bold bg-gradient-to-r from-rose-50 to-amber-50 text-rose-700 border border-rose-200/80 hover:border-rose-300 hover:bg-rose-100/70 transition-all duration-200 active:scale-95 cursor-pointer shadow-2xs\"\n              title=\"\351\243\237\343\201\271\343\203\255\343\202\260\343\203\273Google\343\203\236\343\203\203\343\203\227\343\203\273Instagram\343\201\256URL\343\201\213\343\202\211AI\344\270\200\347\231\272\347\231\273\351\214\262\"\n            >\n              <Share2 className=\"w-4 h-4 text-rose-500\" />\n              <span className=\"hidden sm:inline\">\345\205\261\346\234\211\343\203\252\343\203\263\343\202\257\343\201\213\343\202\211\347\231\273\351\214\262</span>\n              <span className=\"sm:hidden\">URL\347\231\273\351\214\262</span>\n              <span className=\"text-[9px] bg-rose-500 text-white font-extrabold px-1.5 py-0.2 rounded-full hidden xs:inline\">\n                AI\n              </span>\n            </button>\n\n            {/* Quick Favorites Button */}\n            <button\n              id=\"header-fav-toggle-btn\"\n              onClick={onToggleFavoritesOnly}\n              className={`flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 border ${\n                favoritesOnly\n                  ? \'bg-rose-500 text-white border-rose-500 shadow-sm shadow-rose-200\'\n                  : \'bg-white/80 text-stone-600 border-stone-200/80 hover:bg-rose-50/60 hover:text-rose-600\'\n              }`}\n              title=\"\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277\350\241\250\347\244\272\"\n            >\n              <Heart className={`w-4 h-4 ${favoritesOnly ? \'fill-current text-white\' : \'text-rose-500\'}`} />\n              <span className=\"hidden md:inline\">\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212</span>\n              <span className={`text-[11px] px-1.5 py-0.2 rounded-full ${favoritesOnly ? \'bg-white/20 text-white\' : \'bg-stone-100 text-stone-600\'}`}>\n                {favoriteCount}\n              </span>\n            </button>\n\n            {/* Random Pick Roulette Button */}\n            <button\n              id=\"header-random-roulette-btn\"\n              onClick={onOpenRandomModal}\n              className=\"flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-amber-50 text-amber-800 border border-amber-200/70 hover:bg-amber-100 hover:border-amber-300 transition-all duration-200 active:scale-95\"\n              title=\"\344\273\212\346\227\245\343\201\251\343\201\223\350\241\214\343\201\217\357\274\237\350\277\267\343\201\243\343\201\237\343\202\211\343\203\253\343\203\274\343\203\254\343\203\203\343\203\210\"\n            >\n              <Dices className=\"w-4 h-4 text-amber-600\" />\n              <span className=\"hidden lg:inline\">\344\273\212\346\227\245\343\201\251\343\201\223\350\241\214\343\201\217\357\274\237</span>\n              <span className=\"lg:hidden hidden sm:inline\">\343\203\253\343\203\274\343\203\254\343\203\203\343\203\210</span>\n            </button>\n\n            {/* MyPage / Folder / Backup Button */}\n            {onOpenMyPage && (\n              <button\n                id=\"header-mypage-btn\"\n                onClick={onOpenMyPage}\n                className=\"flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white text-stone-700 border border-stone-200 hover:bg-stone-50 hover:border-stone-300 transition-all duration-200 active:scale-95\"\n                title=\"\343\203\236\343\202\244\343\203\232\343\203\274\343\202\270\357\274\210\347\265\261\350\250\210\343\203\273\343\203\225\343\202\251\343\203\253\343\203\200\343\203\273\343\203\220\343\203\203\343\202\257\343\202\242\343\203\203\343\203\227\357\274\211\"\n              >\n                <User className=\"w-4 h-4 text-stone-600\" />\n                <span className=\"hidden sm:inline\">\343\203\236\343\202\244\343\203\232\343\203\274\343\202\270</span>\n              </button>\n            )}\n\n            {/* Add Spot Button */}\n            <button\n              id=\"header-add-spot-btn\"\n              onClick={onOpenAddModal}\n              className=\"flex items-center gap-1.5 px-3 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-white bg-gradient-to-r from-stone-900 to-stone-800 hover:from-rose-600 hover:to-pink-600 active:scale-95 shadow-sm transition-all duration-200 cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4 stroke-[2.5]\" />\n              <span className=\"hidden xs:inline\">\343\201\212\345\272\227\343\202\222\350\250\230\351\214\262</span>\n              <span className=\"xs:hidden\">\350\277\275\345\212\240</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};"
      }
