      original_chunk {
        target_content: "        <div className=\"flex items-center gap-2\">\n          <div className=\"w-6 h-6 rounded-lg bg-gradient-to-tr from-rose-500 to-amber-500 flex items-center justify-center text-white shadow-2xs\">\n            <Sparkles className=\"w-3.5 h-3.5\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-1.5\">\n              <span className=\"text-xs font-black text-stone-900 tracking-tight\">\n                \345\245\275\343\201\277\345\255\246\347\277\222\343\202\244\343\203\263\343\202\265\343\202\244\343\203\210\n              </span>\n              <span className=\"px-1.5 py-0.2 rounded-md bg-rose-500/10 text-rose-600 text-[10px] font-bold\">\n                Lv.{summary.level}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          {/* Progress Mini Bar */}\n          <div className=\"hidden sm:flex items-center gap-1.5 text-[10px] text-stone-500 font-medium\">\n            <span>\347\262\276\345\272\246</span>\n            <div className=\"w-16 h-1.5 bg-stone-100 rounded-full overflow-hidden\">\n              <div\n                className=\"h-full bg-gradient-to-r from-rose-500 to-amber-400 rounded-full transition-all duration-500\"\n                style={{ width: `${summary.confidencePercent}%` }}\n              />\n            </div>\n            <span className=\"font-bold text-stone-700\">{summary.confidencePercent}%</span>\n          </div>\n\n          <button\n            type=\"button\"\n            className=\"p-1 rounded-lg hover:bg-stone-100 text-stone-400 hover:text-stone-700 transition-colors\"\n            title={isExpanded ? \'\346\212\230\343\202\212\343\201\237\343\201\237\343\202\200\' : \'\345\261\225\351\226\213\343\201\231\343\202\213\'}\n          >\n            {isExpanded ? (\n              <ChevronUp className=\"w-4 h-4\" />\n            ) : (\n              <ChevronDown className=\"w-4 h-4\" />\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Expanded Content View */}\n      {isExpanded && (\n        <div className=\"px-3.5 pb-3 pt-0.5 border-t border-stone-100 space-y-2.5 animate-in fade-in slide-in-from-top-1 duration-200\">\n          {!hasPreferences ? (\n            /* Initial state before swiping */\n            <div className=\"py-2 text-center space-y-1\">\n              <p className=\"text-[11px] text-stone-600 font-medium\">\n                \343\202\253\343\203\274\343\203\211\343\202\222\345\267\246\345\217\263\343\201\253\343\202\271\343\203\257\343\202\244\343\203\227\343\201\231\343\202\213\343\201\250\343\200\201\343\201\202\343\201\252\343\201\237\343\201\256\345\245\275\343\201\215\343\201\252\343\202\270\343\203\243\343\203\263\343\203\253\343\202\204\343\202\250\343\203\252\343\202\242\343\202\222\343\203\252\343\202\242\343\203\253\343\202\277\343\202\244\343\203\240\343\201\247\345\255\246\347\277\222\343\201\227\343\201\276\343\201\231\357\274\201\n              </p>\n              <div className=\"flex items-center justify-center gap-3 text-[10px] text-stone-600 font-bold pt-1\">\n                <span className=\"flex items-center gap-1\">\n                  <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n                  \345\217\263: \350\241\214\343\201\215\343\201\237\343\201\204\n                </span>\n                <span className=\"flex items-center gap-1\">\n                  <span className=\"w-2 h-2 rounded-full bg-amber-500\" />\n                  \344\270\212: \343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\n                </span>\n                <span className=\"flex items-center gap-1\">\n                  <span className=\"w-2 h-2 rounded-full bg-stone-400\" />\n                  \345\267\246: \343\203\221\343\202\271\n                </span>\n              </div>\n            </div>\n          ) : (\n            /* Real-time Preferred Tags & Areas Display */\n            <div className=\"space-y-2\">\n              {/* Recommended Genres & Areas Grid */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1\">\n                {/* Top Recommended Genres */}\n                <div className=\"bg-rose-50/60 rounded-xl p-2 border border-rose-100/80 space-y-1\">\n                  <div className=\"flex items-center justify-between text-[10px] font-bold text-rose-800\">\n                    <span className=\"flex items-center gap-1\">\n                      <Utensils className=\"w-3 h-3 text-rose-500\" />\n                      \343\201\212\343\201\231\343\201\231\343\202\201\343\202\270\343\203\243\343\203\263\343\203\253\n                    </span>\n                    <span className=\"text-[9px] text-rose-500/80\">\345\245\275\346\204\237\345\272\246\343\202\271\343\202\263\343\202\242</span>\n                  </div>\n                  <div className=\"flex flex-wrap gap-1\">\n                    {summary.topGenres.length > 0 ? (\n                      summary.topGenres.map((g) => (\n                        <span\n                          key={g.name}\n                          className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-white text-rose-700 text-[10px] font-extrabold border border-rose-200/90 shadow-2xs transition-all hover:scale-105\"\n                        >\n                          <span>{g.name}</span>\n                          <span className=\"text-[9px] font-black text-rose-500 bg-rose-50 px-1 rounded-sm\">\n                            +{g.score}\n                          </span>\n                        </span>\n                      ))\n                    ) : (\n                      <span className=\"text-[10px] text-stone-400 italic\">\345\255\246\347\277\222\344\270\255...</span>\n                    )}\n                  </div>\n                </div>\n\n                {/* Top Recommended Areas */}\n                <div className=\"bg-amber-50/60 rounded-xl p-2 border border-amber-100/80 space-y-1\">\n                  <div className=\"flex items-center justify-between text-[10px] font-bold text-amber-800\">\n                    <span className=\"flex items-center gap-1\">\n                      <MapPin className=\"w-3 h-3 text-amber-600\" />\n                      \343\201\212\343\201\231\343\201\231\343\202\201\343\202\250\343\203\252\343\202\242\n                    </span>\n                    <span className=\"text-[9px] text-amber-600/80\">\345\245\275\346\204\237\345\272\246\343\202\271\343\202\263\343\202\242</span>\n                  </div>\n                  <div className=\"flex flex-wrap gap-1\">\n                    {summary.topAreas.length > 0 ? (\n                      summary.topAreas.map((a) => (\n                        <span\n                          key={a.name}\n                          className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-white text-amber-900 text-[10px] font-extrabold border border-amber-200/90 shadow-2xs transition-all hover:scale-105\"\n                        >\n                          <span>{a.name}</span>\n                          <span className=\"text-[9px] font-black text-amber-600 bg-amber-50 px-1 rounded-sm\">\n                            +{a.score}\n                          </span>\n                        </span>\n                      ))\n                    ) : (\n                      <span className=\"text-[10px] text-stone-400 italic\">\345\255\246\347\277\222\344\270\255...</span>\n                    )}\n                  </div>\n                </div>\n              </div>\n\n              {/* Sub bar: Top Scenes & Detailed Report Link */}\n              <div className=\"flex items-center justify-between pt-0.5 text-[10px]\">\n                <div className=\"flex items-center gap-1 text-stone-500 overflow-hidden\">\n                  <span className=\"font-bold text-stone-600 shrink-0\">\345\245\275\343\201\277\343\201\256\343\202\267\343\203\274\343\203\263:</span>\n                  <div className=\"flex items-center gap-1 truncate\">\n                    {summary.topScenes.length > 0 ? (\n                      summary.topScenes.map((s) => (\n                        <span\n                          key={s.name}\n                          className=\"px-1.5 py-0.2 rounded bg-stone-100 text-stone-700 font-semibold\"\n                        >\n                          {s.name} (+{s.score})\n                        </span>\n                      ))\n                    ) : (\n                      <span className=\"text-stone-400\">\343\203\207\343\203\274\343\202\277\350\223\204\347\251\215\344\270\255</span>\n                    )}\n                  </div>\n                </div>\n\n                {onOpenDetailedSummary && (\n                  <button\n                    type=\"button\"\n                    onClick={onOpenDetailedSummary}\n                    className=\"text-rose-600 hover:text-rose-700 font-bold shrink-0 hover:underline cursor-pointer flex items-center gap-0.5 ml-2\"\n                  >\n                    <span>\350\251\263\347\264\260\343\203\254\343\203\235\343\203\274\343\203\210</span>\n                    <TrendingUp className=\"w-3 h-3\" />\n                  </button>\n                )}"
