    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div\n      id=\"add-spot-modal-backdrop\"\n      className=\"fixed inset-0 z-50 bg-stone-950/60 backdrop-blur-sm flex items-center justify-center p-3 sm:p-5 overflow-y-auto\"\n      onClick={onClose}\n    >\n      <div\n        id=\"add-spot-modal-content\"\n        className=\"bg-[#FAF8F5] rounded-3xl w-full max-w-2xl overflow-hidden shadow-2xl border border-stone-200/80 my-auto max-h-[92vh] flex flex-col animate-in zoom-in-95 duration-200\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-stone-200/80 bg-white/70 backdrop-blur-md flex items-center justify-between sticky top-0 z-10\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h2 className=\"text-lg font-bold text-stone-900\">\n                {isAiPrefilled\n                  ? \'\345\205\261\346\234\211\343\203\252\343\203\263\343\202\257\343\201\213\343\202\211AI\350\207\252\345\213\225\345\205\245\345\212\233\'\n                  : initialSpot && \'id\' in initialSpot\n                  ? \'\343\201\212\345\272\227\346\203\205\345\240\261\343\202\222\347\267\250\351\233\206\'\n                  : \'\346\226\260\343\201\227\343\201\204\343\201\212\343\201\231\343\201\231\343\202\201\345\272\227\343\202\222\350\250\230\351\214\262\'}\n              </h2>\n              {isAiPrefilled && (\n                <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-gradient-to-r from-rose-500 to-amber-500 text-white shadow-xs\">\n                  <Sparkles className=\"w-3 h-3\" />\n                  AI\350\247\243\346\236\220\346\270\210\343\201\277\n                </span>\n              )}\n            </div>\n            <p className=\"text-xs text-stone-500\">\n              {isAiPrefilled\n                ? \'AI\343\201\214\350\247\243\346\236\220\343\201\227\343\201\237\345\272\227\350\210\227\346\203\205\345\240\261\343\201\247\343\201\231\343\200\202\345\206\205\345\256\271\343\202\222\347\242\272\350\252\215\343\203\273\350\252\277\346\225\264\343\201\227\343\201\246\347\231\273\351\214\262\343\201\227\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\'\n                : \'\345\217\213\351\201\224\343\202\204\345\205\210\350\274\251\343\201\213\343\202\211\346\225\231\343\201\210\343\201\246\343\202\202\343\202\211\343\201\243\343\201\237\347\276\216\345\221\263\343\201\227\343\201\204\345\272\227\343\202\222\350\277\275\345\212\240\343\201\227\343\201\276\343\201\227\343\202\207\343\201\206\'}\n            </p>\n          </div>\n          <button\n            id=\"close-add-modal-btn\"\n            onClick={onClose}\n            className=\"p-2 rounded-full hover:bg-stone-100 text-stone-400 hover:text-stone-700 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Form Body */}\n        <form onSubmit={handleSubmit} className=\"p-6 overflow-y-auto space-y-6 flex-1\">\n          {/* Shop Name */}\n          <div className=\"space-y-1.5\">\n            <label className=\"block text-xs font-bold text-stone-700\">\n              \345\272\227\345\220\215 <span className=\"text-rose-500\">*</span>\n            </label>\n            <input\n              id=\"input-spot-name\"\n              type=\"text\"\n              placeholder=\"\344\276\213: BISTRO MARCHE \350\241\250\345\217\202\351\201\223\"\n              value={name}\n              onChange={(e) => setName(e.target.value)}\n              className={`w-full px-4 py-2.5 bg-white border ${\n                errors.name ? \'border-rose-400 ring-1 ring-rose-400\' : \'border-stone-200\'\n              } rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-400/30 focus:border-rose-400`}\n            />\n            {errors.name && <p className=\"text-xs text-rose-500\">{errors.name}</p>}\n          </div>\n\n          {/* Recommender */}\n          <div className=\"space-y-1.5\">\n            <label className=\"block text-xs font-bold text-stone-700 flex items-center gap-1\">\n              <UserCheck className=\"w-3.5 h-3.5 text-rose-500\" />\n              \347\264\271\344\273\213\343\201\227\343\201\246\343\201\217\343\202\214\343\201\237\344\272\272 <span className=\"text-rose-500\">*</span>\n            </label>\n            <input\n              id=\"input-spot-recommender\"\n              type=\"text\"\n              placeholder=\"\344\276\213: \343\202\274\343\203\237\343\201\256\343\201\276\343\202\212\343\201\252\345\205\210\350\274\251\343\200\201\351\253\230\346\240\241\343\201\256\345\217\213\351\201\224\343\201\276\343\201\204\343\200\201\343\203\220\343\202\244\343\203\210\345\272\227\351\225\267\"\n              value={recommender}\n              onChange={(e) => setRecommender(e.target.value)}\n              className={`w-full px-4 py-2.5 bg-white border ${\n                errors.recommender ? \'border-rose-400 ring-1 ring-rose-400\' : \'border-stone-200\'\n              } rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-400/30 focus:border-rose-400`}\n            />\n            {errors.recommender && <p className=\"text-xs text-rose-500\">{errors.recommender}</p>}\n          </div>\n\n          {/* Area */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-xs font-bold text-stone-700 flex items-center gap-1\">\n              <MapPin className=\"w-3.5 h-3.5 text-stone-500\" />\n              \343\202\250\343\203\252\343\202\242 <span className=\"text-rose-500\">*</span>\n            </label>\n            <div className=\"flex flex-wrap gap-1.5\">\n              {COMMON_AREAS.map((a) => (\n                <button\n                  key={a}\n                  type=\"button\"\n                  onClick={() => {\n                    setIsCustomArea(false);\n                    setArea(a);\n                  }}\n                  className={`px-3 py-1.5 rounded-xl text-xs font-semibold transition-all cursor-pointer ${\n                    !isCustomArea && area === a\n                      ? \'bg-rose-500 text-white shadow-sm shadow-rose-200\'\n                      : \'bg-white text-stone-600 border border-stone-200 hover:bg-stone-50\'\n                  }`}\n                >\n                  {a}\n                </button>\n              ))}\n              <button\n                type=\"button\"\n                onClick={() => setIsCustomArea(true)}\n                className={`px-3 py-1.5 rounded-xl text-xs font-semibold transition-all cursor-pointer ${\n                  isCustomArea\n                    ? \'bg-rose-500 text-white shadow-sm\'\n                    : \'bg-white text-stone-600 border border-dashed border-stone-300 hover:bg-stone-50\'\n                }`}\n              >\n                + \343\201\235\343\201\256\344\273\226\343\202\250\343\203\252\343\202\242\n              </button>\n            </div>\n            {isCustomArea && (\n              <input\n                id=\"input-custom-area\"\n                type=\"text\"\n                placeholder=\"\343\202\250\343\203\252\343\202\242\345\220\215\343\202\222\345\205\245\345\212\233\357\274\210\344\276\213: \345\220\211\347\245\245\345\257\272\343\200\201\351\216\214\345\200\211\343\200\201\344\270\211\350\273\222\350\214\266\345\261\213\357\274\211\"\n                value={customArea}\n                onChange={(e) => setCustomArea(e.target.value)}\n                className=\"mt-2 w-full px-4 py-2 bg-white border border-stone-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-400/30\"\n              />\n            )}\n            {errors.area && <p className=\"text-xs text-rose-500\">{errors.area}</p>}\n          </div>\n\n          {/* Price Range */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-xs font-bold text-stone-700 flex items-center gap-1\">\n              <Wallet className=\"w-3.5 h-3.5 text-stone-500\" />\n              \344\276\241\346\240\274\345\270\257\357\274\210\344\272\210\347\256\227\357\274\211 <span className=\"text-rose-500\">*</span>\n            </label>\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n              {ALL_PRICE_RANGES.map((price) => {\n                const isSelected = priceRange === price;\n                return (\n                  <button\n                    key={price}\n                    type=\"button\"\n                    onClick={() => setPriceRange(price)}\n                    className={`py-2.5 px-3 rounded-2xl text-xs font-bold text-center transition-all cursor-pointer border ${\n                      isSelected\n                        ? \'bg-stone-900 text-white border-stone-900 shadow-sm\'\n                        : \'bg-white text-stone-700 border-stone-200 hover:bg-stone-50\'\n                    }`}\n                  >\n                    {price}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Genres (Multi-select) */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-xs font-bold text-stone-700 flex items-center gap-1\">\n              <Tag className=\"w-3.5 h-3.5 text-stone-500\" />\n              \343\202\270\343\203\243\343\203\263\343\203\253\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211 <span className=\"text-rose-500\">*</span>\n            </label>\n            <div className=\"flex flex-wrap gap-1.5\">\n              {COMMON_GENRES.map((g) => {\n                const isSelected = genres.includes(g);\n                const style = getGenreStyle(g);\n                return (\n                  <button\n                    key={g}\n                    type=\"button\"\n                    onClick={() => handleToggleGenre(g)}\n                    className={`px-3 py-1.5 rounded-xl text-xs font-semibold transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-rose-600 text-white shadow-sm\'\n                        : `${style.bg} ${style.text} border ${style.border} hover:opacity-80`\n                    }`}\n                  >\n                    {g}\n                  </button>\n                );\n              })}\n            </div>\n\n            {/* Custom genre add */}\n            <div className=\"flex items-center gap-2 pt-1\">\n              <input\n                type=\"text\"\n                placeholder=\"\344\273\226\343\201\256\343\202\270\343\203\243\343\203\263\343\203\253\343\202\222\350\277\275\345\212\240\357\274\210\344\276\213: \343\203\231\343\203\274\343\202\253\343\203\252\343\203\274\357\274\211\"\n                value={customGenre}\n                onChange={(e) => setCustomGenre(e.target.value)}\n                onKeyDown={(e) => {\n                  if (e.key === \'Enter\') {\n                    e.preventDefault();\n                    handleAddCustomGenre(e);\n                  }\n                }}\n                className=\"px-3 py-1.5 bg-white border border-stone-200 rounded-xl text-xs flex-1 focus:outline-none focus:ring-1 focus:ring-rose-400\"\n              />\n              <button\n                type=\"button\"\n                onClick={handleAddCustomGenre}\n                className=\"px-3 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-bold rounded-xl\"\n              >\n                \350\277\275\345\212\240\n              </button>\n            </div>\n            {errors.genres && <p className=\"text-xs text-rose-500\">{errors.genres}</p>}\n          </div>\n\n          {/* Scenes (Multi-select) */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-xs font-bold text-stone-700 flex items-center gap-1\">\n              <Users2 className=\"w-3.5 h-3.5 text-stone-500\" />\n              \343\201\212\343\201\231\343\201\231\343\202\201\343\202\267\343\203\274\343\203\263\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211 <span className=\"text-rose-500\">*</span>\n            </label>\n            <div className=\"flex flex-wrap gap-1.5\">\n              {ALL_SCENES.map((scene) => {\n                const isSelected = scenes.includes(scene);\n                const style = getSceneStyle(scene);\n                return (\n                  <button\n                    key={scene}\n                    type=\"button\"\n                    onClick={() => handleToggleScene(scene)}\n                    className={`px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-rose-500 text-white font-bold shadow-sm shadow-rose-200 scale-105\'\n                        : `${style.bg} ${style.text} border ${style.border} hover:opacity-80`\n                    }`}\n                  >\n                    #{scene}\n                  </button>\n                );\n              })}\n            </div>\n            {errors.scenes && <p className=\"text-xs text-rose-500\">{errors.scenes}</p>}\n          </div>\n\n          {/* Highlight Dish */}\n          <div className=\"space-y-1.5\">\n            <label className=\"block text-xs font-bold text-stone-700 flex items-center gap-1\">\n              <Sparkles className=\"w-3.5 h-3.5 text-rose-500\" />\n              \346\216\250\343\201\227\343\203\241\343\203\213\343\203\245\343\203\274\343\203\273\351\240\274\343\202\200\343\201\271\343\201\215\344\270\200\345\223\201\357\274\210\344\273\273\346\204\217\357\274\211\n            </label>\n            <input\n              id=\"input-spot-highlight\"\n              type=\"text\"\n              placeholder=\"\344\276\213: \350\207\252\345\256\266\350\243\275\343\203\254\343\203\210\343\203\255\343\203\227\343\203\252\343\203\263\343\200\201\347\224\237\343\202\255\343\202\246\343\202\244\343\202\265\343\203\257\343\203\274\343\200\201\347\224\237\343\202\246\343\203\213\343\201\256\343\203\221\343\202\271\343\202\277\"\n              value={highlightDish}\n              onChange={(e) => setHighlightDish(e.target.value)}\n              className=\"w-full px-4 py-2.5 bg-white border border-stone-200 rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-400/30 focus:border-rose-400\"\n            />\n          </div>\n\n          {/* Comment */}\n          <div className=\"space-y-1.5\">\n            <label className=\"block text-xs font-bold text-stone-700 flex items-center gap-1\">\n              <MessageSquare className=\"w-3.5 h-3.5 text-stone-500\" />\n              \343\201\212\343\201\231\343\201\231\343\202\201\343\203\235\343\202\244\343\203\263\343\203\210\343\203\273\343\202\263\343\203\241\343\203\263\343\203\210 <span className=\"text-rose-500\">*</span>\n            </label>\n            <textarea\n              id=\"input-spot-comment\"\n              rows={3}\n              placeholder=\"\345\205\210\350\274\251\343\202\204\345\217\213\351\201\224\343\201\214\346\225\231\343\201\210\343\201\246\343\201\217\343\202\214\343\201\237\347\220\206\347\224\261\343\202\204\351\233\260\345\233\262\346\260\227\343\200\201\343\201\212\343\201\231\343\201\231\343\202\201\343\201\256\351\240\274\343\201\277\346\226\271\343\201\252\343\201\251...\"\n              value={comment}\n              onChange={(e) => setComment(e.target.value)}\n              className={`w-full px-4 py-2.5 bg-white border ${\n                errors.comment ? \'border-rose-400 ring-1 ring-rose-400\' : \'border-stone-200\'\n              } rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-400/30 focus:border-rose-400`}\n            />\n            {errors.comment && <p className=\"text-xs text-rose-500\">{errors.comment}</p>}\n          </div>\n\n          {/* Links Section: Google Maps & Tabelog with AI Auto-Search */}\n          <div className=\"bg-white rounded-3xl p-5 border border-stone-200/90 shadow-sm space-y-4\">\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2.5\">\n              <div>\n                <label className=\"block text-xs font-bold text-stone-900 flex items-center gap-1.5\">\n                  <Globe className=\"w-4 h-4 text-rose-500\" />\n                  <span>\345\272\227\350\210\227\343\203\252\343\203\263\343\202\257\357\274\210Google\343\203\236\343\203\203\343\203\227\343\203\273\351\243\237\343\201\271\343\203\255\343\202\260\357\274\211</span>\n                  <span className=\"text-[11px] text-stone-400 font-normal\">\357\274\210\344\273\273\346\204\217\357\274\211</span>\n                </label>\n                <p className=\"text-[11px] text-stone-500 mt-0.5\">\n                  \345\272\227\345\220\215\343\201\250\343\202\250\343\203\252\343\202\242\343\201\213\343\202\211\343\200\201Google\343\203\236\343\203\203\343\203\227\343\201\250\351\243\237\343\201\271\343\203\255\343\202\260\343\201\256URL\343\202\222AI\343\201\214\350\207\252\345\213\225\346\244\234\347\264\242\343\201\247\343\201\215\343\201\276\343\201\231\n                </p>\n              </div>\n\n              {/* Search Links with AI Button */}\n              <button\n                id=\"btn-ai-search-links\"\n                type=\"button\"\n                onClick={handleSearchLinks}\n                disabled={isSearchingLinks || !name.trim()}\n                className={`inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-2xl text-xs font-bold transition-all shadow-sm cursor-pointer shrink-0 ${\n                  isSearchingLinks\n                    ? \'bg-rose-100 text-rose-500 cursor-wait\'\n                    : !name.trim()\n                    ? \'bg-stone-100 text-stone-400 border border-stone-200 cursor-not-allowed\'\n                    : \'bg-gradient-to-r from-rose-500 to-amber-500 hover:from-rose-600 hover:to-amber-600 text-white active:scale-95 shadow-rose-200\'\n                }`}\n                title={!name.trim() ? \'\345\272\227\345\220\215\343\202\222\345\205\245\345\212\233\343\201\231\343\202\213\343\201\250\346\244\234\347\264\242\343\201\247\343\201\215\343\201\276\343\201\231\' : \'Google\343\203\236\343\203\203\343\203\227\343\201\250\351\243\237\343\201\271\343\203\255\343\202\260\343\201\256URL\343\202\222AI\343\201\247\350\207\252\345\213\225\346\244\234\347\264\242\'}\n              >\n                {isSearchingLinks ? (\n                  <>\n                    <div className=\"w-3.5 h-3.5 border-2 border-rose-500 border-t-transparent rounded-full animate-spin\" />\n                    <span>AI\343\201\214\343\203\252\343\203\263\343\202\257\346\244\234\347\264\242\344\270\255...</span>\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-3.5 h-3.5 text-amber-200\" />\n                    <span>AI\343\201\247\343\203\252\343\203\263\343\202\257\343\202\222\346\244\234\347\264\242</span>\n                  </>\n                )}\n              </button>\n            </div>\n\n            {/* Error or Warning Notice */}\n            {searchError && (\n              <div className=\"flex items-start gap-2 p-3 rounded-2xl bg-amber-50 border border-amber-200 text-amber-800 text-xs animate-in fade-in\">\n                <AlertCircle className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n                <span className=\"flex-1 leading-relaxed\">{searchError}</span>\n              </div>\n            )}\n\n            {/* AI Candidates Results Box */}\n            {hasSearched && linkCandidates.length > 0 && (\n              <div className=\"p-4 rounded-2xl bg-gradient-to-br from-rose-50/70 via-amber-50/40 to-stone-50 border border-rose-200/80 space-y-3 animate-in fade-in zoom-in-98 duration-200\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-rose-500 text-white shadow-xs\">\n                      <Sparkles className=\"w-3 h-3\" />\n                      AI\346\244\234\347\264\242\347\265\220\346\236\234\n                    </span>\n                    <span className=\"text-xs font-bold text-stone-800\">\n                      \345\200\231\350\243\234\343\201\214\350\246\213\343\201\244\343\201\213\343\202\212\343\201\276\343\201\227\343\201\237\357\274\210{linkCandidates.length}\344\273\266\357\274\211\n                    </span>\n                  </div>\n                  <span className=\"text-[10px] text-stone-500\">\n                    \343\202\277\343\203\203\343\203\227\343\201\227\343\201\246URL\343\202\222\343\203\225\343\202\251\343\203\274\343\203\240\343\201\253\345\217\215\346\230\240\n                  </span>\n                </div>\n\n                <div className=\"space-y-2.5\">\n                  {linkCandidates.map((candidate, idx) => {\n                    const isApplied = appliedCandidateId === candidate.id;\n                    return (\n                      <div\n                        key={candidate.id || idx}\n                        id={`ai-candidate-${candidate.id}`}\n                        className={`p-3.5 rounded-2xl bg-white border transition-all ${\n                          isApplied\n                            ? \'border-emerald-500 ring-2 ring-emerald-500/20 shadow-sm\'\n                            : \'border-stone-200 hover:border-rose-300 shadow-xs\'\n                        }`}\n                      >\n                        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                          <div>\n                            <div className=\"flex items-center gap-2\">\n                              <h4 className=\"text-xs font-bold text-stone-900\">\n                                {candidate.title}\n                              </h4>\n                              {candidate.sourceType === \'ai_grounded\' && (\n                                <span className=\"text-[10px] bg-emerald-50 text-emerald-700 font-semibold px-2 py-0.2 rounded-full border border-emerald-200\">\n                                  WEB\347\205\247\345\220\210\346\270\210\n                                </span>\n                              )}\n                            </div>\n                            {candidate.address && (\n                              <p className=\"text-[11px] text-stone-500 mt-0.5 flex items-center gap-1\">\n                                <MapPin className=\"w-3 h-3 text-rose-400 shrink-0\" />\n                                <span className=\"truncate\">{candidate.address}</span>\n                              </p>\n                            )}\n                            {candidate.description && (\n                              <p className=\"text-[11px] text-stone-600 mt-1 line-clamp-2 leading-relaxed\">\n                                {candidate.description}\n                              </p>\n                            )}\n                          </div>\n\n                          {/* Action button to apply both */}\n                          <div className=\"flex items-center gap-1.5 shrink-0 self-end sm:self-center\">\n                            <button\n                              id={`apply-candidate-${candidate.id}`}\n                              type=\"button\"\n                              onClick={() => handleApplyCandidate(candidate, \'both\')}\n                              className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer ${\n                                isApplied\n                                  ? \'bg-emerald-600 text-white shadow-xs\'\n                                  : \'bg-stone-900 hover:bg-rose-600 text-white shadow-xs active:scale-95\'\n                              }`}\n                            >\n                              {isApplied ? (\n                                <>\n                                  <Check className=\"w-3.5 h-3.5\" />\n                                  <span>\345\217\215\346\230\240\345\256\214\344\272\206</span>\n                                </>\n                              ) : (\n                                <>\n                                  <Check className=\"w-3.5 h-3.5\" />\n                                  <span>\343\201\223\343\201\256\345\200\231\350\243\234\343\202\222\345\217\215\346\230\240</span>\n                                </>\n                              )}\n                            </button>\n                          </div>\n                        </div>\n\n                        {/* Direct link previews inside candidate */}\n                        <div className=\"mt-3 pt-2.5 border-t border-stone-100 flex flex-wrap items-center gap-2 text-[11px]\">\n                          {/* Google Maps link preview */}\n                          {candidate.googleMapsUrl && (\n                            <div className=\"inline-flex items-center gap-1 bg-stone-50 hover:bg-stone-100 border border-stone-200 rounded-xl px-2.5 py-1\">\n                              <Compass className=\"w-3 h-3 text-rose-500 shrink-0\" />\n                              <span className=\"font-semibold text-stone-700\">Google\343\203\236\343\203\203\343\203\227:</span>\n                              <a\n                                href={candidate.googleMapsUrl}\n                                target=\"_blank\"\n                                rel=\"noopener noreferrer\"\n                                className=\"text-rose-600 hover:underline flex items-center gap-0.5 max-w-[130px] truncate\"\n                              >\n                                <span>\347\242\272\350\252\215</span>\n                                <ExternalLink className=\"w-2.5 h-2.5\" />\n                              </a>\n                              <button\n                                type=\"button\"\n                                onClick={() => handleApplyCandidate(candidate, \'map\')}\n                                className=\"ml-1 text-[10px] text-stone-500 hover:text-stone-900 underline cursor-pointer\"\n                                title=\"Google\343\203\236\343\203\203\343\203\227URL\343\201\256\343\201\277\345\217\215\346\230\240\"\n                              >\n                                \343\203\236\343\203\203\343\203\227\343\201\256\343\201\277\n                              </button>\n                            </div>\n                          )}\n\n                          {/* Tabelog link preview */}\n                          {candidate.tabelogUrl && (\n                            <div className=\"inline-flex items-center gap-1 bg-amber-50/70 hover:bg-amber-100/80 border border-amber-200 rounded-xl px-2.5 py-1\">\n                              <Utensils className=\"w-3 h-3 text-amber-600 shrink-0\" />\n                              <span className=\"font-semibold text-stone-700\">\351\243\237\343\201\271\343\203\255\343\202\260:</span>\n                              <a\n                                href={candidate.tabelogUrl}\n                                target=\"_blank\"\n                                rel=\"noopener noreferrer\"\n                                className=\"text-amber-700 hover:underline flex items-center gap-0.5 max-w-[130px] truncate font-medium\"\n                              >\n                                <span>\347\242\272\350\252\215</span>\n                                <ExternalLink className=\"w-2.5 h-2.5\" />\n                              </a>\n                              <button\n                                type=\"button\"\n                                onClick={() => handleApplyCandidate(candidate, \'tabelog\')}\n                                className=\"ml-1 text-[10px] text-stone-500 hover:text-stone-900 underline cursor-pointer\"\n                                title=\"\351\243\237\343\201\271\343\203\255\343\202\260URL\343\201\256\343\201\277\345\217\215\346\230\240\"\n                              >\n                                \351\243\237\343\201\271\343\203\255\343\202\260\343\201\256\343\201\277\n                              </button>\n                            </div>\n                          )}\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            )}\n\n            {/* If searched and 0 candidates */}\n            {hasSearched && linkCandidates.length === 0 && !isSearchingLinks && (\n              <div className=\"p-3.5 rounded-2xl bg-stone-50 border border-stone-200 text-center space-y-1\">\n                <p className=\"text-xs font-bold text-stone-700\">\n                  \350\251\262\345\275\223\343\201\231\343\202\213URL\343\201\214\350\246\213\343\201\244\343\201\213\343\202\212\343\201\276\343\201\233\343\202\223\343\201\247\343\201\227\343\201\237\n                </p>\n                <p className=\"text-[11px] text-stone-500\">\n                  \344\270\213\343\201\256\345\205\245\345\212\233\346\254\204\343\201\253Google\343\203\236\343\203\203\343\203\227\343\202\204\351\243\237\343\201\271\343\203\255\343\202\260\343\201\256URL\343\202\222\346\211\213\345\213\225\343\201\247\350\262\274\343\202\212\344\273\230\343\201\221\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\n                </p>\n              </div>\n            )}\n\n            {/* Manual URL Input Fields */}\n            <div className=\"space-y-3 pt-1\">\n              {/* Google Map Link Input */}\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"text-xs font-bold text-stone-700 flex items-center gap-1\">\n                    <Compass className=\"w-3.5 h-3.5 text-rose-500\" />\n                    <span>Google\343\203\236\343\203\203\343\203\227\343\201\256URL</span>\n                  </label>\n                  {mapUrl && (\n                    <div className=\"flex items-center gap-2\">\n                      <a\n                        href={mapUrl}\n                        target=\"_blank\"\n                        rel=\"noopener noreferrer\"\n                        className=\"text-[11px] font-semibold text-rose-600 hover:underline flex items-center gap-0.5\"\n                      >\n                        <span>\343\203\252\343\203\263\343\202\257\343\202\222\351\226\213\343\201\204\343\201\246\347\242\272\350\252\215</span>\n                        <ExternalLink className=\"w-3 h-3\" />\n                      </a>\n                      <button\n                        type=\"button\"\n                        onClick={() => setMapUrl(\'\')}\n                        className=\"text-[11px] text-stone-400 hover:text-stone-600 cursor-pointer\"\n                      >\n                        \343\202\257\343\203\252\343\202\242\n                      </button>\n                    </div>\n                  )}\n                </div>\n                <input\n                  id=\"input-spot-map\"\n                  type=\"url\"\n                  placeholder=\"https://maps.app.goo.gl/... \343\201\276\343\201\237\343\201\257 Google Map \343\201\256\345\205\261\346\234\211URL\"\n                  value={mapUrl}\n                  onChange={(e) => setMapUrl(e.target.value)}\n                  className=\"w-full px-4 py-2.5 bg-white border border-stone-200 rounded-2xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-rose-400/30 focus:border-rose-400\"\n                />\n              </div>\n\n              {/* Tabelog Link Input */}\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"text-xs font-bold text-stone-700 flex items-center gap-1\">\n                    <Utensils className=\"w-3.5 h-3.5 text-amber-600\" />\n                    <span>\351\243\237\343\201\271\343\203\255\343\202\260\343\201\256URL</span>\n                  </label>\n                  {tabelogUrl && (\n                    <div className=\"flex items-center gap-2\">\n                      <a\n                        href={tabelogUrl}\n                        target=\"_blank\"\n                        rel=\"noopener noreferrer\"\n                        className=\"text-[11px] font-semibold text-amber-700 hover:underline flex items-center gap-0.5\"\n                      >\n                        <span>\343\203\252\343\203\263\343\202\257\343\202\222\351\226\213\343\201\204\343\201\246\347\242\272\350\252\215</span>\n                        <ExternalLink className=\"w-3 h-3\" />\n                      </a>\n                      <button\n                        type=\"button\"\n                        onClick={() => setTabelogUrl(\'\')}\n                        className=\"text-[11px] text-stone-400 hover:text-stone-600 cursor-pointer\"\n                      >\n                        \343\202\257\343\203\252\343\202\242\n                      </button>\n                    </div>\n                  )}\n                </div>\n                <input\n                  id=\"input-spot-tabelog\"\n                  type=\"url\"\n                  placeholder=\"https://tabelog.com/... \343\201\276\343\201\237\343\201\257\345\272\227\350\210\227\343\201\256\351\243\237\343\201\271\343\203\255\343\202\260URL\"\n                  value={tabelogUrl}\n                  onChange={(e) => setTabelogUrl(e.target.value)}\n                  className=\"w-full px-4 py-2.5 bg-white border border-stone-200 rounded-2xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-amber-400/30 focus:border-amber-400\"\n                />\n              </div>\n\n              <p className=\"text-[10px] text-stone-400 leading-relaxed\">\n                \342\200\273 \350\207\252\345\213\225\346\244\234\347\264\242\343\201\257\345\200\231\350\243\234\346\217\220\346\241\210\343\201\256\350\243\234\345\212\251\346\251\237\350\203\275\343\201\247\343\201\231\343\200\202\347\233\264\346\216\245URL\343\202\222\345\205\245\345\212\233\343\203\273\345\244\211\346\233\264\343\201\231\343\202\213\343\201\223\343\201\250\343\202\202\345\217\257\350\203\275\343\201\247\343\201\231\343\200\202\n              </p>\n            </div>\n          </div>\n\n          {/* Image Selection */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-xs font-bold text-stone-700 flex items-center gap-1\">\n              <ImageIcon className=\"w-3.5 h-3.5 text-stone-500\" />\n              \343\202\244\343\203\241\343\203\274\343\202\270\345\206\231\347\234\237\n            </label>\n            <div className=\"grid grid-cols-4 gap-2\">\n              {PRESET_IMAGES.map((preset) => (\n                <button\n                  key={preset.label}\n                  type=\"button\"\n                  onClick={() => {\n                    setIsCustomImage(false);\n                    setImageUrl(preset.url);\n                  }}\n                  className={`group relative aspect-[4/3] rounded-xl overflow-hidden border-2 transition-all cursor-pointer ${\n                    !isCustomImage && imageUrl === preset.url\n                      ? \'border-rose-500 ring-2 ring-rose-400/30\'\n                      : \'border-transparent opacity-70 hover:opacity-100\'\n                  }`}\n                >\n                  <img\n                    src={preset.url}\n                    alt={preset.label}\n                    className=\"w-full h-full object-cover\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                  <div className=\"absolute inset-0 bg-black/30 flex items-center justify-center p-1\">\n                    <span className=\"text-[10px] font-bold text-white text-center leading-tight\">\n                      {preset.label}\n                    </span>\n                  </div>\n                </button>\n              ))}\n            </div>\n\n            {/* Custom image URL toggle */}\n            <div className=\"pt-1\">\n              <button\n                type=\"button\"\n                onClick={() => setIsCustomImage(!isCustomImage)}\n                className=\"text-xs font-semibold text-rose-600 hover:text-rose-700 cursor-pointer\"\n              >\n                {isCustomImage ? \'\342\206\220 \343\203\227\343\203\252\343\202\273\343\203\203\343\203\210\343\201\213\343\202\211\351\201\270\343\201\266\' : \'+ \347\224\273\345\203\217URL\343\202\222\347\233\264\346\216\245\346\214\207\345\256\232\343\201\231\343\202\213\'}\n              </button>\n              {isCustomImage && (\n                <input\n                  type=\"url\"\n                  placeholder=\"https://... \347\224\273\345\203\217URL\"\n                  value={imageUrl}\n                  onChange={(e) => setImageUrl(e.target.value)}\n                  className=\"mt-2 w-full px-4 py-2 bg-white border border-stone-200 rounded-xl text-xs focus:outline-none focus:ring-1 focus:ring-rose-400\"\n                />\n              )}\n            </div>\n          </div>\n\n          {/* Visit Status & My Experience Memo Section */}\n          <div className=\"bg-stone-50/90 rounded-2xl p-4 sm:p-5 border border-stone-200/80 space-y-4\">\n            <div className=\"space-y-2\">\n              <label className=\"block text-xs font-bold text-stone-700\">\n                \350\250\252\345\225\217\343\202\271\343\203\206\343\203\274\343\202\277\343\202\271\n              </label>\n              <div className=\"grid grid-cols-2 gap-2\">\n                <button\n                  type=\"button\"\n                  id=\"status-choice-unvisited\"\n                  onClick={() => setIsVisited(false)}\n                  className={`flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs font-bold transition-all cursor-pointer border ${\n                    !isVisited\n                      ? \'bg-amber-400 text-stone-950 border-amber-400 shadow-sm\'\n                      : \'bg-white text-stone-600 border-stone-200 hover:bg-stone-50\'\n                  }`}\n                >\n                  <Bookmark className=\"w-4 h-4 stroke-[2.5]\" />\n                  <span>\350\241\214\343\201\215\343\201\237\343\201\204 (\346\234\252\350\250\252\345\225\217)</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  id=\"status-choice-visited\"\n                  onClick={() => setIsVisited(true)}\n                  className={`flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs font-bold transition-all cursor-pointer border ${\n                    isVisited\n                      ? \'bg-emerald-600 text-white border-emerald-600 shadow-sm\'\n                      : \'bg-white text-stone-600 border-stone-200 hover:bg-stone-50\'\n                  }`}\n                >\n                  <CheckCircle2 className=\"w-4 h-4 stroke-[2.5]\" />\n                  <span>\350\241\214\343\201\243\343\201\237 (\350\250\252\345\225\217\346\270\210\343\201\277)</span>\n                </button>\n              </div>\n            </div>\n\n            {/* If visited, show date & myMemo */}\n            {isVisited && (\n              <div className=\"space-y-3 pt-2 border-t border-stone-200/60 animate-in fade-in duration-150\">\n                <div className=\"space-y-1\">\n                  <label className=\"block text-xs font-bold text-stone-700\">\n                    \350\250\252\345\225\217\346\227\245\357\274\210\344\273\273\346\204\217\357\274\211\n                  </label>\n                  <input\n                    id=\"input-form-visited-at\"\n                    type=\"date\"\n                    value={visitedAt}\n                    onChange={(e) => setVisitedAt(e.target.value)}\n                    className=\"w-full px-3 py-2 bg-white border border-stone-200 rounded-xl text-xs text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-500/30\"\n                  />\n                </div>\n\n                <div className=\"space-y-1\">\n                  <label className=\"block text-xs font-bold text-stone-700 flex items-center gap-1\">\n                    <MessageSquareHeart className=\"w-3.5 h-3.5 text-emerald-600\" />\n                    \350\207\252\345\210\206\343\201\256\346\204\237\346\203\263\343\203\273\350\250\252\345\225\217\343\203\241\343\203\242\357\274\210\344\273\273\346\204\217\357\274\211\n                  </label>\n                  <textarea\n                    id=\"input-form-my-memo\"\n                    rows={2}\n                    placeholder=\"\345\256\237\351\232\233\343\201\253\350\241\214\343\201\243\343\201\246\343\201\277\343\201\246\343\201\251\343\201\206\343\201\240\343\201\243\343\201\237\343\201\213\343\200\201\346\263\250\346\226\207\343\201\227\343\201\237\343\202\202\343\201\256\343\202\204\346\204\237\346\203\263\343\202\222\350\250\230\351\214\262...\"\n                    value={myMemo}\n                    onChange={(e) => setMyMemo(e.target.value)}\n                    className=\"w-full px-3 py-2 bg-white border border-stone-200 rounded-xl text-xs text-stone-800 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 resize-none\"\n                  />\n                </div>\n              </div>\n            )}\n\n            {/* Favorite toggle option */}\n            <div className=\"pt-2 border-t border-stone-200/60 flex items-center justify-between\">\n              <span className=\"text-xs font-bold text-stone-700 flex items-center gap-1.5\">\n                <Heart className={`w-3.5 h-3.5 ${isFavorite ? \'text-rose-500 fill-rose-500\' : \'text-stone-400\'}`} />\n                \343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\253\350\277\275\345\212\240\343\201\231\343\202\213\n              </span>\n              <button\n                type=\"button\"\n                onClick={() => setIsFavorite(!isFavorite)}\n                className={`w-11 h-6 flex items-center rounded-full p-1 transition-colors cursor-pointer ${\n                  isFavorite ? \'bg-rose-500\' : \'bg-stone-300\'\n                }`}\n              >\n                <div\n                  className={`bg-white w-4 h-4 rounded-full shadow-md transform transition-transform ${\n                    isFavorite ? \'translate-x-5\' : \'translate-x-0\'\n                  }`}\n                />\n              </button>\n            </div>\n          </div>\n\n          {/* \360\237\224\222 Private Memo Section (\350\207\252\345\210\206\345\260\202\347\224\250\351\235\236\345\205\254\351\226\213\343\203\241\343\203\242) */}\n          <div className=\"bg-stone-900/5 rounded-2xl p-4 sm:p-5 border border-stone-300/70 space-y-2.5\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"text-xs font-bold text-stone-800 flex items-center gap-1.5\">\n                <Lock className=\"w-3.5 h-3.5 text-stone-700\" />\n                <span>\360\237\224\222 \350\207\252\345\210\206\345\260\202\347\224\250\343\203\273\351\235\236\345\205\254\351\226\213\343\203\241\343\203\242\357\274\210\344\273\273\346\204\217\357\274\211</span>\n              </label>\n              <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-stone-200 font-bold text-stone-600\">\n                \351\235\236\345\205\254\351\226\213\343\203\273\345\205\261\346\234\211\343\201\225\343\202\214\343\201\276\343\201\233\343\202\223\n              </span>\n            </div>\n            <textarea\n              id=\"input-form-private-memo\"\n              rows={2}\n              placeholder=\"\344\276\213: \344\272\210\347\256\2272\344\272\272\343\201\2478,000\345\206\206\343\200\202\343\200\207\343\200\207\343\201\225\343\202\223\343\201\250\350\241\214\343\201\243\343\201\237\343\200\202\343\202\253\343\202\246\343\203\263\343\202\277\343\203\274\345\270\255\343\201\214\343\201\212\343\201\231\343\201\231\343\202\201\343\200\202\"\n              value={privateMemo}\n              onChange={(e) => setPrivateMemo(e.target.value)}\n              className=\"w-full px-3.5 py-2.5 bg-white border border-stone-300 rounded-xl text-xs text-stone-800 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-400 resize-none\"\n            />\n          </div>\n\n          {/* \360\237\223\201 Folder Classification Section */}\n          {availableFolders.length > 0 && (\n            <div className=\"space-y-2\">\n              <label className=\"block text-xs font-bold text-stone-700 flex items-center gap-1\">\n                <FolderOpen className=\"w-3.5 h-3.5 text-rose-500\" />\n                <span>\346\211\200\345\261\236\343\203\225\343\202\251\343\203\253\343\203\200\343\203\273\343\203\252\343\202\271\343\203\210\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211</span>\n              </label>\n              <div className=\"flex flex-wrap gap-2\">\n                {availableFolders.map((folder) => {\n                  const isSelected = selectedFolders.includes(folder.name);\n                  return (\n                    <button\n                      type=\"button\"\n                      key={folder.id}\n                      onClick={() => {\n                        if (isSelected) {\n                          setSelectedFolders(selectedFolders.filter((f) => f !== folder.name));\n                        } else {\n                          setSelectedFolders([...selectedFolders, folder.name]);\n                        }\n                      }}\n                      className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer border ${\n                        isSelected\n                          ? \'bg-rose-500 text-white border-rose-600 shadow-2xs\'\n                          : \'bg-white text-stone-700 border-stone-200 hover:bg-stone-50\'\n                      }`}\n                    >\n                      <span>{isSelected ? \'\342\234\223 \' : \'+ \'}</span>\n                      <span>{folder.name}</span>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          )}\n\n          {/* \360\237\217\252 Store Operating Status Selector */}\n          <div className=\"space-y-2 bg-stone-50/80 p-3.5 rounded-2xl border border-stone-200/80\">\n            <label className=\"block text-xs font-bold text-stone-700 flex items-center gap-1\">\n              <Store className=\"w-3.5 h-3.5 text-stone-600\" />\n              <span>\345\272\227\350\210\227\343\201\256\345\226\266\346\245\255\343\202\271\343\203\206\343\203\274\343\202\277\343\202\271</span>\n            </label>\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n              {[\n                { val: \'open\', label: \'\351\200\232\345\270\270\345\226\266\346\245\255\344\270\255\', color: \'bg-emerald-50 text-emerald-700 border-emerald-200\' },\n                { val: \'permanently_closed\', label: \'\351\226\211\345\272\227\343\203\273\351\226\211\346\245\255\', color: \'bg-red-50 text-red-700 border-red-200\' },\n                { val: \'temporarily_closed\', label: \'\344\274\221\346\245\255\344\270\255\', color: \'bg-amber-50 text-amber-700 border-amber-200\' },\n                { val: \'moved\', label: \'\347\247\273\350\273\242\346\270\210\', color: \'bg-indigo-50 text-indigo-700 border-indigo-200\' },\n              ].map((opt) => (\n                <button\n                  type=\"button\"\n                  key={opt.val}\n                  onClick={() => setOperatingStatus(opt.val as OperatingStatus)}\n                  className={`py-2 px-2.5 rounded-xl text-xs font-bold border transition-all cursor-pointer ${\n                    operatingStatus === opt.val\n                      ? \'bg-stone-900 text-white border-stone-900 shadow-2xs\'\n                      : `${opt.color} hover:opacity-80`\n                  }`}\n                >\n                  {opt.label}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Submit Button */}\n          <div className=\"pt-3\">\n            <button\n              id=\"submit-spot-btn\"\n              type=\"submit\"\n              className=\"w-full py-3.5 rounded-2xl bg-gradient-to-r from-stone-900 to-rose-950 hover:from-rose-600 hover:to-pink-600 text-white font-bold text-sm shadow-md transition-all active:scale-98 cursor-pointer\"\n            >\n              {initialSpot ? \'\345\244\211\346\233\264\343\202\222\344\277\235\345\255\230\343\201\231\343\202\213\' : \'\343\201\212\343\201\231\343\201\231\343\202\201\345\272\227\343\202\222\347\231\273\351\214\262\343\201\231\343\202\213 \342\234\250\'}\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );"
      replacement_content: "  return (\n    <div\n      id=\"add-spot-modal-backdrop\"\n      className=\"fixed inset-0 z-50 bg-stone-950/70 backdrop-blur-xs flex items-center justify-center p-3 sm:p-5 overflow-y-auto\"\n      onClick={onClose}\n    >\n      <div\n        id=\"add-spot-modal-content\"\n        className=\"bg-white rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl border border-stone-200 my-auto max-h-[92vh] flex flex-col animate-in zoom-in-95 duration-150\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Header */}\n        <div className=\"px-5 py-4 border-b border-stone-200 bg-white flex items-center justify-between sticky top-0 z-10\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h2 className=\"text-base font-bold text-stone-900\">\n                {isAiPrefilled\n                  ? \'\345\205\261\346\234\211\343\203\252\343\203\263\343\202\257\343\201\213\343\202\211AI\350\207\252\345\213\225\345\205\245\345\212\233\'\n                  : initialSpot && \'id\' in initialSpot\n                  ? \'\345\272\227\350\210\227\346\203\205\345\240\261\343\202\222\347\267\250\351\233\206\'\n                  : \'\343\201\212\343\201\231\343\201\231\343\202\201\345\272\227\343\202\222\347\231\273\351\214\262\'}\n              </h2>\n              {isAiPrefilled && (\n                <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-stone-900 text-white\">\n                  <Sparkles className=\"w-3 h-3 text-orange-400\" />\n                  AI\350\247\243\346\236\220\346\270\210\343\201\277\n                </span>\n              )}\n            </div>\n            <p className=\"text-xs text-stone-500 mt-0.5\">\n              {isAiPrefilled\n                ? \'AI\343\201\214\350\247\243\346\236\220\343\201\227\343\201\237\345\272\227\350\210\227\346\203\205\345\240\261\343\201\247\343\201\231\343\200\202\345\206\205\345\256\271\343\202\222\347\242\272\350\252\215\343\203\273\350\252\277\346\225\264\343\201\227\343\201\246\347\231\273\351\214\262\343\201\227\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\'\n                : \'\343\201\212\343\201\231\343\201\231\343\202\201\343\201\225\343\202\214\343\201\237\347\276\216\345\221\263\343\201\227\343\201\204\343\201\212\345\272\227\343\201\256\346\203\205\345\240\261\343\202\222\350\250\230\351\214\262\343\201\227\343\201\276\343\201\231\'}\n            </p>\n          </div>\n          <button\n            id=\"close-add-modal-btn\"\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg hover:bg-stone-100 text-stone-400 hover:text-stone-700 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Form Body */}\n        <form onSubmit={handleSubmit} className=\"p-5 sm:p-6 overflow-y-auto space-y-5 flex-1\">\n          {/* Shop Name */}\n          <div className=\"space-y-1.5\">\n            <label className=\"block text-xs font-semibold text-stone-700\">\n              \345\272\227\345\220\215 <span className=\"text-orange-600\">*</span>\n            </label>\n            <input\n              id=\"input-spot-name\"\n              type=\"text\"\n              placeholder=\"\344\276\213: BISTRO MARCHE \350\241\250\345\217\202\351\201\223\"\n              value={name}\n              onChange={(e) => setName(e.target.value)}\n              className={`w-full px-3.5 py-2 bg-white border ${\n                errors.name ? \'border-orange-500 ring-1 ring-orange-500\' : \'border-stone-200\'\n              } rounded-lg text-sm focus:outline-none focus:border-stone-900`}\n            />\n            {errors.name && <p className=\"text-xs text-orange-600\">{errors.name}</p>}\n          </div>\n\n          {/* Recommender */}\n          <div className=\"space-y-1.5\">\n            <label className=\"block text-xs font-semibold text-stone-700 flex items-center gap-1\">\n              <UserCheck className=\"w-3.5 h-3.5 text-stone-500\" />\n              \343\201\212\343\201\231\343\201\231\343\202\201\343\201\227\343\201\246\343\201\217\343\202\214\343\201\237\344\272\272 <span className=\"text-orange-600\">*</span>\n            </label>\n            <input\n              id=\"input-spot-recommender\"\n              type=\"text\"\n              placeholder=\"\344\276\213: \343\201\276\343\202\212\343\201\252\345\205\210\350\274\251\343\200\201\345\217\213\344\272\272\343\201\276\343\201\204\343\200\201\343\203\220\343\202\244\343\203\210\345\272\227\351\225\267\"\n              value={recommender}\n              onChange={(e) => setRecommender(e.target.value)}\n              className={`w-full px-3.5 py-2 bg-white border ${\n                errors.recommender ? \'border-orange-500 ring-1 ring-orange-500\' : \'border-stone-200\'\n              } rounded-lg text-sm focus:outline-none focus:border-stone-900`}\n            />\n            {errors.recommender && <p className=\"text-xs text-orange-600\">{errors.recommender}</p>}\n          </div>\n\n          {/* Area */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-xs font-semibold text-stone-700 flex items-center gap-1\">\n              <MapPin className=\"w-3.5 h-3.5 text-stone-500\" />\n              \343\202\250\343\203\252\343\202\242 <span className=\"text-orange-600\">*</span>\n            </label>\n            <div className=\"flex flex-wrap gap-1.5\">\n              {COMMON_AREAS.map((a) => (\n                <button\n                  key={a}\n                  type=\"button\"\n                  onClick={() => {\n                    setIsCustomArea(false);\n                    setArea(a);\n                  }}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\n                    !isCustomArea && area === a\n                      ? \'bg-stone-900 text-white shadow-xs\'\n                      : \'bg-stone-100 text-stone-600 hover:bg-stone-200 border border-stone-200/60\'\n                  }`}\n                >\n                  {a}\n                </button>\n              ))}\n              <button\n                type=\"button\"\n                onClick={() => setIsCustomArea(true)}\n                className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\n                  isCustomArea\n                    ? \'bg-stone-900 text-white\'\n                    : \'bg-white text-stone-500 border border-dashed border-stone-300 hover:bg-stone-50\'\n                }`}\n              >\n                + \343\201\235\343\201\256\344\273\226\343\202\250\343\203\252\343\202\242\n              </button>\n            </div>\n            {isCustomArea && (\n              <input\n                id=\"input-custom-area\"\n                type=\"text\"\n                placeholder=\"\343\202\250\343\203\252\343\202\242\345\220\215\343\202\222\345\205\245\345\212\233\357\274\210\344\276\213: \345\220\211\347\245\245\345\257\272\343\200\201\351\216\214\345\200\211\343\200\201\344\270\211\350\273\222\350\214\266\345\261\213\357\274\211\"\n                value={customArea}\n                onChange={(e) => setCustomArea(e.target.value)}\n                className=\"mt-2 w-full px-3.5 py-2 bg-white border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-stone-900\"\n              />\n            )}\n            {errors.area && <p className=\"text-xs text-orange-600\">{errors.area}</p>}\n          </div>\n\n          {/* Price Range */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-xs font-semibold text-stone-700 flex items-center gap-1\">\n              <Wallet className=\"w-3.5 h-3.5 text-stone-500\" />\n              \344\272\210\347\256\227\343\203\273\344\276\241\346\240\274\345\270\257 <span className=\"text-orange-600\">*</span>\n            </label>\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n              {ALL_PRICE_RANGES.map((price) => {\n                const isSelected = priceRange === price;\n                return (\n                  <button\n                    key={price}\n                    type=\"button\"\n                    onClick={() => setPriceRange(price)}\n                    className={`py-2 px-3 rounded-lg text-xs font-semibold text-center transition-all cursor-pointer border ${\n                      isSelected\n                        ? \'bg-stone-900 text-white border-stone-900 shadow-xs\'\n                        : \'bg-white text-stone-700 border-stone-200 hover:bg-stone-50\'\n                    }`}\n                  >\n                    {price}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Genres (Multi-select) */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-xs font-semibold text-stone-700 flex items-center gap-1\">\n              <Tag className=\"w-3.5 h-3.5 text-stone-500\" />\n              \343\202\270\343\203\243\343\203\263\343\203\253\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211 <span className=\"text-orange-600\">*</span>\n            </label>\n            <div className=\"flex flex-wrap gap-1.5\">\n              {COMMON_GENRES.map((g) => {\n                const isSelected = genres.includes(g);\n                return (\n                  <button\n                    key={g}\n                    type=\"button\"\n                    onClick={() => handleToggleGenre(g)}\n                    className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer border ${\n                      isSelected\n                        ? \'bg-stone-900 text-white border-stone-900 shadow-xs\'\n                        : \'bg-stone-100 text-stone-700 border-stone-200/80 hover:bg-stone-200\'\n                    }`}\n                  >\n                    {g}\n                  </button>\n                );\n              })}\n            </div>\n\n            {/* Custom genre add */}\n            <div className=\"flex items-center gap-2 pt-1\">\n              <input\n                type=\"text\"\n                placeholder=\"\344\273\226\343\201\256\343\202\270\343\203\243\343\203\263\343\203\253\343\202\222\350\277\275\345\212\240\357\274\210\344\276\213: \343\203\231\343\203\274\343\202\253\343\203\252\343\203\274\357\274\211\"\n                value={customGenre}\n                onChange={(e) => setCustomGenre(e.target.value)}\n                onKeyDown={(e) => {\n                  if (e.key === \'Enter\') {\n                    e.preventDefault();\n                    handleAddCustomGenre(e);\n                  }\n                }}\n                className=\"px-3 py-1.5 bg-white border border-stone-200 rounded-lg text-xs flex-1 focus:outline-none focus:border-stone-900\"\n              />\n              <button\n                type=\"button\"\n                onClick={handleAddCustomGenre}\n                className=\"px-3 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-semibold rounded-lg cursor-pointer\"\n              >\n                \350\277\275\345\212\240\n              </button>\n            </div>\n            {errors.genres && <p className=\"text-xs text-orange-600\">{errors.genres}</p>}\n          </div>\n\n          {/* Scenes (Multi-select) */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-xs font-semibold text-stone-700 flex items-center gap-1\">\n              <Users2 className=\"w-3.5 h-3.5 text-stone-500\" />\n              \343\201\212\343\201\231\343\201\231\343\202\201\343\202\267\343\203\274\343\203\263\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211 <span className=\"text-orange-600\">*</span>\n            </label>\n            <div className=\"flex flex-wrap gap-1.5\">\n              {ALL_SCENES.map((scene) => {\n                const isSelected = scenes.includes(scene);\n                return (\n                  <button\n                    key={scene}\n                    type=\"button\"\n                    onClick={() => handleToggleScene(scene)}\n                    className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer border ${\n                      isSelected\n                        ? \'bg-stone-900 text-white border-stone-900 shadow-xs\'\n                        : \'bg-stone-100 text-stone-700 border-stone-200/80 hover:bg-stone-200\'\n                    }`}\n                  >\n                    #{scene}\n                  </button>\n                );\n              })}\n            </div>\n            {errors.scenes && <p className=\"text-xs text-orange-600\">{errors.scenes}</p>}\n          </div>\n\n          {/* Highlight Dish */}\n          <div className=\"space-y-1.5\">\n            <label className=\"block text-xs font-semibold text-stone-700 flex items-center gap-1\">\n              <Sparkles className=\"w-3.5 h-3.5 text-stone-400\" />\n              \346\216\250\343\201\227\343\203\241\343\203\213\343\203\245\343\203\274\343\203\273\351\240\274\343\202\200\343\201\271\343\201\215\344\270\200\345\223\201\357\274\210\344\273\273\346\204\217\357\274\211\n            </label>\n            <input\n              id=\"input-spot-highlight\"\n              type=\"text\"\n              placeholder=\"\344\276\213: \350\207\252\345\256\266\350\243\275\343\203\254\343\203\210\343\203\255\343\203\227\343\203\252\343\203\263\343\200\201\347\224\237\343\202\246\343\203\213\343\201\256\343\203\221\343\202\271\343\202\277\"\n              value={highlightDish}\n              onChange={(e) => setHighlightDish(e.target.value)}\n              className=\"w-full px-3.5 py-2 bg-white border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-stone-900\"\n            />\n          </div>\n\n          {/* Comment */}\n          <div className=\"space-y-1.5\">\n            <label className=\"block text-xs font-semibold text-stone-700 flex items-center gap-1\">\n              <MessageSquare className=\"w-3.5 h-3.5 text-stone-500\" />\n              \343\201\212\343\201\231\343\201\231\343\202\201\343\203\235\343\202\244\343\203\263\343\203\210\343\203\273\343\202\263\343\203\241\343\203\263\343\203\210 <span className=\"text-orange-600\">*</span>\n            </label>\n            <textarea\n              id=\"input-spot-comment\"\n              rows={3}\n              placeholder=\"\346\225\231\343\201\210\343\201\246\343\201\217\343\202\214\343\201\237\347\220\206\347\224\261\343\202\204\351\233\260\345\233\262\346\260\227\343\200\201\343\201\212\343\201\231\343\201\231\343\202\201\343\201\256\351\240\274\343\201\277\346\226\271\343\201\252\343\201\251...\"\n              value={comment}\n              onChange={(e) => setComment(e.target.value)}\n              className={`w-full px-3.5 py-2 bg-white border ${\n                errors.comment ? \'border-orange-500 ring-1 ring-orange-500\' : \'border-stone-200\'\n              } rounded-lg text-sm focus:outline-none focus:border-stone-900`}\n            />\n            {errors.comment && <p className=\"text-xs text-orange-600\">{errors.comment}</p>}\n          </div>\n\n          {/* Links Section: Google Maps & Tabelog with AI Auto-Search */}\n          <div className=\"bg-stone-50 rounded-xl p-4 sm:p-5 border border-stone-200 space-y-3.5\">\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2.5\">\n              <div>\n                <label className=\"block text-xs font-bold text-stone-900 flex items-center gap-1.5\">\n                  <Globe className=\"w-4 h-4 text-stone-600\" />\n                  <span>\345\272\227\350\210\227\343\203\252\343\203\263\343\202\257\357\274\210Google\343\203\236\343\203\203\343\203\227\343\203\273\351\243\237\343\201\271\343\203\255\343\202\260\357\274\211</span>\n                  <span className=\"text-[11px] text-stone-400 font-normal\">\357\274\210\344\273\273\346\204\217\357\274\211</span>\n                </label>\n                <p className=\"text-[11px] text-stone-500 mt-0.5\">\n                  \345\272\227\345\220\215\343\201\250\343\202\250\343\203\252\343\202\242\343\201\213\343\202\211\343\200\201Google\343\203\236\343\203\203\343\203\227\343\201\250\351\243\237\343\201\271\343\203\255\343\202\260\343\201\256URL\343\202\222AI\343\201\214\350\207\252\345\213\225\346\244\234\347\264\242\343\201\247\343\201\215\343\201\276\343\201\231\n                </p>\n              </div>\n\n              {/* Search Links with AI Button */}\n              <button\n                id=\"btn-ai-search-links\"\n                type=\"button\"\n                onClick={handleSearchLinks}\n                disabled={isSearchingLinks || !name.trim()}\n                className={`inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold transition-all cursor-pointer shrink-0 ${\n                  isSearchingLinks\n                    ? \'bg-stone-200 text-stone-500 cursor-wait\'\n                    : !name.trim()\n                    ? \'bg-stone-100 text-stone-400 border border-stone-200 cursor-not-allowed\'\n                    : \'bg-stone-900 hover:bg-stone-800 text-white shadow-xs active:scale-95\'\n                }`}\n              >\n                {isSearchingLinks ? (\n                  <>\n                    <div className=\"w-3.5 h-3.5 border-2 border-stone-400 border-t-transparent rounded-full animate-spin\" />\n                    <span>\346\244\234\347\264\242\344\270\255...</span>\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-3.5 h-3.5 text-orange-400\" />\n                    <span>AI\343\201\247\343\203\252\343\203\263\343\202\257\346\244\234\347\264\242</span>\n                  </>\n                )}\n              </button>\n            </div>\n\n            {/* Error or Warning Notice */}\n            {searchError && (\n              <div className=\"flex items-start gap-2 p-3 rounded-lg bg-amber-50 border border-amber-200 text-amber-900 text-xs animate-in fade-in\">\n                <AlertCircle className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n                <span className=\"flex-1 leading-relaxed\">{searchError}</span>\n              </div>\n            )}\n\n            {/* AI Candidates Results Box */}\n            {hasSearched && linkCandidates.length > 0 && (\n              <div className=\"p-3.5 rounded-xl bg-white border border-stone-200 space-y-2.5\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-stone-900 text-white\">\n                      AI\346\244\234\347\264\242\347\265\220\346\236\234\n                    </span>\n                    <span className=\"text-xs font-bold text-stone-800\">\n                      {linkCandidates.length}\344\273\266\343\201\256\345\200\231\350\243\234\n                    </span>\n                  </div>\n                  <span className=\"text-[10px] text-stone-500\">\n                    \343\202\277\343\203\203\343\203\227\343\201\227\343\201\246URL\343\202\222\345\217\215\346\230\240\n                  </span>\n                </div>\n\n                <div className=\"space-y-2\">\n                  {linkCandidates.map((candidate, idx) => {\n                    const isApplied = appliedCandidateId === candidate.id;\n                    return (\n                      <div\n                        key={candidate.id || idx}\n                        id={`ai-candidate-${candidate.id}`}\n                        className={`p-3 rounded-lg bg-stone-50 border transition-all ${\n                          isApplied\n                            ? \'border-stone-900 bg-white ring-1 ring-stone-900\'\n                            : \'border-stone-200 hover:border-stone-400\'\n                        }`}\n                      >\n                        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                          <div>\n                            <div className=\"flex items-center gap-2\">\n                              <h4 className=\"text-xs font-bold text-stone-900\">\n                                {candidate.title}\n                              </h4>\n                              {candidate.sourceType === \'ai_grounded\' && (\n                                <span className=\"text-[10px] bg-stone-200 text-stone-700 font-medium px-1.5 py-0.2 rounded\">\n                                  WEB\347\205\247\345\220\210\n                                </span>\n                              )}\n                            </div>\n                            {candidate.address && (\n                              <p className=\"text-[11px] text-stone-500 mt-0.5 flex items-center gap-1\">\n                                <MapPin className=\"w-3 h-3 text-stone-400 shrink-0\" />\n                                <span className=\"truncate\">{candidate.address}</span>\n                              </p>\n                            )}\n                            {candidate.description && (\n                              <p className=\"text-[11px] text-stone-600 mt-1 line-clamp-2 leading-relaxed\">\n                                {candidate.description}\n                              </p>\n                            )}\n                          </div>\n\n                          {/* Action button to apply both */}\n                          <div className=\"flex items-center gap-1.5 shrink-0 self-end sm:self-center\">\n                            <button\n                              id={`apply-candidate-${candidate.id}`}\n                              type=\"button\"\n                              onClick={() => handleApplyCandidate(candidate, \'both\')}\n                              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\n                                isApplied\n                                  ? \'bg-stone-900 text-white\'\n                                  : \'bg-white border border-stone-300 hover:bg-stone-100 text-stone-800\'\n                              }`}\n                            >\n                              <Check className=\"w-3.5 h-3.5\" />\n                              <span>{isApplied ? \'\345\217\215\346\230\240\346\270\210\' : \'\345\217\215\346\230\240\343\201\231\343\202\213\'}</span>\n                            </button>\n                          </div>\n                        </div>\n\n                        {/* Direct link previews inside candidate */}\n                        <div className=\"mt-2.5 pt-2 border-t border-stone-200 flex flex-wrap items-center gap-2 text-[11px]\">\n                          {candidate.googleMapsUrl && (\n                            <div className=\"inline-flex items-center gap-1 bg-white border border-stone-200 rounded-md px-2 py-0.5\">\n                              <Compass className=\"w-3 h-3 text-stone-500 shrink-0\" />\n                              <span className=\"font-medium text-stone-700\">Google\343\203\236\343\203\203\343\203\227:</span>\n                              <a\n                                href={candidate.googleMapsUrl}\n                                target=\"_blank\"\n                                rel=\"noopener noreferrer\"\n                                className=\"text-stone-900 hover:underline flex items-center gap-0.5\"\n                              >\n                                <span>\347\242\272\350\252\215</span>\n                                <ExternalLink className=\"w-2.5 h-2.5\" />\n                              </a>\n                            </div>\n                          )}\n\n                          {candidate.tabelogUrl && (\n                            <div className=\"inline-flex items-center gap-1 bg-white border border-stone-200 rounded-md px-2 py-0.5\">\n                              <Utensils className=\"w-3 h-3 text-stone-500 shrink-0\" />\n                              <span className=\"font-medium text-stone-700\">\351\243\237\343\201\271\343\203\255\343\202\260:</span>\n                              <a\n                                href={candidate.tabelogUrl}\n                                target=\"_blank\"\n                                rel=\"noopener noreferrer\"\n                                className=\"text-stone-900 hover:underline flex items-center gap-0.5\"\n                              >\n                                <span>\347\242\272\350\252\215</span>\n                                <ExternalLink className=\"w-2.5 h-2.5\" />\n                              </a>\n                            </div>\n                          )}\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            )}\n\n            {/* If searched and 0 candidates */}\n            {hasSearched && linkCandidates.length === 0 && !isSearchingLinks && (\n              <div className=\"p-3 rounded-lg bg-stone-100 border border-stone-200 text-center space-y-0.5\">\n                <p className=\"text-xs font-semibold text-stone-700\">\n                  \350\251\262\345\275\223\343\201\231\343\202\213URL\343\201\214\350\246\213\343\201\244\343\201\213\343\202\212\343\201\276\343\201\233\343\202\223\343\201\247\343\201\227\343\201\237\n                </p>\n                <p className=\"text-[11px] text-stone-500\">\n                  \344\270\213\343\201\256\345\205\245\345\212\233\346\254\204\343\201\253Google\343\203\236\343\203\203\343\203\227\343\202\204\351\243\237\343\201\271\343\203\255\343\202\260\343\201\256URL\343\202\222\346\211\213\345\213\225\343\201\247\350\262\274\343\202\212\344\273\230\343\201\221\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\n                </p>\n              </div>\n            )}\n\n            {/* Manual URL Input Fields */}\n            <div className=\"space-y-2.5 pt-1\">\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"text-xs font-semibold text-stone-700 flex items-center gap-1\">\n                    <Compass className=\"w-3.5 h-3.5 text-stone-500\" />\n                    <span>Google\343\203\236\343\203\203\343\203\227\343\201\256URL</span>\n                  </label>\n                  {mapUrl && (\n                    <div className=\"flex items-center gap-2\">\n                      <a\n                        href={mapUrl}\n                        target=\"_blank\"\n                        rel=\"noopener noreferrer\"\n                        className=\"text-[11px] font-medium text-stone-700 hover:underline flex items-center gap-0.5\"\n                      >\n                        <span>\351\226\213\343\201\217</span>\n                        <ExternalLink className=\"w-3 h-3\" />\n                      </a>\n                      <button\n                        type=\"button\"\n                        onClick={() => setMapUrl(\'\')}\n                        className=\"text-[11px] text-stone-400 hover:text-stone-600 cursor-pointer\"\n                      >\n                        \343\202\257\343\203\252\343\202\242\n                      </button>\n                    </div>\n                  )}\n                </div>\n                <input\n                  id=\"input-spot-map\"\n                  type=\"url\"\n                  placeholder=\"https://maps.app.goo.gl/... \343\201\276\343\201\237\343\201\257 Google Map \343\201\256\345\205\261\346\234\211URL\"\n                  value={mapUrl}\n                  onChange={(e) => setMapUrl(e.target.value)}\n                  className=\"w-full px-3.5 py-2 bg-white border border-stone-200 rounded-lg text-xs sm:text-sm focus:outline-none focus:border-stone-900\"\n                />\n              </div>\n\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"text-xs font-semibold text-stone-700 flex items-center gap-1\">\n                    <Utensils className=\"w-3.5 h-3.5 text-stone-500\" />\n                    <span>\351\243\237\343\201\271\343\203\255\343\202\260\343\201\256URL</span>\n                  </label>\n                  {tabelogUrl && (\n                    <div className=\"flex items-center gap-2\">\n                      <a\n                        href={tabelogUrl}\n                        target=\"_blank\"\n                        rel=\"noopener noreferrer\"\n                        className=\"text-[11px] font-medium text-stone-700 hover:underline flex items-center gap-0.5\"\n                      >\n                        <span>\351\226\213\343\201\217</span>\n                        <ExternalLink className=\"w-3 h-3\" />\n                      </a>\n                      <button\n                        type=\"button\"\n                        onClick={() => setTabelogUrl(\'\')}\n                        className=\"text-[11px] text-stone-400 hover:text-stone-600 cursor-pointer\"\n                      >\n                        \343\202\257\343\203\252\343\202\242\n                      </button>\n                    </div>\n                  )}\n                </div>\n                <input\n                  id=\"input-spot-tabelog\"\n                  type=\"url\"\n                  placeholder=\"https://tabelog.com/... \343\201\276\343\201\237\343\201\257\345\272\227\350\210\227\343\201\256\351\243\237\343\201\271\343\203\255\343\202\260URL\"\n                  value={tabelogUrl}\n                  onChange={(e) => setTabelogUrl(e.target.value)}\n                  className=\"w-full px-3.5 py-2 bg-white border border-stone-200 rounded-lg text-xs sm:text-sm focus:outline-none focus:border-stone-900\"\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Image Selection */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-xs font-semibold text-stone-700 flex items-center gap-1\">\n              <ImageIcon className=\"w-3.5 h-3.5 text-stone-500\" />\n              \343\202\253\343\203\220\343\203\274\345\206\231\347\234\237\n            </label>\n            <div className=\"grid grid-cols-4 gap-2\">\n              {PRESET_IMAGES.map((preset) => (\n                <button\n                  key={preset.label}\n                  type=\"button\"\n                  onClick={() => {\n                    setIsCustomImage(false);\n                    setImageUrl(preset.url);\n                  }}\n                  className={`group relative aspect-[4/3] rounded-lg overflow-hidden border transition-all cursor-pointer ${\n                    !isCustomImage && imageUrl === preset.url\n                      ? \'border-stone-900 ring-2 ring-stone-900\'\n                      : \'border-transparent opacity-75 hover:opacity-100\'\n                  }`}\n                >\n                  <img\n                    src={preset.url}\n                    alt={preset.label}\n                    className=\"w-full h-full object-cover\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                  <div className=\"absolute inset-0 bg-stone-950/40 flex items-center justify-center p-1\">\n                    <span className=\"text-[10px] font-semibold text-white text-center leading-tight\">\n                      {preset.label}\n                    </span>\n                  </div>\n                </button>\n              ))}\n            </div>\n\n            {/* Custom image URL toggle */}\n            <div className=\"pt-1\">\n              <button\n                type=\"button\"\n                onClick={() => setIsCustomImage(!isCustomImage)}\n                className=\"text-xs font-semibold text-stone-700 hover:text-stone-900 cursor-pointer\"\n              >\n                {isCustomImage ? \'\342\206\220 \343\203\227\343\203\252\343\202\273\343\203\203\343\203\210\343\201\213\343\202\211\351\201\270\346\212\236\' : \'+ \347\224\273\345\203\217URL\343\202\222\347\233\264\346\216\245\345\205\245\345\212\233\'}\n              </button>\n              {isCustomImage && (\n                <input\n                  type=\"url\"\n                  placeholder=\"https://... \347\224\273\345\203\217URL\"\n                  value={imageUrl}\n                  onChange={(e) => setImageUrl(e.target.value)}\n                  className=\"mt-2 w-full px-3.5 py-2 bg-white border border-stone-200 rounded-lg text-xs focus:outline-none focus:border-stone-900\"\n                />\n              )}\n            </div>\n          </div>\n\n          {/* Visit Status & My Experience Memo Section */}\n          <div className=\"bg-stone-50 rounded-xl p-4 border border-stone-200 space-y-3.5\">\n            <div className=\"space-y-1.5\">\n              <label className=\"block text-xs font-semibold text-stone-700\">\n                \350\250\252\345\225\217\343\202\271\343\203\206\343\203\274\343\202\277\343\202\271\n              </label>\n              <div className=\"grid grid-cols-2 gap-2\">\n                <button\n                  type=\"button\"\n                  id=\"status-choice-unvisited\"\n                  onClick={() => setIsVisited(false)}\n                  className={`flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-xs font-semibold transition-all cursor-pointer border ${\n                    !isVisited\n                      ? \'bg-stone-900 text-white border-stone-900 shadow-xs\'\n                      : \'bg-white text-stone-600 border-stone-200 hover:bg-stone-50\'\n                  }`}\n                >\n                  <Bookmark className=\"w-3.5 h-3.5 stroke-[2.5]\" />\n                  <span>\350\241\214\343\201\215\343\201\237\343\201\204 (\346\234\252\350\250\252\345\225\217)</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  id=\"status-choice-visited\"\n                  onClick={() => setIsVisited(true)}\n                  className={`flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-xs font-semibold transition-all cursor-pointer border ${\n                    isVisited\n                      ? \'bg-stone-900 text-white border-stone-900 shadow-xs\'\n                      : \'bg-white text-stone-600 border-stone-200 hover:bg-stone-50\'\n                  }`}\n                >\n                  <CheckCircle2 className=\"w-3.5 h-3.5 stroke-[2.5]\" />\n                  <span>\350\250\252\345\225\217\346\270\210\343\201\277 (\350\241\214\343\201\243\343\201\237)</span>\n                </button>\n              </div>\n            </div>\n\n            {/* If visited, show date & myMemo */}\n            {isVisited && (\n              <div className=\"space-y-2.5 pt-2 border-t border-stone-200\">\n                <div className=\"space-y-1\">\n                  <label className=\"block text-xs font-semibold text-stone-700\">\n                    \350\250\252\345\225\217\346\227\245\357\274\210\344\273\273\346\204\217\357\274\211\n                  </label>\n                  <input\n                    id=\"input-form-visited-at\"\n                    type=\"date\"\n                    value={visitedAt}\n                    onChange={(e) => setVisitedAt(e.target.value)}\n                    className=\"w-full px-3 py-1.5 bg-white border border-stone-200 rounded-lg text-xs text-stone-800 focus:outline-none focus:border-stone-900\"\n                  />\n                </div>\n\n                <div className=\"space-y-1\">\n                  <label className=\"block text-xs font-semibold text-stone-700 flex items-center gap-1\">\n                    <MessageSquareHeart className=\"w-3.5 h-3.5 text-stone-500\" />\n                    \350\250\252\345\225\217\343\203\241\343\203\242\343\203\273\346\204\237\346\203\263\357\274\210\344\273\273\346\204\217\357\274\211\n                  </label>\n                  <textarea\n                    id=\"input-form-my-memo\"\n                    rows={2}\n                    placeholder=\"\345\256\237\351\232\233\343\201\253\350\241\214\343\201\243\343\201\246\343\201\277\343\201\237\346\204\237\346\203\263\343\202\204\346\263\250\346\226\207\343\201\227\343\201\237\343\203\241\343\203\213\343\203\245\343\203\274...\"\n                    value={myMemo}\n                    onChange={(e) => setMyMemo(e.target.value)}\n                    className=\"w-full px-3 py-1.5 bg-white border border-stone-200 rounded-lg text-xs text-stone-800 placeholder:text-stone-400 focus:outline-none focus:border-stone-900 resize-none\"\n                  />\n                </div>\n              </div>\n            )}\n\n            {/* Favorite toggle option */}\n            <div className=\"pt-2 border-t border-stone-200 flex items-center justify-between\">\n              <span className=\"text-xs font-semibold text-stone-700 flex items-center gap-1.5\">\n                <Heart className={`w-3.5 h-3.5 ${isFavorite ? \'text-orange-600 fill-orange-600\' : \'text-stone-400\'}`} />\n                \343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\253\350\277\275\345\212\240\343\201\231\343\202\213\n              </span>\n              <button\n                type=\"button\"\n                onClick={() => setIsFavorite(!isFavorite)}\n                className={`w-10 h-5 flex items-center rounded-full p-0.5 transition-colors cursor-pointer ${\n                  isFavorite ? \'bg-orange-600\' : \'bg-stone-300\'\n                }`}\n              >\n                <div\n                  className={`bg-white w-4 h-4 rounded-full shadow-xs transform transition-transform ${\n                    isFavorite ? \'translate-x-5\' : \'translate-x-0\'\n                  }`}\n                />\n              </button>\n            </div>\n          </div>\n\n          {/* \360\237\224\222 Private Memo Section */}\n          <div className=\"bg-stone-50 rounded-xl p-4 border border-stone-200 space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"text-xs font-semibold text-stone-800 flex items-center gap-1.5\">\n                <Lock className=\"w-3.5 h-3.5 text-stone-700\" />\n                <span>\351\235\236\345\205\254\351\226\213\343\203\241\343\203\242\357\274\210\350\207\252\345\210\206\345\260\202\347\224\250\343\203\273\344\273\273\346\204\217\357\274\211</span>\n              </label>\n              <span className=\"text-[10px] text-stone-500\">\n                \351\235\236\345\205\254\351\226\213\n              </span>\n            </div>\n            <textarea\n              id=\"input-form-private-memo\"\n              rows={2}\n              placeholder=\"\344\276\213: \344\274\232\350\250\2102\344\272\272\343\201\2478,000\345\206\206\343\200\202\344\272\210\347\264\204\345\277\205\351\240\210\343\200\202\343\202\253\343\202\246\343\203\263\343\202\277\343\203\274\345\270\255\343\201\214\350\211\257\343\201\204\343\200\202\"\n              value={privateMemo}\n              onChange={(e) => setPrivateMemo(e.target.value)}\n              className=\"w-full px-3 py-2 bg-white border border-stone-200 rounded-lg text-xs text-stone-800 placeholder:text-stone-400 focus:outline-none focus:border-stone-900 resize-none\"\n            />\n          </div>\n\n          {/* \360\237\223\201 Folder Classification Section */}\n          {availableFolders.length > 0 && (\n            <div className=\"space-y-2\">\n              <label className=\"block text-xs font-semibold text-stone-700 flex items-center gap-1\">\n                <FolderOpen className=\"w-3.5 h-3.5 text-stone-500\" />\n                <span>\346\211\200\345\261\236\343\203\225\343\202\251\343\203\253\343\203\200\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211</span>\n              </label>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {availableFolders.map((folder) => {\n                  const isSelected = selectedFolders.includes(folder.name);\n                  return (\n                    <button\n                      type=\"button\"\n                      key={folder.id}\n                      onClick={() => {\n                        if (isSelected) {\n                          setSelectedFolders(selectedFolders.filter((f) => f !== folder.name));\n                        } else {\n                          setSelectedFolders([...selectedFolders, folder.name]);\n                        }\n                      }}\n                      className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer border ${\n                        isSelected\n                          ? \'bg-stone-900 text-white border-stone-900 shadow-xs\'\n                          : \'bg-white text-stone-700 border-stone-200 hover:bg-stone-50\'\n                      }`}\n                    >\n                      <span>{isSelected ? \'\342\234\223 \' : \'+ \'}</span>\n                      <span>{folder.name}</span>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          )}\n\n          {/* \360\237\217\252 Store Operating Status Selector */}\n          <div className=\"space-y-2 bg-stone-50 p-3.5 rounded-xl border border-stone-200\">\n            <label className=\"block text-xs font-semibold text-stone-700 flex items-center gap-1\">\n              <Store className=\"w-3.5 h-3.5 text-stone-600\" />\n              <span>\345\272\227\350\210\227\345\226\266\346\245\255\343\202\271\343\203\206\343\203\274\343\202\277\343\202\271</span>\n            </label>\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n              {[\n                { val: \'open\', label: \'\351\200\232\345\270\270\345\226\266\346\245\255\344\270\255\' },\n                { val: \'permanently_closed\', label: \'\351\226\211\345\272\227\343\203\273\351\226\211\346\245\255\' },\n                { val: \'temporarily_closed\', label: \'\344\274\221\346\245\255\344\270\255\' },\n                { val: \'moved\', label: \'\347\247\273\350\273\242\346\270\210\' },\n              ].map((opt) => (\n                <button\n                  type=\"button\"\n                  key={opt.val}\n                  onClick={() => setOperatingStatus(opt.val as OperatingStatus)}\n                  className={`py-1.5 px-2.5 rounded-lg text-xs font-semibold border transition-all cursor-pointer ${\n                    operatingStatus === opt.val\n                      ? \'bg-stone-900 text-white border-stone-900 shadow-xs\'\n                      : \'bg-white text-stone-600 border-stone-200 hover:bg-stone-50\'\n                  }`}\n                >\n                  {opt.label}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Submit Button */}\n          <div className=\"pt-2\">\n            <button\n              id=\"submit-spot-btn\"\n              type=\"submit\"\n              className=\"w-full py-3 rounded-xl bg-stone-900 hover:bg-stone-800 text-white font-semibold text-sm shadow-sm transition-all cursor-pointer\"\n            >\n              {initialSpot && \'id\' in initialSpot ? \'\345\244\211\346\233\264\343\202\222\344\277\235\345\255\230\' : \'\343\201\212\343\201\231\343\201\231\343\202\201\345\272\227\343\202\222\347\231\273\351\214\262\'}\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );"
    }
