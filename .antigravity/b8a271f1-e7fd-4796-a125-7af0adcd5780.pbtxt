    instruction: "Refactor FilterSortBar.tsx with clean monotone design, restrained border radii, and orange active accents"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport {\n  Search,\n  X,\n  SlidersHorizontal,\n  ArrowUpDown,\n  RotateCcw,\n  MapPin,\n  Tag,\n  Wallet,\n  Users2,\n  ChevronDown,\n  Bookmark,\n  Heart,\n  Sparkles,\n  Filter,\n  FolderOpen,\n} from \'lucide-react\';\nimport {\n  FilterState,\n  SortOption,\n  PriceRange,\n  Scene,\n  VisitStatusFilter,\n  COMMON_AREAS,\n  COMMON_GENRES,\n  ALL_SCENES,\n  ALL_PRICE_RANGES,\n  CustomFolder,\n} from \'../types\';\nimport { getGenreStyle, getSceneStyle } from \'../utils/helpers\';\n\ninterface FilterSortBarProps {\n  filters: FilterState;\n  onFilterChange: (updater: (prev: FilterState) => FilterState) => void;\n  onResetFilters: () => void;\n  availableAreas: string[];\n  availableGenres: string[];\n  availableFolders?: CustomFolder[];\n  totalResultsCount: number;\n  unvisitedCount: number;\n  visitedCount: number;\n  allCount: number;\n}\n\nexport const FilterSortBar: React.FC<FilterSortBarProps> = ({\n  filters,\n  onFilterChange,\n  onResetFilters,\n  availableAreas,\n  availableGenres,\n  availableFolders = [],\n  totalResultsCount,\n  unvisitedCount,\n  allCount,\n}) => {\n  const [isExpanded, setIsExpanded] = useState(false);\n\n  // Combine common areas/genres with any unique ones from data\n  const allAreas = Array.from(new Set([...COMMON_AREAS, ...availableAreas]));\n  const allGenres = Array.from(new Set([...COMMON_GENRES, ...availableGenres]));\n\n  const isUnvisitedOnlyActive =\n    filters.unvisitedOnly || filters.visitStatus === \'unvisited\';\n\n  // Count active filter conditions\n  const activeFilterCount =\n    filters.areas.length +\n    filters.genres.length +\n    filters.priceRanges.length +\n    filters.scenes.length +\n    ((filters.folders || []).length) +\n    (filters.favoritesOnly ? 1 : 0) +\n    (isUnvisitedOnlyActive ? 1 : 0) +\n    (filters.visitStatus === \'visited\' ? 1 : 0) +\n    (filters.searchQuery.trim() ? 1 : 0);\n\n  // Toggle Unvisited Only switch\n  const handleToggleUnvisitedOnly = () => {\n    onFilterChange((prev) => {\n      const nextActive = !(prev.unvisitedOnly || prev.visitStatus === \'unvisited\');\n      return {\n        ...prev,\n        unvisitedOnly: nextActive,\n        visitStatus: nextActive ? \'unvisited\' : \'all\',\n      };\n    });\n  };\n\n  // Toggle Favorites Only switch\n  const handleToggleFavoritesOnly = () => {\n    onFilterChange((prev) => ({\n      ...prev,\n      favoritesOnly: !prev.favoritesOnly,\n    }));\n  };\n\n  const handleToggleArea = (area: string) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      areas: prev.areas.includes(area)\n        ? prev.areas.filter((a) => a !== area)\n        : [...prev.areas, area],\n    }));\n  };\n\n  const handleToggleGenre = (genre: string) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      genres: prev.genres.includes(genre)\n        ? prev.genres.filter((g) => g !== genre)\n        : [...prev.genres, genre],\n    }));\n  };\n\n  const handleTogglePriceRange = (range: PriceRange) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      priceRanges: prev.priceRanges.includes(range)\n        ? prev.priceRanges.filter((r) => r !== range)\n        : [...prev.priceRanges, range],\n    }));\n  };\n\n  const handleToggleScene = (scene: Scene) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      scenes: prev.scenes.includes(scene)\n        ? prev.scenes.filter((s) => s !== scene)\n        : [...prev.scenes, scene],\n    }));\n  };\n\n  const handleToggleFolder = (folderName: string) => {\n    onFilterChange((prev) => {\n      const current = prev.folders || [];\n      return {\n        ...prev,\n        folders: current.includes(folderName)\n          ? current.filter((f) => f !== folderName)\n          : [...current, folderName],\n      };\n    });\n  };\n\n  return (\n    <div className=\"bg-white rounded-3xl border border-stone-200/80 p-4 sm:p-5 shadow-sm space-y-4\">\n      {/* Top Controls Row: Switch Toggles & Match Count */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 border-b border-stone-100 pb-3.5\">\n        {/* Toggle Switches Group */}\n        <div className=\"flex items-center gap-2.5 sm:gap-4 flex-wrap\">\n          {/* Requirement 1: \343\200\214\346\234\252\350\250\252\345\225\217\343\201\256\345\272\227\350\210\227\343\201\256\343\201\277\350\241\250\347\244\272\343\200\215\343\203\210\343\202\260\343\203\253\343\202\271\343\202\244\343\203\203\343\203\201 */}\n          <div\n            id=\"toggle-unvisited-wrapper\"\n            onClick={handleToggleUnvisitedOnly}\n            className={`flex items-center gap-2.5 px-3.5 py-1.5 rounded-2xl border transition-all cursor-pointer select-none ${\n              isUnvisitedOnlyActive\n                ? \'bg-amber-50/90 border-amber-300 text-stone-900 shadow-sm\'\n                : \'bg-stone-50 hover:bg-stone-100/80 border-stone-200 text-stone-600\'\n            }`}\n            title=\"\343\201\276\343\201\240\350\250\252\345\225\217\343\201\227\343\201\246\343\201\204\343\201\252\343\201\204\350\241\214\343\201\215\343\201\237\343\201\204\345\272\227\350\210\227\343\201\256\343\201\277\343\202\222\350\241\250\347\244\272\343\201\227\343\201\276\343\201\231\"\n          >\n            <div className=\"flex items-center gap-1.5\">\n              <Bookmark\n                className={`w-4 h-4 ${\n                  isUnvisitedOnlyActive\n                    ? \'text-amber-600 stroke-[2.5]\'\n                    : \'text-stone-400\'\n                }`}\n              />\n              <span className=\"text-xs font-bold whitespace-nowrap\">\n                \346\234\252\350\250\252\345\225\217\343\201\256\345\272\227\350\210\227\343\201\256\343\201\277\350\241\250\347\244\272\n              </span>\n              <span\n                className={`text-[10px] font-bold px-1.5 py-0.5 rounded-full ${\n                  isUnvisitedOnlyActive\n                    ? \'bg-amber-400 text-stone-950\'\n                    : \'bg-stone-200/80 text-stone-600\'\n                }`}\n              >\n                {unvisitedCount}\344\273\266\n              </span>\n            </div>\n\n            {/* iOS style Toggle Switch */}\n            <button\n              type=\"button\"\n              id=\"switch-unvisited-only\"\n              role=\"switch\"\n              aria-checked={isUnvisitedOnlyActive}\n              onClick={(e) => {\n                e.stopPropagation();\n                handleToggleUnvisitedOnly();\n              }}\n              className={`w-9 h-5 flex items-center rounded-full p-0.5 transition-colors duration-200 cursor-pointer ${\n                isUnvisitedOnlyActive ? \'bg-amber-500\' : \'bg-stone-300\'\n              }`}\n            >\n              <div\n                className={`bg-white w-4 h-4 rounded-full shadow-md transform transition-transform duration-200 ${\n                  isUnvisitedOnlyActive ? \'translate-x-4\' : \'translate-x-0\'\n                }`}\n              />\n            </button>\n          </div>\n\n          {/* Quick Favorite Only Switch */}\n          <div\n            id=\"toggle-favorite-wrapper\"\n            onClick={handleToggleFavoritesOnly}\n            className={`flex items-center gap-2.5 px-3 py-1.5 rounded-2xl border transition-all cursor-pointer select-none ${\n              filters.favoritesOnly\n                ? \'bg-rose-50/90 border-rose-200 text-rose-900 shadow-sm\'\n                : \'bg-stone-50 hover:bg-stone-100/80 border-stone-200 text-stone-600\'\n            }`}\n            title=\"\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\253\350\277\275\345\212\240\343\201\227\343\201\237\345\272\227\350\210\227\343\201\256\343\201\277\343\202\222\350\241\250\347\244\272\343\201\227\343\201\276\343\201\231\"\n          >\n            <div className=\"flex items-center gap-1.5\">\n              <Heart\n                className={`w-3.5 h-3.5 ${\n                  filters.favoritesOnly\n                    ? \'text-rose-500 fill-rose-500\'\n                    : \'text-stone-400\'\n                }`}\n              />\n              <span className=\"text-xs font-semibold whitespace-nowrap\">\n                \343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277\n              </span>\n            </div>\n\n            {/* Switch knob */}\n            <button\n              type=\"button\"\n              id=\"switch-favorites-only\"\n              role=\"switch\"\n              aria-checked={filters.favoritesOnly}\n              onClick={(e) => {\n                e.stopPropagation();\n                handleToggleFavoritesOnly();\n              }}\n              className={`w-8 h-4.5 flex items-center rounded-full p-0.5 transition-colors duration-200 cursor-pointer ${\n                filters.favoritesOnly ? \'bg-rose-500\' : \'bg-stone-300\'\n              }`}\n            >\n              <div\n                className={`bg-white w-3.5 h-3.5 rounded-full shadow-md transform transition-transform duration-200 ${\n                  filters.favoritesOnly ? \'translate-x-3.5\' : \'translate-x-0\'\n                }`}\n              />\n            </button>\n          </div>\n        </div>\n\n        {/* Match Count Indicator */}\n        <div className=\"text-xs text-stone-500 font-medium flex items-center gap-1.5 ml-auto\">\n          <span>\350\241\250\347\244\272\344\270\255:</span>\n          <span className=\"font-extrabold text-rose-600 text-base\">\n            {totalResultsCount}\n          </span>\n          <span className=\"text-stone-400\">/ \345\205\250{allCount}\344\273\266</span>\n        </div>\n      </div>\n\n      {/* Search Input & Sort & Expand Button */}\n      <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3\">\n        {/* Search input */}\n        <div className=\"relative flex-1\">\n          <Search className=\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\" />\n          <input\n            id=\"search-input\"\n            type=\"text\"\n            placeholder=\"\345\272\227\345\220\215\343\202\204\343\202\255\343\203\274\343\203\257\343\203\274\343\203\211\343\200\201\343\201\212\343\201\231\343\201\231\343\202\201\343\201\227\343\201\237\344\272\272\343\201\247\346\244\234\347\264\242\357\274\210\344\276\213: \343\203\227\343\203\252\343\203\263\343\200\201\343\203\206\343\203\251\343\202\271\343\200\201\343\203\257\343\202\244\343\203\263\357\274\211\"\n            value={filters.searchQuery}\n            onChange={(e) =>\n              onFilterChange((prev) => ({ ...prev, searchQuery: e.target.value }))\n            }\n            className=\"w-full pl-10 pr-9 py-2.5 bg-stone-50/80 hover:bg-stone-50 focus:bg-white border border-stone-200 rounded-2xl text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-rose-400/30 focus:border-rose-400 transition-all\"\n          />\n          {filters.searchQuery && (\n            <button\n              id=\"clear-search-btn\"\n              onClick={() => onFilterChange((prev) => ({ ...prev, searchQuery: \'\' }))}\n              className=\"absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-600 p-0.5 rounded-full\"\n              title=\"\346\244\234\347\264\242\343\202\257\343\203\252\343\202\242\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          )}\n        </div>\n\n        {/* Sort Selector Dropdown */}\n        <div className=\"flex items-center gap-2\">\n          <div className=\"relative min-w-[160px] sm:min-w-[180px]\">\n            <ArrowUpDown className=\"w-3.5 h-3.5 text-stone-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n            <select\n              id=\"sort-select\"\n              value={filters.sortBy}\n              onChange={(e) =>\n                onFilterChange((prev) => ({\n                  ...prev,\n                  sortBy: e.target.value as SortOption,\n                }))\n              }\n              className=\"w-full pl-8 pr-8 py-2.5 bg-stone-50 hover:bg-stone-100 border border-stone-200 rounded-2xl text-xs sm:text-sm font-semibold text-stone-700 appearance-none focus:outline-none focus:ring-2 focus:ring-rose-400/30 focus:border-rose-400 cursor-pointer transition-all\"\n            >\n              <option value=\"newest\">\350\277\275\345\212\240\346\227\245\346\231\202\357\274\232\346\226\260\343\201\227\343\201\204\351\240\206</option>\n              <option value=\"oldest\">\350\277\275\345\212\240\346\227\245\346\231\202\357\274\232\345\217\244\343\201\204\351\240\206</option>\n              <option value=\"priceAsc\">\344\276\241\346\240\274\345\270\257\357\274\232\345\256\211\343\201\204\351\240\206</option>\n              <option value=\"priceDesc\">\344\276\241\346\240\274\345\270\257\357\274\232\351\253\230\343\201\204\351\240\206</option>\n            </select>\n            <ChevronDown className=\"w-4 h-4 text-stone-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n          </div>\n\n          {/* Toggle Detailed Filter Panel button */}\n          <button\n            id=\"toggle-filter-panel-btn\"\n            onClick={() => setIsExpanded(!isExpanded)}\n            className={`flex items-center gap-1.5 px-3.5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold border transition-all duration-200 cursor-pointer ${\n              isExpanded ||\n              filters.areas.length > 0 ||\n              filters.genres.length > 0 ||\n              filters.priceRanges.length > 0\n                ? \'bg-rose-50 border-rose-200 text-rose-700 shadow-sm\'\n                : \'bg-stone-50 hover:bg-stone-100 border-stone-200 text-stone-700\'\n            }`}\n          >\n            <SlidersHorizontal className=\"w-3.5 h-3.5\" />\n            <span>\350\251\263\347\264\260\347\265\236\343\202\212\350\276\274\343\201\277</span>\n            {filters.areas.length + filters.genres.length + filters.priceRanges.length > 0 && (\n              <span className=\"w-5 h-5 flex items-center justify-center text-[10px] font-extrabold bg-rose-500 text-white rounded-full\">\n                {filters.areas.length + filters.genres.length + filters.priceRanges.length}\n              </span>\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Quick Scene Chips Bar (Always visible for easy 1-tap filtering) */}\n      <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none text-xs\">\n        <span className=\"text-stone-400 text-xs font-semibold whitespace-nowrap mr-1 flex items-center gap-1\">\n          <Users2 className=\"w-3 h-3\" />\n          \343\202\267\343\203\274\343\203\263:\n        </span>\n        {ALL_SCENES.map((scene) => {\n          const isSelected = filters.scenes.includes(scene);\n          const style = getSceneStyle(scene);\n          return (\n            <button\n              key={scene}\n              id={`quick-scene-${scene}`}\n              onClick={() => handleToggleScene(scene)}\n              className={`px-3 py-1.5 rounded-full font-medium transition-all duration-150 whitespace-nowrap cursor-pointer ${\n                isSelected\n                  ? \'bg-rose-500 text-white font-bold shadow-sm shadow-rose-200 scale-105\'\n                  : `${style.bg} ${style.text} border ${style.border} hover:opacity-80`\n              }`}\n            >\n              {scene}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Expandable Filter Details (Price, Area, Genre) */}\n      {isExpanded && (\n        <div className=\"pt-3 border-t border-stone-100 space-y-4 animate-in fade-in duration-200\">\n          {/* Price Range Filter */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-600\">\n              <Wallet className=\"w-3.5 h-3.5 text-stone-500\" />\n              <span>\344\272\210\347\256\227\343\203\273\344\276\241\346\240\274\345\270\257\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211</span>\n            </div>\n            <div className=\"flex flex-wrap gap-1.5\">\n              {ALL_PRICE_RANGES.map((price) => {\n                const isSelected = filters.priceRanges.includes(price);\n                return (\n                  <button\n                    key={price}\n                    id={`filter-price-${price}`}\n                    onClick={() => handleTogglePriceRange(price)}\n                    className={`px-3 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-stone-900 text-white font-bold shadow-sm\'\n                        : \'bg-stone-100 text-stone-600 hover:bg-stone-200/80 border border-stone-200/60\'\n                    }`}\n                  >\n                    {price}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Area Filter */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-600\">\n              <MapPin className=\"w-3.5 h-3.5 text-stone-500\" />\n              <span>\343\202\250\343\203\252\343\202\242\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211</span>\n            </div>\n            <div className=\"flex flex-wrap gap-1.5 max-h-32 overflow-y-auto pr-1\">\n              {allAreas.map((area) => {\n                const isSelected = filters.areas.includes(area);\n                return (\n                  <button\n                    key={area}\n                    id={`filter-area-${area}`}\n                    onClick={() => handleToggleArea(area)}\n                    className={`px-3 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-rose-500 text-white font-bold shadow-sm shadow-rose-200\'\n                        : \'bg-stone-100 text-stone-600 hover:bg-stone-200/80 border border-stone-200/60\'\n                    }`}\n                  >\n                    {area}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Genre Filter */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-600\">\n              <Tag className=\"w-3.5 h-3.5 text-stone-500\" />\n              <span>\343\202\270\343\203\243\343\203\263\343\203\253\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211</span>\n            </div>\n            <div className=\"flex flex-wrap gap-1.5 max-h-32 overflow-y-auto pr-1\">\n              {allGenres.map((genre) => {\n                const isSelected = filters.genres.includes(genre);\n                const style = getGenreStyle(genre);\n                return (\n                  <button\n                    key={genre}\n                    id={`filter-genre-${genre}`}\n                    onClick={() => handleToggleGenre(genre)}\n                    className={`px-3 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-rose-600 text-white font-bold shadow-sm\'\n                        : `${style.bg} ${style.text} border ${style.border} hover:opacity-80`\n                    }`}\n                  >\n                    {genre}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Folder Filter (if available) */}\n          {availableFolders.length > 0 && (\n            <div className=\"space-y-1.5 pt-1\">\n              <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-600\">\n                <FolderOpen className=\"w-3.5 h-3.5 text-rose-500\" />\n                <span>\343\203\225\343\202\251\343\203\253\343\203\200 / \343\202\253\343\202\271\343\202\277\343\203\240\343\203\252\343\202\271\343\203\210\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211</span>\n              </div>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {availableFolders.map((folder) => {\n                  const isSelected = (filters.folders || []).includes(folder.name);\n                  return (\n                    <button\n                      key={folder.id}\n                      id={`filter-folder-${folder.id}`}\n                      onClick={() => handleToggleFolder(folder.name)}\n                      className={`px-3 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer border ${\n                        isSelected\n                          ? \'bg-rose-500 text-white font-bold shadow-sm\'\n                          : \'bg-rose-50/70 text-rose-800 border-rose-200 hover:bg-rose-100\'\n                      }`}\n                    >\n                      {folder.name}\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Requirement 2: \347\217\276\345\234\250\351\201\270\346\212\236\344\270\255\343\201\256\343\203\225\343\202\243\343\203\253\343\202\277\343\203\274\343\202\277\343\202\260\350\241\250\347\244\272\343\202\250\343\203\252\343\202\242 (Active Filter Chips) */}\n      <div\n        id=\"active-filters-container\"\n        className=\"pt-2.5 border-t border-stone-100/90\"\n      >\n        {activeFilterCount > 0 ? (\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 bg-stone-50/80 p-3 rounded-2xl border border-stone-200/60\">\n            <div className=\"flex items-center gap-2 flex-wrap flex-1\">\n              <span className=\"text-[11px] font-bold text-stone-500 flex items-center gap-1 shrink-0\">\n                <Filter className=\"w-3 h-3 text-rose-500\" />\n                \351\201\270\346\212\236\344\270\255 ({activeFilterCount}):\n              </span>\n\n              {/* \346\244\234\347\264\242\343\202\255\343\203\274\343\203\257\343\203\274\343\203\211\343\202\277\343\202\260 */}\n              {filters.searchQuery.trim() && (\n                <span\n                  id=\"active-chip-search\"\n                  className=\"inline-flex items-center gap-1.5 bg-white text-stone-800 px-2.5 py-1 rounded-xl border border-stone-200 text-xs font-medium shadow-2xs animate-in fade-in\"\n                >\n                  <Search className=\"w-3 h-3 text-stone-400\" />\n                  <span className=\"truncate max-w-[120px]\">\n                    &quot;{filters.searchQuery}&quot;\n                  </span>\n                  <button\n                    type=\"button\"\n                    onClick={() =>\n                      onFilterChange((prev) => ({ ...prev, searchQuery: \'\' }))\n                    }\n                    className=\"text-stone-400 hover:text-stone-700 cursor-pointer p-0.5 rounded-full hover:bg-stone-100\"\n                    title=\"\346\244\234\347\264\242\346\235\241\344\273\266\343\202\222\350\247\243\351\231\244\"\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              )}\n\n              {/* \346\234\252\350\250\252\345\225\217\343\201\256\345\272\227\350\210\227\343\201\256\343\201\277\343\202\277\343\202\260 */}\n              {isUnvisitedOnlyActive && (\n                <span\n                  id=\"active-chip-unvisited\"\n                  className=\"inline-flex items-center gap-1.5 bg-amber-100 text-amber-950 px-2.5 py-1 rounded-xl border border-amber-300 text-xs font-bold shadow-2xs animate-in fade-in\"\n                >\n                  <Bookmark className=\"w-3 h-3 text-amber-700 stroke-[2.5]\" />\n                  <span>\346\234\252\350\250\252\345\225\217\343\201\256\343\201\277</span>\n                  <button\n                    type=\"button\"\n                    onClick={handleToggleUnvisitedOnly}\n                    className=\"text-amber-800 hover:text-amber-950 cursor-pointer p-0.5 rounded-full hover:bg-amber-200/60\"\n                    title=\"\346\234\252\350\250\252\345\225\217\343\201\256\343\201\277\350\247\243\351\231\244\"\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              )}\n\n              {/* \343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277\343\202\277\343\202\260 */}\n              {filters.favoritesOnly && (\n                <span\n                  id=\"active-chip-favorites\"\n                  className=\"inline-flex items-center gap-1.5 bg-rose-100 text-rose-900 px-2.5 py-1 rounded-xl border border-rose-200 text-xs font-bold shadow-2xs animate-in fade-in\"\n                >\n                  <Heart className=\"w-3 h-3 text-rose-600 fill-rose-600\" />\n                  <span>\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277</span>\n                  <button\n                    type=\"button\"\n                    onClick={handleToggleFavoritesOnly}\n                    className=\"text-rose-700 hover:text-rose-950 cursor-pointer p-0.5 rounded-full hover:bg-rose-200/60\"\n                    title=\"\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277\350\247\243\351\231\244\"\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              )}\n\n              {/* \343\202\250\343\203\252\343\202\242\343\202\277\343\202\260 */}\n              {filters.areas.map((area) => (\n                <span\n                  key={`active-area-${area}`}\n                  id={`active-chip-area-${area}`}\n                  className=\"inline-flex items-center gap-1.5 bg-sky-50 text-sky-800 px-2.5 py-1 rounded-xl border border-sky-200 text-xs font-medium shadow-2xs animate-in fade-in\"\n                >\n                  <MapPin className=\"w-3 h-3 text-sky-600\" />\n                  <span>{area}</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleToggleArea(area)}\n                    className=\"text-sky-600 hover:text-sky-900 cursor-pointer p-0.5 rounded-full hover:bg-sky-100\"\n                    title={`${area}\343\202\222\350\247\243\351\231\244`}\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              ))}\n\n              {/* \343\202\270\343\203\243\343\203\263\343\203\253\343\202\277\343\202\260 */}\n              {filters.genres.map((genre) => (\n                <span\n                  key={`active-genre-${genre}`}\n                  id={`active-chip-genre-${genre}`}\n                  className=\"inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 px-2.5 py-1 rounded-xl border border-emerald-200 text-xs font-medium shadow-2xs animate-in fade-in\"\n                >\n                  <Tag className=\"w-3 h-3 text-emerald-600\" />\n                  <span>{genre}</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleToggleGenre(genre)}\n                    className=\"text-emerald-600 hover:text-emerald-900 cursor-pointer p-0.5 rounded-full hover:bg-emerald-100\"\n                    title={`${genre}\343\202\222\350\247\243\351\231\244`}\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              ))}\n\n              {/* \344\272\210\347\256\227\343\202\277\343\202\260 */}\n              {filters.priceRanges.map((price) => (\n                <span\n                  key={`active-price-${price}`}\n                  id={`active-chip-price-${price}`}\n                  className=\"inline-flex items-center gap-1.5 bg-stone-100 text-stone-800 px-2.5 py-1 rounded-xl border border-stone-200 text-xs font-medium shadow-2xs animate-in fade-in\"\n                >\n                  <Wallet className=\"w-3 h-3 text-stone-600\" />\n                  <span>{price}</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleTogglePriceRange(price)}\n                    className=\"text-stone-600 hover:text-stone-900 cursor-pointer p-0.5 rounded-full hover:bg-stone-200\"\n                    title={`${price}\343\202\222\350\247\243\351\231\244`}\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              ))}\n\n              {/* \343\203\225\343\202\251\343\203\253\343\203\200\343\202\277\343\202\260 */}\n              {(filters.folders || []).map((folderName) => (\n                <span\n                  key={`active-folder-${folderName}`}\n                  id={`active-chip-folder-${folderName}`}\n                  className=\"inline-flex items-center gap-1.5 bg-rose-50 text-rose-800 px-2.5 py-1 rounded-xl border border-rose-200 text-xs font-bold shadow-2xs animate-in fade-in\"\n                >\n                  <FolderOpen className=\"w-3 h-3 text-rose-600\" />\n                  <span>{folderName}</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleToggleFolder(folderName)}\n                    className=\"text-rose-600 hover:text-rose-900 cursor-pointer p-0.5 rounded-full hover:bg-rose-100\"\n                    title={`${folderName}\343\202\222\350\247\243\351\231\244`}\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              ))}\n\n              {/* \343\202\267\343\203\274\343\203\263\343\202\277\343\202\260 */}\n              {filters.scenes.map((scene) => (\n                <span\n                  key={`active-scene-${scene}`}\n                  id={`active-chip-scene-${scene}`}\n                  className=\"inline-flex items-center gap-1.5 bg-purple-50 text-purple-800 px-2.5 py-1 rounded-xl border border-purple-200 text-xs font-medium shadow-2xs animate-in fade-in\"\n                >\n                  <Users2 className=\"w-3 h-3 text-purple-600\" />\n                  <span>{scene}</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleToggleScene(scene)}\n                    className=\"text-purple-600 hover:text-purple-900 cursor-pointer p-0.5 rounded-full hover:bg-purple-100\"\n                    title={`${scene}\343\202\222\350\247\243\351\231\244`}\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              ))}\n            </div>\n\n            {/* Clear All Filters Button */}\n            <button\n              id=\"reset-all-filters-btn\"\n              onClick={onResetFilters}\n              className=\"flex items-center gap-1 px-2.5 py-1 rounded-xl bg-white hover:bg-rose-50 text-stone-600 hover:text-rose-600 border border-stone-200 hover:border-rose-200 text-xs font-bold transition-all cursor-pointer self-end sm:self-auto shrink-0 shadow-2xs\"\n            >\n              <RotateCcw className=\"w-3 h-3\" />\n              <span>\345\205\250\346\235\241\344\273\266\343\202\257\343\203\252\343\202\242</span>\n            </button>\n          </div>\n        ) : (\n          <div className=\"flex items-center justify-between text-xs text-stone-400 py-0.5 px-1\">\n            <span className=\"flex items-center gap-1 text-[11px]\">\n              <Sparkles className=\"w-3 h-3 text-amber-400\" />\n              \343\201\231\343\201\271\343\201\246\343\201\256\345\272\227\350\210\227\343\202\222\350\241\250\347\244\272\344\270\255\357\274\210\346\234\252\347\265\236\343\202\212\350\276\274\343\201\277\357\274\211\n            </span>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport {\n  Search,\n  X,\n  SlidersHorizontal,\n  ArrowUpDown,\n  RotateCcw,\n  MapPin,\n  Tag,\n  Wallet,\n  Users2,\n  ChevronDown,\n  Bookmark,\n  Heart,\n  Filter,\n  FolderOpen,\n} from \'lucide-react\';\nimport {\n  FilterState,\n  SortOption,\n  PriceRange,\n  Scene,\n  COMMON_AREAS,\n  COMMON_GENRES,\n  ALL_SCENES,\n  ALL_PRICE_RANGES,\n  CustomFolder,\n} from \'../types\';\n\ninterface FilterSortBarProps {\n  filters: FilterState;\n  onFilterChange: (updater: (prev: FilterState) => FilterState) => void;\n  onResetFilters: () => void;\n  availableAreas: string[];\n  availableGenres: string[];\n  availableFolders?: CustomFolder[];\n  totalResultsCount: number;\n  unvisitedCount: number;\n  visitedCount: number;\n  allCount: number;\n}\n\nexport const FilterSortBar: React.FC<FilterSortBarProps> = ({\n  filters,\n  onFilterChange,\n  onResetFilters,\n  availableAreas,\n  availableGenres,\n  availableFolders = [],\n  totalResultsCount,\n  unvisitedCount,\n  allCount,\n}) => {\n  const [isExpanded, setIsExpanded] = useState(false);\n\n  // Combine common areas/genres with any unique ones from data\n  const allAreas = Array.from(new Set([...COMMON_AREAS, ...availableAreas]));\n  const allGenres = Array.from(new Set([...COMMON_GENRES, ...availableGenres]));\n\n  const isUnvisitedOnlyActive =\n    filters.unvisitedOnly || filters.visitStatus === \'unvisited\';\n\n  // Count active filter conditions\n  const activeFilterCount =\n    filters.areas.length +\n    filters.genres.length +\n    filters.priceRanges.length +\n    filters.scenes.length +\n    ((filters.folders || []).length) +\n    (filters.favoritesOnly ? 1 : 0) +\n    (isUnvisitedOnlyActive ? 1 : 0) +\n    (filters.visitStatus === \'visited\' ? 1 : 0) +\n    (filters.searchQuery.trim() ? 1 : 0);\n\n  // Toggle Unvisited Only switch\n  const handleToggleUnvisitedOnly = () => {\n    onFilterChange((prev) => {\n      const nextActive = !(prev.unvisitedOnly || prev.visitStatus === \'unvisited\');\n      return {\n        ...prev,\n        unvisitedOnly: nextActive,\n        visitStatus: nextActive ? \'unvisited\' : \'all\',\n      };\n    });\n  };\n\n  // Toggle Favorites Only switch\n  const handleToggleFavoritesOnly = () => {\n    onFilterChange((prev) => ({\n      ...prev,\n      favoritesOnly: !prev.favoritesOnly,\n    }));\n  };\n\n  const handleToggleArea = (area: string) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      areas: prev.areas.includes(area)\n        ? prev.areas.filter((a) => a !== area)\n        : [...prev.areas, area],\n    }));\n  };\n\n  const handleToggleGenre = (genre: string) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      genres: prev.genres.includes(genre)\n        ? prev.genres.filter((g) => g !== genre)\n        : [...prev.genres, genre],\n    }));\n  };\n\n  const handleTogglePriceRange = (range: PriceRange) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      priceRanges: prev.priceRanges.includes(range)\n        ? prev.priceRanges.filter((r) => r !== range)\n        : [...prev.priceRanges, range],\n    }));\n  };\n\n  const handleToggleScene = (scene: Scene) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      scenes: prev.scenes.includes(scene)\n        ? prev.scenes.filter((s) => s !== scene)\n        : [...prev.scenes, scene],\n    }));\n  };\n\n  const handleToggleFolder = (folderName: string) => {\n    onFilterChange((prev) => {\n      const current = prev.folders || [];\n      return {\n        ...prev,\n        folders: current.includes(folderName)\n          ? current.filter((f) => f !== folderName)\n          : [...current, folderName],\n      };\n    });\n  };\n\n  return (\n    <div className=\"bg-white rounded-2xl border border-stone-200/90 p-4 sm:p-5 shadow-2xs space-y-4\">\n      {/* Top Controls Row: Switch Toggles & Match Count */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 border-b border-stone-100 pb-3.5\">\n        {/* Toggle Switches Group */}\n        <div className=\"flex items-center gap-2.5 sm:gap-3.5 flex-wrap\">\n          {/* Unvisited Only Toggle */}\n          <div\n            id=\"toggle-unvisited-wrapper\"\n            onClick={handleToggleUnvisitedOnly}\n            className={`flex items-center gap-2.5 px-3 py-1.5 rounded-lg border transition-all cursor-pointer select-none ${\n              isUnvisitedOnlyActive\n                ? \'bg-stone-900 border-stone-900 text-white shadow-2xs\'\n                : \'bg-stone-50 hover:bg-stone-100/80 border-stone-200 text-stone-700\'\n            }`}\n            title=\"\343\201\276\343\201\240\350\250\252\345\225\217\343\201\227\343\201\246\343\201\204\343\201\252\343\201\204\350\241\214\343\201\215\343\201\237\343\201\204\345\272\227\350\210\227\343\201\256\343\201\277\343\202\222\350\241\250\347\244\272\343\201\227\343\201\276\343\201\231\"\n          >\n            <div className=\"flex items-center gap-1.5\">\n              <Bookmark\n                className={`w-3.5 h-3.5 ${\n                  isUnvisitedOnlyActive ? \'text-orange-400 stroke-[2.5]\' : \'text-stone-400\'\n                }`}\n              />\n              <span className=\"text-xs font-semibold whitespace-nowrap\">\n                \346\234\252\350\250\252\345\225\217\343\201\256\343\201\277\n              </span>\n              <span\n                className={`text-[10px] font-semibold px-1.5 py-0.2 rounded ${\n                  isUnvisitedOnlyActive\n                    ? \'bg-stone-800 text-orange-300\'\n                    : \'bg-stone-200/70 text-stone-600\'\n                }`}\n              >\n                {unvisitedCount}\n              </span>\n            </div>\n\n            {/* Switch knob */}\n            <button\n              type=\"button\"\n              id=\"switch-unvisited-only\"\n              role=\"switch\"\n              aria-checked={isUnvisitedOnlyActive}\n              onClick={(e) => {\n                e.stopPropagation();\n                handleToggleUnvisitedOnly();\n              }}\n              className={`w-8 h-4.5 flex items-center rounded-full p-0.5 transition-colors cursor-pointer ${\n                isUnvisitedOnlyActive ? \'bg-orange-600\' : \'bg-stone-300\'\n              }`}\n            >\n              <div\n                className={`bg-white w-3.5 h-3.5 rounded-full shadow-xs transform transition-transform ${\n                  isUnvisitedOnlyActive ? \'translate-x-3.5\' : \'translate-x-0\'\n                }`}\n              />\n            </button>\n          </div>\n\n          {/* Quick Favorite Only Switch */}\n          <div\n            id=\"toggle-favorite-wrapper\"\n            onClick={handleToggleFavoritesOnly}\n            className={`flex items-center gap-2.5 px-3 py-1.5 rounded-lg border transition-all cursor-pointer select-none ${\n              filters.favoritesOnly\n                ? \'bg-orange-50 border-orange-300 text-orange-950 shadow-2xs font-semibold\'\n                : \'bg-stone-50 hover:bg-stone-100/80 border-stone-200 text-stone-700\'\n            }`}\n            title=\"\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\253\350\277\275\345\212\240\343\201\227\343\201\237\345\272\227\350\210\227\343\201\256\343\201\277\343\202\222\350\241\250\347\244\272\343\201\227\343\201\276\343\201\231\"\n          >\n            <div className=\"flex items-center gap-1.5\">\n              <Heart\n                className={`w-3.5 h-3.5 ${\n                  filters.favoritesOnly\n                    ? \'text-orange-600 fill-orange-600\'\n                    : \'text-stone-400\'\n                }`}\n              />\n              <span className=\"text-xs font-semibold whitespace-nowrap\">\n                \343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277\n              </span>\n            </div>\n\n            {/* Switch knob */}\n            <button\n              type=\"button\"\n              id=\"switch-favorites-only\"\n              role=\"switch\"\n              aria-checked={filters.favoritesOnly}\n              onClick={(e) => {\n                e.stopPropagation();\n                handleToggleFavoritesOnly();\n              }}\n              className={`w-8 h-4.5 flex items-center rounded-full p-0.5 transition-colors cursor-pointer ${\n                filters.favoritesOnly ? \'bg-orange-600\' : \'bg-stone-300\'\n              }`}\n            >\n              <div\n                className={`bg-white w-3.5 h-3.5 rounded-full shadow-xs transform transition-transform ${\n                  filters.favoritesOnly ? \'translate-x-3.5\' : \'translate-x-0\'\n                }`}\n              />\n            </button>\n          </div>\n        </div>\n\n        {/* Match Count Indicator */}\n        <div className=\"text-xs text-stone-500 font-medium flex items-center gap-1.5 ml-auto\">\n          <span>\350\241\250\347\244\272:</span>\n          <span className=\"font-bold text-stone-900 text-sm\">\n            {totalResultsCount}\n          </span>\n          <span className=\"text-stone-400\">/ \345\205\250{allCount}\344\273\266</span>\n        </div>\n      </div>\n\n      {/* Search Input & Sort & Expand Button */}\n      <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5\">\n        {/* Search input */}\n        <div className=\"relative flex-1\">\n          <Search className=\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\" />\n          <input\n            id=\"search-input\"\n            type=\"text\"\n            placeholder=\"\345\272\227\345\220\215\343\200\201\343\202\250\343\203\252\343\202\242\343\200\201\343\201\212\343\201\231\343\201\231\343\202\201\343\201\227\343\201\237\344\272\272\343\200\201\347\211\271\345\276\264\343\201\247\346\244\234\347\264\242...\"\n            value={filters.searchQuery}\n            onChange={(e) =>\n              onFilterChange((prev) => ({ ...prev, searchQuery: e.target.value }))\n            }\n            className=\"w-full pl-10 pr-9 py-2 bg-stone-50 hover:bg-stone-100/50 focus:bg-white border border-stone-200 rounded-lg text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all\"\n          />\n          {filters.searchQuery && (\n            <button\n              id=\"clear-search-btn\"\n              onClick={() => onFilterChange((prev) => ({ ...prev, searchQuery: \'\' }))}\n              className=\"absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-700 p-0.5 rounded-md\"\n              title=\"\346\244\234\347\264\242\343\202\257\343\203\252\343\202\242\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          )}\n        </div>\n\n        {/* Sort Selector Dropdown */}\n        <div className=\"flex items-center gap-2\">\n          <div className=\"relative min-w-[150px] sm:min-w-[170px]\">\n            <ArrowUpDown className=\"w-3.5 h-3.5 text-stone-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n            <select\n              id=\"sort-select\"\n              value={filters.sortBy}\n              onChange={(e) =>\n                onFilterChange((prev) => ({\n                  ...prev,\n                  sortBy: e.target.value as SortOption,\n                }))\n              }\n              className=\"w-full pl-8 pr-8 py-2 bg-stone-50 hover:bg-stone-100/70 border border-stone-200 rounded-lg text-xs font-semibold text-stone-700 appearance-none focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 cursor-pointer transition-all\"\n            >\n              <option value=\"newest\">\350\277\275\345\212\240\346\227\245\346\231\202\357\274\232\346\226\260\343\201\227\343\201\204\351\240\206</option>\n              <option value=\"oldest\">\350\277\275\345\212\240\346\227\245\346\231\202\357\274\232\345\217\244\343\201\204\351\240\206</option>\n              <option value=\"priceAsc\">\344\276\241\346\240\274\345\270\257\357\274\232\345\256\211\343\201\204\351\240\206</option>\n              <option value=\"priceDesc\">\344\276\241\346\240\274\345\270\257\357\274\232\351\253\230\343\201\204\351\240\206</option>\n            </select>\n            <ChevronDown className=\"w-3.5 h-3.5 text-stone-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n          </div>\n\n          {/* Toggle Detailed Filter Panel button */}\n          <button\n            id=\"toggle-filter-panel-btn\"\n            onClick={() => setIsExpanded(!isExpanded)}\n            className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold border transition-all cursor-pointer ${\n              isExpanded ||\n              filters.areas.length > 0 ||\n              filters.genres.length > 0 ||\n              filters.priceRanges.length > 0\n                ? \'bg-stone-900 border-stone-900 text-white shadow-2xs\'\n                : \'bg-stone-50 hover:bg-stone-100 border-stone-200 text-stone-700\'\n            }`}\n          >\n            <SlidersHorizontal className=\"w-3.5 h-3.5\" />\n            <span>\350\251\263\347\264\260\347\265\236\343\202\212\350\276\274\343\201\277</span>\n            {filters.areas.length + filters.genres.length + filters.priceRanges.length > 0 && (\n              <span className=\"w-4 h-4 flex items-center justify-center text-[10px] font-bold bg-orange-600 text-white rounded\">\n                {filters.areas.length + filters.genres.length + filters.priceRanges.length}\n              </span>\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Quick Scene Chips Bar */}\n      <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 text-xs\">\n        <span className=\"text-stone-400 text-xs font-semibold whitespace-nowrap mr-1 flex items-center gap-1\">\n          <Users2 className=\"w-3 h-3\" />\n          \343\202\267\343\203\274\343\203\263:\n        </span>\n        {ALL_SCENES.map((scene) => {\n          const isSelected = filters.scenes.includes(scene);\n          return (\n            <button\n              key={scene}\n              id={`quick-scene-${scene}`}\n              onClick={() => handleToggleScene(scene)}\n              className={`px-2.5 py-1 rounded-md text-xs transition-all whitespace-nowrap cursor-pointer ${\n                isSelected\n                  ? \'bg-stone-900 text-white font-bold shadow-2xs\'\n                  : \'bg-stone-100 text-stone-700 border border-stone-200/80 hover:bg-stone-200/80\'\n              }`}\n            >\n              {scene}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Expandable Filter Details (Price, Area, Genre, Folders) */}\n      {isExpanded && (\n        <div className=\"pt-3 border-t border-stone-100 space-y-3.5\">\n          {/* Price Range Filter */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-semibold text-stone-700\">\n              <Wallet className=\"w-3.5 h-3.5 text-stone-500\" />\n              <span>\344\272\210\347\256\227\343\203\273\344\276\241\346\240\274\345\270\257</span>\n            </div>\n            <div className=\"flex flex-wrap gap-1.5\">\n              {ALL_PRICE_RANGES.map((price) => {\n                const isSelected = filters.priceRanges.includes(price);\n                return (\n                  <button\n                    key={price}\n                    id={`filter-price-${price}`}\n                    onClick={() => handleTogglePriceRange(price)}\n                    className={`px-2.5 py-1 rounded-md text-xs font-medium transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-stone-900 text-white font-semibold\'\n                        : \'bg-stone-100 text-stone-700 hover:bg-stone-200/80 border border-stone-200/70\'\n                    }`}\n                  >\n                    {price}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Area Filter */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-semibold text-stone-700\">\n              <MapPin className=\"w-3.5 h-3.5 text-stone-500\" />\n              <span>\343\202\250\343\203\252\343\202\242</span>\n            </div>\n            <div className=\"flex flex-wrap gap-1.5 max-h-32 overflow-y-auto pr-1\">\n              {allAreas.map((area) => {\n                const isSelected = filters.areas.includes(area);\n                return (\n                  <button\n                    key={area}\n                    id={`filter-area-${area}`}\n                    onClick={() => handleToggleArea(area)}\n                    className={`px-2.5 py-1 rounded-md text-xs font-medium transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-stone-900 text-white font-semibold\'\n                        : \'bg-stone-100 text-stone-700 hover:bg-stone-200/80 border border-stone-200/70\'\n                    }`}\n                  >\n                    {area}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Genre Filter */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-semibold text-stone-700\">\n              <Tag className=\"w-3.5 h-3.5 text-stone-500\" />\n              <span>\343\202\270\343\203\243\343\203\263\343\203\253</span>\n            </div>\n            <div className=\"flex flex-wrap gap-1.5 max-h-32 overflow-y-auto pr-1\">\n              {allGenres.map((genre) => {\n                const isSelected = filters.genres.includes(genre);\n                return (\n                  <button\n                    key={genre}\n                    id={`filter-genre-${genre}`}\n                    onClick={() => handleToggleGenre(genre)}\n                    className={`px-2.5 py-1 rounded-md text-xs font-medium transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-stone-900 text-white font-semibold\'\n                        : \'bg-stone-100 text-stone-700 hover:bg-stone-200/80 border border-stone-200/70\'\n                    }`}\n                  >\n                    {genre}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Folder Filter (if available) */}\n          {availableFolders.length > 0 && (\n            <div className=\"space-y-1.5 pt-1\">\n              <div className=\"flex items-center gap-1.5 text-xs font-semibold text-stone-700\">\n                <FolderOpen className=\"w-3.5 h-3.5 text-stone-500\" />\n                <span>\343\203\225\343\202\251\343\203\253\343\203\200 / \343\203\252\343\202\271\343\203\210</span>\n              </div>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {availableFolders.map((folder) => {\n                  const isSelected = (filters.folders || []).includes(folder.name);\n                  return (\n                    <button\n                      key={folder.id}\n                      id={`filter-folder-${folder.id}`}\n                      onClick={() => handleToggleFolder(folder.name)}\n                      className={`px-2.5 py-1 rounded-md text-xs font-medium transition-all cursor-pointer border ${\n                        isSelected\n                          ? \'bg-stone-900 text-white border-stone-900 font-semibold\'\n                          : \'bg-stone-100 text-stone-700 border-stone-200 hover:bg-stone-200/80\'\n                      }`}\n                    >\n                      {folder.name}\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Active Filter Chips */}\n      <div\n        id=\"active-filters-container\"\n        className=\"pt-2 border-t border-stone-100\"\n      >\n        {activeFilterCount > 0 ? (\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 bg-stone-50 p-2.5 sm:p-3 rounded-xl border border-stone-200/70\">\n            <div className=\"flex items-center gap-1.5 flex-wrap flex-1\">\n              <span className=\"text-[11px] font-semibold text-stone-500 flex items-center gap-1 shrink-0 mr-1\">\n                <Filter className=\"w-3 h-3 text-stone-600\" />\n                \351\201\270\346\212\236\344\270\255 ({activeFilterCount}):\n              </span>\n\n              {/* Search keyword chip */}\n              {filters.searchQuery.trim() && (\n                <span\n                  id=\"active-chip-search\"\n                  className=\"inline-flex items-center gap-1 bg-white text-stone-800 px-2 py-0.5 rounded-md border border-stone-200 text-xs font-medium shadow-2xs\"\n                >\n                  <Search className=\"w-3 h-3 text-stone-400\" />\n                  <span className=\"truncate max-w-[120px]\">\n                    &quot;{filters.searchQuery}&quot;\n                  </span>\n                  <button\n                    type=\"button\"\n                    onClick={() =>\n                      onFilterChange((prev) => ({ ...prev, searchQuery: \'\' }))\n                    }\n                    className=\"text-stone-400 hover:text-stone-700 cursor-pointer p-0.5\"\n                    title=\"\346\244\234\347\264\242\346\235\241\344\273\266\343\202\222\350\247\243\351\231\244\"\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              )}\n\n              {/* Unvisited only chip */}\n              {isUnvisitedOnlyActive && (\n                <span\n                  id=\"active-chip-unvisited\"\n                  className=\"inline-flex items-center gap-1 bg-stone-900 text-white px-2 py-0.5 rounded-md text-xs font-semibold shadow-2xs\"\n                >\n                  <Bookmark className=\"w-3 h-3 text-orange-400\" />\n                  <span>\346\234\252\350\250\252\345\225\217\343\201\256\343\201\277</span>\n                  <button\n                    type=\"button\"\n                    onClick={handleToggleUnvisitedOnly}\n                    className=\"text-stone-300 hover:text-white cursor-pointer p-0.5\"\n                    title=\"\346\234\252\350\250\252\345\225\217\343\201\256\343\201\277\350\247\243\351\231\244\"\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              )}\n\n              {/* Favorites only chip */}\n              {filters.favoritesOnly && (\n                <span\n                  id=\"active-chip-favorites\"\n                  className=\"inline-flex items-center gap-1 bg-orange-50 text-orange-700 px-2 py-0.5 rounded-md border border-orange-200 text-xs font-semibold shadow-2xs\"\n                >\n                  <Heart className=\"w-3 h-3 text-orange-600 fill-orange-600\" />\n                  <span>\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277</span>\n                  <button\n                    type=\"button\"\n                    onClick={handleToggleFavoritesOnly}\n                    className=\"text-orange-600 hover:text-orange-950 cursor-pointer p-0.5\"\n                    title=\"\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277\350\247\243\351\231\244\"\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              )}\n\n              {/* Areas */}\n              {filters.areas.map((area) => (\n                <span\n                  key={`active-area-${area}`}\n                  id={`active-chip-area-${area}`}\n                  className=\"inline-flex items-center gap-1 bg-white text-stone-800 px-2 py-0.5 rounded-md border border-stone-200 text-xs font-medium shadow-2xs\"\n                >\n                  <MapPin className=\"w-3 h-3 text-stone-400\" />\n                  <span>{area}</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleToggleArea(area)}\n                    className=\"text-stone-400 hover:text-stone-700 cursor-pointer p-0.5\"\n                    title={`${area}\343\202\222\350\247\243\351\231\244`}\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              ))}\n\n              {/* Genres */}\n              {filters.genres.map((genre) => (\n                <span\n                  key={`active-genre-${genre}`}\n                  id={`active-chip-genre-${genre}`}\n                  className=\"inline-flex items-center gap-1 bg-white text-stone-800 px-2 py-0.5 rounded-md border border-stone-200 text-xs font-medium shadow-2xs\"\n                >\n                  <Tag className=\"w-3 h-3 text-stone-400\" />\n                  <span>{genre}</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleToggleGenre(genre)}\n                    className=\"text-stone-400 hover:text-stone-700 cursor-pointer p-0.5\"\n                    title={`${genre}\343\202\222\350\247\243\351\231\244`}\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              ))}\n\n              {/* Prices */}\n              {filters.priceRanges.map((price) => (\n                <span\n                  key={`active-price-${price}`}\n                  id={`active-chip-price-${price}`}\n                  className=\"inline-flex items-center gap-1 bg-white text-stone-800 px-2 py-0.5 rounded-md border border-stone-200 text-xs font-medium shadow-2xs\"\n                >\n                  <Wallet className=\"w-3 h-3 text-stone-400\" />\n                  <span>{price}</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleTogglePriceRange(price)}\n                    className=\"text-stone-400 hover:text-stone-700 cursor-pointer p-0.5\"\n                    title={`${price}\343\202\222\350\247\243\351\231\244`}\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              ))}\n\n              {/* Folders */}\n              {(filters.folders || []).map((folderName) => (\n                <span\n                  key={`active-folder-${folderName}`}\n                  id={`active-chip-folder-${folderName}`}\n                  className=\"inline-flex items-center gap-1 bg-white text-stone-800 px-2 py-0.5 rounded-md border border-stone-200 text-xs font-medium shadow-2xs\"\n                >\n                  <FolderOpen className=\"w-3 h-3 text-stone-400\" />\n                  <span>{folderName}</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleToggleFolder(folderName)}\n                    className=\"text-stone-400 hover:text-stone-700 cursor-pointer p-0.5\"\n                    title={`${folderName}\343\202\222\350\247\243\351\231\244`}\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              ))}\n\n              {/* Scenes */}\n              {filters.scenes.map((scene) => (\n                <span\n                  key={`active-scene-${scene}`}\n                  id={`active-chip-scene-${scene}`}\n                  className=\"inline-flex items-center gap-1 bg-white text-stone-800 px-2 py-0.5 rounded-md border border-stone-200 text-xs font-medium shadow-2xs\"\n                >\n                  <Users2 className=\"w-3 h-3 text-stone-400\" />\n                  <span>{scene}</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleToggleScene(scene)}\n                    className=\"text-stone-400 hover:text-stone-700 cursor-pointer p-0.5\"\n                    title={`${scene}\343\202\222\350\247\243\351\231\244`}\n                  >\n                    <X className=\"w-3 h-3\" />\n                  </button>\n                </span>\n              ))}\n            </div>\n\n            {/* Clear All Filters Button */}\n            <button\n              id=\"reset-all-filters-btn\"\n              onClick={onResetFilters}\n              className=\"flex items-center gap-1 px-2.5 py-1 rounded-md bg-white hover:bg-stone-100 text-stone-600 hover:text-stone-900 border border-stone-200 text-xs font-semibold transition-all cursor-pointer self-end sm:self-auto shrink-0 shadow-2xs\"\n            >\n              <RotateCcw className=\"w-3 h-3\" />\n              <span>\346\235\241\344\273\266\343\202\257\343\203\252\343\202\242</span>\n            </button>\n          </div>\n        ) : (\n          <div className=\"flex items-center justify-between text-xs text-stone-400 py-0.5 px-1\">\n            <span className=\"text-[11px]\">\n              \343\201\231\343\201\271\343\201\246\343\201\256\345\272\227\350\210\227\343\202\222\350\241\250\347\244\272\344\270\255\n            </span>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
