    replacement_chunks {
      target_content: "interface AddEditSpotModalProps {\n  initialSpot?: RestaurantSpot | null;\n  onClose: () => void;\n  onSave: (spot: RestaurantSpot) => void;\n}\n\nexport const AddEditSpotModal: React.FC<AddEditSpotModalProps> = ({\n  initialSpot,\n  onClose,\n  onSave,\n}) => {\n  const [name, setName] = useState(initialSpot?.name || \'\');\n  const [area, setArea] = useState(initialSpot?.area || \'\350\241\250\345\217\202\351\201\223\');\n  const [customArea, setCustomArea] = useState(\'\');\n  const [isCustomArea, setIsCustomArea] = useState(\n    initialSpot ? !COMMON_AREAS.includes(initialSpot.area) : false\n  );\n\n  const [genres, setGenres] = useState<string[]>(\n    initialSpot?.genres || [\'\343\202\253\343\203\225\343\202\247\']\n  );\n  const [customGenre, setCustomGenre] = useState(\'\');\n\n  const [priceRange, setPriceRange] = useState<PriceRange>(\n    initialSpot?.priceRange || \'1000\343\200\2343000\345\206\206\'\n  );\n\n  const [scenes, setScenes] = useState<Scene[]>(\n    initialSpot?.scenes || [\'\345\245\263\345\255\220\344\274\232\']\n  );\n\n  const [recommender, setRecommender] = useState(\n    initialSpot?.recommender || \'\'\n  );\n  const [highlightDish, setHighlightDish] = useState(\n    initialSpot?.highlightDish || \'\'\n  );\n  const [comment, setComment] = useState(initialSpot?.comment || \'\');\n  const [mapUrl, setMapUrl] = useState(initialSpot?.mapUrl || \'\');\n  const [tabelogUrl, setTabelogUrl] = useState(initialSpot?.tabelogUrl || \'\');\n  const [imageUrl, setImageUrl] = useState(\n    initialSpot?.imageUrl || PRESET_IMAGES[0].url\n  );\n  const [isCustomImage, setIsCustomImage] = useState(false);"
      replacement_content: "interface AddEditSpotModalProps {\n  initialSpot?: RestaurantSpot | Partial<RestaurantSpot> | null;\n  onClose: () => void;\n  onSave: (spot: RestaurantSpot) => void;\n  isAiPrefilled?: boolean;\n}\n\nexport const AddEditSpotModal: React.FC<AddEditSpotModalProps> = ({\n  initialSpot,\n  onClose,\n  onSave,\n  isAiPrefilled = false,\n}) => {\n  const initialAreaIsCommon = initialSpot?.area\n    ? COMMON_AREAS.includes(initialSpot.area)\n    : true;\n\n  const [name, setName] = useState(initialSpot?.name || \'\');\n  const [area, setArea] = useState(\n    initialAreaIsCommon ? (initialSpot?.area || \'\350\241\250\345\217\202\351\201\223\') : \'\343\201\235\343\201\256\344\273\226\'\n  );\n  const [customArea, setCustomArea] = useState(\n    !initialAreaIsCommon ? (initialSpot?.area || \'\') : \'\'\n  );\n  const [isCustomArea, setIsCustomArea] = useState(!initialAreaIsCommon);\n\n  const [genres, setGenres] = useState<string[]>(\n    initialSpot?.genres && initialSpot.genres.length > 0\n      ? initialSpot.genres\n      : [\'\343\202\253\343\203\225\343\202\247\']\n  );\n  const [customGenre, setCustomGenre] = useState(\'\');\n\n  const [priceRange, setPriceRange] = useState<PriceRange>(\n    (initialSpot?.priceRange as PriceRange) || \'1000\343\200\2343000\345\206\206\'\n  );\n\n  const [scenes, setScenes] = useState<Scene[]>(\n    (initialSpot?.scenes as Scene[]) && initialSpot.scenes.length > 0\n      ? (initialSpot.scenes as Scene[])\n      : [\'\345\245\263\345\255\220\344\274\232\']\n  );\n\n  const [recommender, setRecommender] = useState(\n    initialSpot?.recommender || (isAiPrefilled ? \'\345\205\261\346\234\211\343\203\252\343\203\263\343\202\257\' : \'\')\n  );\n  const [highlightDish, setHighlightDish] = useState(\n    initialSpot?.highlightDish || \'\'\n  );\n  const [comment, setComment] = useState(initialSpot?.comment || \'\');\n  const [mapUrl, setMapUrl] = useState(initialSpot?.mapUrl || \'\');\n  const [tabelogUrl, setTabelogUrl] = useState(initialSpot?.tabelogUrl || \'\');\n  const [imageUrl, setImageUrl] = useState(\n    initialSpot?.imageUrl || PRESET_IMAGES[0].url\n  );\n  const [isCustomImage, setIsCustomImage] = useState(\n    initialSpot?.imageUrl ? !PRESET_IMAGES.some(p => p.url === initialSpot.imageUrl) : false\n  );"
    }
