  file_change {
    absolute_path_uri: "file:///src/components/FilterSortBar.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport {\n  Search,\n  X,\n  SlidersHorizontal,\n  ArrowUpDown,\n  RotateCcw,\n  MapPin,\n  Tag,\n  Wallet,\n  Users2,\n  ChevronDown,\n} from \'lucide-react\';\nimport {\n  FilterState,\n  SortOption,\n  PriceRange,\n  Scene,\n  COMMON_AREAS,\n  COMMON_GENRES,\n  ALL_SCENES,\n  ALL_PRICE_RANGES,\n} from \'../types\';\nimport { getGenreStyle, getSceneStyle } from \'../utils/helpers\';\n\ninterface FilterSortBarProps {\n  filters: FilterState;\n  onFilterChange: (updater: (prev: FilterState) => FilterState) => void;\n  onResetFilters: () => void;\n  availableAreas: string[];\n  availableGenres: string[];\n  totalResultsCount: number;\n}\n\nexport const FilterSortBar: React.FC<FilterSortBarProps> = ({\n  filters,\n  onFilterChange,\n  onResetFilters,\n  availableAreas,\n  availableGenres,\n  totalResultsCount,\n}) => {\n  const [isExpanded, setIsExpanded] = useState(false);\n\n  // Combine common areas/genres with any unique ones from data\n  const allAreas = Array.from(new Set([...COMMON_AREAS, ...availableAreas]));\n  const allGenres = Array.from(new Set([...COMMON_GENRES, ...availableGenres]));\n\n  const activeFilterCount =\n    filters.areas.length +\n    filters.genres.length +\n    filters.priceRanges.length +\n    filters.scenes.length +\n    (filters.favoritesOnly ? 1 : 0) +\n    (filters.searchQuery.trim() ? 1 : 0);\n\n  const handleToggleArea = (area: string) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      areas: prev.areas.includes(area)\n        ? prev.areas.filter((a) => a !== area)\n        : [...prev.areas, area],\n    }));\n  };\n\n  const handleToggleGenre = (genre: string) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      genres: prev.genres.includes(genre)\n        ? prev.genres.filter((g) => g !== genre)\n        : [...prev.genres, genre],\n    }));\n  };\n\n  const handleTogglePriceRange = (range: PriceRange) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      priceRanges: prev.priceRanges.includes(range)\n        ? prev.priceRanges.filter((r) => r !== range)\n        : [...prev.priceRanges, range],\n    }));\n  };\n\n  const handleToggleScene = (scene: Scene) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      scenes: prev.scenes.includes(scene)\n        ? prev.scenes.filter((s) => s !== scene)\n        : [...prev.scenes, scene],\n    }));\n  };\n\n  return (\n    <div className=\"bg-white rounded-3xl border border-stone-200/80 p-4 sm:p-5 shadow-sm space-y-4\">\n      {/* Top row: Search input & Sort selector */}\n      <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3\">\n        {/* Search input */}\n        <div className=\"relative flex-1\">\n          <Search className=\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\" />\n          <input\n            id=\"search-input\"\n            type=\"text\"\n            placeholder=\"\345\272\227\345\220\215\343\202\204\343\201\212\343\201\231\343\201\231\343\202\201\343\203\235\343\202\244\343\203\263\343\203\210\343\201\247\346\244\234\347\264\242\357\274\210\344\276\213: \343\203\227\343\203\252\343\203\263\343\200\201\343\203\206\343\203\251\343\202\271\343\200\201\343\203\257\343\202\244\343\203\263\357\274\211\"\n            value={filters.searchQuery}\n            onChange={(e) =>\n              onFilterChange((prev) => ({ ...prev, searchQuery: e.target.value }))\n            }\n            className=\"w-full pl-10 pr-9 py-2.5 bg-stone-50/80 hover:bg-stone-50 focus:bg-white border border-stone-200 rounded-2xl text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-rose-400/30 focus:border-rose-400 transition-all\"\n          />\n          {filters.searchQuery && (\n            <button\n              id=\"clear-search-btn\"\n              onClick={() => onFilterChange((prev) => ({ ...prev, searchQuery: \'\' }))}\n              className=\"absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-600 p-0.5 rounded-full\"\n              title=\"\346\244\234\347\264\242\343\202\257\343\203\252\343\202\242\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          )}\n        </div>\n\n        {/* Sort Selector Dropdown */}\n        <div className=\"flex items-center gap-2\">\n          <div className=\"relative min-w-[170px] sm:min-w-[190px]\">\n            <ArrowUpDown className=\"w-3.5 h-3.5 text-stone-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n            <select\n              id=\"sort-select\"\n              value={filters.sortBy}\n              onChange={(e) =>\n                onFilterChange((prev) => ({\n                  ...prev,\n                  sortBy: e.target.value as SortOption,\n                }))\n              }\n              className=\"w-full pl-8 pr-8 py-2.5 bg-stone-50 hover:bg-stone-100 border border-stone-200 rounded-2xl text-xs sm:text-sm font-semibold text-stone-700 appearance-none focus:outline-none focus:ring-2 focus:ring-rose-400/30 focus:border-rose-400 cursor-pointer transition-all\"\n            >\n              <option value=\"newest\">\350\277\275\345\212\240\346\227\245\346\231\202\357\274\232\346\226\260\343\201\227\343\201\204\351\240\206</option>\n              <option value=\"oldest\">\350\277\275\345\212\240\346\227\245\346\231\202\357\274\232\345\217\244\343\201\204\351\240\206</option>\n              <option value=\"priceAsc\">\344\276\241\346\240\274\345\270\257\357\274\232\345\256\211\343\201\204\351\240\206</option>\n              <option value=\"priceDesc\">\344\276\241\346\240\274\345\270\257\357\274\232\351\253\230\343\201\204\351\240\206</option>\n            </select>\n            <ChevronDown className=\"w-4 h-4 text-stone-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n          </div>\n\n          {/* Toggle Filter Panel button */}\n          <button\n            id=\"toggle-filter-panel-btn\"\n            onClick={() => setIsExpanded(!isExpanded)}\n            className={`flex items-center gap-1.5 px-3.5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold border transition-all duration-200 cursor-pointer ${\n              isExpanded || activeFilterCount > 0\n                ? \'bg-rose-50 border-rose-200 text-rose-700 shadow-sm\'\n                : \'bg-stone-50 hover:bg-stone-100 border-stone-200 text-stone-700\'\n            }`}\n          >\n            <SlidersHorizontal className=\"w-3.5 h-3.5\" />\n            <span>\347\265\236\343\202\212\350\276\274\343\201\277</span>\n            {activeFilterCount > 0 && (\n              <span className=\"w-5 h-5 flex items-center justify-center text-[10px] font-extrabold bg-rose-500 text-white rounded-full\">\n                {activeFilterCount}\n              </span>\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Quick Scene Chips Bar (Always visible for fast tap) */}\n      <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none text-xs\">\n        <span className=\"text-stone-400 text-xs font-semibold whitespace-nowrap mr-1 flex items-center gap-1\">\n          <Users2 className=\"w-3 h-3\" />\n          \343\202\267\343\203\274\343\203\263:\n        </span>\n        {ALL_SCENES.map((scene) => {\n          const isSelected = filters.scenes.includes(scene);\n          const style = getSceneStyle(scene);\n          return (\n            <button\n              key={scene}\n              id={`quick-scene-${scene}`}\n              onClick={() => handleToggleScene(scene)}\n              className={`px-3 py-1.5 rounded-full font-medium transition-all duration-150 whitespace-nowrap cursor-pointer ${\n                isSelected\n                  ? \'bg-rose-500 text-white font-bold shadow-sm shadow-rose-200 scale-105\'\n                  : `${style.bg} ${style.text} border ${style.border} hover:opacity-80`\n              }`}\n            >\n              {scene}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Expandable Filter Details (Area, Genre, Price Range) */}\n      {isExpanded && (\n        <div className=\"pt-3 border-t border-stone-100 space-y-4 animate-in fade-in duration-200\">\n          {/* Price Range Filter */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-600\">\n              <Wallet className=\"w-3.5 h-3.5 text-stone-500\" />\n              <span>\344\272\210\347\256\227\343\203\273\344\276\241\346\240\274\345\270\257\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211</span>\n            </div>\n            <div className=\"flex flex-wrap gap-1.5\">\n              {ALL_PRICE_RANGES.map((price) => {\n                const isSelected = filters.priceRanges.includes(price);\n                return (\n                  <button\n                    key={price}\n                    id={`filter-price-${price}`}\n                    onClick={() => handleTogglePriceRange(price)}\n                    className={`px-3 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-stone-900 text-white font-bold shadow-sm\'\n                        : \'bg-stone-100 text-stone-600 hover:bg-stone-200/80 border border-stone-200/60\'\n                    }`}\n                  >\n                    {price}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Area Filter */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-600\">\n              <MapPin className=\"w-3.5 h-3.5 text-stone-500\" />\n              <span>\343\202\250\343\203\252\343\202\242\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211</span>\n            </div>\n            <div className=\"flex flex-wrap gap-1.5 max-h-32 overflow-y-auto pr-1\">\n              {allAreas.map((area) => {\n                const isSelected = filters.areas.includes(area);\n                return (\n                  <button\n                    key={area}\n                    id={`filter-area-${area}`}\n                    onClick={() => handleToggleArea(area)}\n                    className={`px-3 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-rose-500 text-white font-bold shadow-sm shadow-rose-200\'\n                        : \'bg-stone-100 text-stone-600 hover:bg-stone-200/80 border border-stone-200/60\'\n                    }`}\n                  >\n                    {area}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Genre Filter */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-600\">\n              <Tag className=\"w-3.5 h-3.5 text-stone-500\" />\n              <span>\343\202\270\343\203\243\343\203\263\343\203\253\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211</span>\n            </div>\n            <div className=\"flex flex-wrap gap-1.5 max-h-32 overflow-y-auto pr-1\">\n              {allGenres.map((genre) => {\n                const isSelected = filters.genres.includes(genre);\n                const style = getGenreStyle(genre);\n                return (\n                  <button\n                    key={genre}\n                    id={`filter-genre-${genre}`}\n                    onClick={() => handleToggleGenre(genre)}\n                    className={`px-3 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-rose-600 text-white font-bold shadow-sm\'\n                        : `${style.bg} ${style.text} border ${style.border} hover:opacity-80`\n                    }`}\n                  >\n                    {genre}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Active filter tags summary & Reset button */}\n      <div className=\"flex items-center justify-between text-xs pt-1 border-t border-stone-100/80 text-stone-500\">\n        <div className=\"flex items-center gap-1.5 flex-wrap\">\n          <span className=\"font-semibold text-stone-700\">\n            \350\251\262\345\275\223\357\274\232<span className=\"text-rose-600 font-bold text-sm\">{totalResultsCount}</span> \344\273\266\n          </span>\n\n          {activeFilterCount > 0 && (\n            <span className=\"text-stone-400 hidden sm:inline\">|</span>\n          )}\n\n          {/* Individual filter dismissal chips */}\n          {filters.favoritesOnly && (\n            <span className=\"inline-flex items-center gap-1 bg-rose-50 text-rose-700 px-2 py-0.5 rounded-md border border-rose-100 text-[11px] font-medium\">\n              \342\230\205 \343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277\n            </span>\n          )}\n\n          {filters.scenes.map((s) => (\n            <span\n              key={s}\n              onClick={() => handleToggleScene(s)}\n              className=\"inline-flex items-center gap-1 bg-purple-50 text-purple-700 px-2 py-0.5 rounded-md border border-purple-100 text-[11px] font-medium cursor-pointer hover:bg-purple-100\"\n            >\n              {s} <X className=\"w-2.5 h-2.5\" />\n            </span>\n          ))}\n\n          {filters.priceRanges.map((p) => (\n            <span\n              key={p}\n              onClick={() => handleTogglePriceRange(p)}\n              className=\"inline-flex items-center gap-1 bg-amber-50 text-amber-700 px-2 py-0.5 rounded-md border border-amber-100 text-[11px] font-medium cursor-pointer hover:bg-amber-100\"\n            >\n              {p} <X className=\"w-2.5 h-2.5\" />\n            </span>\n          ))}\n\n          {filters.areas.map((a) => (\n            <span\n              key={a}\n              onClick={() => handleToggleArea(a)}\n              className=\"inline-flex items-center gap-1 bg-sky-50 text-sky-700 px-2 py-0.5 rounded-md border border-sky-100 text-[11px] font-medium cursor-pointer hover:bg-sky-100\"\n            >\n              {a} <X className=\"w-2.5 h-2.5\" />\n            </span>\n          ))}\n\n          {filters.genres.map((g) => (\n            <span\n              key={g}\n              onClick={() => handleToggleGenre(g)}\n              className=\"inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-md border border-emerald-100 text-[11px] font-medium cursor-pointer hover:bg-emerald-100\"\n            >\n              {g} <X className=\"w-2.5 h-2.5\" />\n            </span>\n          ))}\n        </div>\n\n        {activeFilterCount > 0 && (\n          <button\n            id=\"reset-all-filters-btn\"\n            onClick={onResetFilters}\n            className=\"flex items-center gap-1 text-stone-500 hover:text-rose-600 font-semibold transition-colors cursor-pointer ml-auto whitespace-nowrap pl-2\"\n          >\n            <RotateCcw className=\"w-3 h-3\" />\n            <span>\346\235\241\344\273\266\343\203\252\343\202\273\343\203\203\343\203\210</span>\n          </button>\n        )}\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Search,\n  X,\n  SlidersHorizontal,\n  ArrowUpDown,\n  RotateCcw,\n  MapPin,\n  Tag,\n  Wallet,\n  Users2,\n  ChevronDown,\n  Bookmark,\n  CheckCircle2,\n  Layers,\n} from \'lucide-react\';\nimport {\n  FilterState,\n  SortOption,\n  PriceRange,\n  Scene,\n  VisitStatusFilter,\n  COMMON_AREAS,\n  COMMON_GENRES,\n  ALL_SCENES,\n  ALL_PRICE_RANGES,\n} from \'../types\';\nimport { getGenreStyle, getSceneStyle } from \'../utils/helpers\';\n\ninterface FilterSortBarProps {\n  filters: FilterState;\n  onFilterChange: (updater: (prev: FilterState) => FilterState) => void;\n  onResetFilters: () => void;\n  availableAreas: string[];\n  availableGenres: string[];\n  totalResultsCount: number;\n  unvisitedCount: number;\n  visitedCount: number;\n  allCount: number;\n}\n\nexport const FilterSortBar: React.FC<FilterSortBarProps> = ({\n  filters,\n  onFilterChange,\n  onResetFilters,\n  availableAreas,\n  availableGenres,\n  totalResultsCount,\n  unvisitedCount,\n  visitedCount,\n  allCount,\n}) => {\n  const [isExpanded, setIsExpanded] = useState(false);\n\n  // Combine common areas/genres with any unique ones from data\n  const allAreas = Array.from(new Set([...COMMON_AREAS, ...availableAreas]));\n  const allGenres = Array.from(new Set([...COMMON_GENRES, ...availableGenres]));\n\n  const activeFilterCount =\n    filters.areas.length +\n    filters.genres.length +\n    filters.priceRanges.length +\n    filters.scenes.length +\n    (filters.favoritesOnly ? 1 : 0) +\n    (filters.visitStatus !== \'all\' ? 1 : 0) +\n    (filters.searchQuery.trim() ? 1 : 0);\n\n  const handleToggleArea = (area: string) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      areas: prev.areas.includes(area)\n        ? prev.areas.filter((a) => a !== area)\n        : [...prev.areas, area],\n    }));\n  };\n\n  const handleToggleGenre = (genre: string) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      genres: prev.genres.includes(genre)\n        ? prev.genres.filter((g) => g !== genre)\n        : [...prev.genres, genre],\n    }));\n  };\n\n  const handleTogglePriceRange = (range: PriceRange) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      priceRanges: prev.priceRanges.includes(range)\n        ? prev.priceRanges.filter((r) => r !== range)\n        : [...prev.priceRanges, range],\n    }));\n  };\n\n  const handleToggleScene = (scene: Scene) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      scenes: prev.scenes.includes(scene)\n        ? prev.scenes.filter((s) => s !== scene)\n        : [...prev.scenes, scene],\n    }));\n  };\n\n  const handleSelectVisitStatus = (status: VisitStatusFilter) => {\n    onFilterChange((prev) => ({\n      ...prev,\n      visitStatus: status,\n    }));\n  };\n\n  return (\n    <div className=\"bg-white rounded-3xl border border-stone-200/80 p-4 sm:p-5 shadow-sm space-y-4\">\n      {/* Visit Status Tab Bar: \343\201\231\343\201\271\343\201\246 / \350\241\214\343\201\215\343\201\237\343\201\204\357\274\210\346\234\252\350\250\252\345\225\217\357\274\211 / \350\241\214\343\201\243\343\201\237\357\274\210\350\250\252\345\225\217\346\270\210\343\201\277\357\274\211 */}\n      <div className=\"flex items-center justify-between gap-2 border-b border-stone-100 pb-3 flex-wrap\">\n        <div className=\"flex items-center gap-1.5 p-1 bg-stone-100/90 rounded-2xl\">\n          <button\n            id=\"filter-status-all\"\n            onClick={() => handleSelectVisitStatus(\'all\')}\n            className={`flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer ${\n              filters.visitStatus === \'all\'\n                ? \'bg-white text-stone-900 shadow-sm\'\n                : \'text-stone-600 hover:text-stone-900\'\n            }`}\n          >\n            <Layers className=\"w-3.5 h-3.5\" />\n            <span>\343\201\231\343\201\271\343\201\246</span>\n            <span className=\"text-[10px] px-1.5 py-0.2 rounded-full bg-stone-200 text-stone-700\">\n              {allCount}\n            </span>\n          </button>\n\n          <button\n            id=\"filter-status-unvisited\"\n            onClick={() => handleSelectVisitStatus(\'unvisited\')}\n            className={`flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer ${\n              filters.visitStatus === \'unvisited\'\n                ? \'bg-amber-400 text-stone-950 shadow-sm\'\n                : \'text-stone-600 hover:text-stone-900\'\n            }`}\n          >\n            <Bookmark className=\"w-3.5 h-3.5 stroke-[2.5]\" />\n            <span>\350\241\214\343\201\215\343\201\237\343\201\204 (\346\234\252\350\250\252\345\225\217)</span>\n            <span\n              className={`text-[10px] px-1.5 py-0.2 rounded-full ${\n                filters.visitStatus === \'unvisited\'\n                  ? \'bg-stone-900 text-white\'\n                  : \'bg-stone-200 text-stone-700\'\n              }`}\n            >\n              {unvisitedCount}\n            </span>\n          </button>\n\n          <button\n            id=\"filter-status-visited\"\n            onClick={() => handleSelectVisitStatus(\'visited\')}\n            className={`flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer ${\n              filters.visitStatus === \'visited\'\n                ? \'bg-emerald-600 text-white shadow-sm\'\n                : \'text-stone-600 hover:text-stone-900\'\n            }`}\n          >\n            <CheckCircle2 className=\"w-3.5 h-3.5 stroke-[2.5]\" />\n            <span>\350\241\214\343\201\243\343\201\237 (\350\250\252\345\225\217\346\270\210\343\201\277)</span>\n            <span\n              className={`text-[10px] px-1.5 py-0.2 rounded-full ${\n                filters.visitStatus === \'visited\'\n                  ? \'bg-white/30 text-white\'\n                  : \'bg-stone-200 text-stone-700\'\n              }`}\n            >\n              {visitedCount}\n            </span>\n          </button>\n        </div>\n\n        {/* Total match indicator */}\n        <div className=\"text-xs text-stone-500 font-medium\">\n          \350\241\250\347\244\272\344\270\255\357\274\232<span className=\"font-bold text-rose-600 text-sm\">{totalResultsCount}</span> \344\273\266\n        </div>\n      </div>\n\n      {/* Search input & Sort selector */}\n      <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3\">\n        {/* Search input */}\n        <div className=\"relative flex-1\">\n          <Search className=\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\" />\n          <input\n            id=\"search-input\"\n            type=\"text\"\n            placeholder=\"\345\272\227\345\220\215\343\202\204\343\201\212\343\201\231\343\201\231\343\202\201\343\203\235\343\202\244\343\203\263\343\203\210\343\201\247\346\244\234\347\264\242\357\274\210\344\276\213: \343\203\227\343\203\252\343\203\263\343\200\201\343\203\206\343\203\251\343\202\271\343\200\201\343\203\257\343\202\244\343\203\263\357\274\211\"\n            value={filters.searchQuery}\n            onChange={(e) =>\n              onFilterChange((prev) => ({ ...prev, searchQuery: e.target.value }))\n            }\n            className=\"w-full pl-10 pr-9 py-2.5 bg-stone-50/80 hover:bg-stone-50 focus:bg-white border border-stone-200 rounded-2xl text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-rose-400/30 focus:border-rose-400 transition-all\"\n          />\n          {filters.searchQuery && (\n            <button\n              id=\"clear-search-btn\"\n              onClick={() => onFilterChange((prev) => ({ ...prev, searchQuery: \'\' }))}\n              className=\"absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-600 p-0.5 rounded-full\"\n              title=\"\346\244\234\347\264\242\343\202\257\343\203\252\343\202\242\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          )}\n        </div>\n\n        {/* Sort Selector Dropdown */}\n        <div className=\"flex items-center gap-2\">\n          <div className=\"relative min-w-[170px] sm:min-w-[190px]\">\n            <ArrowUpDown className=\"w-3.5 h-3.5 text-stone-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n            <select\n              id=\"sort-select\"\n              value={filters.sortBy}\n              onChange={(e) =>\n                onFilterChange((prev) => ({\n                  ...prev,\n                  sortBy: e.target.value as SortOption,\n                }))\n              }\n              className=\"w-full pl-8 pr-8 py-2.5 bg-stone-50 hover:bg-stone-100 border border-stone-200 rounded-2xl text-xs sm:text-sm font-semibold text-stone-700 appearance-none focus:outline-none focus:ring-2 focus:ring-rose-400/30 focus:border-rose-400 cursor-pointer transition-all\"\n            >\n              <option value=\"newest\">\350\277\275\345\212\240\346\227\245\346\231\202\357\274\232\346\226\260\343\201\227\343\201\204\351\240\206</option>\n              <option value=\"oldest\">\350\277\275\345\212\240\346\227\245\346\231\202\357\274\232\345\217\244\343\201\204\351\240\206</option>\n              <option value=\"priceAsc\">\344\276\241\346\240\274\345\270\257\357\274\232\345\256\211\343\201\204\351\240\206</option>\n              <option value=\"priceDesc\">\344\276\241\346\240\274\345\270\257\357\274\232\351\253\230\343\201\204\351\240\206</option>\n            </select>\n            <ChevronDown className=\"w-4 h-4 text-stone-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n          </div>\n\n          {/* Toggle Filter Panel button */}\n          <button\n            id=\"toggle-filter-panel-btn\"\n            onClick={() => setIsExpanded(!isExpanded)}\n            className={`flex items-center gap-1.5 px-3.5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold border transition-all duration-200 cursor-pointer ${\n              isExpanded || activeFilterCount > (filters.visitStatus !== \'all\' ? 1 : 0)\n                ? \'bg-rose-50 border-rose-200 text-rose-700 shadow-sm\'\n                : \'bg-stone-50 hover:bg-stone-100 border-stone-200 text-stone-700\'\n            }`}\n          >\n            <SlidersHorizontal className=\"w-3.5 h-3.5\" />\n            <span>\347\265\236\343\202\212\350\276\274\343\201\277</span>\n            {activeFilterCount > 0 && (\n              <span className=\"w-5 h-5 flex items-center justify-center text-[10px] font-extrabold bg-rose-500 text-white rounded-full\">\n                {activeFilterCount}\n              </span>\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Quick Scene Chips Bar (Always visible for fast tap) */}\n      <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none text-xs\">\n        <span className=\"text-stone-400 text-xs font-semibold whitespace-nowrap mr-1 flex items-center gap-1\">\n          <Users2 className=\"w-3 h-3\" />\n          \343\202\267\343\203\274\343\203\263:\n        </span>\n        {ALL_SCENES.map((scene) => {\n          const isSelected = filters.scenes.includes(scene);\n          const style = getSceneStyle(scene);\n          return (\n            <button\n              key={scene}\n              id={`quick-scene-${scene}`}\n              onClick={() => handleToggleScene(scene)}\n              className={`px-3 py-1.5 rounded-full font-medium transition-all duration-150 whitespace-nowrap cursor-pointer ${\n                isSelected\n                  ? \'bg-rose-500 text-white font-bold shadow-sm shadow-rose-200 scale-105\'\n                  : `${style.bg} ${style.text} border ${style.border} hover:opacity-80`\n              }`}\n            >\n              {scene}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Expandable Filter Details (Area, Genre, Price Range) */}\n      {isExpanded && (\n        <div className=\"pt-3 border-t border-stone-100 space-y-4 animate-in fade-in duration-200\">\n          {/* Price Range Filter */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-600\">\n              <Wallet className=\"w-3.5 h-3.5 text-stone-500\" />\n              <span>\344\272\210\347\256\227\343\203\273\344\276\241\346\240\274\345\270\257\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211</span>\n            </div>\n            <div className=\"flex flex-wrap gap-1.5\">\n              {ALL_PRICE_RANGES.map((price) => {\n                const isSelected = filters.priceRanges.includes(price);\n                return (\n                  <button\n                    key={price}\n                    id={`filter-price-${price}`}\n                    onClick={() => handleTogglePriceRange(price)}\n                    className={`px-3 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-stone-900 text-white font-bold shadow-sm\'\n                        : \'bg-stone-100 text-stone-600 hover:bg-stone-200/80 border border-stone-200/60\'\n                    }`}\n                  >\n                    {price}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Area Filter */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-600\">\n              <MapPin className=\"w-3.5 h-3.5 text-stone-500\" />\n              <span>\343\202\250\343\203\252\343\202\242\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211</span>\n            </div>\n            <div className=\"flex flex-wrap gap-1.5 max-h-32 overflow-y-auto pr-1\">\n              {allAreas.map((area) => {\n                const isSelected = filters.areas.includes(area);\n                return (\n                  <button\n                    key={area}\n                    id={`filter-area-${area}`}\n                    onClick={() => handleToggleArea(area)}\n                    className={`px-3 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-rose-500 text-white font-bold shadow-sm shadow-rose-200\'\n                        : \'bg-stone-100 text-stone-600 hover:bg-stone-200/80 border border-stone-200/60\'\n                    }`}\n                  >\n                    {area}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Genre Filter */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-600\">\n              <Tag className=\"w-3.5 h-3.5 text-stone-500\" />\n              <span>\343\202\270\343\203\243\343\203\263\343\203\253\357\274\210\350\244\207\346\225\260\351\201\270\346\212\236\345\217\257\357\274\211</span>\n            </div>\n            <div className=\"flex flex-wrap gap-1.5 max-h-32 overflow-y-auto pr-1\">\n              {allGenres.map((genre) => {\n                const isSelected = filters.genres.includes(genre);\n                const style = getGenreStyle(genre);\n                return (\n                  <button\n                    key={genre}\n                    id={`filter-genre-${genre}`}\n                    onClick={() => handleToggleGenre(genre)}\n                    className={`px-3 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer ${\n                      isSelected\n                        ? \'bg-rose-600 text-white font-bold shadow-sm\'\n                        : `${style.bg} ${style.text} border ${style.border} hover:opacity-80`\n                    }`}\n                  >\n                    {genre}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Active filter tags summary & Reset button */}\n      <div className=\"flex items-center justify-between text-xs pt-1 border-t border-stone-100/80 text-stone-500\">\n        <div className=\"flex items-center gap-1.5 flex-wrap\">\n          {filters.visitStatus === \'unvisited\' && (\n            <span className=\"inline-flex items-center gap-1 bg-amber-100 text-stone-900 px-2 py-0.5 rounded-md border border-amber-200 text-[11px] font-bold\">\n              <Bookmark className=\"w-3 h-3\" /> \346\234\252\350\250\252\345\225\217\357\274\210\350\241\214\343\201\215\343\201\237\343\201\204\357\274\211\343\201\256\343\201\277\n              <button\n                onClick={() => handleSelectVisitStatus(\'all\')}\n                className=\"hover:text-stone-700 ml-0.5\"\n              >\n                <X className=\"w-2.5 h-2.5\" />\n              </button>\n            </span>\n          )}\n\n          {filters.visitStatus === \'visited\' && (\n            <span className=\"inline-flex items-center gap-1 bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-md border border-emerald-200 text-[11px] font-bold\">\n              <CheckCircle2 className=\"w-3 h-3\" /> \350\250\252\345\225\217\346\270\210\343\201\277\357\274\210\350\241\214\343\201\243\343\201\237\357\274\211\343\201\256\343\201\277\n              <button\n                onClick={() => handleSelectVisitStatus(\'all\')}\n                className=\"hover:text-emerald-950 ml-0.5\"\n              >\n                <X className=\"w-2.5 h-2.5\" />\n              </button>\n            </span>\n          )}\n\n          {/* Individual filter dismissal chips */}\n          {filters.favoritesOnly && (\n            <span className=\"inline-flex items-center gap-1 bg-rose-50 text-rose-700 px-2 py-0.5 rounded-md border border-rose-100 text-[11px] font-medium\">\n              \342\230\205 \343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\256\343\201\277\n            </span>\n          )}\n\n          {filters.scenes.map((s) => (\n            <span\n              key={s}\n              onClick={() => handleToggleScene(s)}\n              className=\"inline-flex items-center gap-1 bg-purple-50 text-purple-700 px-2 py-0.5 rounded-md border border-purple-100 text-[11px] font-medium cursor-pointer hover:bg-purple-100\"\n            >\n              {s} <X className=\"w-2.5 h-2.5\" />\n            </span>\n          ))}\n\n          {filters.priceRanges.map((p) => (\n            <span\n              key={p}\n              onClick={() => handleTogglePriceRange(p)}\n              className=\"inline-flex items-center gap-1 bg-amber-50 text-amber-700 px-2 py-0.5 rounded-md border border-amber-100 text-[11px] font-medium cursor-pointer hover:bg-amber-100\"\n            >\n              {p} <X className=\"w-2.5 h-2.5\" />\n            </span>\n          ))}\n\n          {filters.areas.map((a) => (\n            <span\n              key={a}\n              onClick={() => handleToggleArea(a)}\n              className=\"inline-flex items-center gap-1 bg-sky-50 text-sky-700 px-2 py-0.5 rounded-md border border-sky-100 text-[11px] font-medium cursor-pointer hover:bg-sky-100\"\n            >\n              {a} <X className=\"w-2.5 h-2.5\" />\n            </span>\n          ))}\n\n          {filters.genres.map((g) => (\n            <span\n              key={g}\n              onClick={() => handleToggleGenre(g)}\n              className=\"inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-md border border-emerald-100 text-[11px] font-medium cursor-pointer hover:bg-emerald-100\"\n            >\n              {g} <X className=\"w-2.5 h-2.5\" />\n            </span>\n          ))}\n        </div>\n\n        {activeFilterCount > 0 && (\n          <button\n            id=\"reset-all-filters-btn\"\n            onClick={onResetFilters}\n            className=\"flex items-center gap-1 text-stone-500 hover:text-rose-600 font-semibold transition-colors cursor-pointer ml-auto whitespace-nowrap pl-2\"\n          >\n            <RotateCcw className=\"w-3 h-3\" />\n            <span>\346\235\241\344\273\266\343\203\252\343\202\273\343\203\203\343\203\210</span>\n          </button>\n        )}\n      </div>\n    </div>\n  );\n};"
    }
