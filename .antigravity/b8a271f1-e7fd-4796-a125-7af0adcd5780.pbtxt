  file_change {
    absolute_path_uri: "file:///src/components/SpotDetailModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport {\n  X,\n  Heart,\n  MapPin,\n  ExternalLink,\n  Share2,\n  Calendar,\n  Sparkles,\n  Quote,\n  Edit3,\n  Trash2,\n  Check,\n  Tag,\n  Users2,\n  ArrowRight,\n  UtensilsCrossed,\n  Bookmark,\n  CheckCircle2,\n  MessageSquareHeart,\n  Save,\n  Lock,\n  Eye,\n  EyeOff,\n  FolderOpen,\n  AlertTriangle,\n  RotateCcw,\n  Store,\n} from \'lucide-react\';\nimport { RestaurantSpot, OperatingStatus } from \'../types\';\nimport {\n  getGenreStyle,\n  getSceneStyle,\n  PRICE_COLORS,\n  formatJapaneseDate,\n  getRelatedSpots,\n  generateRecommenderAvatar,\n} from \'../utils/helpers\';\nimport { checkStoreOperatingStatus, getOperatingStatusBadge } from \'../utils/aiStatusCheck\';\nimport { SpotDetailMap } from \'./SpotDetailMap\';\n\ninterface SpotDetailModalProps {\n  spot: RestaurantSpot;\n  allSpots: RestaurantSpot[];\n  onClose: () => void;\n  onSelectSpot: (spot: RestaurantSpot) => void;\n  onToggleFavorite: (id: string) => void;\n  onToggleVisited?: (id: string) => void;\n  onUpdateSpot?: (spot: RestaurantSpot) => void;\n  onEditSpot: (spot: RestaurantSpot) => void;\n  onDeleteSpot: (id: string) => void;\n  onShowToast: (message: string) => void;\n  hidePrivateMemoMode?: boolean;\n}\n\nexport const SpotDetailModal: React.FC<SpotDetailModalProps> = ({\n  spot,\n  allSpots,\n  onClose,\n  onSelectSpot,\n  onToggleFavorite,\n  onToggleVisited,\n  onUpdateSpot,\n  onEditSpot,\n  onDeleteSpot,\n  onShowToast,\n  hidePrivateMemoMode = false,\n}) => {\n  const [copied, setCopied] = useState(false);\n  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);\n  \n  // Visit memo state\n  const [isEditingMemo, setIsEditingMemo] = useState(false);\n  const [memoText, setMemoText] = useState(spot.myMemo || \'\');\n  const [visitedDate, setVisitedDate] = useState(\n    spot.visitedAt || new Date().toISOString().split(\'T\')[0]\n  );\n\n  // Private memo state\n  const [isEditingPrivateMemo, setIsEditingPrivateMemo] = useState(false);\n  const [privateMemoText, setPrivateMemoText] = useState(spot.privateMemo || \'\');\n\n  // AI Store Status checking state\n  const [isCheckingStatus, setIsCheckingStatus] = useState(false);\n\n  const avatar = generateRecommenderAvatar(spot.recommender);\n  const priceStyle = PRICE_COLORS[spot.priceRange];\n  const relatedSpots = getRelatedSpots(spot, allSpots);\n  const statusBadge = getOperatingStatusBadge(spot.operatingStatus);\n\n  const handleSaveVisitMemo = () => {\n    if (onUpdateSpot) {\n      onUpdateSpot({\n        ...spot,\n        isVisited: true,\n        visitedAt: visitedDate,\n        myMemo: memoText.trim() || undefined,\n      });\n      setIsEditingMemo(false);\n      onShowToast(\'\350\250\252\345\225\217\343\203\241\343\203\242\343\202\222\346\233\264\346\226\260\343\201\227\343\201\276\343\201\227\343\201\237\360\237\223\235\');\n    }\n  };\n\n  const handleSavePrivateMemo = () => {\n    if (onUpdateSpot) {\n      onUpdateSpot({\n        ...spot,\n        privateMemo: privateMemoText.trim() || undefined,\n      });\n      setIsEditingPrivateMemo(false);\n      onShowToast(\'\360\237\224\222 \350\207\252\345\210\206\345\260\202\347\224\250\351\235\236\345\205\254\351\226\213\343\203\241\343\203\242\343\202\222\344\277\235\345\255\230\343\201\227\343\201\276\343\201\227\343\201\237\');\n    }\n  };\n\n  // AI Status Check Handler\n  const handleCheckStoreStatus = async () => {\n    setIsCheckingStatus(true);\n    onShowToast(\'\342\234\250 AI\343\201\214\346\234\200\346\226\260\343\201\256\345\226\266\346\245\255\347\212\266\346\263\201\343\202\222\350\252\277\346\237\273\344\270\255...\');\n    try {\n      const result = await checkStoreOperatingStatus({\n        name: spot.name,\n        area: spot.area,\n        mapUrl: spot.mapUrl,\n        tabelogUrl: spot.tabelogUrl,\n      });\n\n      if (onUpdateSpot) {\n        onUpdateSpot({\n          ...spot,\n          operatingStatus: result.operatingStatus,\n          statusCheckNote: result.statusCheckNote,\n          lastStatusCheckedAt: result.checkedAt,\n        });\n      }\n\n      const badge = getOperatingStatusBadge(result.operatingStatus);\n      onShowToast(`\345\272\227\350\210\227\347\212\266\346\205\213: \343\200\220${badge.label}\343\200\221 ${result.statusCheckNote}`);\n    } catch (err: any) {\n      console.error(\'Status check error:\', err);\n      onShowToast(\'\345\226\266\346\245\255\347\212\266\346\263\201\343\201\256\347\242\272\350\252\215\343\201\253\345\244\261\346\225\227\343\201\227\343\201\276\343\201\227\343\201\237\');\n    } finally {\n      setIsCheckingStatus(false);\n    }\n  };\n\n  const handleShare = async () => {\n    const shareText = `\360\237\215\264\343\200\220${spot.name}\343\200\221(${spot.area})\\n\360\237\221\244 ${spot.recommender} \343\201\256\343\201\212\343\201\231\343\201\231\343\202\201\357\274\201\\n\360\237\222\260 \344\272\210\347\256\227\357\274\232${spot.priceRange}\\n\360\237\222\254\343\200\214${spot.comment}\343\200\215\\n${\n      spot.mapUrl ? `\360\237\223\215 \343\203\236\343\203\203\343\203\227: ${spot.mapUrl}` : \'\'\n    }`;\n\n    if (navigator.share) {\n      try {\n        await navigator.share({\n          title: `${spot.name} - \345\217\213\343\201\240\343\201\241\343\201\256\343\201\212\343\201\231\343\201\231\343\202\201\343\202\260\343\203\253\343\203\241`,\n          text: shareText,\n        });\n        onShowToast(\'\343\201\212\343\201\231\343\201\231\343\202\201\346\203\205\345\240\261\343\202\222\343\202\267\343\202\247\343\202\242\343\201\227\343\201\276\343\201\227\343\201\237\342\234\250\');\n      } catch {\n        // Fallback to clipboard if dismissed\n      }\n    } else {\n      try {\n        await navigator.clipboard.writeText(shareText);\n        setCopied(true);\n        onShowToast(\'\343\201\212\343\201\231\343\201\231\343\202\201\343\203\206\343\202\255\343\202\271\343\203\210\343\202\222\343\202\257\343\203\252\343\203\203\343\203\227\343\203\234\343\203\274\343\203\211\343\201\253\343\202\263\343\203\224\343\203\274\343\201\227\343\201\276\343\201\227\343\201\237\360\237\223\213\');\n        setTimeout(() => setCopied(false), 2500);\n      } catch {\n        onShowToast(\'\343\202\263\343\203\224\343\203\274\343\201\253\345\244\261\346\225\227\343\201\227\343\201\276\343\201\227\343\201\237\');\n      }\n    }\n  };\n\n  return (\n    <div\n      id=\"spot-detail-backdrop\"\n      className=\"fixed inset-0 z-50 bg-stone-950/60 backdrop-blur-sm flex items-center justify-center p-3 sm:p-5 overflow-y-auto\"\n      onClick={onClose}\n    >\n      <div\n        id=\"spot-detail-content\"\n        className=\"bg-[#FAF8F5] rounded-3xl w-full max-w-2xl overflow-hidden shadow-2xl border border-stone-200/80 my-auto flex flex-col max-h-[92vh] animate-in zoom-in-95 duration-200\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Scrollable Container */}\n        <div className=\"overflow-y-auto flex-1\">\n          {/* Hero Image Section */}\n          <div className=\"relative aspect-[16/9] sm:aspect-[21/9] w-full bg-stone-200\">\n            <img\n              src={\n                spot.imageUrl ||\n                \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80\'\n              }\n              alt={spot.name}\n              className=\"w-full h-full object-cover\"\n              referrerPolicy=\"no-referrer\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-stone-900/80 via-black/20 to-black/40\" />\n\n            {/* Top Bar Actions */}\n            <div className=\"absolute top-4 inset-x-4 flex items-center justify-between\">\n              <button\n                id=\"detail-close-btn\"\n                onClick={onClose}\n                className=\"p-2.5 rounded-full bg-black/40 hover:bg-black/60 text-white backdrop-blur-md transition-colors cursor-pointer\"\n                title=\"\351\226\211\343\201\230\343\202\213\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n\n              <div className=\"flex items-center gap-2\">\n                {/* Visit Status Toggle Button */}\n                <button\n                  id=\"detail-visit-status-btn\"\n                  onClick={() => onToggleVisited && onToggleVisited(spot.id)}\n                  className={`flex items-center gap-1.5 px-3.5 py-2 rounded-full backdrop-blur-md text-xs font-bold transition-all shadow-md active:scale-95 cursor-pointer ${\n                    spot.isVisited\n                      ? \'bg-emerald-500 hover:bg-emerald-600 text-white\'\n                      : \'bg-amber-400 hover:bg-amber-500 text-stone-950\'\n                  }`}\n                  title={spot.isVisited ? \'\350\250\252\345\225\217\346\270\210\343\201\277\357\274\210\343\202\257\343\203\252\343\203\203\343\202\257\343\201\247\343\200\214\350\241\214\343\201\215\343\201\237\343\201\204\343\200\215\343\201\253\345\244\211\346\233\264\357\274\211\' : \'\350\241\214\343\201\215\343\201\237\343\201\204\357\274\210\343\202\257\343\203\252\343\203\203\343\202\257\343\201\247\343\200\214\350\241\214\343\201\243\343\201\237\343\200\215\343\201\253\345\244\211\346\233\264\357\274\211\'}\n                >\n                  {spot.isVisited ? (\n                    <>\n                      <CheckCircle2 className=\"w-4 h-4 stroke-[2.5]\" />\n                      <span>\350\241\214\343\201\243\343\201\237\357\274\201</span>\n                    </>\n                  ) : (\n                    <>\n                      <Bookmark className=\"w-4 h-4 stroke-[2.5]\" />\n                      <span>\350\241\214\343\201\215\343\201\237\343\201\204</span>\n                    </>\n                  )}\n                </button>\n\n                <button\n                  id=\"detail-share-btn\"\n                  onClick={handleShare}\n                  className=\"flex items-center gap-1.5 px-3 py-2 rounded-full bg-white/90 hover:bg-white text-stone-800 backdrop-blur-md text-xs font-bold transition-all shadow-sm cursor-pointer\"\n                  title=\"LINE\343\202\204SNS\343\201\247\343\202\267\343\202\247\343\202\242\"\n                >\n                  {copied ? (\n                    <Check className=\"w-3.5 h-3.5 text-emerald-600\" />\n                  ) : (\n                    <Share2 className=\"w-3.5 h-3.5\" />\n                  )}\n                  <span>{copied ? \'\343\202\263\343\203\224\343\203\274\346\270\210\343\201\277\' : \'\343\202\267\343\202\247\343\202\242\'}</span>\n                </button>\n\n                <button\n                  id=\"detail-fav-btn\"\n                  onClick={() => onToggleFavorite(spot.id)}\n                  className={`p-2.5 rounded-full backdrop-blur-md transition-all cursor-pointer ${\n                    spot.isFavorite\n                      ? \'bg-rose-500 text-white shadow-md shadow-rose-500/40 scale-105\'\n                      : \'bg-white/90 hover:bg-white text-stone-700\'\n                  }`}\n                  title={spot.isFavorite ? \'\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\350\247\243\351\231\244\' : \'\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\253\350\277\275\345\212\240\'}\n                >\n                  <Heart\n                    className={`w-5 h-5 ${\n                      spot.isFavorite ? \'fill-current\' : \'\'\n                    }`}\n                  />\n                </button>\n              </div>\n            </div>\n\n            {/* Bottom Title on Hero */}\n            <div className=\"absolute bottom-4 left-4 right-4 text-white\">\n              <div className=\"flex items-center gap-2 flex-wrap mb-1.5\">\n                <span className=\"inline-flex items-center gap-1 px-3 py-0.5 rounded-full bg-white/90 text-stone-900 font-bold text-xs\">\n                  <MapPin className=\"w-3.5 h-3.5 text-rose-500\" />\n                  {spot.area}\n                </span>\n                <span className={`px-2.5 py-0.5 rounded-full font-bold text-xs ${priceStyle.bg}`}>\n                  {spot.priceRange}\n                </span>\n                {spot.isVisited ? (\n                  <span className=\"px-2.5 py-0.5 rounded-full font-bold text-xs bg-emerald-500 text-white flex items-center gap-1 shadow-sm\">\n                    <CheckCircle2 className=\"w-3 h-3\" /> \350\250\252\345\225\217\346\270\210\343\201\277\n                  </span>\n                ) : (\n                  <span className=\"px-2.5 py-0.5 rounded-full font-bold text-xs bg-amber-400 text-stone-950 flex items-center gap-1 shadow-sm\">\n                    <Bookmark className=\"w-3 h-3\" /> \350\241\214\343\201\215\343\201\237\343\201\204\345\272\227\n                  </span>\n                )}\n              </div>\n              <h2 className=\"text-xl sm:text-2xl md:text-3xl font-extrabold tracking-tight drop-shadow-sm\">\n                {spot.name}\n              </h2>\n            </div>\n          </div>\n\n          {/* Details Body */}\n          <div className=\"p-5 sm:p-7 space-y-6\">\n            {/* Recommender Quote Card (Core App Feature) */}\n            <div className=\"relative bg-gradient-to-br from-slate-900/5 via-amber-500/10 to-stone-100 rounded-3xl p-5 sm:p-6 border border-amber-200/80 shadow-sm\">\n              <Quote className=\"absolute right-5 top-5 w-12 h-12 text-amber-500/20 pointer-events-none\" />\n\n              {/* Recommender identity */}\n              <div className=\"flex items-center gap-3 mb-3\">\n                <div\n                  className={`w-10 h-10 rounded-2xl flex items-center justify-center font-bold text-base shadow-sm ${avatar.bg} ${avatar.text}`}\n                >\n                  {avatar.initial}\n                </div>\n                <div>\n                  <div className=\"text-xs font-bold text-amber-800\">\n                    \343\201\212\343\201\231\343\201\231\343\202\201\343\201\227\343\201\246\343\201\217\343\202\214\343\201\237\344\272\272\n                  </div>\n                  <div className=\"text-base font-bold text-slate-900\">\n                    {spot.recommender}\n                  </div>\n                </div>\n              </div>\n\n              {/* Highlight dish if present */}\n              {spot.highlightDish && (\n                <div className=\"mb-3 inline-flex items-center gap-1.5 px-3 py-1 bg-white/90 rounded-xl border border-amber-300 text-xs font-bold text-amber-900 shadow-2xs\">\n                  <Sparkles className=\"w-3.5 h-3.5 text-amber-600\" />\n                  <span>\343\201\212\343\201\231\343\201\231\343\202\201\343\201\256\344\270\200\345\223\201\357\274\232{spot.highlightDish}</span>\n                </div>\n              )}\n\n              {/* Comment text */}\n              <p className=\"text-stone-800 text-sm sm:text-base leading-relaxed whitespace-pre-wrap font-medium\">\n                {spot.comment}\n              </p>\n            </div>\n\n            {/* Visit Status & My Memo Section */}\n            <div className=\"bg-white rounded-3xl p-5 border border-stone-200/80 shadow-sm space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <div className={`w-8 h-8 rounded-xl flex items-center justify-center ${\n                    spot.isVisited ? \'bg-emerald-100 text-emerald-700\' : \'bg-amber-100 text-amber-800\'\n                  }`}>\n                    {spot.isVisited ? <CheckCircle2 className=\"w-4 h-4\" /> : <Bookmark className=\"w-4 h-4\" />}\n                  </div>\n                  <div>\n                    <h3 className=\"text-sm font-bold text-stone-900\">\n                      \350\250\252\345\225\217\343\202\271\343\203\206\343\203\274\343\202\277\343\202\271\357\274\232{spot.isVisited ? \'\350\250\252\345\225\217\346\270\210\343\201\277\357\274\210\350\241\214\343\201\243\343\201\237\357\274\211\' : \'\346\234\252\350\250\252\345\225\217\357\274\210\350\241\214\343\201\215\343\201\237\343\201\204\357\274\211\'}\n                    </h3>\n                    <p className=\"text-[11px] text-stone-500\">\n                      {spot.isVisited ? \'\345\256\237\351\232\233\343\201\253\350\241\214\343\201\243\343\201\237\350\250\230\351\214\262\343\202\204\346\204\237\346\203\263\343\203\241\343\203\242\' : \'\343\201\276\343\201\240\350\241\214\343\201\243\343\201\246\343\201\204\343\201\252\343\201\204\346\260\227\343\201\253\343\201\252\343\202\213\343\201\212\345\272\227\'}\n                    </p>\n                  </div>\n                </div>\n\n                <button\n                  id=\"detail-memo-toggle-visited-btn\"\n                  onClick={() => onToggleVisited && onToggleVisited(spot.id)}\n                  className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer ${\n                    spot.isVisited\n                      ? \'bg-stone-100 hover:bg-stone-200 text-stone-700\'\n                      : \'bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm\'\n                  }`}\n                >\n                  {spot.isVisited ? \'\343\200\214\350\241\214\343\201\215\343\201\237\343\201\204\343\200\215\343\201\253\346\210\273\343\201\231\' : \'\343\200\214\350\241\214\343\201\243\343\201\237\357\274\201\343\200\215\343\201\253\343\201\231\343\202\213\'}\n                </button>\n              </div>\n\n              {/* If visited, show visit memo and date */}\n              {spot.isVisited && (\n                <div className=\"mt-3 pt-3 border-t border-stone-100 space-y-3\">\n                  {!isEditingMemo ? (\n                    <div className=\"space-y-2\">\n                      <div className=\"flex items-center justify-between text-xs\">\n                        <span className=\"font-semibold text-stone-600 flex items-center gap-1.5\">\n                          <MessageSquareHeart className=\"w-3.5 h-3.5 text-emerald-600\" />\n                          \350\207\252\345\210\206\343\201\256\346\204\237\346\203\263\343\203\273\350\250\252\345\225\217\343\203\241\343\203\242\357\274\210\345\205\261\346\234\211\347\224\250\357\274\211\n                        </span>\n                        <div className=\"flex items-center gap-2\">\n                          {spot.visitedAt && (\n                            <span className=\"text-stone-400\">\n                              \350\250\252\345\225\217\346\227\245: {spot.visitedAt}\n                            </span>\n                          )}\n                          <button\n                            id=\"edit-visit-memo-btn\"\n                            onClick={() => {\n                              setMemoText(spot.myMemo || \'\');\n                              setVisitedDate(spot.visitedAt || new Date().toISOString().split(\'T\')[0]);\n                              setIsEditingMemo(true);\n                            }}\n                            className=\"text-emerald-700 font-bold hover:underline cursor-pointer flex items-center gap-1\"\n                          >\n                            <Edit3 className=\"w-3 h-3\" />\n                            {spot.myMemo ? \'\343\203\241\343\203\242\343\202\222\347\267\250\351\233\206\' : \'\343\203\241\343\203\242\343\202\222\350\277\275\345\212\240\'}\n                          </button>\n                        </div>\n                      </div>\n\n                      {spot.myMemo ? (\n                        <p className=\"text-xs sm:text-sm text-stone-700 bg-emerald-50/60 p-3.5 rounded-2xl border border-emerald-100/80 whitespace-pre-wrap font-normal leading-relaxed\">\n                          {spot.myMemo}\n                        </p>\n                      ) : (\n                        <p className=\"text-xs text-stone-400 italic bg-stone-50 p-3 rounded-2xl border border-stone-100\">\n                          \350\250\252\345\225\217\343\203\241\343\203\242\343\201\257\343\201\276\343\201\240\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\343\200\214\343\203\241\343\203\242\343\202\222\350\277\275\345\212\240\343\200\215\343\201\213\343\202\211\351\243\237\343\201\271\343\201\237\346\204\237\346\203\263\343\202\204\351\233\260\345\233\262\346\260\227\343\202\222\350\250\230\351\214\262\343\201\247\343\201\215\343\201\276\343\201\231\343\200\202\n                        </p>\n                      )}\n                    </div>\n                  ) : (\n                    /* Inline Memo Editor */\n                    <div className=\"space-y-3 bg-stone-50 p-3.5 rounded-2xl border border-stone-200/80 animate-in fade-in duration-150\">\n                      <div className=\"flex items-center justify-between gap-3\">\n                        <label className=\"text-xs font-bold text-stone-700\">\n                          \350\250\252\345\225\217\346\227\245\n                        </label>\n                        <input\n                          id=\"input-visited-date\"\n                          type=\"date\"\n                          value={visitedDate}\n                          onChange={(e) => setVisitedDate(e.target.value)}\n                          className=\"px-3 py-1 bg-white border border-stone-200 rounded-xl text-xs text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-500/30\"\n                        />\n                      </div>\n\n                      <div className=\"space-y-1\">\n                        <label className=\"text-xs font-bold text-stone-700\">\n                          \350\207\252\345\210\206\343\201\256\346\204\237\346\203\263\343\203\273\351\243\237\343\201\271\343\201\237\343\202\202\343\201\256\343\203\241\343\203\242\n                        </label>\n                        <textarea\n                          id=\"input-visited-memo\"\n                          rows={3}\n                          placeholder=\"\344\276\213: \343\203\221\343\202\271\343\202\277\343\201\214\347\265\266\345\223\201\343\201\240\343\201\243\343\201\237\357\274\201\345\272\227\345\223\241\343\201\225\343\202\223\343\201\256\346\216\245\345\256\242\343\202\202\350\246\252\345\210\207\343\201\247\343\201\276\343\201\237\350\241\214\343\201\215\343\201\237\343\201\204\343\200\202\"\n                          value={memoText}\n                          onChange={(e) => setMemoText(e.target.value)}\n                          className=\"w-full px-3 py-2 bg-white border border-stone-200 rounded-xl text-xs text-stone-800 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 resize-none\"\n                        />\n                      </div>\n\n                      <div className=\"flex items-center justify-end gap-2 pt-1\">\n                        <button\n                          type=\"button\"\n                          onClick={() => setIsEditingMemo(false)}\n                          className=\"px-3 py-1.5 rounded-xl bg-stone-200 hover:bg-stone-300 text-stone-700 text-xs font-semibold cursor-pointer\"\n                        >\n                          \343\202\255\343\203\243\343\203\263\343\202\273\343\203\253\n                        </button>\n                        <button\n                          type=\"button\"\n                          onClick={handleSaveVisitMemo}\n                          className=\"flex items-center gap-1 px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-sm cursor-pointer\"\n                        >\n                          <Save className=\"w-3 h-3\" />\n                          \344\277\235\345\255\230\343\201\231\343\202\213\n                        </button>\n                      </div>\n                    </div>\n                  )}\n                </div>\n              )}\n            </div>\n\n            {/* \360\237\224\222 Private Memo Section (\350\207\252\345\210\206\345\260\202\347\224\250\351\235\236\345\205\254\351\226\213\343\203\241\343\203\242) */}\n            <div className=\"bg-stone-900/5 rounded-3xl p-5 border border-stone-300/70 space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-8 h-8 rounded-xl bg-stone-800 text-white flex items-center justify-center\">\n                    <Lock className=\"w-4 h-4\" />\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <h3 className=\"text-sm font-extrabold text-stone-900\">\n                        \360\237\224\222 \350\207\252\345\210\206\345\260\202\347\224\250\343\203\273\351\235\236\345\205\254\351\226\213\343\203\241\343\203\242\n                      </h3>\n                      <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-stone-200 font-bold text-stone-700\">\n                        \344\273\226\344\272\272\343\201\253\343\201\257\350\246\213\343\201\210\343\201\276\343\201\233\343\202\223\n                      </span>\n                    </div>\n                    <p className=\"text-[11px] text-stone-500\">\n                      \345\256\237\351\232\233\343\201\256\343\201\212\344\274\232\350\250\210\351\241\215\343\203\273\344\270\200\347\267\222\343\201\253\350\241\214\343\201\243\343\201\237\344\272\272\343\203\273\343\203\227\343\203\251\343\202\244\343\203\231\343\203\274\343\203\210\343\201\252\345\202\231\345\277\230\351\214\262\n                    </p>\n                  </div>\n                </div>\n\n                {!isEditingPrivateMemo && (\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setPrivateMemoText(spot.privateMemo || \'\');\n                      setIsEditingPrivateMemo(true);\n                    }}\n                    className=\"text-stone-700 text-xs font-bold hover:underline cursor-pointer flex items-center gap-1 px-2.5 py-1 bg-white rounded-xl border border-stone-200\"\n                  >\n                    <Edit3 className=\"w-3 h-3\" />\n                    {spot.privateMemo ? \'\347\267\250\351\233\206\' : \'\350\277\275\345\212\240\'}\n                  </button>\n                )}\n              </div>\n\n              {!isEditingPrivateMemo ? (\n                <div>\n                  {hidePrivateMemoMode ? (\n                    <div className=\"p-3 bg-stone-200/60 rounded-2xl text-xs text-stone-500 flex items-center gap-2 font-medium\">\n                      <EyeOff className=\"w-4 h-4 text-stone-400\" />\n                      <span>\360\237\224\222 \343\203\227\343\203\251\343\202\244\343\203\220\343\202\267\343\203\274\344\277\235\350\255\267\343\201\256\343\201\237\343\202\201\347\217\276\345\234\250\351\235\236\350\241\250\347\244\272\343\201\253\343\201\252\343\201\243\343\201\246\343\201\204\343\201\276\343\201\231\357\274\210\343\203\236\343\202\244\343\203\232\343\203\274\343\202\270\343\201\247\350\247\243\351\231\244\345\217\257\350\203\275\357\274\211</span>\n                    </div>\n                  ) : spot.privateMemo ? (\n                    <div className=\"p-3.5 bg-white rounded-2xl border border-stone-200 text-xs text-stone-800 whitespace-pre-wrap font-medium leading-relaxed\">\n                      {spot.privateMemo}\n                    </div>\n                  ) : (\n                    <div className=\"text-xs text-stone-400 italic\">\n                      \351\235\236\345\205\254\351\226\213\343\203\241\343\203\242\343\201\257\347\231\273\351\214\262\343\201\225\343\202\214\343\201\246\343\201\204\343\201\276\343\201\233\343\202\223\343\200\202\343\200\214\350\277\275\345\212\240\343\200\215\343\201\213\343\202\211\350\250\230\351\214\262\343\201\247\343\201\215\343\201\276\343\201\231\343\200\202\n                    </div>\n                  )}\n                </div>\n              ) : (\n                <div className=\"space-y-2 pt-1 animate-in fade-in duration-150\">\n                  <textarea\n                    rows={2}\n                    value={privateMemoText}\n                    onChange={(e) => setPrivateMemoText(e.target.value)}\n                    placeholder=\"\344\276\213: 2\344\272\272\343\201\247\351\243\262\343\202\223\343\201\247\345\220\210\350\250\210\302\2458,500\343\200\202\343\200\207\343\200\207\343\201\225\343\202\223\343\201\250\350\241\214\343\201\243\343\201\237\343\200\202\344\272\210\347\264\204\345\277\205\351\240\210\343\200\202\"\n                    className=\"w-full px-3 py-2 bg-white border border-stone-300 rounded-xl text-xs text-stone-800 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-400 resize-none\"\n                  />\n                  <div className=\"flex items-center justify-end gap-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setIsEditingPrivateMemo(false)}\n                      className=\"px-3 py-1 rounded-xl bg-stone-200 text-stone-700 text-xs font-bold cursor-pointer\"\n                    >\n                      \343\202\255\343\203\243\343\203\263\343\202\273\343\203\253\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={handleSavePrivateMemo}\n                      className=\"flex items-center gap-1 px-3 py-1 rounded-xl bg-stone-900 text-white text-xs font-bold cursor-pointer\"\n                    >\n                      <Save className=\"w-3 h-3\" />\n                      \344\277\235\345\255\230\n                    </button>\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* AI Store Status & Risk Management Card */}\n            <div className={`p-4 rounded-3xl border transition-all ${\n              statusBadge.isAlert\n                ? \'bg-red-50/80 border-red-200 text-red-900\'\n                : \'bg-white border-stone-200/80\'\n            }`}>\n              <div className=\"flex items-center justify-between gap-3\">\n                <div className=\"flex items-center gap-2\">\n                  <Store className={`w-4 h-4 ${statusBadge.isAlert ? \'text-red-600\' : \'text-stone-500\'}`} />\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-xs font-extrabold text-stone-900\">\n                        \345\226\266\346\245\255\343\202\271\343\203\206\343\203\274\343\202\277\343\202\271\n                      </span>\n                      <span className={`text-[10px] font-extrabold px-2 py-0.5 rounded-full border ${statusBadge.bg} ${statusBadge.text} ${statusBadge.border}`}>\n                        {statusBadge.label}\n                      </span>\n                    </div>\n                    {spot.statusCheckNote && (\n                      <p className=\"text-[11px] text-stone-600 mt-0.5\">\n                        {spot.statusCheckNote}\n                      </p>\n                    )}\n                  </div>\n                </div>\n\n                <button\n                  type=\"button\"\n                  onClick={handleCheckStoreStatus}\n                  disabled={isCheckingStatus}\n                  className=\"shrink-0 flex items-center gap-1 px-3 py-1.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-bold transition-all cursor-pointer disabled:opacity-50\"\n                  title=\"Google\346\244\234\347\264\242\343\201\247\351\226\211\345\272\227\343\202\204\347\247\273\350\273\242\343\200\201\345\226\266\346\245\255\347\212\266\346\205\213\343\202\222AI\347\242\272\350\252\215\"\n                >\n                  <Sparkles className={`w-3.5 h-3.5 text-amber-500 ${isCheckingStatus ? \'animate-spin\' : \'\'}`} />\n                  <span>{isCheckingStatus ? \'AI\347\242\272\350\252\215\344\270\255...\' : \'AI\345\226\266\346\245\255\343\203\201\343\202\247\343\203\203\343\202\257\'}</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Folders List if present */}\n            {spot.folders && spot.folders.length > 0 && (\n              <div className=\"flex items-center gap-2 flex-wrap\">\n                <span className=\"text-xs font-bold text-stone-500 flex items-center gap-1\">\n                  <FolderOpen className=\"w-3.5 h-3.5 text-rose-500\" /> \346\211\200\345\261\236\343\203\225\343\202\251\343\203\253\343\203\200:\n                </span>\n                {spot.folders.map((f) => (\n                  <span\n                    key={f}\n                    className=\"px-2.5 py-1 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-extrabold\"\n                  >\n                    {f}\n                  </span>\n                ))}\n              </div>\n            )}\n\n            {/* Tags & Metadata Overview */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              {/* Genres */}\n              <div className=\"bg-white rounded-2xl p-4 border border-stone-200/70 space-y-2\">\n                <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-500\">\n                  <Tag className=\"w-3.5 h-3.5 text-stone-400\" />\n                  <span>\343\202\270\343\203\243\343\203\263\343\203\253</span>\n                </div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {spot.genres.map((genre) => {\n                    const style = getGenreStyle(genre);\n                    return (\n                      <span\n                        key={genre}\n                        className={`text-xs font-semibold px-2.5 py-1 rounded-xl border ${style.bg} ${style.text} ${style.border}`}\n                      >\n                        {genre}\n                      </span>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Scenes */}\n              <div className=\"bg-white rounded-2xl p-4 border border-stone-200/70 space-y-2\">\n                <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-500\">\n                  <Users2 className=\"w-3.5 h-3.5 text-stone-400\" />\n                  <span>\343\201\212\343\201\231\343\201\231\343\202\201\345\210\251\347\224\250\343\202\267\343\203\274\343\203\263</span>\n                </div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {spot.scenes.map((scene) => {\n                    const style = getSceneStyle(scene);\n                    return (\n                      <span\n                        key={scene}\n                        className={`text-xs font-semibold px-2.5 py-1 rounded-xl border ${style.bg} ${style.text} ${style.border}`}\n                      >\n                        #{scene}\n                      </span>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n\n            {/* Location & Mini Map Section */}\n            <SpotDetailMap spot={spot} onShowToast={onShowToast} />\n\n            {/* Action Buttons Row */}\n            <div className=\"flex items-center justify-between gap-3 pt-2\">\n              <div className=\"text-xs text-stone-500\">\n                <span>\350\250\230\351\214\262\346\227\245: {formatJapaneseDate(spot.createdAt)}</span>\n              </div>\n\n              {/* Edit & Delete Controls */}\n              <div className=\"flex items-center gap-2 justify-end\">\n                <button\n                  id=\"detail-edit-btn\"\n                  onClick={() => onEditSpot(spot)}\n                  className=\"flex items-center gap-1.5 px-4 py-2.5 rounded-2xl bg-white hover:bg-stone-100 text-stone-700 font-semibold text-xs border border-stone-200 transition-colors cursor-pointer\"\n                >\n                  <Edit3 className=\"w-3.5 h-3.5\" />\n                  <span>\347\267\250\351\233\206</span>\n                </button>\n\n                {showDeleteConfirm ? (\n                  <div className=\"flex items-center gap-1\">\n                    <button\n                      id=\"confirm-delete-btn\"\n                      onClick={() => onDeleteSpot(spot.id)}\n                      className=\"px-3 py-2.5 rounded-2xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs transition-colors cursor-pointer\"\n                    >\n                      \345\211\212\351\231\244\343\201\231\343\202\213\n                    </button>\n                    <button\n                      onClick={() => setShowDeleteConfirm(false)}\n                      className=\"px-3 py-2.5 rounded-2xl bg-stone-200 hover:bg-stone-300 text-stone-700 font-semibold text-xs transition-colors cursor-pointer\"\n                    >\n                      \343\202\255\343\203\243\343\203\263\343\202\273\343\203\253\n                    </button>\n                  </div>\n                ) : (\n                  <button\n                    id=\"detail-delete-btn\"\n                    onClick={() => setShowDeleteConfirm(true)}\n                    className=\"p-2.5 rounded-2xl bg-white hover:bg-red-50 text-stone-400 hover:text-red-600 border border-stone-200 transition-colors cursor-pointer\"\n                    title=\"\345\211\212\351\231\244\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                )}\n              </div>\n            </div>\n\n            {/* Related Recommendations */}\n            <div className=\"pt-4 border-t border-stone-200/80 space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-7 h-7 rounded-xl bg-rose-100 flex items-center justify-center text-rose-600\">\n                    <UtensilsCrossed className=\"w-4 h-4\" />\n                  </div>\n                  <div>\n                    <h3 className=\"text-sm sm:text-base font-bold text-stone-900\">\n                      \343\201\223\343\201\206\343\201\204\343\201\206\343\201\256\343\202\202\343\201\212\343\201\231\343\201\231\343\202\201\n                    </h3>\n                    <p className=\"text-[11px] text-stone-500\">\n                      \345\220\214\343\201\230\343\202\250\343\203\252\343\202\242\343\202\204\343\202\270\343\203\243\343\203\263\343\203\253\343\201\256\343\201\212\343\201\231\343\201\231\343\202\201\343\202\271\343\203\235\343\203\203\343\203\210\357\274\210\346\234\200\345\244\2473\344\273\266\357\274\211\n                    </p>\n                  </div>\n                </div>\n              </div>\n\n              {relatedSpots.length > 0 ? (\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  {relatedSpots.map(({ spot: relSpot, matchReasons }) => (\n                    <div\n                      key={relSpot.id}\n                      id={`related-spot-${relSpot.id}`}\n                      onClick={() => onSelectSpot(relSpot)}\n                      className=\"group bg-white rounded-2xl p-3 border border-stone-200/80 hover:border-rose-300 hover:shadow-md transition-all cursor-pointer flex flex-col justify-between\"\n                    >\n                      <div>\n                        {/* Thumbnail */}\n                        <div className=\"relative aspect-[16/10] w-full rounded-xl overflow-hidden mb-2 bg-stone-100\">\n                          <img\n                            src={\n                              relSpot.imageUrl ||\n                              \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80\'\n                            }\n                            alt={relSpot.name}\n                            className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n                            loading=\"lazy\"\n                            referrerPolicy=\"no-referrer\"\n                          />\n                          <span className=\"absolute top-1.5 left-1.5 px-2 py-0.5 rounded-md bg-white/90 backdrop-blur-md text-stone-900 font-bold text-[10px]\">\n                            {relSpot.area}\n                          </span>\n                        </div>\n\n                        {/* Title */}\n                        <h4 className=\"text-xs font-bold text-stone-900 group-hover:text-rose-600 transition-colors line-clamp-1\">\n                          {relSpot.name}\n                        </h4>\n\n                        {/* Match Reason Tag */}\n                        <p className=\"text-[10px] font-semibold text-rose-600 mt-1 line-clamp-1\">\n                          \342\234\250 {matchReasons[0] || \'\343\201\212\343\201\231\343\201\231\343\202\201\'}\n                        </p>\n                      </div>\n\n                      <div className=\"mt-2 pt-2 border-t border-stone-100 flex items-center justify-between text-[10px] text-stone-500\">\n                        <span>{relSpot.priceRange}</span>\n                        <span className=\"flex items-center text-rose-500 font-bold group-hover:translate-x-0.5 transition-transform\">\n                          \350\246\213\343\202\213 <ArrowRight className=\"w-2.5 h-2.5 ml-0.5\" />\n                        </span>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              ) : (\n                <div className=\"bg-white/60 rounded-2xl p-4 text-center text-xs text-stone-500 border border-dashed border-stone-200\">\n                  \345\220\214\343\201\230\343\202\250\343\203\252\343\202\242\343\202\204\343\202\270\343\203\243\343\203\263\343\203\253\343\201\256\344\273\226\343\201\256\347\231\273\351\214\262\345\272\227\343\201\214\343\201\276\343\201\240\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\n                  <br />\n                  \346\226\260\343\201\227\343\201\204\343\201\212\345\272\227\343\202\222\347\231\273\351\214\262\343\201\231\343\202\213\343\201\250\350\207\252\345\213\225\343\201\247\343\203\236\343\203\203\343\203\201\343\203\263\343\202\260\343\201\225\343\202\214\343\201\276\343\201\231\357\274\201\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  X,\n  Heart,\n  MapPin,\n  Share2,\n  Edit3,\n  Trash2,\n  Check,\n  Tag,\n  Users2,\n  ArrowRight,\n  UtensilsCrossed,\n  Bookmark,\n  CheckCircle2,\n  MessageSquareHeart,\n  Save,\n  Lock,\n  EyeOff,\n  FolderOpen,\n  Store,\n  Sparkles,\n} from \'lucide-react\';\nimport { RestaurantSpot } from \'../types\';\nimport {\n  formatJapaneseDate,\n  getRelatedSpots,\n  generateRecommenderAvatar,\n} from \'../utils/helpers\';\nimport { checkStoreOperatingStatus, getOperatingStatusBadge } from \'../utils/aiStatusCheck\';\nimport { SpotDetailMap } from \'./SpotDetailMap\';\n\ninterface SpotDetailModalProps {\n  spot: RestaurantSpot;\n  allSpots: RestaurantSpot[];\n  onClose: () => void;\n  onSelectSpot: (spot: RestaurantSpot) => void;\n  onToggleFavorite: (id: string) => void;\n  onToggleVisited?: (id: string) => void;\n  onUpdateSpot?: (spot: RestaurantSpot) => void;\n  onEditSpot: (spot: RestaurantSpot) => void;\n  onDeleteSpot: (id: string) => void;\n  onShowToast: (message: string) => void;\n  hidePrivateMemoMode?: boolean;\n}\n\nexport const SpotDetailModal: React.FC<SpotDetailModalProps> = ({\n  spot,\n  allSpots,\n  onClose,\n  onSelectSpot,\n  onToggleFavorite,\n  onToggleVisited,\n  onUpdateSpot,\n  onEditSpot,\n  onDeleteSpot,\n  onShowToast,\n  hidePrivateMemoMode = false,\n}) => {\n  const [copied, setCopied] = useState(false);\n  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);\n  \n  // Visit memo state\n  const [isEditingMemo, setIsEditingMemo] = useState(false);\n  const [memoText, setMemoText] = useState(spot.myMemo || \'\');\n  const [visitedDate, setVisitedDate] = useState(\n    spot.visitedAt || new Date().toISOString().split(\'T\')[0]\n  );\n\n  // Private memo state\n  const [isEditingPrivateMemo, setIsEditingPrivateMemo] = useState(false);\n  const [privateMemoText, setPrivateMemoText] = useState(spot.privateMemo || \'\');\n\n  // AI Store Status checking state\n  const [isCheckingStatus, setIsCheckingStatus] = useState(false);\n\n  const avatar = generateRecommenderAvatar(spot.recommender);\n  const relatedSpots = getRelatedSpots(spot, allSpots);\n  const statusBadge = getOperatingStatusBadge(spot.operatingStatus);\n\n  const handleSaveVisitMemo = () => {\n    if (onUpdateSpot) {\n      onUpdateSpot({\n        ...spot,\n        isVisited: true,\n        visitedAt: visitedDate,\n        myMemo: memoText.trim() || undefined,\n      });\n      setIsEditingMemo(false);\n      onShowToast(\'\350\250\252\345\225\217\343\203\241\343\203\242\343\202\222\346\233\264\346\226\260\343\201\227\343\201\276\343\201\227\343\201\237\');\n    }\n  };\n\n  const handleSavePrivateMemo = () => {\n    if (onUpdateSpot) {\n      onUpdateSpot({\n        ...spot,\n        privateMemo: privateMemoText.trim() || undefined,\n      });\n      setIsEditingPrivateMemo(false);\n      onShowToast(\'\351\235\236\345\205\254\351\226\213\343\203\241\343\203\242\343\202\222\344\277\235\345\255\230\343\201\227\343\201\276\343\201\227\343\201\237\');\n    }\n  };\n\n  // AI Status Check Handler\n  const handleCheckStoreStatus = async () => {\n    setIsCheckingStatus(true);\n    onShowToast(\'AI\343\201\214\346\234\200\346\226\260\343\201\256\345\226\266\346\245\255\347\212\266\346\263\201\343\202\222\347\242\272\350\252\215\344\270\255...\');\n    try {\n      const result = await checkStoreOperatingStatus({\n        name: spot.name,\n        area: spot.area,\n        mapUrl: spot.mapUrl,\n        tabelogUrl: spot.tabelogUrl,\n      });\n\n      if (onUpdateSpot) {\n        onUpdateSpot({\n          ...spot,\n          operatingStatus: result.operatingStatus,\n          statusCheckNote: result.statusCheckNote,\n          lastStatusCheckedAt: result.checkedAt,\n        });\n      }\n\n      const badge = getOperatingStatusBadge(result.operatingStatus);\n      onShowToast(`\345\226\266\346\245\255\347\212\266\346\263\201: \343\200\220${badge.label}\343\200\221 ${result.statusCheckNote}`);\n    } catch (err: any) {\n      console.error(\'Status check error:\', err);\n      onShowToast(\'\345\226\266\346\245\255\347\212\266\346\263\201\343\201\256\347\242\272\350\252\215\343\201\253\345\244\261\346\225\227\343\201\227\343\201\276\343\201\227\343\201\237\');\n    } finally {\n      setIsCheckingStatus(false);\n    }\n  };\n\n  const handleShare = async () => {\n    const shareText = `\343\200\220${spot.name}\343\200\221(${spot.area})\\n\343\201\212\343\201\231\343\201\231\343\202\201: ${spot.recommender}\\n\344\272\210\347\256\227: ${spot.priceRange}\\n\343\200\214${spot.comment}\343\200\215\\n${\n      spot.mapUrl ? `\343\203\236\343\203\203\343\203\227: ${spot.mapUrl}` : \'\'\n    }`;\n\n    if (navigator.share) {\n      try {\n        await navigator.share({\n          title: `${spot.name} - \343\201\212\343\201\231\343\201\231\343\202\201\343\202\260\343\203\253\343\203\241`,\n          text: shareText,\n        });\n        onShowToast(\'\343\201\212\343\201\231\343\201\231\343\202\201\346\203\205\345\240\261\343\202\222\343\202\267\343\202\247\343\202\242\343\201\227\343\201\276\343\201\227\343\201\237\');\n      } catch {\n        // Fallback\n      }\n    } else {\n      try {\n        await navigator.clipboard.writeText(shareText);\n        setCopied(true);\n        onShowToast(\'\343\201\212\343\201\231\343\201\231\343\202\201\343\203\206\343\202\255\343\202\271\343\203\210\343\202\222\343\202\263\343\203\224\343\203\274\343\201\227\343\201\276\343\201\227\343\201\237\');\n        setTimeout(() => setCopied(false), 2500);\n      } catch {\n        onShowToast(\'\343\202\263\343\203\224\343\203\274\343\201\253\345\244\261\346\225\227\343\201\227\343\201\276\343\201\227\343\201\237\');\n      }\n    }\n  };\n\n  return (\n    <div\n      id=\"spot-detail-backdrop\"\n      className=\"fixed inset-0 z-50 bg-stone-950/70 backdrop-blur-xs flex items-center justify-center p-3 sm:p-5 overflow-y-auto\"\n      onClick={onClose}\n    >\n      <div\n        id=\"spot-detail-content\"\n        className=\"bg-white rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl border border-stone-200 my-auto flex flex-col max-h-[92vh] animate-in zoom-in-95 duration-150\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Scrollable Container */}\n        <div className=\"overflow-y-auto flex-1\">\n          {/* Hero Image Section */}\n          <div className=\"relative aspect-[16/9] sm:aspect-[21/9] w-full bg-stone-900\">\n            <img\n              src={\n                spot.imageUrl ||\n                \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80\'\n              }\n              alt={spot.name}\n              className=\"w-full h-full object-cover opacity-90\"\n              referrerPolicy=\"no-referrer\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-stone-950/90 via-stone-950/30 to-black/40\" />\n\n            {/* Top Bar Actions */}\n            <div className=\"absolute top-3.5 inset-x-3.5 flex items-center justify-between\">\n              <button\n                id=\"detail-close-btn\"\n                onClick={onClose}\n                className=\"p-2 rounded-full bg-black/50 hover:bg-black/80 text-white backdrop-blur-md transition-colors cursor-pointer\"\n                title=\"\351\226\211\343\201\230\343\202\213\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n\n              <div className=\"flex items-center gap-2\">\n                {/* Visit Status Toggle Button */}\n                <button\n                  id=\"detail-visit-status-btn\"\n                  onClick={() => onToggleVisited && onToggleVisited(spot.id)}\n                  className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg backdrop-blur-md text-xs font-semibold transition-all cursor-pointer ${\n                    spot.isVisited\n                      ? \'bg-stone-900/90 text-stone-200 border border-stone-700 hover:bg-stone-900\'\n                      : \'bg-white/90 hover:bg-white text-stone-900 shadow-sm\'\n                  }`}\n                >\n                  {spot.isVisited ? (\n                    <>\n                      <CheckCircle2 className=\"w-3.5 h-3.5 text-stone-300 stroke-[2.5]\" />\n                      <span>\350\250\252\345\225\217\346\270\210\343\201\277</span>\n                    </>\n                  ) : (\n                    <>\n                      <Bookmark className=\"w-3.5 h-3.5 text-orange-600 stroke-[2.5]\" />\n                      <span>\350\241\214\343\201\215\343\201\237\343\201\204</span>\n                    </>\n                  )}\n                </button>\n\n                <button\n                  id=\"detail-share-btn\"\n                  onClick={handleShare}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/90 hover:bg-white text-stone-900 backdrop-blur-md text-xs font-semibold transition-all shadow-sm cursor-pointer\"\n                  title=\"\343\202\267\343\202\247\343\202\242\"\n                >\n                  {copied ? (\n                    <Check className=\"w-3.5 h-3.5 text-stone-900\" />\n                  ) : (\n                    <Share2 className=\"w-3.5 h-3.5\" />\n                  )}\n                  <span>{copied ? \'\343\202\263\343\203\224\343\203\274\346\270\210\' : \'\343\202\267\343\202\247\343\202\242\'}</span>\n                </button>\n\n                <button\n                  id=\"detail-fav-btn\"\n                  onClick={() => onToggleFavorite(spot.id)}\n                  className={`p-2 rounded-lg backdrop-blur-md transition-all cursor-pointer ${\n                    spot.isFavorite\n                      ? \'bg-white text-orange-600 shadow-sm\'\n                      : \'bg-black/50 hover:bg-black/70 text-white\'\n                  }`}\n                  title={spot.isFavorite ? \'\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\350\247\243\351\231\244\' : \'\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\253\350\277\275\345\212\240\'}\n                >\n                  <Heart\n                    className={`w-4 h-4 ${\n                      spot.isFavorite ? \'fill-orange-600\' : \'\'\n                    }`}\n                  />\n                </button>\n              </div>\n            </div>\n\n            {/* Bottom Title on Hero */}\n            <div className=\"absolute bottom-3.5 left-4 right-4 text-white\">\n              <div className=\"flex items-center gap-2 flex-wrap mb-1.5 text-xs\">\n                <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-white/95 text-stone-900 font-bold\">\n                  <MapPin className=\"w-3 h-3 text-stone-700\" />\n                  {spot.area}\n                </span>\n                <span className=\"px-2 py-0.5 rounded-md font-semibold bg-stone-900/90 text-stone-200 border border-stone-700/60\">\n                  {spot.priceRange}\n                </span>\n                {spot.isVisited ? (\n                  <span className=\"px-2 py-0.5 rounded-md font-medium bg-stone-800/90 text-stone-300 border border-stone-700\">\n                    \350\250\252\345\225\217\346\270\210\343\201\277\n                  </span>\n                ) : (\n                  <span className=\"px-2 py-0.5 rounded-md font-medium bg-orange-600/90 text-white\">\n                    \350\241\214\343\201\215\343\201\237\343\201\204\n                  </span>\n                )}\n              </div>\n              <h2 className=\"text-xl sm:text-2xl font-bold tracking-tight text-white\">\n                {spot.name}\n              </h2>\n            </div>\n          </div>\n\n          {/* Details Body */}\n          <div className=\"p-4 sm:p-6 space-y-5\">\n            {/* Recommender Quote Card */}\n            <div className=\"bg-stone-50 rounded-xl p-4 sm:p-5 border border-stone-200/80\">\n              {/* Recommender identity */}\n              <div className=\"flex items-center gap-2.5 mb-2.5\">\n                <div\n                  className={`w-8 h-8 rounded-lg flex items-center justify-center font-bold text-xs ${avatar.bg} ${avatar.text}`}\n                >\n                  {avatar.initial}\n                </div>\n                <div>\n                  <div className=\"text-[11px] font-medium text-stone-500\">\n                    \343\201\212\343\201\231\343\201\231\343\202\201\343\201\227\343\201\237\344\272\272\n                  </div>\n                  <div className=\"text-sm font-bold text-stone-900\">\n                    {spot.recommender}\n                  </div>\n                </div>\n              </div>\n\n              {/* Highlight dish if present */}\n              {spot.highlightDish && (\n                <div className=\"mb-2.5 inline-flex items-center gap-1 px-2.5 py-1 bg-white rounded-md border border-stone-200 text-xs font-semibold text-stone-800\">\n                  <span>\343\202\244\343\203\201\346\212\274\343\201\227: {spot.highlightDish}</span>\n                </div>\n              )}\n\n              {/* Comment text */}\n              <p className=\"text-stone-800 text-sm leading-relaxed whitespace-pre-wrap font-normal\">\n                {spot.comment}\n              </p>\n            </div>\n\n            {/* Visit Status & My Memo Section */}\n            <div className=\"bg-white rounded-xl p-4 border border-stone-200 space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <div className={`w-7 h-7 rounded-lg flex items-center justify-center ${\n                    spot.isVisited ? \'bg-stone-900 text-white\' : \'bg-stone-100 text-stone-700\'\n                  }`}>\n                    {spot.isVisited ? <CheckCircle2 className=\"w-4 h-4\" /> : <Bookmark className=\"w-4 h-4\" />}\n                  </div>\n                  <div>\n                    <h3 className=\"text-xs font-bold text-stone-900\">\n                      \350\250\252\345\225\217\343\202\271\343\203\206\343\203\274\343\202\277\343\202\271: {spot.isVisited ? \'\350\250\252\345\225\217\346\270\210\343\201\277\' : \'\346\234\252\350\250\252\345\225\217\'}\n                    </h3>\n                    <p className=\"text-[11px] text-stone-500\">\n                      {spot.isVisited ? \'\350\250\252\345\225\217\346\227\245\343\201\250\345\205\254\351\226\213\346\204\237\346\203\263\343\203\241\343\203\242\' : \'\343\201\276\343\201\240\350\241\214\343\201\243\343\201\246\343\201\204\343\201\252\343\201\204\346\260\227\343\201\253\343\201\252\343\202\213\343\201\212\345\272\227\'}\n                    </p>\n                  </div>\n                </div>\n\n                <button\n                  id=\"detail-memo-toggle-visited-btn\"\n                  onClick={() => onToggleVisited && onToggleVisited(spot.id)}\n                  className=\"px-2.5 py-1 rounded-md text-xs font-semibold border border-stone-200 bg-stone-50 hover:bg-stone-100 text-stone-700 transition-colors cursor-pointer\"\n                >\n                  {spot.isVisited ? \'\343\200\214\350\241\214\343\201\215\343\201\237\343\201\204\343\200\215\343\201\253\345\244\211\346\233\264\' : \'\343\200\214\350\250\252\345\225\217\346\270\210\343\201\277\343\200\215\343\201\253\345\244\211\346\233\264\'}\n                </button>\n              </div>\n\n              {/* If visited, show visit memo and date */}\n              {spot.isVisited && (\n                <div className=\"pt-2.5 border-t border-stone-100 space-y-2.5\">\n                  {!isEditingMemo ? (\n                    <div className=\"space-y-1.5\">\n                      <div className=\"flex items-center justify-between text-xs\">\n                        <span className=\"font-semibold text-stone-700 flex items-center gap-1\">\n                          <MessageSquareHeart className=\"w-3.5 h-3.5 text-stone-500\" />\n                          \350\250\252\345\225\217\343\203\241\343\203\242\343\203\273\346\204\237\346\203\263\n                        </span>\n                        <div className=\"flex items-center gap-2\">\n                          {spot.visitedAt && (\n                            <span className=\"text-stone-400 text-[11px]\">\n                              \350\250\252\345\225\217\346\227\245: {spot.visitedAt}\n                            </span>\n                          )}\n                          <button\n                            id=\"edit-visit-memo-btn\"\n                            onClick={() => {\n                              setMemoText(spot.myMemo || \'\');\n                              setVisitedDate(spot.visitedAt || new Date().toISOString().split(\'T\')[0]);\n                              setIsEditingMemo(true);\n                            }}\n                            className=\"text-stone-900 font-semibold hover:underline cursor-pointer flex items-center gap-1 text-[11px]\"\n                          >\n                            <Edit3 className=\"w-3 h-3\" />\n                            {spot.myMemo ? \'\347\267\250\351\233\206\' : \'\350\277\275\345\212\240\'}\n                          </button>\n                        </div>\n                      </div>\n\n                      {spot.myMemo ? (\n                        <p className=\"text-xs text-stone-800 bg-stone-50 p-3 rounded-lg border border-stone-200/80 whitespace-pre-wrap font-normal leading-relaxed\">\n                          {spot.myMemo}\n                        </p>\n                      ) : (\n                        <p className=\"text-xs text-stone-400 italic bg-stone-50 p-2.5 rounded-lg border border-stone-100\">\n                          \350\250\252\345\225\217\343\203\241\343\203\242\343\201\257\343\201\276\343\201\240\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\n                        </p>\n                      )}\n                    </div>\n                  ) : (\n                    /* Inline Memo Editor */\n                    <div className=\"space-y-2.5 bg-stone-50 p-3 rounded-lg border border-stone-200\">\n                      <div className=\"flex items-center justify-between gap-3\">\n                        <label className=\"text-xs font-semibold text-stone-700\">\n                          \350\250\252\345\225\217\346\227\245\n                        </label>\n                        <input\n                          id=\"input-visited-date\"\n                          type=\"date\"\n                          value={visitedDate}\n                          onChange={(e) => setVisitedDate(e.target.value)}\n                          className=\"px-2.5 py-1 bg-white border border-stone-200 rounded-md text-xs text-stone-800 focus:outline-none focus:border-stone-900\"\n                        />\n                      </div>\n\n                      <div className=\"space-y-1\">\n                        <label className=\"text-xs font-semibold text-stone-700\">\n                          \346\204\237\346\203\263\343\203\273\351\243\237\343\201\271\343\201\237\343\202\202\343\201\256\n                        </label>\n                        <textarea\n                          id=\"input-visited-memo\"\n                          rows={3}\n                          placeholder=\"\344\276\213: \343\203\221\343\202\271\343\202\277\343\201\214\347\265\266\345\223\201\343\201\240\343\201\243\343\201\237\343\200\202\345\272\227\345\223\241\343\201\225\343\202\223\343\202\202\350\246\252\345\210\207\343\200\202\"\n                          value={memoText}\n                          onChange={(e) => setMemoText(e.target.value)}\n                          className=\"w-full px-2.5 py-2 bg-white border border-stone-200 rounded-md text-xs text-stone-800 placeholder:text-stone-400 focus:outline-none focus:border-stone-900 resize-none\"\n                        />\n                      </div>\n\n                      <div className=\"flex items-center justify-end gap-2 pt-1\">\n                        <button\n                          type=\"button\"\n                          onClick={() => setIsEditingMemo(false)}\n                          className=\"px-2.5 py-1 rounded-md bg-stone-200 text-stone-700 text-xs font-medium cursor-pointer\"\n                        >\n                          \343\202\255\343\203\243\343\203\263\343\202\273\343\203\253\n                        </button>\n                        <button\n                          type=\"button\"\n                          onClick={handleSaveVisitMemo}\n                          className=\"flex items-center gap-1 px-3 py-1 rounded-md bg-stone-900 hover:bg-stone-800 text-white text-xs font-semibold cursor-pointer\"\n                        >\n                          <Save className=\"w-3 h-3\" />\n                          \344\277\235\345\255\230\n                        </button>\n                      </div>\n                    </div>\n                  )}\n                </div>\n              )}\n            </div>\n\n            {/* \360\237\224\222 Private Memo Section */}\n            <div className=\"bg-stone-50 rounded-xl p-4 border border-stone-200 space-y-2.5\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-7 h-7 rounded-lg bg-stone-800 text-white flex items-center justify-center\">\n                    <Lock className=\"w-3.5 h-3.5\" />\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-1.5\">\n                      <h3 className=\"text-xs font-bold text-stone-900\">\n                        \351\235\236\345\205\254\351\226\213\343\203\241\343\203\242\357\274\210\350\207\252\345\210\206\345\260\202\347\224\250\357\274\211\n                      </h3>\n                    </div>\n                    <p className=\"text-[11px] text-stone-500\">\n                      \344\274\232\350\250\210\351\241\215\343\202\204\345\220\214\344\274\264\350\200\205\343\201\252\343\201\251\343\200\201\344\273\226\344\272\272\343\201\253\345\205\261\346\234\211\343\201\225\343\202\214\343\201\252\343\201\204\343\203\227\343\203\251\343\202\244\343\203\231\343\203\274\343\203\210\345\202\231\345\277\230\351\214\262\n                    </p>\n                  </div>\n                </div>\n\n                {!isEditingPrivateMemo && (\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setPrivateMemoText(spot.privateMemo || \'\');\n                      setIsEditingPrivateMemo(true);\n                    }}\n                    className=\"text-stone-800 text-xs font-semibold hover:underline cursor-pointer flex items-center gap-1 px-2.5 py-1 bg-white rounded-md border border-stone-200\"\n                  >\n                    <Edit3 className=\"w-3 h-3\" />\n                    {spot.privateMemo ? \'\347\267\250\351\233\206\' : \'\350\277\275\345\212\240\'}\n                  </button>\n                )}\n              </div>\n\n              {!isEditingPrivateMemo ? (\n                <div>\n                  {hidePrivateMemoMode ? (\n                    <div className=\"p-2.5 bg-stone-200/70 rounded-md text-xs text-stone-600 flex items-center gap-1.5\">\n                      <EyeOff className=\"w-3.5 h-3.5 text-stone-500\" />\n                      <span>\343\203\227\343\203\251\343\202\244\343\203\220\343\202\267\343\203\274\344\277\235\350\255\267\343\201\256\343\201\237\343\202\201\351\235\236\350\241\250\347\244\272\344\270\255</span>\n                    </div>\n                  ) : spot.privateMemo ? (\n                    <div className=\"p-3 bg-white rounded-md border border-stone-200 text-xs text-stone-800 whitespace-pre-wrap leading-relaxed font-normal\">\n                      {spot.privateMemo}\n                    </div>\n                  ) : (\n                    <div className=\"text-xs text-stone-400 italic\">\n                      \351\235\236\345\205\254\351\226\213\343\203\241\343\203\242\343\201\257\347\231\273\351\214\262\343\201\225\343\202\214\343\201\246\343\201\204\343\201\276\343\201\233\343\202\223\343\200\202\n                    </div>\n                  )}\n                </div>\n              ) : (\n                <div className=\"space-y-2 pt-1\">\n                  <textarea\n                    rows={2}\n                    value={privateMemoText}\n                    onChange={(e) => setPrivateMemoText(e.target.value)}\n                    placeholder=\"\344\276\213: 2\344\272\272\343\201\247\302\2458,500\343\200\202\344\272\210\347\264\204\345\277\205\351\240\210\343\200\202\"\n                    className=\"w-full px-2.5 py-2 bg-white border border-stone-300 rounded-md text-xs text-stone-800 placeholder:text-stone-400 focus:outline-none focus:border-stone-900 resize-none\"\n                  />\n                  <div className=\"flex items-center justify-end gap-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setIsEditingPrivateMemo(false)}\n                      className=\"px-2.5 py-1 rounded-md bg-stone-200 text-stone-700 text-xs font-medium cursor-pointer\"\n                    >\n                      \343\202\255\343\203\243\343\203\263\343\202\273\343\203\253\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={handleSavePrivateMemo}\n                      className=\"flex items-center gap-1 px-3 py-1 rounded-md bg-stone-900 text-white text-xs font-semibold cursor-pointer\"\n                    >\n                      <Save className=\"w-3 h-3\" />\n                      \344\277\235\345\255\230\n                    </button>\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* AI Store Status Check */}\n            <div className={`p-3.5 rounded-xl border transition-all ${\n              statusBadge.isAlert\n                ? \'bg-rose-50 border-rose-200 text-rose-900\'\n                : \'bg-white border-stone-200\'\n            }`}>\n              <div className=\"flex items-center justify-between gap-3\">\n                <div className=\"flex items-center gap-2\">\n                  <Store className=\"w-4 h-4 text-stone-500\" />\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-xs font-bold text-stone-900\">\n                        \345\226\266\346\245\255\343\202\271\343\203\206\343\203\274\343\202\277\343\202\271\n                      </span>\n                      <span className={`text-[10px] font-semibold px-2 py-0.5 rounded border ${statusBadge.bg} ${statusBadge.text} ${statusBadge.border}`}>\n                        {statusBadge.label}\n                      </span>\n                    </div>\n                    {spot.statusCheckNote && (\n                      <p className=\"text-[11px] text-stone-600 mt-0.5\">\n                        {spot.statusCheckNote}\n                      </p>\n                    )}\n                  </div>\n                </div>\n\n                <button\n                  type=\"button\"\n                  onClick={handleCheckStoreStatus}\n                  disabled={isCheckingStatus}\n                  className=\"shrink-0 flex items-center gap-1 px-2.5 py-1 rounded-md bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-semibold transition-all cursor-pointer disabled:opacity-50\"\n                  title=\"Google\346\244\234\347\264\242\343\201\247\345\226\266\346\245\255\347\212\266\346\205\213\343\202\222\347\242\272\350\252\215\"\n                >\n                  <Sparkles className={`w-3 h-3 text-stone-500 ${isCheckingStatus ? \'animate-spin\' : \'\'}`} />\n                  <span>{isCheckingStatus ? \'\347\242\272\350\252\215\344\270\255...\' : \'\345\226\266\346\245\255\343\203\201\343\202\247\343\203\203\343\202\257\'}</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Folders List if present */}\n            {spot.folders && spot.folders.length > 0 && (\n              <div className=\"flex items-center gap-2 flex-wrap\">\n                <span className=\"text-xs font-semibold text-stone-500 flex items-center gap-1\">\n                  <FolderOpen className=\"w-3.5 h-3.5 text-stone-400\" /> \343\203\225\343\202\251\343\203\253\343\203\200:\n                </span>\n                {spot.folders.map((f) => (\n                  <span\n                    key={f}\n                    className=\"px-2 py-0.5 rounded-md bg-stone-100 border border-stone-200 text-stone-700 text-xs font-medium\"\n                  >\n                    {f}\n                  </span>\n                ))}\n              </div>\n            )}\n\n            {/* Tags & Metadata Overview */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              {/* Genres */}\n              <div className=\"bg-white rounded-xl p-3.5 border border-stone-200 space-y-1.5\">\n                <div className=\"flex items-center gap-1.5 text-xs font-semibold text-stone-500\">\n                  <Tag className=\"w-3.5 h-3.5 text-stone-400\" />\n                  <span>\343\202\270\343\203\243\343\203\263\343\203\253</span>\n                </div>\n                <div className=\"flex flex-wrap gap-1\">\n                  {spot.genres.map((genre) => (\n                    <span\n                      key={genre}\n                      className=\"text-xs font-medium px-2 py-0.5 rounded-md bg-stone-100 text-stone-700 border border-stone-200/80\"\n                    >\n                      {genre}\n                    </span>\n                  ))}\n                </div>\n              </div>\n\n              {/* Scenes */}\n              <div className=\"bg-white rounded-xl p-3.5 border border-stone-200 space-y-1.5\">\n                <div className=\"flex items-center gap-1.5 text-xs font-semibold text-stone-500\">\n                  <Users2 className=\"w-3.5 h-3.5 text-stone-400\" />\n                  <span>\343\201\212\343\201\231\343\201\231\343\202\201\343\202\267\343\203\274\343\203\263</span>\n                </div>\n                <div className=\"flex flex-wrap gap-1\">\n                  {spot.scenes.map((scene) => (\n                    <span\n                      key={scene}\n                      className=\"text-xs font-medium px-2 py-0.5 rounded-md bg-stone-100 text-stone-700 border border-stone-200/80\"\n                    >\n                      #{scene}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            </div>\n\n            {/* Location & Mini Map Section */}\n            <SpotDetailMap spot={spot} onShowToast={onShowToast} />\n\n            {/* Action Buttons Row */}\n            <div className=\"flex items-center justify-between gap-3 pt-1\">\n              <div className=\"text-xs text-stone-400\">\n                <span>\347\231\273\351\214\262\346\227\245: {formatJapaneseDate(spot.createdAt)}</span>\n              </div>\n\n              {/* Edit & Delete Controls */}\n              <div className=\"flex items-center gap-2 justify-end\">\n                <button\n                  id=\"detail-edit-btn\"\n                  onClick={() => onEditSpot(spot)}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-stone-100 hover:bg-stone-200 text-stone-700 font-semibold text-xs border border-stone-200 transition-colors cursor-pointer\"\n                >\n                  <Edit3 className=\"w-3.5 h-3.5\" />\n                  <span>\347\267\250\351\233\206</span>\n                </button>\n\n                {showDeleteConfirm ? (\n                  <div className=\"flex items-center gap-1\">\n                    <button\n                      id=\"confirm-delete-btn\"\n                      onClick={() => onDeleteSpot(spot.id)}\n                      className=\"px-3 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-white font-semibold text-xs transition-colors cursor-pointer\"\n                    >\n                      \345\211\212\351\231\244\343\201\231\343\202\213\n                    </button>\n                    <button\n                      onClick={() => setShowDeleteConfirm(false)}\n                      className=\"px-3 py-1.5 rounded-lg bg-stone-100 text-stone-700 text-xs transition-colors cursor-pointer\"\n                    >\n                      \343\202\255\343\203\243\343\203\263\343\202\273\343\203\253\n                    </button>\n                  </div>\n                ) : (\n                  <button\n                    id=\"detail-delete-btn\"\n                    onClick={() => setShowDeleteConfirm(true)}\n                    className=\"p-2 rounded-lg bg-stone-100 hover:bg-stone-200 text-stone-500 hover:text-stone-800 border border-stone-200 transition-colors cursor-pointer\"\n                    title=\"\345\211\212\351\231\244\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                )}\n              </div>\n            </div>\n\n            {/* Related Recommendations */}\n            <div className=\"pt-4 border-t border-stone-200 space-y-3\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-6 h-6 rounded-md bg-stone-100 flex items-center justify-center text-stone-700\">\n                  <UtensilsCrossed className=\"w-3.5 h-3.5\" />\n                </div>\n                <div>\n                  <h3 className=\"text-xs font-bold text-stone-900\">\n                    \344\274\274\343\201\246\343\201\204\343\202\213\343\201\212\343\201\231\343\201\231\343\202\201\343\202\271\343\203\235\343\203\203\343\203\210\n                  </h3>\n                </div>\n              </div>\n\n              {relatedSpots.length > 0 ? (\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2.5\">\n                  {relatedSpots.map(({ spot: relSpot, matchReasons }) => (\n                    <div\n                      key={relSpot.id}\n                      id={`related-spot-${relSpot.id}`}\n                      onClick={() => onSelectSpot(relSpot)}\n                      className=\"group bg-stone-50 hover:bg-white rounded-xl p-2.5 border border-stone-200/80 hover:border-stone-400 hover:shadow-sm transition-all cursor-pointer flex flex-col justify-between\"\n                    >\n                      <div>\n                        {/* Thumbnail */}\n                        <div className=\"relative aspect-[16/10] w-full rounded-lg overflow-hidden mb-2 bg-stone-200\">\n                          <img\n                            src={\n                              relSpot.imageUrl ||\n                              \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80\'\n                            }\n                            alt={relSpot.name}\n                            className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n                            loading=\"lazy\"\n                            referrerPolicy=\"no-referrer\"\n                          />\n                          <span className=\"absolute top-1 left-1 px-1.5 py-0.2 rounded bg-black/60 backdrop-blur-md text-white font-semibold text-[10px]\">\n                            {relSpot.area}\n                          </span>\n                        </div>\n\n                        {/* Title */}\n                        <h4 className=\"text-xs font-bold text-stone-900 group-hover:text-orange-600 transition-colors line-clamp-1\">\n                          {relSpot.name}\n                        </h4>\n\n                        {/* Match Reason Tag */}\n                        <p className=\"text-[10px] font-medium text-stone-500 mt-0.5 line-clamp-1\">\n                          {matchReasons[0] || \'\343\201\212\343\201\231\343\201\231\343\202\201\'}\n                        </p>\n                      </div>\n\n                      <div className=\"mt-2 pt-1.5 border-t border-stone-200/60 flex items-center justify-between text-[10px] text-stone-500\">\n                        <span>{relSpot.priceRange}</span>\n                        <span className=\"flex items-center text-stone-700 font-semibold group-hover:text-orange-600 transition-colors\">\n                          \350\251\263\347\264\260 <ArrowRight className=\"w-2.5 h-2.5 ml-0.5\" />\n                        </span>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              ) : (\n                <div className=\"bg-stone-50 rounded-xl p-3.5 text-center text-xs text-stone-400 border border-dashed border-stone-200\">\n                  \345\220\214\343\201\230\343\202\250\343\203\252\343\202\242\343\202\204\343\202\270\343\203\243\343\203\263\343\203\253\343\201\256\344\273\226\343\201\256\347\231\273\351\214\262\345\272\227\343\201\214\343\201\276\343\201\240\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
    }
