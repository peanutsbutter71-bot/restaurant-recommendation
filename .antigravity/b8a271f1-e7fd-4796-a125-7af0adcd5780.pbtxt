        }
        lines {
          text: "                    operatingStatus === opt.val"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      ? \'bg-stone-900 text-white border-stone-900 shadow-2xs\'"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                      : `${opt.color} hover:opacity-80`"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                      ? \'bg-stone-900 text-white border-stone-900 shadow-xs\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      : \'bg-white text-stone-600 border-stone-200 hover:bg-stone-50\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  }`}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                >"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  {opt.label}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                </button>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              ))}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          {/* Submit Button */}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <div className=\"pt-3\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          <div className=\"pt-2\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <button"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              id=\"submit-spot-btn\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              type=\"submit\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              className=\"w-full py-3.5 rounded-2xl bg-gradient-to-r from-stone-900 to-rose-950 hover:from-rose-600 hover:to-pink-600 text-white font-bold text-sm shadow-md transition-all active:scale-98 cursor-pointer\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              className=\"w-full py-3 rounded-xl bg-stone-900 hover:bg-stone-800 text-white font-semibold text-sm shadow-sm transition-all cursor-pointer\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            >"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              {initialSpot ? \'\345\244\211\346\233\264\343\202\222\344\277\235\345\255\230\343\201\231\343\202\213\' : \'\343\201\212\343\201\231\343\201\231\343\202\201\345\272\227\343\202\222\347\231\273\351\214\262\343\201\231\343\202\213 \342\234\250\'}"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              {initialSpot && \'id\' in initialSpot ? \'\345\244\211\346\233\264\343\202\222\344\277\235\345\255\230\' : \'\343\201\212\343\201\231\343\201\231\343\202\201\345\272\227\343\202\222\347\231\273\351\214\262\'}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            </button>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </form>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  );"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
      }
