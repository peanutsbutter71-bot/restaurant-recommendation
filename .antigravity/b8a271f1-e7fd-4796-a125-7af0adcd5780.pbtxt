  file_change {
    absolute_path_uri: "file:///src/components/SpotListItem.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  Heart,\n  MapPin,\n  Sparkles,\n  ArrowUpRight,\n  CheckCircle2,\n  Bookmark,\n  ExternalLink,\n  Utensils,\n  Map,\n} from \'lucide-react\';\nimport { RestaurantSpot } from \'../types\';\nimport {\n  getSceneStyle,\n  PRICE_COLORS,\n  generateRecommenderAvatar,\n} from \'../utils/helpers\';\n\ninterface SpotListItemProps {\n  spot: RestaurantSpot;\n  onSelect: (spot: RestaurantSpot) => void;\n  onToggleFavorite: (id: string, e: React.MouseEvent) => void;\n  onToggleVisited?: (id: string, e: React.MouseEvent) => void;\n}\n\nexport const SpotListItem: React.FC<SpotListItemProps> = ({\n  spot,\n  onSelect,\n  onToggleFavorite,\n  onToggleVisited,\n}) => {\n  const avatar = generateRecommenderAvatar(spot.recommender);\n  const priceStyle = PRICE_COLORS[spot.priceRange];\n\n  return (\n    <div\n      id={`spot-list-item-${spot.id}`}\n      onClick={() => onSelect(spot)}\n      className=\"group bg-white rounded-2xl border border-stone-200/80 hover:border-rose-300 p-3 sm:p-3.5 shadow-2xs hover:shadow-md transition-all duration-200 flex items-center gap-3 sm:gap-4 cursor-pointer\"\n    >\n      {/* Compact Thumbnail (84px - 100px) */}\n      <div className=\"relative w-20 h-20 sm:w-24 sm:h-24 rounded-xl overflow-hidden bg-stone-100 shrink-0 border border-stone-200/60\">\n        <img\n          src={\n            spot.imageUrl ||\n            \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=400&q=80\'\n          }\n          alt={spot.name}\n          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n          loading=\"lazy\"\n          referrerPolicy=\"no-referrer\"\n        />\n\n        {/* Visit Status mini overlay badge */}\n        <div className=\"absolute top-1 left-1\">\n          <span\n            className={`px-1.5 py-0.5 rounded-md text-[9px] font-extrabold shadow-xs ${\n              spot.isVisited\n                ? \'bg-emerald-600/90 text-white\'\n                : \'bg-amber-500/90 text-stone-900\'\n            }`}\n          >\n            {spot.isVisited ? \'\346\270\210\' : \'\350\241\214\343\201\215\343\201\237\343\201\204\'}\n          </span>\n        </div>\n      </div>\n\n      {/* Main Info Columns */}\n      <div className=\"flex-1 min-w-0 flex flex-col justify-between py-0.5 gap-1.5\">\n        {/* Row 1: Area, Price, Genres & Actions */}\n        <div className=\"flex items-center justify-between gap-2\">\n          <div className=\"flex items-center gap-1.5 flex-wrap min-w-0\">\n            {/* Area Badge */}\n            <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-stone-100 text-stone-800 font-bold text-[11px]\">\n              <MapPin className=\"w-2.5 h-2.5 text-rose-500\" />\n              {spot.area}\n            </span>\n\n            {/* Price badge */}\n            <span\n              className={`px-2 py-0.5 rounded-md text-[10px] sm:text-[11px] font-bold border ${priceStyle.bg} ${priceStyle.text} ${priceStyle.border}`}\n            >\n              {spot.priceRange}\n            </span>\n\n            {/* First Genre */}\n            {spot.genres.slice(0, 2).map((genre) => (\n              <span\n                key={genre}\n                className=\"hidden xs:inline-block px-1.5 py-0.5 rounded-md bg-stone-50 text-stone-600 border border-stone-200/60 text-[10px] font-medium\"\n              >\n                {genre}\n              </span>\n            ))}\n          </div>\n\n          {/* Quick Action buttons: Visit & Favorite */}\n          <div className=\"flex items-center gap-1 shrink-0\">\n            <button\n              type=\"button\"\n              id={`list-visit-toggle-${spot.id}`}\n              onClick={(e) => {\n                e.stopPropagation();\n                onToggleVisited && onToggleVisited(spot.id, e);\n              }}\n              className={`p-1.5 sm:px-2 sm:py-1 rounded-xl text-[11px] font-bold transition-all border active:scale-95 cursor-pointer flex items-center gap-1 ${\n                spot.isVisited\n                  ? \'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100\'\n                  : \'bg-stone-50 text-stone-600 border-stone-200 hover:bg-amber-50 hover:text-amber-700 hover:border-amber-200\'\n              }`}\n              title={spot.isVisited ? \'\350\250\252\345\225\217\346\270\210\343\201\277\357\274\210\343\202\257\343\203\252\343\203\203\343\202\257\343\201\247\343\200\214\350\241\214\343\201\215\343\201\237\343\201\204\343\200\215\343\201\253\345\244\211\346\233\264\357\274\211\' : \'\350\241\214\343\201\215\343\201\237\343\201\204\357\274\210\343\202\257\343\203\252\343\203\203\343\202\257\343\201\247\343\200\214\350\241\214\343\201\243\343\201\237\343\200\215\343\201\253\345\244\211\346\233\264\357\274\211\'}\n            >\n              {spot.isVisited ? (\n                <>\n                  <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600\" />\n                  <span className=\"hidden md:inline\">\350\241\214\343\201\243\343\201\237</span>\n                </>\n              ) : (\n                <>\n                  <Bookmark className=\"w-3.5 h-3.5 text-amber-500\" />\n                  <span className=\"hidden md:inline\">\350\241\214\343\201\215\343\201\237\343\201\204</span>\n                </>\n              )}\n            </button>\n\n            <button\n              type=\"button\"\n              id={`list-fav-btn-${spot.id}`}\n              onClick={(e) => {\n                e.stopPropagation();\n                onToggleFavorite(spot.id, e);\n              }}\n              className={`p-1.5 rounded-xl transition-all border active:scale-90 cursor-pointer ${\n                spot.isFavorite\n                  ? \'bg-rose-50 text-rose-600 border-rose-200 hover:bg-rose-100\'\n                  : \'bg-stone-50 text-stone-400 border-stone-200 hover:text-rose-500 hover:bg-rose-50\'\n              }`}\n              title={spot.isFavorite ? \'\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\350\247\243\351\231\244\' : \'\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\253\350\277\275\345\212\240\'}\n            >\n              <Heart\n                className={`w-3.5 h-3.5 ${\n                  spot.isFavorite ? \'fill-current text-rose-500\' : \'\'\n                }`}\n              />\n            </button>\n          </div>\n        </div>\n\n        {/* Row 2: Shop Name & Highlight Dish */}\n        <div className=\"min-w-0\">\n          <div className=\"flex items-center gap-2\">\n            <h3 className=\"text-sm sm:text-base font-extrabold text-stone-900 group-hover:text-rose-600 transition-colors truncate\">\n              {spot.name}\n            </h3>\n            <ArrowUpRight className=\"w-3.5 h-3.5 text-stone-400 group-hover:text-rose-500 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity\" />\n          </div>\n\n          {spot.highlightDish && (\n            <p className=\"text-[11px] text-rose-600 font-bold truncate flex items-center gap-1 mt-0.5\">\n              <Sparkles className=\"w-3 h-3 shrink-0\" />\n              <span>\346\216\250\343\201\227\357\274\232{spot.highlightDish}</span>\n            </p>\n          )}\n        </div>\n\n        {/* Row 3: Recommender & Comment preview */}\n        <div className=\"flex items-center gap-2 text-xs text-stone-600 min-w-0\">\n          <div className=\"flex items-center gap-1.5 shrink-0\">\n            <span\n              className={`w-4 h-4 rounded-full flex items-center justify-center font-bold text-[9px] ${avatar.bg} ${avatar.text}`}\n            >\n              {avatar.initial}\n            </span>\n            <span className=\"font-semibold text-stone-700 text-[11px] truncate max-w-[100px] sm:max-w-[140px]\">\n              {spot.recommender}\n            </span>\n          </div>\n\n          <span className=\"text-stone-300\">|</span>\n\n          <p className=\"text-[11px] text-stone-500 truncate italic\">\n            \343\200\214{spot.comment}\343\200\215\n          </p>\n        </div>\n\n        {/* Row 4: Scene Tags & External Map Links (optional on larger screens) */}\n        <div className=\"flex items-center justify-between pt-1 border-t border-stone-100 gap-2\">\n          <div className=\"flex items-center gap-1 overflow-hidden\">\n            {spot.scenes.slice(0, 3).map((scene) => {\n              const style = getSceneStyle(scene);\n              return (\n                <span\n                  key={scene}\n                  className={`text-[10px] font-medium px-1.5 py-0.2 rounded-md border ${style.bg} ${style.text} ${style.border}`}\n                >\n                  #{scene}\n                </span>\n              );\n            })}\n          </div>\n\n          <div className=\"flex items-center gap-1.5 shrink-0 text-[10px] font-bold text-stone-400\">\n            {spot.mapUrl && (\n              <a\n                href={spot.mapUrl}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                onClick={(e) => e.stopPropagation()}\n                className=\"hover:text-rose-600 flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-stone-50 hover:bg-rose-50 border border-stone-200/60 transition-colors\"\n                title=\"Google\343\203\236\343\203\203\343\203\227\343\202\222\351\226\213\343\201\217\"\n              >\n                <Map className=\"w-2.5 h-2.5 text-rose-500\" />\n                <span>Map</span>\n              </a>\n            )}\n            {spot.tabelogUrl && (\n              <a\n                href={spot.tabelogUrl}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                onClick={(e) => e.stopPropagation()}\n                className=\"hover:text-amber-700 flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-amber-50/70 hover:bg-amber-100 border border-amber-200/60 text-amber-800 transition-colors\"\n                title=\"\351\243\237\343\201\271\343\203\255\343\202\260\343\202\222\351\226\213\343\201\217\"\n              >\n                <Utensils className=\"w-2.5 h-2.5 text-amber-600\" />\n                <span>\351\243\237\343\201\271\343\203\255\343\202\260</span>\n              </a>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
