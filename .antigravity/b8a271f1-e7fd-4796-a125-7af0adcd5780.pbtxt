        target_content: "            {/* Recommender Quote Card (Core App Feature) */}\n            <div className=\"relative bg-gradient-to-br from-rose-50/90 via-pink-50/60 to-amber-50/50 rounded-3xl p-5 sm:p-6 border border-rose-100/80 shadow-sm\">\n              <Quote className=\"absolute right-5 top-5 w-12 h-12 text-rose-200/50 pointer-events-none\" />\n\n              {/* Recommender identity */}\n              <div className=\"flex items-center gap-3 mb-3\">\n                <div\n                  className={`w-10 h-10 rounded-2xl flex items-center justify-center font-bold text-base shadow-sm ${avatar.bg} ${avatar.text}`}\n                >\n                  {avatar.initial}\n                </div>\n                <div>\n                  <div className=\"text-xs font-semibold text-rose-600\">\n                    \343\201\212\343\201\231\343\201\231\343\202\201\343\201\227\343\201\246\343\201\217\343\202\214\343\201\237\344\272\272\n                  </div>\n                  <div className=\"text-base font-bold text-stone-900\">\n                    {spot.recommender}\n                  </div>\n                </div>\n              </div>\n\n              {/* Highlight dish if present */}\n              {spot.highlightDish && (\n                <div className=\"mb-3 inline-flex items-center gap-1.5 px-3 py-1 bg-white/80 rounded-xl border border-rose-200/70 text-xs font-bold text-rose-700\">\n                  <Sparkles className=\"w-3.5 h-3.5 text-rose-500\" />\n                  <span>\343\201\212\343\201\231\343\201\231\343\202\201\343\201\256\344\270\200\345\223\201\357\274\232{spot.highlightDish}</span>\n                </div>\n              )}\n\n              {/* Comment text */}\n              <p className=\"text-stone-800 text-sm sm:text-base leading-relaxed whitespace-pre-wrap font-medium\">\n                {spot.comment}\n              </p>\n            </div>"
        replacement_content: "            {/* Recommender Quote Card (Core App Feature) */}\n            <div className=\"relative bg-gradient-to-br from-slate-900/5 via-amber-500/10 to-stone-100 rounded-3xl p-5 sm:p-6 border border-amber-200/80 shadow-sm\">\n              <Quote className=\"absolute right-5 top-5 w-12 h-12 text-amber-500/20 pointer-events-none\" />\n\n              {/* Recommender identity */}\n              <div className=\"flex items-center gap-3 mb-3\">\n                <div\n                  className={`w-10 h-10 rounded-2xl flex items-center justify-center font-bold text-base shadow-sm ${avatar.bg} ${avatar.text}`}\n                >\n                  {avatar.initial}\n                </div>\n                <div>\n                  <div className=\"text-xs font-bold text-amber-800\">\n                    \343\201\212\343\201\231\343\201\231\343\202\201\343\201\227\343\201\246\343\201\217\343\202\214\343\201\237\344\272\272\n                  </div>\n                  <div className=\"text-base font-bold text-slate-900\">\n                    {spot.recommender}\n                  </div>\n                </div>\n              </div>\n\n              {/* Highlight dish if present */}\n              {spot.highlightDish && (\n                <div className=\"mb-3 inline-flex items-center gap-1.5 px-3 py-1 bg-white/90 rounded-xl border border-amber-300 text-xs font-bold text-amber-900 shadow-2xs\">\n                  <Sparkles className=\"w-3.5 h-3.5 text-amber-600\" />\n                  <span>\343\201\212\343\201\231\343\201\231\343\202\201\343\201\256\344\270\200\345\223\201\357\274\232{spot.highlightDish}</span>\n                </div>\n              )}\n\n              {/* Comment text */}\n              <p className=\"text-stone-800 text-sm sm:text-base leading-relaxed whitespace-pre-wrap font-medium\">\n                {spot.comment}\n              </p>\n            </div>"
