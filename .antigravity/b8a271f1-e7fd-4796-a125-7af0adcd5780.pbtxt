      replacement_content: "import React, { useState } from \'react\';\nimport {\n  X,\n  Heart,\n  MapPin,\n  ExternalLink,\n  Share2,\n  Calendar,\n  Sparkles,\n  Quote,\n  Edit3,\n  Trash2,\n  Check,\n  Tag,\n  Wallet,\n  Users2,\n  ArrowRight,\n  UtensilsCrossed,\n} from \'lucide-react\';\nimport { RestaurantSpot } from \'../types\';\nimport {\n  getGenreStyle,\n  getSceneStyle,\n  PRICE_COLORS,\n  formatJapaneseDate,\n  getRelatedSpots,\n  generateRecommenderAvatar,\n} from \'../utils/helpers\';\n\ninterface SpotDetailModalProps {\n  spot: RestaurantSpot;\n  allSpots: RestaurantSpot[];\n  onClose: () => void;\n  onSelectSpot: (spot: RestaurantSpot) => void;\n  onToggleFavorite: (id: string) => void;\n  onEditSpot: (spot: RestaurantSpot) => void;\n  onDeleteSpot: (id: string) => void;\n  onShowToast: (message: string) => void;\n}\n\nexport const SpotDetailModal: React.FC<SpotDetailModalProps> = ({\n  spot,\n  allSpots,\n  onClose,\n  onSelectSpot,\n  onToggleFavorite,\n  onEditSpot,\n  onDeleteSpot,\n  onShowToast,\n}) => {\n  const [copied, setCopied] = useState(false);\n  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);\n\n  const avatar = generateRecommenderAvatar(spot.recommender);\n  const priceStyle = PRICE_COLORS[spot.priceRange];\n  const relatedSpots = getRelatedSpots(spot, allSpots);\n\n  const handleShare = async () => {\n    const shareText = `\360\237\215\264\343\200\220${spot.name}\343\200\221(${spot.area})\\n\360\237\221\244 ${spot.recommender} \343\201\256\343\201\212\343\201\231\343\201\231\343\202\201\357\274\201\\n\360\237\222\260 \344\272\210\347\256\227\357\274\232${spot.priceRange}\\n\360\237\222\254\343\200\214${spot.comment}\343\200\215\\n${\n      spot.mapUrl ? `\360\237\223\215 \343\203\236\343\203\203\343\203\227: ${spot.mapUrl}` : \'\'\n    }`;\n\n    if (navigator.share) {\n      try {\n        await navigator.share({\n          title: `${spot.name} - \345\217\213\343\201\240\343\201\241\343\201\256\343\201\212\343\201\231\343\201\231\343\202\201\343\202\260\343\203\253\343\203\241`,\n          text: shareText,\n        });\n        onShowToast(\'\343\201\212\343\201\231\343\201\231\343\202\201\346\203\205\345\240\261\343\202\222\343\202\267\343\202\247\343\202\242\343\201\227\343\201\276\343\201\227\343\201\237\342\234\250\');\n      } catch {\n        // Fallback to clipboard if dismissed\n      }\n    } else {\n      try {\n        await navigator.clipboard.writeText(shareText);\n        setCopied(true);\n        onShowToast(\'\343\201\212\343\201\231\343\201\231\343\202\201\343\203\206\343\202\255\343\202\271\343\203\210\343\202\222\343\202\257\343\203\252\343\203\203\343\203\227\343\203\234\343\203\274\343\203\211\343\201\253\343\202\263\343\203\224\343\203\274\343\201\227\343\201\276\343\201\227\343\201\237\360\237\223\213\');\n        setTimeout(() => setCopied(false), 2500);\n      } catch {\n        onShowToast(\'\343\202\263\343\203\224\343\203\274\343\201\253\345\244\261\346\225\227\343\201\227\343\201\276\343\201\227\343\201\237\');\n      }\n    }\n  };\n\n  return (\n    <div\n      id=\"spot-detail-backdrop\"\n      className=\"fixed inset-0 z-50 bg-stone-950/60 backdrop-blur-sm flex items-center justify-center p-3 sm:p-5 overflow-y-auto\"\n      onClick={onClose}\n    >\n      <div\n        id=\"spot-detail-content\"\n        className=\"bg-[#FAF8F5] rounded-3xl w-full max-w-2xl overflow-hidden shadow-2xl border border-stone-200/80 my-auto flex flex-col max-h-[92vh] animate-in zoom-in-95 duration-200\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Scrollable Container */}\n        <div className=\"overflow-y-auto flex-1\">\n          {/* Hero Image Section */}\n          <div className=\"relative aspect-[16/9] sm:aspect-[21/9] w-full bg-stone-200\">\n            <img\n              src={\n                spot.imageUrl ||\n                \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80\'\n              }\n              alt={spot.name}\n              className=\"w-full h-full object-cover\"\n              referrerPolicy=\"no-referrer\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-stone-900/80 via-black/20 to-black/40\" />\n\n            {/* Top Bar Actions */}\n            <div className=\"absolute top-4 inset-x-4 flex items-center justify-between\">\n              <button\n                id=\"detail-close-btn\"\n                onClick={onClose}\n                className=\"p-2.5 rounded-full bg-black/40 hover:bg-black/60 text-white backdrop-blur-md transition-colors cursor-pointer\"\n                title=\"\351\226\211\343\201\230\343\202\213\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n\n              <div className=\"flex items-center gap-2\">\n                <button\n                  id=\"detail-share-btn\"\n                  onClick={handleShare}\n                  className=\"flex items-center gap-1.5 px-3 py-2 rounded-full bg-white/90 hover:bg-white text-stone-800 backdrop-blur-md text-xs font-bold transition-all shadow-sm cursor-pointer\"\n                  title=\"LINE\343\202\204SNS\343\201\247\343\202\267\343\202\247\343\202\242\"\n                >\n                  {copied ? (\n                    <Check className=\"w-3.5 h-3.5 text-emerald-600\" />\n                  ) : (\n                    <Share2 className=\"w-3.5 h-3.5\" />\n                  )}\n                  <span>{copied ? \'\343\202\263\343\203\224\343\203\274\346\270\210\343\201\277\' : \'\343\202\267\343\202\247\343\202\242\'}</span>\n                </button>\n\n                <button\n                  id=\"detail-fav-btn\"\n                  onClick={() => onToggleFavorite(spot.id)}\n                  className={`p-2.5 rounded-full backdrop-blur-md transition-all cursor-pointer ${\n                    spot.isFavorite\n                      ? \'bg-rose-500 text-white shadow-md shadow-rose-500/40 scale-105\'\n                      : \'bg-white/90 hover:bg-white text-stone-700\'\n                  }`}\n                  title={spot.isFavorite ? \'\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\350\247\243\351\231\244\' : \'\343\201\212\346\260\227\343\201\253\345\205\245\343\202\212\343\201\253\350\277\275\345\212\240\'}\n                >\n                  <Heart\n                    className={`w-5 h-5 ${\n                      spot.isFavorite ? \'fill-current\' : \'\'\n                    }`}\n                  />\n                </button>\n              </div>\n            </div>\n\n            {/* Bottom Title on Hero */}\n            <div className=\"absolute bottom-4 left-4 right-4 text-white\">\n              <div className=\"flex items-center gap-2 flex-wrap mb-1.5\">\n                <span className=\"inline-flex items-center gap-1 px-3 py-0.5 rounded-full bg-white/90 text-stone-900 font-bold text-xs\">\n                  <MapPin className=\"w-3.5 h-3.5 text-rose-500\" />\n                  {spot.area}\n                </span>\n                <span className={`px-2.5 py-0.5 rounded-full font-bold text-xs ${priceStyle.bg}`}>\n                  {spot.priceRange}\n                </span>\n              </div>\n              <h2 className=\"text-xl sm:text-2xl md:text-3xl font-extrabold tracking-tight drop-shadow-sm\">\n                {spot.name}\n              </h2>\n            </div>\n          </div>\n\n          {/* Details Body */}\n          <div className=\"p-5 sm:p-7 space-y-6\">\n            {/* Recommender Quote Card (Core App Feature) */}\n            <div className=\"relative bg-gradient-to-br from-rose-50/90 via-pink-50/60 to-amber-50/50 rounded-3xl p-5 sm:p-6 border border-rose-100/80 shadow-sm\">\n              <Quote className=\"absolute right-5 top-5 w-12 h-12 text-rose-200/50 pointer-events-none\" />\n\n              {/* Recommender identity */}\n              <div className=\"flex items-center gap-3 mb-3\">\n                <div\n                  className={`w-10 h-10 rounded-2xl flex items-center justify-center font-bold text-base shadow-sm ${avatar.bg} ${avatar.text}`}\n                >\n                  {avatar.initial}\n                </div>\n                <div>\n                  <div className=\"text-xs font-semibold text-rose-600\">\n                    \343\201\212\343\201\231\343\201\231\343\202\201\343\201\227\343\201\246\343\201\217\343\202\214\343\201\237\344\272\272\n                  </div>\n                  <div className=\"text-base font-bold text-stone-900\">\n                    {spot.recommender}\n                  </div>\n                </div>\n              </div>\n\n              {/* Highlight dish if present */}\n              {spot.highlightDish && (\n                <div className=\"mb-3 inline-flex items-center gap-1.5 px-3 py-1 bg-white/80 rounded-xl border border-rose-200/70 text-xs font-bold text-rose-700\">\n                  <Sparkles className=\"w-3.5 h-3.5 text-rose-500\" />\n                  <span>\343\201\212\343\201\231\343\201\231\343\202\201\343\201\256\344\270\200\345\223\201\357\274\232{spot.highlightDish}</span>\n                </div>\n              )}\n\n              {/* Comment text */}\n              <p className=\"text-stone-800 text-sm sm:text-base leading-relaxed whitespace-pre-wrap font-medium\">\n                {spot.comment}\n              </p>\n            </div>\n\n            {/* Tags & Metadata Overview */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              {/* Genres */}\n              <div className=\"bg-white rounded-2xl p-4 border border-stone-200/70 space-y-2\">\n                <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-500\">\n                  <Tag className=\"w-3.5 h-3.5 text-stone-400\" />\n                  <span>\343\202\270\343\203\243\343\203\263\343\203\253</span>\n                </div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {spot.genres.map((genre) => {\n                    const style = getGenreStyle(genre);\n                    return (\n                      <span\n                        key={genre}\n                        className={`text-xs font-semibold px-2.5 py-1 rounded-xl border ${style.bg} ${style.text} ${style.border}`}\n                      >\n                        {genre}\n                      </span>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Scenes */}\n              <div className=\"bg-white rounded-2xl p-4 border border-stone-200/70 space-y-2\">\n                <div className=\"flex items-center gap-1.5 text-xs font-bold text-stone-500\">\n                  <Users2 className=\"w-3.5 h-3.5 text-stone-400\" />\n                  <span>\343\201\212\343\201\231\343\201\231\343\202\201\345\210\251\347\224\250\343\202\267\343\203\274\343\203\263</span>\n                </div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {spot.scenes.map((scene) => {\n                    const style = getSceneStyle(scene);\n                    return (\n                      <span\n                        key={scene}\n                        className={`text-xs font-semibold px-2.5 py-1 rounded-xl border ${style.bg} ${style.text} ${style.border}`}\n                      >\n                        #{scene}\n                      </span>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n\n            {/* Google Map Link & Action Row */}\n            <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-2\">\n              {spot.mapUrl ? (\n                <a\n                  id=\"detail-map-link\"\n                  href={spot.mapUrl}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-stone-900 hover:bg-stone-800 text-white font-bold text-sm shadow-md transition-all active:scale-98\"\n                >\n                  <MapPin className=\"w-4 h-4 text-rose-400\" />\n                  <span>Google\343\203\236\343\203\203\343\203\227\343\201\247\351\226\213\343\201\217</span>\n                  <ExternalLink className=\"w-3.5 h-3.5 text-stone-400 ml-1\" />\n                </a>\n              ) : (\n                <a\n                  id=\"detail-map-search-link\"\n                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(\n                    `${spot.name} ${spot.area}`\n                  )}`}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-stone-100 hover:bg-stone-200 text-stone-800 font-bold text-sm border border-stone-200 transition-all\"\n                >\n                  <MapPin className=\"w-4 h-4 text-rose-500\" />\n                  <span>Google\343\203\236\343\203\203\343\203\227\343\201\247\345\272\227\345\220\215\343\202\222\346\244\234\347\264\242</span>\n                  <ExternalLink className=\"w-3.5 h-3.5 text-stone-400 ml-1\" />\n                </a>\n              )}\n\n              {/* Edit & Delete Controls */}\n              <div className=\"flex items-center gap-2 justify-end\">\n                <button\n                  id=\"detail-edit-btn\"\n                  onClick={() => onEditSpot(spot)}\n                  className=\"flex items-center gap-1.5 px-4 py-3 rounded-2xl bg-white hover:bg-stone-100 text-stone-700 font-semibold text-xs border border-stone-200 transition-colors cursor-pointer\"\n                >\n                  <Edit3 className=\"w-3.5 h-3.5\" />\n                  <span>\347\267\250\351\233\206</span>\n                </button>\n\n                {showDeleteConfirm ? (\n                  <div className=\"flex items-center gap-1\">\n                    <button\n                      id=\"confirm-delete-btn\"\n                      onClick={() => onDeleteSpot(spot.id)}\n                      className=\"px-3 py-3 rounded-2xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs transition-colors cursor-pointer\"\n                    >\n                      \345\211\212\351\231\244\343\201\231\343\202\213\n                    </button>\n                    <button\n                      onClick={() => setShowDeleteConfirm(false)}\n                      className=\"px-3 py-3 rounded-2xl bg-stone-200 hover:bg-stone-300 text-stone-700 font-semibold text-xs transition-colors cursor-pointer\"\n                    >\n                      \343\202\255\343\203\243\343\203\263\343\202\273\343\203\253\n                    </button>\n                  </div>\n                ) : (\n                  <button\n                    id=\"detail-delete-btn\"\n                    onClick={() => setShowDeleteConfirm(true)}\n                    className=\"p-3 rounded-2xl bg-white hover:bg-red-50 text-stone-400 hover:text-red-600 border border-stone-200 transition-colors cursor-pointer\"\n                    title=\"\345\211\212\351\231\244\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                )}\n              </div>\n            </div>\n\n            {/* Added date metadata */}\n            <div className=\"flex items-center gap-1.5 text-xs text-stone-400 pt-2 border-t border-stone-100\">\n              <Calendar className=\"w-3.5 h-3.5\" />\n              <span>\350\250\230\351\214\262\346\227\245: {formatJapaneseDate(spot.createdAt)}</span>\n            </div>\n\n            {/* Requirement 3: \343\200\214\343\201\223\343\201\206\343\201\204\343\201\206\343\201\256\343\202\202\343\201\212\343\201\231\343\201\231\343\202\201\343\200\215\346\251\237\350\203\275 (Related Recommendations) */}\n            <div className=\"pt-4 border-t border-stone-200/80 space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-7 h-7 rounded-xl bg-rose-100 flex items-center justify-center text-rose-600\">\n                    <UtensilsCrossed className=\"w-4 h-4\" />\n                  </div>\n                  <div>\n                    <h3 className=\"text-sm sm:text-base font-bold text-stone-900\">\n                      \343\201\223\343\201\206\343\201\204\343\201\206\343\201\256\343\202\202\343\201\212\343\201\231\343\201\231\343\202\201\n                    </h3>\n                    <p className=\"text-[11px] text-stone-500\">\n                      \345\220\214\343\201\230\343\202\250\343\203\252\343\202\242\343\202\204\343\202\270\343\203\243\343\203\263\343\203\253\343\201\256\343\201\212\343\201\231\343\201\231\343\202\201\343\202\271\343\203\235\343\203\203\343\203\210\357\274\210\346\234\200\345\244\2473\344\273\266\357\274\211\n                    </p>\n                  </div>\n                </div>\n              </div>\n\n              {relatedSpots.length > 0 ? (\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  {relatedSpots.map(({ spot: relSpot, matchReasons }) => (\n                    <div\n                      key={relSpot.id}\n                      id={`related-spot-${relSpot.id}`}\n                      onClick={() => onSelectSpot(relSpot)}\n                      className=\"group bg-white rounded-2xl p-3 border border-stone-200/80 hover:border-rose-300 hover:shadow-md transition-all cursor-pointer flex flex-col justify-between\"\n                    >\n                      <div>\n                        {/* Thumbnail */}\n                        <div className=\"relative aspect-[16/10] w-full rounded-xl overflow-hidden mb-2 bg-stone-100\">\n                          <img\n                            src={\n                              relSpot.imageUrl ||\n                              \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80\'\n                            }\n                            alt={relSpot.name}\n                            className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n                            loading=\"lazy\"\n                            referrerPolicy=\"no-referrer\"\n                          />\n                          <span className=\"absolute top-1.5 left-1.5 px-2 py-0.5 rounded-md bg-white/90 backdrop-blur-md text-stone-900 font-bold text-[10px]\">\n                            {relSpot.area}\n                          </span>\n                        </div>\n\n                        {/* Title */}\n                        <h4 className=\"text-xs font-bold text-stone-900 group-hover:text-rose-600 transition-colors line-clamp-1\">\n                          {relSpot.name}\n                        </h4>\n\n                        {/* Match Reason Tag */}\n                        <p className=\"text-[10px] font-semibold text-rose-600 mt-1 line-clamp-1\">\n                          \342\234\250 {matchReasons[0] || \'\343\201\212\343\201\231\343\201\231\343\202\201\'}\n                        </p>\n                      </div>\n\n                      <div className=\"mt-2 pt-2 border-t border-stone-100 flex items-center justify-between text-[10px] text-stone-500\">\n                        <span>{relSpot.priceRange}</span>\n                        <span className=\"flex items-center text-rose-500 font-bold group-hover:translate-x-0.5 transition-transform\">\n                          \350\246\213\343\202\213 <ArrowRight className=\"w-2.5 h-2.5 ml-0.5\" />\n                        </span>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              ) : (\n                <div className=\"bg-white/60 rounded-2xl p-4 text-center text-xs text-stone-500 border border-dashed border-stone-200\">\n                  \345\220\214\343\201\230\343\202\250\343\203\252\343\202\242\343\202\204\343\202\270\343\203\243\343\203\263\343\203\253\343\201\256\344\273\226\343\201\256\347\231\273\351\214\262\345\272\227\343\201\214\343\201\276\343\201\240\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\n                  <br />\n                  \346\226\260\343\201\227\343\201\204\343\201\212\345\272\227\343\202\222\347\231\273\351\214\262\343\201\231\343\202\213\343\201\250\350\207\252\345\213\225\343\201\247\343\203\236\343\203\203\343\203\201\343\203\263\343\202\260\343\201\225\343\202\214\343\201\276\343\201\231\357\274\201\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
