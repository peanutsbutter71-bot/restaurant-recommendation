        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (filters.sortBy === \'priceAsc\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const orderDiff = PRICE_ORDER[a.priceRange] - PRICE_ORDER[b.priceRange];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (orderDiff !== 0) return orderDiff;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();"
