reas Display */\n            <div className=\"space-y-2\">\n              {/* Recommended Genres & Areas Grid */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1\">\n                {/* Top Recommended Genres */}\n                <div className=\"bg-rose-50/60 rounded-xl p-2 border border-rose-100/80 space-y-1\">\n                  <div className=\"flex items-center justify-between text-[10px] font-bold text-rose-800\">\n                    <span className=\"flex items-center gap-1\">\n                      <Utensils className=\"w-3 h-3 text-rose-500\" />\n                      \343\201\212\343\201\231\343\201\231\343\202\201\343\202\270\343\203\243\343\203\263\343\203\253\n                    </span>\n                    <span className=\"text-[9px] text-rose-500/80\">\345\245\275\346\204\237\345\272\246\343\202\271\343\202\263\343\202\242</span>\n                  </div>\n                  <div className=\"flex flex-wrap gap-1\">\n                    {summary.topGenres.length > 0 ? (\n                      summary.topGenres.map((g) => (\n                        <span\n                          key={g.name}\n                          className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-white text-rose-700 text-[10px] font-extrabold border border-rose-200/90 shadow-2xs transition-all hover:scale-105\"\n                        >\n                          <span>{g.name}</span>\n                          <span className=\"text-[9px] font-black text-rose-500 bg-rose-50 px-1 rounded-sm\">\n                            +{g.score}\n                          </span>\n                        </span>\n                      ))\n                    ) : (\n                      <span className=\"text-[10px] text-stone-400 italic\">\345\255\246\347\277\222\344\270\255...</span>\n                    )}\n                  </div>\n                </div>\n\n                {/* Top Recommended Areas */}\n                <div className=\"bg-amber-50/60 rounded-xl p-2 border border-amber-100/80 space-y-1\">\n                  <div className=\"flex items-center justify-between text-[10px] font-bold text-amber-800\">\n                    <span className=\"flex items-center gap-1\">\n                      <MapPin className=\"w-3 h-3 text-amber-600\" />\n                      \343\201\212\343\201\231\343\201\231\343\202\201\343\202\250\343\203\252\343\202\242\n                    </span>\n                    <span className=\"text-[9px] text-amber-600/80\">\345\245\275\346\204\237\345\272\246\343\202\271\343\202\263\343\202\242</span>\n                  </div>\n                  <div className=\"flex flex-wrap gap-1\">\n                    {summary.topAreas.length > 0 ? (\n                      summary.topAreas.map((a) => (\n                        <span\n                          key={a.name}\n                          className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-white text-amber-900 text-[10px] font-extrabold border border-amber-200/90 shadow-2xs transition-all hover:scale-105\"\n                        >\n                          <span>{a.name}</span>\n                          <span className=\"text-[9px] font-black text-amber-600 bg-amber-50 px-1 rounded-sm\">\n                            +{a.score}\n                          </span>\n                        </span>\n                      ))\n                    ) : (\n                      <span className=\"text-[10px] text-stone-400 italic\">\345\255\246\347\277\222\344\270\255...</span>\n                    )}\n                  </div>\n                </div>\n              </div>\n\n              {/* Sub bar: Top Scenes & Detailed Report Link */}\n              <div className=\"flex items-center justify-between pt-0.5 text-[10px]\">\n                <div className=\"flex items-center gap-1 text-stone-500 overflow-hidden\">\n                  <span className=\"font-bold text-stone-600 shrink-0\">\345\245\275\343\201\277\343\20