03\203\343\203\227\343\203\225\343\202\241\343\202\244\343\203\253\343\201\256\345\275\242\345\274\217\343\201\214\346\255\243\343\201\227\343\201\217\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\');\n        }\n\n        resolve({\n          spots: loadedSpots,\n          folders: loadedFolders,\n        });\n      } catch (err: any) {\n        reject(new Error(err.message || \'JSON\343\203\225\343\202\241\343\202\244\343\203\253\343\201\256\350\252\255\343\201\277\350\276\274\343\201\277\343\201\253\345\244\261\346\225\227\343\201\227\343\201\276\343\201\227\343\201\237\'));\n      }\n    };\n    reader.onerror = () => {\n      reject(new Error(\'\343\203\225\343\202\241\343\202\244\343\203\253\343\201\256\350\252\255\343\201\277\350\276\274\343\201\277\344\270\255\343\201\253\343\202\250\343\203\251\343\203\274\343\201\214\347\231\272\347\224\237\343\201\227\343\201\276\343\201\227\343\201\237\'));\n    };\n    reader.readAsText(file);\n  });\n}\n"
